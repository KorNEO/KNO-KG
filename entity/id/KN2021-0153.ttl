@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0153 a ontolex:Word ;
    frac:attestation kno:KN2021-0153-att-nn ;
    ontolex:canonicalForm kno:KN2021-0153-form ;
    ontolex:sense kno:KN2021-0153-sense .

kno:KN2021-0153-att-nn a frac:Attestation ;
    dcterms:date "2020-08-31"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/022/0003498808> .

kno:KN2021-0153-form a ontolex:Form ;
    frac:frequency kno:KN2021-0153-freq-nn,
        kno:KN2021-0153-freq-yt ;
    ontolex:writtenRep "산스장"@ko .

kno:KN2021-0153-freq-nn a frac:CorpusFrequency ;
    rdf:value 767 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0153-freq-yt a frac:CorpusFrequency ;
    rdf:value 2414 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0153-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%95%BC%EC%99%B8%20%ED%97%AC%EC%8A%A4%EC%9E%A5> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

