@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0266 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2022-0266-att-nn ;
    ontolex:canonicalForm kno:KN2022-0266-form ;
    ontolex:sense kno:KN2022-0266-sense .

kno:KN2022-0266-att-nn a frac:Attestation ;
    dcterms:date "2021-06-28"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/025/0003113611> .

kno:KN2022-0266-form a ontolex:Form ;
    frac:frequency kno:KN2022-0266-freq-nn,
        kno:KN2022-0266-freq-yt ;
    ontolex:writtenRep "청년^내일^저축^계좌"@ko .

kno:KN2022-0266-freq-nn a frac:CorpusFrequency ;
    rdf:value 3608 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0266-freq-yt a frac:CorpusFrequency ;
    rdf:value 139 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0266-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%B2%AD%EB%85%84%EB%82%B4%EC%9D%BC%EC%A0%80%EC%B6%95%EA%B3%84%EC%A2%8C> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

