@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0149 a ontolex:Word ;
    frac:attestation kno:KN2022-0149-att-nn ;
    ontolex:canonicalForm kno:KN2022-0149-form ;
    ontolex:sense kno:KN2022-0149-sense .

kno:KN2022-0149-att-nn a frac:Attestation ;
    dcterms:date "2021-01-25"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/016/0001784256> .

kno:KN2022-0149-form a ontolex:Form ;
    frac:frequency kno:KN2022-0149-freq-nn,
        kno:KN2022-0149-freq-yt ;
    ontolex:writtenRep "뮨-파"@ko .

kno:KN2022-0149-freq-nn a frac:CorpusFrequency ;
    rdf:value 145 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0149-freq-yt a frac:CorpusFrequency ;
    rdf:value 1012 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0149-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%AE%A8%ED%8C%8C> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

