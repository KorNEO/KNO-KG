@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0374 a ontolex:Word ;
    frac:attestation kno:KN2020-0374-att-nn ;
    ontolex:canonicalForm kno:KN2020-0374-form ;
    ontolex:sense kno:KN2020-0374-sense .

kno:KN2020-0374-att-nn a frac:Attestation ;
    dcterms:date "2020-04-23"^^xsd:date ;
    frac:locus <https://m.sports.naver.com/article/003/0009830336> .

kno:KN2020-0374-form a ontolex:Form ;
    frac:frequency kno:KN2020-0374-freq-nn,
        kno:KN2020-0374-freq-yt ;
    ontolex:writtenRep "코비디엇"@ko .

kno:KN2020-0374-freq-nn a frac:CorpusFrequency ;
    rdf:value 53 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0374-freq-yt a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0374-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

