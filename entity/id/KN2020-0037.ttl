@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0037 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2020-0037-att-nn ;
    ontolex:canonicalForm kno:KN2020-0037-form ;
    ontolex:sense kno:KN2020-0037-sense .

kno:KN2020-0037-att-nn a frac:Attestation ;
    dcterms:date "2020-06-25"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/421/0004718374> .

kno:KN2020-0037-form a ontolex:Form ;
    frac:frequency kno:KN2020-0037-freq-nn,
        kno:KN2020-0037-freq-yt ;
    ontolex:writtenRep "금융^투자^소득세"@ko .

kno:KN2020-0037-freq-nn a frac:CorpusFrequency ;
    rdf:value 23496 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0037-freq-yt a frac:CorpusFrequency ;
    rdf:value 1262 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0037-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EA%B8%88%EC%9C%B5%ED%88%AC%EC%9E%90%EC%86%8C%EB%93%9D%EC%84%B8> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

