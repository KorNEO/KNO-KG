@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0593 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2025-0593-att-nn ;
    ontolex:canonicalForm kno:KN2025-0593-form ;
    ontolex:sense kno:KN2025-0593-sense .

kno:KN2025-0593-att-nn a frac:Attestation ;
    dcterms:date "2025-01-05"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/214/0001398090> .

kno:KN2025-0593-form a ontolex:Form ;
    frac:frequency kno:KN2025-0593-freq-nn,
        kno:KN2025-0593-freq-yt ;
    ontolex:writtenRep "키세스 시위대"@ko .

kno:KN2025-0593-freq-nn a frac:CorpusFrequency ;
    rdf:value 223 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0593-freq-yt a frac:CorpusFrequency ;
    rdf:value 42 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0593-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

