@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0300 a ontolex:Word ;
    frac:attestation kno:KN2023-0300-att-nn ;
    ontolex:canonicalForm kno:KN2023-0300-form ;
    ontolex:sense kno:KN2023-0300-sense .

kno:KN2023-0300-att-nn a frac:Attestation ;
    dcterms:date "2022-12-29"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/037/0000031801> .

kno:KN2023-0300-form a ontolex:Form ;
    frac:frequency kno:KN2023-0300-freq-nn,
        kno:KN2023-0300-freq-yt ;
    ontolex:writtenRep "크룽지"@ko .

kno:KN2023-0300-freq-nn a frac:CorpusFrequency ;
    rdf:value 604 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0300-freq-yt a frac:CorpusFrequency ;
    rdf:value 513 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0300-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%81%AC%EB%A3%A8%EC%95%84%EC%83%81> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

