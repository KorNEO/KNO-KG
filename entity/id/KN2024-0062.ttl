@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0062 a ontolex:Word ;
    frac:attestation kno:KN2024-0062-att-nn ;
    ontolex:canonicalForm kno:KN2024-0062-form ;
    ontolex:sense kno:KN2024-0062-sense .

kno:KN2024-0062-att-nn a frac:Attestation ;
    dcterms:date "2024-05-03"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/311/0001722281> .

kno:KN2024-0062-form a ontolex:Form ;
    frac:frequency kno:KN2024-0062-freq-nn,
        kno:KN2024-0062-freq-yt ;
    ontolex:writtenRep "러키-비키"@ko .

kno:KN2024-0062-freq-nn a frac:CorpusFrequency ;
    rdf:value 71 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0062-freq-yt a frac:CorpusFrequency ;
    rdf:value 1180 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0062-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%9B%90%EC%98%81%EC%A0%81%20%EC%82%AC%EA%B3%A0> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

