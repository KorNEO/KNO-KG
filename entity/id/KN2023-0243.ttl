@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0243 a ontolex:Word ;
    frac:attestation kno:KN2023-0243-att-nn ;
    ontolex:canonicalForm kno:KN2023-0243-form ;
    ontolex:sense kno:KN2023-0243-sense .

kno:KN2023-0243-att-nn a frac:Attestation ;
    dcterms:date "2020-01-01"^^xsd:date ;
    frac:locus <https://m.sports.naver.com/article/529/0000039734> .

kno:KN2023-0243-form a ontolex:Form ;
    frac:frequency kno:KN2023-0243-freq-nn,
        kno:KN2023-0243-freq-yt ;
    ontolex:writtenRep "저니"@ko .

kno:KN2023-0243-freq-nn a frac:CorpusFrequency ;
    rdf:value 16832 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0243-freq-yt a frac:CorpusFrequency ;
    rdf:value 27465 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0243-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/Journey> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

