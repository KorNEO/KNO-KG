@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0404 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2020-0404-att-nn ;
    ontolex:canonicalForm kno:KN2020-0404-form ;
    ontolex:sense kno:KN2020-0404-sense .

kno:KN2020-0404-att-nn a frac:Attestation ;
    dcterms:date "2020-07-09"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/081/0003106176> .

kno:KN2020-0404-form a ontolex:Form ;
    frac:frequency kno:KN2020-0404-freq-nn,
        kno:KN2020-0404-freq-yt ;
    ontolex:writtenRep "화상 벌레"@ko .

kno:KN2020-0404-freq-nn a frac:CorpusFrequency ;
    rdf:value 299 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0404-freq-yt a frac:CorpusFrequency ;
    rdf:value 188 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0404-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%B2%AD%EB%94%B1%EC%A7%80%EA%B0%9C%EB%AF%B8%EB%B0%98%EB%82%A0%EA%B0%9C> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

