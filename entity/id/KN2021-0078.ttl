@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0078 a ontolex:Word ;
    frac:attestation kno:KN2021-0078-att-nn ;
    ontolex:canonicalForm kno:KN2021-0078-form ;
    ontolex:sense kno:KN2021-0078-sense .

kno:KN2021-0078-att-nn a frac:Attestation ;
    dcterms:date "2021-04-28"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/009/0004786392> .

kno:KN2021-0078-form a ontolex:Form ;
    frac:frequency kno:KN2021-0078-freq-nn,
        kno:KN2021-0078-freq-yt ;
    ontolex:writtenRep "돔황챠"@ko .

kno:KN2021-0078-freq-nn a frac:CorpusFrequency ;
    rdf:value 37 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0078-freq-yt a frac:CorpusFrequency ;
    rdf:value 4234 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0078-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EA%B0%80%EC%A6%88%EC%95%84> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

