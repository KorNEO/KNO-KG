@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0106 a ontolex:Word ;
    frac:attestation kno:KN2023-0106-att-nn ;
    ontolex:canonicalForm kno:KN2023-0106-form ;
    ontolex:sense kno:KN2023-0106-sense .

kno:KN2023-0106-att-nn a frac:Attestation ;
    dcterms:date "2023-03-23"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/374/0000328491> .

kno:KN2023-0106-form a ontolex:Form ;
    frac:frequency kno:KN2023-0106-freq-nn,
        kno:KN2023-0106-freq-yt ;
    ontolex:writtenRep "반세권"@ko .

kno:KN2023-0106-freq-nn a frac:CorpusFrequency ;
    rdf:value 650 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0106-freq-yt a frac:CorpusFrequency ;
    rdf:value 6 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0106-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%B0%98%EC%84%B8%EA%B6%8C> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

