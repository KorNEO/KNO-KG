@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0097 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2025-0097-att-nn ;
    ontolex:canonicalForm kno:KN2025-0097-form ;
    ontolex:sense kno:KN2025-0097-sense .

kno:KN2025-0097-att-nn a frac:Attestation ;
    dcterms:date "2025-10-30"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/056/0012057059> .

kno:KN2025-0097-form a ontolex:Form ;
    frac:frequency kno:KN2025-0097-freq-nn,
        kno:KN2025-0097-freq-yt ;
    ontolex:writtenRep "깐부 회동"@ko .

kno:KN2025-0097-freq-nn a frac:CorpusFrequency ;
    rdf:value 527 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0097-freq-yt a frac:CorpusFrequency ;
    rdf:value 66 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0097-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/2025%EB%85%84%20%EC%A0%A0%EC%8A%A8%20%ED%99%A9%20%EB%B0%A9%ED%95%9C> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

