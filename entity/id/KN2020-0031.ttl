@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0031 a ontolex:Word ;
    frac:attestation kno:KN2020-0031-att-nn ;
    ontolex:canonicalForm kno:KN2020-0031-form ;
    ontolex:sense kno:KN2020-0031-sense .

kno:KN2020-0031-att-nn a frac:Attestation ;
    dcterms:date "2020-01-18"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/008/0004342335> .

kno:KN2020-0031-form a ontolex:Form ;
    frac:frequency kno:KN2020-0031-freq-nn,
        kno:KN2020-0031-freq-yt ;
    ontolex:writtenRep "국평오"@ko .

kno:KN2020-0031-freq-nn a frac:CorpusFrequency ;
    rdf:value 15 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0031-freq-yt a frac:CorpusFrequency ;
    rdf:value 28626 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0031-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%8C%80%ED%95%9C%EB%AF%BC%EA%B5%AD%20%EA%B5%AD%EB%AF%BC%20%ED%8F%89%EA%B7%A0%EC%9D%80%20%EC%88%98%EB%8A%A5%205%EB%93%B1%EA%B8%89> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

