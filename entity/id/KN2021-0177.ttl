@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0177 a ontolex:Word ;
    frac:attestation kno:KN2021-0177-att-nn ;
    ontolex:canonicalForm kno:KN2021-0177-form ;
    ontolex:sense kno:KN2021-0177-sense .

kno:KN2021-0177-att-nn a frac:Attestation ;
    dcterms:date "2021-02-25"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/112/0003403746> .

kno:KN2021-0177-form a ontolex:Form ;
    frac:frequency kno:KN2021-0177-freq-nn,
        kno:KN2021-0177-freq-yt ;
    ontolex:writtenRep "싫테"@ko .

kno:KN2021-0177-freq-nn a frac:CorpusFrequency ;
    rdf:value 2 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0177-freq-yt a frac:CorpusFrequency ;
    rdf:value 710 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0177-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%B9%84%EA%B3%B5%ED%85%8C%EB%9F%AC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

