@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0178 a ontolex:Word ;
    frac:attestation kno:KN2022-0178-att-nn ;
    ontolex:canonicalForm kno:KN2022-0178-form ;
    ontolex:sense kno:KN2022-0178-sense .

kno:KN2022-0178-att-nn a frac:Attestation ;
    dcterms:date "2021-07-02"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/002/0002197718> .

kno:KN2022-0178-form a ontolex:Form ;
    frac:frequency kno:KN2022-0178-freq-nn,
        kno:KN2022-0178-freq-yt ;
    ontolex:writtenRep "설거지-론"@ko .

kno:KN2022-0178-freq-nn a frac:CorpusFrequency ;
    rdf:value 520 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0178-freq-yt a frac:CorpusFrequency ;
    rdf:value 4155 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0178-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%84%A4%EA%B1%B0%EC%A7%80%EB%A1%A0> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

