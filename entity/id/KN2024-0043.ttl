@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0043 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2024-0043-att-nn ;
    ontolex:canonicalForm kno:KN2024-0043-form ;
    ontolex:sense kno:KN2024-0043-sense .

kno:KN2024-0043-att-nn a frac:Attestation ;
    dcterms:date "2023-08-27"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/022/0003849127> .

kno:KN2024-0043-form a ontolex:Form ;
    frac:frequency kno:KN2024-0043-freq-nn,
        kno:KN2024-0043-freq-yt ;
    ontolex:writtenRep "노 타투 존"@ko .

kno:KN2024-0043-freq-nn a frac:CorpusFrequency ;
    rdf:value 171 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0043-freq-yt a frac:CorpusFrequency ;
    rdf:value 6 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0043-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%85%B8%ED%83%80%ED%88%AC%EC%A1%B4> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

