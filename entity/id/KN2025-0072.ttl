@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0072 a ontolex:Word ;
    ontolex:canonicalForm kno:KN2025-0072-form ;
    ontolex:sense kno:KN2025-0072-sense .

kno:KN2025-0072-form a ontolex:Form ;
    frac:frequency kno:KN2025-0072-freq-nn,
        kno:KN2025-0072-freq-yt ;
    ontolex:writtenRep "교토 화법"@ko .

kno:KN2025-0072-freq-nn a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0072-freq-yt a frac:CorpusFrequency ;
    rdf:value 253 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0072-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EA%B5%90%ED%86%A0%EC%8B%9C> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

