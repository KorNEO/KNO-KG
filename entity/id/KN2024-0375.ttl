@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0375 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2024-0375-att-nn ;
    ontolex:canonicalForm kno:KN2024-0375-form ;
    ontolex:sense kno:KN2024-0375-sense .

kno:KN2024-0375-att-nn a frac:Attestation ;
    dcterms:date "2024-01-01"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/469/0000778040> .

kno:KN2024-0375-form a ontolex:Form ;
    frac:frequency kno:KN2024-0375-freq-nn,
        kno:KN2024-0375-freq-yt ;
    ontolex:writtenRep "항로^표지^식별^장치"@ko .

kno:KN2024-0375-freq-nn a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0375-freq-yt a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0375-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

