@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0251 a ontolex:Word ;
    frac:attestation kno:KN2021-0251-att-nn ;
    ontolex:canonicalForm kno:KN2021-0251-form ;
    ontolex:sense kno:KN2021-0251-sense .

kno:KN2021-0251-att-nn a frac:Attestation ;
    dcterms:date "2020-09-04"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/119/0002425981> .

kno:KN2021-0251-form a ontolex:Form ;
    frac:frequency kno:KN2021-0251-freq-nn,
        kno:KN2021-0251-freq-yt ;
    ontolex:writtenRep "쩝쩝-박사"@ko .

kno:KN2021-0251-freq-nn a frac:CorpusFrequency ;
    rdf:value 615 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0251-freq-yt a frac:CorpusFrequency ;
    rdf:value 3648 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0251-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%A9%9D%EC%A9%9D%EB%B0%95%EC%82%AC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

