@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0285 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2020-0285-att-nn ;
    ontolex:canonicalForm kno:KN2020-0285-form ;
    ontolex:sense kno:KN2020-0285-sense .

kno:KN2020-0285-att-nn a frac:Attestation ;
    dcterms:date "2020-02-27"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/032/0002994590> .

kno:KN2020-0285-form a ontolex:Form ;
    frac:frequency kno:KN2020-0285-freq-nn,
        kno:KN2020-0285-freq-yt ;
    ontolex:writtenRep "재난^기본^소득"@ko .

kno:KN2020-0285-freq-nn a frac:CorpusFrequency ;
    rdf:value 52421 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0285-freq-yt a frac:CorpusFrequency ;
    rdf:value 2164 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0285-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EA%B8%B0%EB%B3%B8%EC%86%8C%EB%93%9D> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

