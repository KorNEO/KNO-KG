@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0285 a ontolex:Word ;
    frac:attestation kno:KN2022-0285-att-nn ;
    ontolex:canonicalForm kno:KN2022-0285-form ;
    ontolex:sense kno:KN2022-0285-sense .

kno:KN2022-0285-att-nn a frac:Attestation ;
    dcterms:date "2022-04-28"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/082/0001153276> .

kno:KN2022-0285-form a ontolex:Form ;
    frac:frequency kno:KN2022-0285-freq-nn,
        kno:KN2022-0285-freq-yt ;
    ontolex:writtenRep "파산핑"@ko .

kno:KN2022-0285-freq-nn a frac:CorpusFrequency ;
    rdf:value 308 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0285-freq-yt a frac:CorpusFrequency ;
    rdf:value 1977 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0285-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%BA%90%EC%B9%98!%20%ED%8B%B0%EB%8B%88%ED%95%91%20%EC%8B%9C%EB%A6%AC%EC%A6%88/%EB%B9%84%ED%8C%90> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

