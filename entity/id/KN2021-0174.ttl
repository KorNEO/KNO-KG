@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0174 a ontolex:Word ;
    frac:attestation kno:KN2021-0174-att-nn ;
    ontolex:canonicalForm kno:KN2021-0174-form ;
    ontolex:sense kno:KN2021-0174-sense .

kno:KN2021-0174-att-nn a frac:Attestation ;
    dcterms:date "2020-08-28"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/025/0003030183> .

kno:KN2021-0174-form a ontolex:Form ;
    frac:frequency kno:KN2021-0174-freq-nn,
        kno:KN2021-0174-freq-yt ;
    ontolex:writtenRep "식-집사"@ko .

kno:KN2021-0174-freq-nn a frac:CorpusFrequency ;
    rdf:value 1609 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0174-freq-yt a frac:CorpusFrequency ;
    rdf:value 1035 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0174-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%8B%9D%EC%A7%91%EC%82%AC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

