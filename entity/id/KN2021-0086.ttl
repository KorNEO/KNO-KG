@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0086 a ontolex:Word ;
    frac:attestation kno:KN2021-0086-att-nn ;
    ontolex:canonicalForm kno:KN2021-0086-form ;
    ontolex:sense kno:KN2021-0086-sense .

kno:KN2021-0086-att-nn a frac:Attestation ;
    dcterms:date "2020-05-15"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/417/0000542972> .

kno:KN2021-0086-form a ontolex:Form ;
    frac:frequency kno:KN2021-0086-freq-nn,
        kno:KN2021-0086-freq-yt ;
    ontolex:writtenRep "뚜따"@ko .

kno:KN2021-0086-freq-nn a frac:CorpusFrequency ;
    rdf:value 66 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0086-freq-yt a frac:CorpusFrequency ;
    rdf:value 8269 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0086-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%9A%9C%EB%94%B0> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

