@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0469 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2025-0469-att-nn ;
    ontolex:canonicalForm kno:KN2025-0469-form ;
    ontolex:sense kno:KN2025-0469-sense .

kno:KN2025-0469-att-nn a frac:Attestation ;
    dcterms:date "2025-01-08"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/214/0001398679> .

kno:KN2025-0469-form a ontolex:Form ;
    frac:frequency kno:KN2025-0469-freq-nn,
        kno:KN2025-0469-freq-yt ;
    ontolex:writtenRep "은박 요정"@ko .

kno:KN2025-0469-freq-nn a frac:CorpusFrequency ;
    rdf:value 7 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0469-freq-yt a frac:CorpusFrequency ;
    rdf:value 8 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0469-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

