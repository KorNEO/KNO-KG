@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0310 a ontolex:Word ;
    frac:attestation kno:KN2023-0310-att-nn ;
    ontolex:canonicalForm kno:KN2023-0310-form ;
    ontolex:sense kno:KN2023-0310-sense .

kno:KN2023-0310-att-nn a frac:Attestation ;
    dcterms:date "2021-05-27"^^xsd:date ;
    frac:locus <https://m.sports.naver.com/article/477/0000301636> .

kno:KN2023-0310-form a ontolex:Form ;
    frac:frequency kno:KN2023-0310-freq-nn,
        kno:KN2023-0310-freq-yt ;
    ontolex:writtenRep "탈트넘"@ko .

kno:KN2023-0310-freq-nn a frac:CorpusFrequency ;
    rdf:value 529 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0310-freq-yt a frac:CorpusFrequency ;
    rdf:value 9604 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0310-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%83%88%ED%8A%B8%EB%84%98> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

