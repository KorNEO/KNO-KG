@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0244 a ontolex:Word ;
    frac:attestation kno:KN2020-0244-att-nn ;
    ontolex:canonicalForm kno:KN2020-0244-form ;
    ontolex:sense kno:KN2020-0244-sense .

kno:KN2020-0244-att-nn a frac:Attestation ;
    dcterms:date "2020-01-17"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/028/0002481997> .

kno:KN2020-0244-form a ontolex:Form ;
    frac:frequency kno:KN2020-0244-freq-nn,
        kno:KN2020-0244-freq-yt ;
    ontolex:writtenRep "요린이"@ko .

kno:KN2020-0244-freq-nn a frac:CorpusFrequency ;
    rdf:value 10265 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0244-freq-yt a frac:CorpusFrequency ;
    rdf:value 2844 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0244-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%B0%B1%ED%8C%8C%EB%8D%94%20:%20%EC%9A%94%EB%A6%AC%EB%A5%BC%20%EB%A9%88%EC%B6%94%EC%A7%80%20%EB%A7%88!> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

