@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0118 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2023-0118-att-nn ;
    ontolex:canonicalForm kno:KN2023-0118-form ;
    ontolex:sense kno:KN2023-0118-sense .

kno:KN2023-0118-att-nn a frac:Attestation ;
    dcterms:date "2022-09-15"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/009/0005017719> .

kno:KN2023-0118-form a ontolex:Form ;
    frac:frequency kno:KN2023-0118-freq-nn,
        kno:KN2023-0118-freq-yt ;
    ontolex:writtenRep "불법^파업^조장법"@ko .

kno:KN2023-0118-freq-nn a frac:CorpusFrequency ;
    rdf:value 2368 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0118-freq-yt a frac:CorpusFrequency ;
    rdf:value 34 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0118-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

