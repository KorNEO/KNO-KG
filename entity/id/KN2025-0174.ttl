@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0174 a ontolex:Word ;
    frac:attestation kno:KN2025-0174-att-nn ;
    ontolex:canonicalForm kno:KN2025-0174-form ;
    ontolex:sense kno:KN2025-0174-sense .

kno:KN2025-0174-att-nn a frac:Attestation ;
    dcterms:date "2025-12-14"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/009/0005605755> .

kno:KN2025-0174-form a ontolex:Form ;
    frac:frequency kno:KN2025-0174-freq-nn,
        kno:KN2025-0174-freq-yt ;
    ontolex:writtenRep "두쫀쿠"@ko .

kno:KN2025-0174-freq-nn a frac:CorpusFrequency ;
    rdf:value 379 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0174-freq-yt a frac:CorpusFrequency ;
    rdf:value 1055 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0174-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%91%90%EB%B0%94%EC%9D%B4%20%EC%AB%80%EB%93%9D%EC%BF%A0%ED%82%A4> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

