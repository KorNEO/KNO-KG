@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0373 a ontolex:Word ;
    frac:attestation kno:KN2020-0373-att-nn ;
    ontolex:canonicalForm kno:KN2020-0373-form ;
    ontolex:sense kno:KN2020-0373-sense .

kno:KN2020-0373-att-nn a frac:Attestation ;
    dcterms:date "2020-05-21"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/056/0010838609> .

kno:KN2020-0373-form a ontolex:Form ;
    frac:frequency kno:KN2020-0373-freq-nn,
        kno:KN2020-0373-freq-yt ;
    ontolex:writtenRep "코비디보스"@ko .

kno:KN2020-0373-freq-nn a frac:CorpusFrequency ;
    rdf:value 51 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0373-freq-yt a frac:CorpusFrequency ;
    rdf:value 2 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0373-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%BD%94%EB%A1%9C%EB%82%98%20%EC%9D%B4%ED%98%BC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

