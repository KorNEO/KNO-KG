@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0204 a ontolex:MultiwordExpression ;
    ontolex:canonicalForm kno:KN2023-0204-form ;
    ontolex:sense kno:KN2023-0204-sense .

kno:KN2023-0204-form a ontolex:Form ;
    frac:frequency kno:KN2023-0204-freq-nn,
        kno:KN2023-0204-freq-yt ;
    ontolex:writtenRep "우버 파킹"@ko .

kno:KN2023-0204-freq-nn a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0204-freq-yt a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0204-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

