@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0062 a ontolex:MultiwordExpression ;
    ontolex:canonicalForm kno:KN2022-0062-form ;
    ontolex:sense kno:KN2022-0062-sense .

kno:KN2022-0062-form a ontolex:Form ;
    frac:frequency kno:KN2022-0062-freq-nn,
        kno:KN2022-0062-freq-yt ;
    ontolex:writtenRep "국가^첨단^전략^산업^경쟁력^강화^및^보호에^관한^특별^조치법"@ko .

kno:KN2022-0062-freq-nn a frac:CorpusFrequency ;
    rdf:value 672 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0062-freq-yt a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0062-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

