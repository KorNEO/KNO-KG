@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0083 a ontolex:Word ;
    frac:attestation kno:KN2020-0083-att-nn ;
    ontolex:canonicalForm kno:KN2020-0083-form ;
    ontolex:sense kno:KN2020-0083-sense .

kno:KN2020-0083-att-nn a frac:Attestation ;
    dcterms:date "2020-03-03"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/005/0001294805> .

kno:KN2020-0083-form a ontolex:Form ;
    frac:frequency kno:KN2020-0083-freq-nn,
        kno:KN2020-0083-freq-yt ;
    ontolex:writtenRep "달고나-커피"@ko .

kno:KN2020-0083-freq-nn a frac:CorpusFrequency ;
    rdf:value 3141 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0083-freq-yt a frac:CorpusFrequency ;
    rdf:value 12403 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0083-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%8B%AC%EA%B3%A0%EB%82%98%20%EC%BB%A4%ED%94%BC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

