@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0122 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2020-0122-att-nn ;
    ontolex:canonicalForm kno:KN2020-0122-form ;
    ontolex:sense kno:KN2020-0122-sense .

kno:KN2020-0122-att-nn a frac:Attestation ;
    dcterms:date "2020-09-22"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/018/0004742312> .

kno:KN2020-0122-form a ontolex:Form ;
    frac:frequency kno:KN2020-0122-freq-nn,
        kno:KN2020-0122-freq-yt ;
    ontolex:writtenRep "배달 거지"@ko .

kno:KN2020-0122-freq-nn a frac:CorpusFrequency ;
    rdf:value 449 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0122-freq-yt a frac:CorpusFrequency ;
    rdf:value 821 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0122-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%B0%B0%EB%8B%AC%EA%B1%B0%EC%A7%80> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

