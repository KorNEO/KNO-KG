@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0057 a ontolex:Word ;
    frac:attestation kno:KN2021-0057-att-nn ;
    ontolex:canonicalForm kno:KN2021-0057-form ;
    ontolex:sense kno:KN2021-0057-sense .

kno:KN2021-0057-att-nn a frac:Attestation ;
    dcterms:date "2021-02-26"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/057/0001552885> .

kno:KN2021-0057-form a ontolex:Form ;
    frac:frequency kno:KN2021-0057-freq-nn,
        kno:KN2021-0057-freq-yt ;
    ontolex:writtenRep "네카라쿠배당토"@ko .

kno:KN2021-0057-freq-nn a frac:CorpusFrequency ;
    rdf:value 311 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0057-freq-yt a frac:CorpusFrequency ;
    rdf:value 85 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0057-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%84%A4%EC%B9%B4%EB%9D%BC%EC%BF%A0%EB%B0%B0> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

