@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0203 a ontolex:Word ;
    frac:attestation kno:KN2020-0203-att-nn ;
    ontolex:canonicalForm kno:KN2020-0203-form ;
    ontolex:sense kno:KN2020-0203-sense .

kno:KN2020-0203-att-nn a frac:Attestation ;
    dcterms:date "2020-04-02"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/052/0001423308> .

kno:KN2020-0203-form a ontolex:Form ;
    frac:frequency kno:KN2020-0203-freq-nn,
        kno:KN2020-0203-freq-yt ;
    ontolex:writtenRep "아베노마스크"@ko .

kno:KN2020-0203-freq-nn a frac:CorpusFrequency ;
    rdf:value 1565 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0203-freq-yt a frac:CorpusFrequency ;
    rdf:value 1075 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0203-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%95%84%EB%B2%A0%20%EC%8B%A0%EC%A1%B0/%EB%B9%84%ED%8C%90%EA%B3%BC%20%EB%85%BC%EB%9E%80> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

