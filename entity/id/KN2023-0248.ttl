@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0248 a ontolex:Word ;
    frac:attestation kno:KN2023-0248-att-nn ;
    ontolex:canonicalForm kno:KN2023-0248-form ;
    ontolex:sense kno:KN2023-0248-sense .

kno:KN2023-0248-att-nn a frac:Attestation ;
    dcterms:date "2023-06-06"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/032/0003228074> .

kno:KN2023-0248-form a ontolex:Form ;
    frac:frequency kno:KN2023-0248-freq-nn,
        kno:KN2023-0248-freq-yt ;
    ontolex:writtenRep "절싫중떠"@ko .

kno:KN2023-0248-freq-nn a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0248-freq-yt a frac:CorpusFrequency ;
    rdf:value 21 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0248-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%A0%88%EC%9D%B4%20%EC%8B%AB%EC%9C%BC%EB%A9%B4%20%EC%A4%91%EC%9D%B4%20%EB%96%A0%EB%82%98%EB%9D%BC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

