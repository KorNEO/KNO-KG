@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0033 a ontolex:Word ;
    frac:attestation kno:KN2021-0033-att-nn ;
    ontolex:canonicalForm kno:KN2021-0033-form ;
    ontolex:sense kno:KN2021-0033-sense .

kno:KN2021-0033-att-nn a frac:Attestation ;
    dcterms:date "2021-03-11"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/277/0004863371> .

kno:KN2021-0033-form a ontolex:Form ;
    frac:frequency kno:KN2021-0033-freq-nn,
        kno:KN2021-0033-freq-yt ;
    ontolex:writtenRep "군싹"@ko .

kno:KN2021-0033-freq-nn a frac:CorpusFrequency ;
    rdf:value 43 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0033-freq-yt a frac:CorpusFrequency ;
    rdf:value 536 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0033-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%A3%A8%ED%94%BC(%EB%BD%80%EB%A1%B1%EB%BD%80%EB%A1%B1%20%EB%BD%80%EB%A1%9C%EB%A1%9C)> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

