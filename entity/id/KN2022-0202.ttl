@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0202 a ontolex:Word ;
    frac:attestation kno:KN2022-0202-att-nn ;
    ontolex:canonicalForm kno:KN2022-0202-form ;
    ontolex:sense kno:KN2022-0202-sense .

kno:KN2022-0202-att-nn a frac:Attestation ;
    dcterms:date "2022-09-15"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/277/0005147641> .

kno:KN2022-0202-form a ontolex:Form ;
    frac:frequency kno:KN2022-0202-freq-nn,
        kno:KN2022-0202-freq-yt ;
    ontolex:writtenRep "악깡버"@ko .

kno:KN2022-0202-freq-nn a frac:CorpusFrequency ;
    rdf:value 9 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0202-freq-yt a frac:CorpusFrequency ;
    rdf:value 1677 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0202-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%95%85%EC%9C%BC%EB%A1%9C%20%EA%B9%A1%EC%9C%BC%EB%A1%9C%20%EB%B2%84%ED%85%A8%EB%9D%BC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

