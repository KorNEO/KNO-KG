kno:KN2024-0138 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2024-0138-att-nn ;
    ontolex:canonicalForm kno:KN2024-0138-form ;
    ontolex:sense kno:KN2024-0138-sense .

kno:KN2024-0138-att-nn a frac:Attestation ;
    dcterms:date "2023-07-09"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/025/0003292459> .

kno:KN2024-0138-form a ontolex:Form ;
    frac:frequency kno:KN2024-0138-freq-nn,
        kno:KN2024-0138-freq-yt ;
    ontolex:writtenRep "순살 아파트"@ko .

kno:KN2024-0138-freq-nn a frac:CorpusFrequency ;
    rdf:value 1829 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0138-freq-yt a frac:CorpusFrequency ;
    rdf:value 4389 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0138-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/LH%EC%95%84%ED%8C%8C%ED%8A%B8%20%EB%8B%A8%EC%A7%80%20%EC%A7%80%ED%95%98%EC%A3%BC%EC%B0%A8%EC%9E%A5%20%EC%B2%A0%EA%B7%BC%20%EB%88%84%EB%9D%BD%20%EB%8C%80%EA%B1%B0%20%EC%A0%81%EB%B0%9C%20%EC%82%AC%EA%B1%B4> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

