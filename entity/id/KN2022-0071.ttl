@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0071 a ontolex:Word ;
    frac:attestation kno:KN2022-0071-att-nn ;
    ontolex:canonicalForm kno:KN2022-0071-form ;
    ontolex:sense kno:KN2022-0071-sense .

kno:KN2022-0071-att-nn a frac:Attestation ;
    dcterms:date "2020-08-18"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/003/0010026491> .

kno:KN2022-0071-form a ontolex:Form ;
    frac:frequency kno:KN2022-0071-freq-nn,
        kno:KN2022-0071-freq-yt ;
    ontolex:writtenRep "국현미"@ko .

kno:KN2022-0071-freq-nn a frac:CorpusFrequency ;
    rdf:value 141 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0071-freq-yt a frac:CorpusFrequency ;
    rdf:value 101 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0071-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EA%B5%AD%EB%A6%BD%ED%98%84%EB%8C%80%EB%AF%B8%EC%88%A0%EA%B4%80> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

