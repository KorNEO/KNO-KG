@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0195 a ontolex:Word ;
    frac:attestation kno:KN2023-0195-att-nn ;
    ontolex:canonicalForm kno:KN2023-0195-form ;
    ontolex:sense kno:KN2023-0195-sense .

kno:KN2023-0195-att-nn a frac:Attestation ;
    dcterms:date "2022-07-22"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/119/0002623438> .

kno:KN2023-0195-form a ontolex:Form ;
    frac:frequency kno:KN2023-0195-freq-nn,
        kno:KN2023-0195-freq-yt ;
    ontolex:writtenRep "연개특위"@ko .

kno:KN2023-0195-freq-nn a frac:CorpusFrequency ;
    rdf:value 49 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0195-freq-yt a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0195-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

