@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0134 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2025-0134-att-nn ;
    ontolex:canonicalForm kno:KN2025-0134-form ;
    ontolex:sense kno:KN2025-0134-sense .

kno:KN2025-0134-att-nn a frac:Attestation ;
    dcterms:date "2025-05-18"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/018/0006017606> .

kno:KN2025-0134-form a ontolex:Form ;
    frac:frequency kno:KN2025-0134-freq-nn,
        kno:KN2025-0134-freq-yt ;
    ontolex:writtenRep "노쇼 경제론"@ko .

kno:KN2025-0134-freq-nn a frac:CorpusFrequency ;
    rdf:value 53 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0134-freq-yt a frac:CorpusFrequency ;
    rdf:value 38 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0134-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

