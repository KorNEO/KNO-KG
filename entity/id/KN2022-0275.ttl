@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0275 a ontolex:Word ;
    frac:attestation kno:KN2022-0275-att-nn ;
    ontolex:canonicalForm kno:KN2022-0275-form ;
    ontolex:sense kno:KN2022-0275-sense .

kno:KN2022-0275-att-nn a frac:Attestation ;
    dcterms:date "2022-04-19"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/005/0001519874> .

kno:KN2022-0275-form a ontolex:Form ;
    frac:frequency kno:KN2022-0275-freq-nn,
        kno:KN2022-0275-freq-yt ;
    ontolex:writtenRep "코내기"@ko .

kno:KN2022-0275-freq-nn a frac:CorpusFrequency ;
    rdf:value 40 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0275-freq-yt a frac:CorpusFrequency ;
    rdf:value 4 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0275-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%BD%94%EB%A1%9C%EB%82%98%20%ED%95%99%EB%B2%88> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

