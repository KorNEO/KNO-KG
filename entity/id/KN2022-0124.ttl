@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0124 a ontolex:Word ;
    frac:attestation kno:KN2022-0124-att-nn ;
    ontolex:canonicalForm kno:KN2022-0124-form ;
    ontolex:sense kno:KN2022-0124-sense .

kno:KN2022-0124-att-nn a frac:Attestation ;
    dcterms:date "2021-07-08"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/030/0002956217> .

kno:KN2022-0124-form a ontolex:Form ;
    frac:frequency kno:KN2022-0124-freq-nn,
        kno:KN2022-0124-freq-yt ;
    ontolex:writtenRep "디깅-족"@ko .

kno:KN2022-0124-freq-nn a frac:CorpusFrequency ;
    rdf:value 76 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0124-freq-yt a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0124-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%94%94%EA%B9%85> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

