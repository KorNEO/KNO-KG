@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0214 a ontolex:Word ;
    frac:attestation kno:KN2021-0214-att-nn ;
    ontolex:canonicalForm kno:KN2021-0214-form ;
    ontolex:sense kno:KN2021-0214-sense .

kno:KN2021-0214-att-nn a frac:Attestation ;
    dcterms:date "2020-12-12"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/018/0004806076> .

kno:KN2021-0214-form a ontolex:Form ;
    frac:frequency kno:KN2021-0214-freq-nn,
        kno:KN2021-0214-freq-yt ;
    ontolex:writtenRep "이모카세"@ko .

kno:KN2021-0214-freq-nn a frac:CorpusFrequency ;
    rdf:value 4138 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0214-freq-yt a frac:CorpusFrequency ;
    rdf:value 1573 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0214-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EA%B9%80%EB%AF%B8%EB%A0%B9> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

