@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0090 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2020-0090-att-nn ;
    ontolex:canonicalForm kno:KN2020-0090-form ;
    ontolex:sense kno:KN2020-0090-sense .

kno:KN2020-0090-att-nn a frac:Attestation ;
    dcterms:date "2020-03-20"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/052/0001417411> .

kno:KN2020-0090-form a ontolex:Form ;
    frac:frequency kno:KN2020-0090-freq-nn,
        kno:KN2020-0090-freq-yt ;
    ontolex:writtenRep "동학 개미"@ko .

kno:KN2020-0090-freq-nn a frac:CorpusFrequency ;
    rdf:value 21161 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0090-freq-yt a frac:CorpusFrequency ;
    rdf:value 3873 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0090-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EA%B0%9C%EB%AF%B8(%EC%A3%BC%EC%8B%9D)> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

