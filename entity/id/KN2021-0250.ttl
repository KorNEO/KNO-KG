@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0250 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2021-0250-att-nn ;
    ontolex:canonicalForm kno:KN2021-0250-form ;
    ontolex:sense kno:KN2021-0250-sense .

kno:KN2021-0250-att-nn a frac:Attestation ;
    dcterms:date "2020-07-24"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/032/0003022815> .

kno:KN2021-0250-form a ontolex:Form ;
    frac:frequency kno:KN2021-0250-freq-nn,
        kno:KN2021-0250-freq-yt ;
    ontolex:writtenRep "집착 광공"@ko .

kno:KN2021-0250-freq-nn a frac:CorpusFrequency ;
    rdf:value 100 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0250-freq-yt a frac:CorpusFrequency ;
    rdf:value 3179 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0250-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%A7%91%EC%B0%A9%EA%B4%91%EA%B3%B5> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

