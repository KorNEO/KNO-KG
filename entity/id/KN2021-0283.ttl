@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0283 a ontolex:Word ;
    frac:attestation kno:KN2021-0283-att-nn ;
    ontolex:canonicalForm kno:KN2021-0283-form ;
    ontolex:sense kno:KN2021-0283-sense .

kno:KN2021-0283-att-nn a frac:Attestation ;
    dcterms:date "2020-08-17"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/020/0003303762> .

kno:KN2021-0283-form a ontolex:Form ;
    frac:frequency kno:KN2021-0283-freq-nn,
        kno:KN2021-0283-freq-yt ;
    ontolex:writtenRep "트윈데믹"@ko .

kno:KN2021-0283-freq-nn a frac:CorpusFrequency ;
    rdf:value 5628 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0283-freq-yt a frac:CorpusFrequency ;
    rdf:value 247 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0283-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%B2%94%EC%9C%A0%ED%96%89%EC%A0%84%EC%97%BC%EB%B3%91> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

