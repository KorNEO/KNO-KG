@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0088 a ontolex:Word ;
    frac:attestation kno:KN2024-0088-att-nn ;
    ontolex:canonicalForm kno:KN2024-0088-form ;
    ontolex:sense kno:KN2024-0088-sense .

kno:KN2024-0088-att-nn a frac:Attestation ;
    dcterms:date "2023-12-20"^^xsd:date ;
    frac:locus <https://m.sports.naver.com/article/023/0003805908> .

kno:KN2024-0088-form a ontolex:Form ;
    frac:frequency kno:KN2024-0088-freq-nn,
        kno:KN2024-0088-freq-yt ;
    ontolex:writtenRep "분유로이드"@ko .

kno:KN2024-0088-freq-nn a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0088-freq-yt a frac:CorpusFrequency ;
    rdf:value 9 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0088-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

