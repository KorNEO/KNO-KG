@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0314 a ontolex:Word ;
    frac:attestation kno:KN2023-0314-att-nn ;
    ontolex:canonicalForm kno:KN2023-0314-form ;
    ontolex:sense kno:KN2023-0314-sense .

kno:KN2023-0314-att-nn a frac:Attestation ;
    dcterms:date "2021-09-25"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/112/0003479930> .

kno:KN2023-0314-form a ontolex:Form ;
    frac:frequency kno:KN2023-0314-freq-nn,
        kno:KN2023-0314-freq-yt ;
    ontolex:writtenRep "탑꾸"@ko .

kno:KN2023-0314-freq-nn a frac:CorpusFrequency ;
    rdf:value 147 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0314-freq-yt a frac:CorpusFrequency ;
    rdf:value 1037 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0314-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%B9%B4%EB%93%9C%20%ED%94%84%EB%A1%9C%ED%85%8D%ED%84%B0> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

