@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0457 a ontolex:Word ;
    frac:attestation kno:KN2025-0457-att-nn ;
    ontolex:canonicalForm kno:KN2025-0457-form ;
    ontolex:sense kno:KN2025-0457-sense .

kno:KN2025-0457-att-nn a frac:Attestation ;
    dcterms:date "2025-02-27"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/241/0003416227> .

kno:KN2025-0457-form a ontolex:Form ;
    frac:frequency kno:KN2025-0457-freq-nn,
        kno:KN2025-0457-freq-yt ;
    ontolex:writtenRep "위쑤시개"@ko .

kno:KN2025-0457-freq-nn a frac:CorpusFrequency ;
    rdf:value 25 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0457-freq-yt a frac:CorpusFrequency ;
    rdf:value 52 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0457-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

