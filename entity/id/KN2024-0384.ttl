@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0384 a ontolex:Word ;
    frac:attestation kno:KN2024-0384-att-nn ;
    ontolex:canonicalForm kno:KN2024-0384-form ;
    ontolex:sense kno:KN2024-0384-sense .

kno:KN2024-0384-att-nn a frac:Attestation ;
    dcterms:date "2023-11-22"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/417/0000964015> .

kno:KN2024-0384-form a ontolex:Form ;
    frac:frequency kno:KN2024-0384-freq-nn,
        kno:KN2024-0384-freq-yt ;
    ontolex:writtenRep "헥사하이드로칸나비헥솔"@ko .

kno:KN2024-0384-freq-nn a frac:CorpusFrequency ;
    rdf:value 6 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0384-freq-yt a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0384-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%97%A5%EC%82%AC%ED%95%98%EC%9D%B4%EB%93%9C%EB%A1%9C%EC%B9%B8%EB%82%98%EB%B9%84%ED%97%A5%EC%86%94> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

