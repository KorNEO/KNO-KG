@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0288 a ontolex:Word ;
    frac:attestation kno:KN2021-0288-att-nn ;
    ontolex:canonicalForm kno:KN2021-0288-form ;
    ontolex:sense kno:KN2021-0288-sense .

kno:KN2021-0288-att-nn a frac:Attestation ;
    dcterms:date "2021-06-26"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/469/0000613530> .

kno:KN2021-0288-form a ontolex:Form ;
    frac:frequency kno:KN2021-0288-freq-nn,
        kno:KN2021-0288-freq-yt ;
    ontolex:writtenRep "핀플루언서"@ko .

kno:KN2021-0288-freq-nn a frac:CorpusFrequency ;
    rdf:value 1026 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0288-freq-yt a frac:CorpusFrequency ;
    rdf:value 13 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0288-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%95%80%ED%94%8C%EB%A3%A8%EC%96%B8%EC%84%9C> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

