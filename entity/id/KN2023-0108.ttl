@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0108 a ontolex:Word ;
    frac:attestation kno:KN2023-0108-att-nn ;
    ontolex:canonicalForm kno:KN2023-0108-form ;
    ontolex:sense kno:KN2023-0108-sense .

kno:KN2023-0108-att-nn a frac:Attestation ;
    dcterms:date "2022-12-05"^^xsd:date ;
    frac:locus <https://m.sports.naver.com/article/356/0000057502> .

kno:KN2023-0108-form a ontolex:Form ;
    frac:frequency kno:KN2023-0108-freq-nn,
        kno:KN2023-0108-freq-yt ;
    ontolex:writtenRep "뱀서-라이크"@ko .

kno:KN2023-0108-freq-nn a frac:CorpusFrequency ;
    rdf:value 113 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0108-freq-yt a frac:CorpusFrequency ;
    rdf:value 121 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0108-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%B1%80%EC%84%9C%EB%9D%BC%EC%9D%B4%ED%81%AC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

