@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0192 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2024-0192-att-nn ;
    ontolex:canonicalForm kno:KN2024-0192-form ;
    ontolex:sense kno:KN2024-0192-sense .

kno:KN2024-0192-att-nn a frac:Attestation ;
    dcterms:date "2023-09-13"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/003/0012086149> .

kno:KN2024-0192-form a ontolex:Form ;
    frac:frequency kno:KN2024-0192-freq-nn,
        kno:KN2024-0192-freq-yt ;
    ontolex:writtenRep "예술^활동^준비금"@ko .

kno:KN2024-0192-freq-nn a frac:CorpusFrequency ;
    rdf:value 395 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0192-freq-yt a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0192-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

