@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0106 a ontolex:Word ;
    frac:attestation kno:KN2021-0106-att-nn ;
    ontolex:canonicalForm kno:KN2021-0106-form ;
    ontolex:sense kno:KN2021-0106-sense .

kno:KN2021-0106-att-nn a frac:Attestation ;
    dcterms:date "2021-01-18"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/018/0004830616> .

kno:KN2021-0106-form a ontolex:Form ;
    frac:frequency kno:KN2021-0106-freq-nn,
        kno:KN2021-0106-freq-yt ;
    ontolex:writtenRep "마기꾼"@ko .

kno:KN2021-0106-freq-nn a frac:CorpusFrequency ;
    rdf:value 619 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0106-freq-yt a frac:CorpusFrequency ;
    rdf:value 8316 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0106-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%A7%88%EA%B8%B0%EA%BE%BC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

