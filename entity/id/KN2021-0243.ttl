@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0243 a ontolex:Word ;
    frac:attestation kno:KN2021-0243-att-nn ;
    ontolex:canonicalForm kno:KN2021-0243-form ;
    ontolex:sense kno:KN2021-0243-sense .

kno:KN2021-0243-att-nn a frac:Attestation ;
    dcterms:date "2020-10-25"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/009/0004681349> .

kno:KN2021-0243-form a ontolex:Form ;
    frac:frequency kno:KN2021-0243-freq-nn,
        kno:KN2021-0243-freq-yt ;
    ontolex:writtenRep "중수-청"@ko .

kno:KN2021-0243-freq-nn a frac:CorpusFrequency ;
    rdf:value 24144 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0243-freq-yt a frac:CorpusFrequency ;
    rdf:value 7214 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0243-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%A4%91%EB%8C%80%EB%B2%94%EC%A3%84%EC%88%98%EC%82%AC%EC%B2%AD> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

