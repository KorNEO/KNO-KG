# F002488 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002488 a kno:Formative ;
    rdfs:label "(임오)군란(壬午軍亂)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=579644> ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B5%B0%EB%9E%80> ;
    kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "임오군란"@ko ;
    kno:fullFormLexeme kno:LEX-임오군란 ;
    kno:origin "壬午軍亂" ;
    kno:parallelFullForm kno:LEX-임오군란 ;
    kno:registration "우리말샘"@ko ;
    kno:surfaceForm "군란"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    kno:urimalDefinition "조선 고종 19년(1882)인 임오년에 구식 군대의 군인들이 신식 군대인 별기군과의 차별 대우와 밀린 급료에 불만을 품고 군제 개혁에 반대하며 일으킨 난리. 이를 계기로 다시 정권을 잡은 대원군은 여러 가지 개혁을 단행하는 등, 사태 수습에 노력하였으나 결국 실패하여 청나라에 압송되었으며, 조정은 일본과 제물포 조약을 맺게 되었다. 〔명사〕"@ko ;
    kno:urimalTargetCode "579644" .
kno:KN2023-0020-c2 kno:formative kno:F002488 .
