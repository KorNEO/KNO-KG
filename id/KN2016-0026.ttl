# KN2016-0026 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0026 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "과수^에이즈"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372461> ;
    skos:definition "배나 사과 등의 과수에서 관찰할 수 있는 전염성이 강한 세균병을 이르는 말. 나무의 꽃과 잎, 열매 등이 화상을 입은 모양으로 검게 말라 죽으며, 아직까지 완전한 치료법이 없어 감염된 과수 주변의 과수들 또한 모두 소각하거나 매몰해야 한다."@ko ;
    kno:activeYears "8"^^xsd:integer ;
    kno:component kno:KN2016-0026-c1 ;
    kno:component kno:KN2016-0026-c2 ;
    kno:componentString "과수(果樹), 에이즈(AIDS)"@ko ;
    kno:example "¶충남 천안 지역 배 과수 농가에 ‘{과수 에이즈’로} 불리는 ‘화상병’이 지난해에 이어 또 재발했다."@ko ;
