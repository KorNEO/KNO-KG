    a kno:Neologism ;
    rdfs:label "헌법^개정^범국민^운동"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%97%8C%EB%B2%95%EA%B0%9C%EC%A0%95%EB%B2%94%EA%B5%AD%EB%AF%BC%EC%9A%B4%EB%8F%99> ;
    skos:definition "국민들에게 헌법 개정의 필요성을 알리고, 많은 국민들의 동참을 요구하는 운동."@ko ;
