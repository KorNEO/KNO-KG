# F000717 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000717 kno:caseCount "3"^^xsd:integer ;
    kno:semanticTag kno:usas-L2 ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=426> ;
    kno:surfaceForm "동물"@ko ;
    kno:origin "動物" ;
    kno:fullForm "동물"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:label "동물(動物)"@ko ;
    kno:urimalDefinition "생물계의 두 갈래 가운데 하나. 현재 100만~120만 종이 알려져 있고 그 가운데 약 80%는 곤충이 차지한다. 원생동물부터 척추동물까지 23개 문(門)으로 분류된다. 주로 유기물을 영양분으로 섭취하며, 운동, 감각, 신경 따위의 기능이 발달하였다. 소화, 배설, 호흡, 순환, 생식 따위의 기관이 분화되어 있다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "426" .
