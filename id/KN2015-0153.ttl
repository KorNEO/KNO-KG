# KN2015-0153 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0153 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "엄지-맘"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1359835> ;
    skos:definition "아이를 돌보면서 모바일 쇼핑을 즐기는 어머니."@ko ;
