# KN2019-0291 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0291 kno:registration "신어DB"@ko ;
    kno:frequency kno:KN2019-0291-freq-NN-2019 ;
    kno:origin "(<영>fashion自害)" ;
    skos:definition "다른 사람들의 관심을 끌거나 남들에게 과시하기 위해 자기 몸을 스스로 다치게 함. 주로 청소년들이 자해하거나 자해한 상처를 사진으로 찍어 다른 사람들에게 보여 주는 행동을 비꼬아 이르는 말이다."@ko ;
    kno:unitType "구"@ko ;
    a ontolex:MultiwordExpression ;
    kno:indexForm "패션자해"@ko ;
    kno:componentString "패션(fashion), 자해(自害)"@ko ;
    kno:frequency kno:KN2019-0291-freq-NN-2023 ;
    kno:languageType "영_한" ;
    kno:frequency kno:KN2019-0291-freq-NN-2025 ;
    kno:component kno:KN2019-0291-c2 ;
    a kno:Neologism ;
    kno:year "2019"^^xsd:gYear ;
    kno:example "¶OOO OO 소장은 “{패션 자해라는} 말처럼 단순히 아이들이 유행처럼 자해를 한다고 보면 안 된다. 심리적, 정신적 어려움이 발현된 것이다.”라며 “어떤 아이들은 자해의 대안을 찾지 못하거나 대안을 찾을 상태가 되지 않아 어려움을 겪고 있는데 이를 이해하려는 노력이 먼저.”라고 강조했다."@ko ;
    kno:frequency kno:KN2019-0291-freq-NN-total ;
    kno:pos "「구」"@ko ;
    kno:activeYears "3"^^xsd:integer ;
