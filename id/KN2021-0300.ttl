kno:KN2021-0300 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "확장 가상 세계"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%99%95%EC%9E%A5%20%EA%B0%80%EC%83%81%20%EC%84%B8%EA%B3%84> ;
    skos:definition "3차원의 가상 세계에서 자신의 역할을 대신하는 가상의 캐릭터를 통해 현실 세계에서처럼 경제, 사회, 문화적 활동을 함으로써 가상 세계와 현실 세계의 경계가 허물어진 세계. =멀티 버스."@ko ;
