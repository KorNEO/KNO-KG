# KN2014-0093 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0093 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "맞디스-랩"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1358180> ;
    skos:definition "자신을 비방하는 내용의 곡에 맞서기 위해 상대방을 비방하는 내용으로 가사를 쓴 랩."@ko ;
