# KN2017-0036 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0036 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "금-대리"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%88%EB%8C%80%EB%A6%AC> ;
    skos:definition "주로 건설업계의 회사에서, 대리급 인력이 많지 않아 귀함을 비유적으로 이르는 말."@ko ;
    kno:activeYears "10"^^xsd:integer ;
    kno:component kno:KN2017-0036-c1 ;
    kno:component kno:KN2017-0036-c2 ;
    kno:componentString "금(金), 대리(代理)"@ko ;
    kno:example "¶O 회사 대표는 “최근 이직한 대리나 과장급 모두 대기업이나 경쟁 중견 기업에서 연봉을 조금 더 주고 데려간 것.”이라며 “요즘 업계에서는 {금대리}, 은과장이라는 용어까지 등장했다.”라고 말했다."@ko ;
