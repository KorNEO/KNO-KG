@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0225 a ontolex:Word ;
    frac:attestation kno:KN2021-0225-att-nn ;
    ontolex:canonicalForm kno:KN2021-0225-form ;
    ontolex:sense kno:KN2021-0225-sense .

kno:KN2021-0225-att-nn a frac:Attestation ;
    dcterms:date "2020-10-04"^^xsd:date ;
    frac:locus <https://m.sports.naver.com/article/442/0000123952> .

kno:KN2021-0225-form a ontolex:Form ;
    frac:frequency kno:KN2021-0225-freq-nn,
        kno:KN2021-0225-freq-yt ;
    ontolex:writtenRep "잼민-이"@ko .

kno:KN2021-0225-freq-nn a frac:CorpusFrequency ;
    rdf:value 590 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0225-freq-yt a frac:CorpusFrequency ;
    rdf:value 664893 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0225-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%9E%BC%EB%AF%BC%EC%9D%B4> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

