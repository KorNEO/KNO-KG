# KN2021-0225 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0225 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "잼민-이"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9E%BC%EB%AF%BC%EC%9D%B4> ;
    skos:definition "‘어린이’를 속되게 이르는 말. 주로 ‘초등학생’을 낮잡아 이르는 말이다. 차별 및 비하하는 의미가 포함되어 있으므로 사용에 주의가 필요하다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2021-0225-c1 ;
    kno:component kno:KN2021-0225-c2 ;
    kno:componentString "잼민, -이"@ko ;
    kno:example "¶‘초딩’과 비슷하게 쓰이고 있는 ‘{잼민이’는} 게임 실황 방송 플랫폼의 문자 음성 변환기에서 선택할 수 있는 어린 남자아이 목소리인 ‘재민’에서 유래되었다고 한다."@ko ;
