# F004555 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004555 kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    kno:origin "smoking" ;
    kno:urimalTargetCode "390327" ;
    kno:fullForm "스모킹"@ko ;
    rdfs:label "스모킹(smoking)"@ko ;
    kno:urimalDefinition "서양 자수에서, 천을 모아 홀쳐서 생긴 주름과 주름을 연속해서 색실로 수를 놓아 아름다운 무늬와 음영을 나타내는 자수 기법. 헝가리·체코·슬로바키아 등지의 민속 의상에서 그 원형을 볼 수 있으며, 스목의 주름을 고정하는 장식 스티치로서 발전하였다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=390327> ;
    kno:caseCount "1"^^xsd:integer ;
    kno:semanticTag kno:usas-F3 ;
    kno:surfaceForm "스모킹"@ko ;
    kno:registration "우리말샘"@ko .
kno:KN2014-0173-c2 kno:formative kno:F004555 .
