# F000457 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000457 kno:fullForm "골프"@ko ;
    a kno:Formative ;
    kno:urimalTargetCode "524586" ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B3%A8> ;
    kno:urimalDefinition "일정한 장소에서 골프채로 공을 쳐서 가장 적은 타수로 홀에 넣는 경기. 9홀 또는 18홀을 돈다. 각 홀을 돌며 경기해서 총타수를 계산하는 스트로크 플레이와 각 홀마다 승패를 겨루는 매치 플레이의 형식이 있다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=524586> ;
    kno:registration "우리말샘"@ko ;
    rdfs:label "골(프)(golf)"@ko ;
    kno:caseCount "4"^^xsd:integer ;
    kno:fullFormLexeme kno:LEX-골프 ;
    kno:parallelFullForm kno:LEX-골프 ;
    kno:origin "golf" ;
    kno:truncated "true"^^xsd:boolean ;
    kno:semanticTag kno:usas-K5.1 ;
    kno:surfaceForm "골"@ko .
