# KN2023-0171 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0171 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "알줍"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%95%8C%EC%A4%8D> ;
    skos:definition "‘알려 주세요. 주워 주세요.’를 줄여 이르는 말. 해안 쓰레기를 알리고 주우며 조깅을 하는 연안 정화 캠페인의 일종이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2023-0171-c1 ;
    kno:component kno:KN2023-0171-c2 ;
    kno:componentString "알(리다), 줍(다)"@ko ;
    kno:example "¶해양 수산부는 해양 쓰레기 신고를 활성화하고, 피서철 해변 정화를 위해서 {알줍}을 추진할 예정이라고 밝혔다."@ko ;
