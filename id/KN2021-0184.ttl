# KN2021-0184 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0184 kno:frequency kno:KN2021-0184-freq-NN-2020 ;
    kno:componentString "아동(兒童), 특별(特別), 돌봄, 지원비(支援費)"@ko ;
    kno:registration "신어DB"@ko ;
    skos:definition "재난 따위로 인하여 어린 자녀를 돌보는 데 부담이 늘어난 가정을 돕기 위하여 일시적으로 지원하는 일에 드는 비용. 코로나19의 대유행으로 인해 학교, 어린이집, 유치원 등이 휴교 및 휴원하는 기간이 길어짐에 따라 늘어난 가정의 양육 부담을 줄이기 위하여 정부가 2020년 9월에 초등학생 이하의 아동이 있는 가정에 아동 1명당 20만 원씩 지원금을 지급했다. =아동 특별 돌봄비, 아동 특별 돌봄 지원금."@ko ;
    rdfs:label "아동^특별^돌봄^지원비"@ko ;
    kno:unitType "구"@ko ;
    kno:slotFiller "지원비(支援費) (1성분)"@ko ;
    kno:instantiates kno:S000541 ;
    a kno:Neologism ;
    kno:indexForm "아동특별돌봄지원비"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:pos "「구」"@ko ;
    kno:predicate "드다"@ko ;
    kno:year "2021"^^xsd:gYear ;
    kno:component kno:KN2021-0184-c3 ;
    kno:languageType "한^한^고^한" ;
