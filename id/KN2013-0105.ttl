# KN2013-0105 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0105 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "담배 생정"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8B%B4%EB%B0%B0%20%EC%83%9D%EC%A0%95> ;
    skos:definition "초중고생이 담배를 예쁘거나 멋있게 피우는 방법에 대한 정보."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2013-0105-c1 ;
    kno:component kno:KN2013-0105-c2 ;
    kno:componentString "담배, 생정(生情)"@ko ;
    kno:example "¶23일 일선 초중등학교 등에 따르면 최근 청소년들 사이에서 각종 10대 관련 생활 정보를 게시하는 생정 블로그가 유행처럼 번지고 있는 가운데 일부에서 ‘{담배 생정}’, ‘일진 생정’ 등의 제목을 달고 담배 피는 법, 일진 되는 법, 화장 상식 등을 알려 주는 정보 글이 무분별하게 올라와 문제로 지적되고 있다."@ko ;
