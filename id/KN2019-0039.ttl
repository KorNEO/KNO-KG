# KN2019-0039 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0039 kno:formation kno:W05 ;
    kno:languageType "한+영" ;
    kno:component kno:KN2019-0039-c1 ;
