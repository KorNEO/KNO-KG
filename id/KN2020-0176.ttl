# KN2020-0176 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0176 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "쇄국 방역"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%87%84%EA%B5%AD%20%EB%B0%A9%EC%97%AD> ;
    skos:definition "감염원이 외부에서 유입되는 것을 차단하기 위해, 국내로의 입국을 금지하거나 국경을 봉쇄하여 전염병의 발병과 확산을 막는 일. 코로나19의 감염과 확산을 막기 위하여 일부 나라에서 시행된 방역 조치이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2020-0176-c1 ;
    kno:component kno:KN2020-0176-c2 ;
    kno:componentString "쇄국(鎖國), 방역(防疫)"@ko ;
    kno:example "¶그 나라는 철저하게 {쇄국 방역을} 펼쳐 코로나19 방역에 성공했다는 평가를 받고 있다."@ko ;
