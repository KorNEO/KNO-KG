kno:KN2013-0304 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "에스엔에스단식족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1357328> ;
    skos:definition "누리 소통망 서비스(SNS)를 전혀 사용하지 않거나 최소한으로 사용하는 사람. 또는 그런 무리."@ko ;
