# KN2020-0304 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0304 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "젊집사"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A0%8A%EC%A7%91%EC%82%AC> ;
    skos:definition "‘젊을 때 집 사기’를 줄여 이르는 말. 집을 사는 것이 점점 어려워질 것이라는 불안감에 젊은 세대들이 빚을 내서 내 집 마련에 뛰어드는 현상에서 비롯된 말이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2020-0304-c1 ;
    kno:component kno:KN2020-0304-c2 ;
    kno:component kno:KN2020-0304-c3 ;
    kno:componentString "젊(다), 집, 사(다)"@ko ;
    kno:example "¶아무리 ‘{젊집사’라고} 하지만, 10대들조차 부동산 시장에 뛰어드는 것은 너무 심하다."@ko ;
    kno:formation kno:W06 ;
