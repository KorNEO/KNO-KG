# KN2018-0267 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0267 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "욜 테크"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380389> ;
    skos:definition "현재의 행복한 삶을 위하여 자신을 위한 소비에 돈을 아끼지 않으면서도, 불필요한 소비를 최대한 줄이고자 하는 소비 방식."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2018-0267-c1 ;
    kno:component kno:KN2018-0267-c2 ;
    kno:componentString "욜(로)(YOLO), (재)테크(tech)"@ko ;
    kno:example "¶선호하는 분야에서 자유로운 소비를 추구하는 욜로족 사이에서 오히려 저렴한 가격을 찾는 ‘{욜 테크’가} 트렌드로 부상하고 있다는 분석이다."@ko ;
    kno:frequency kno:KN2018-0267-freq-NN-2017 ;
