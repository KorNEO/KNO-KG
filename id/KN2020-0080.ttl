# KN2020-0080 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0080 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "녹녹^갈등"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%85%B9%EB%85%B9%EA%B0%88%EB%93%B1> ;
    skos:definition "‘녹색과 녹색의 갈등’을 줄여 이르는 말. 온실가스 배출 등의 환경 문제를 해결하기 위해 풍력, 수력 따위의 재생 가능 에너지 개발을 추구하는 과정에서 오히려 또 다른 환경 문제가 발생할 경우에 생기는 의견 대립을 말한다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2020-0080-c1 ;
    kno:component kno:KN2020-0080-c2 ;
    kno:componentString "녹녹(綠綠), 갈등(葛藤)"@ko ;
    kno:example "¶풍력, 태양열 등 재생 가능 에너지로의 전환은 당면한 시대적 흐름이지만 환경 파괴를 일으키며 {녹녹 갈등이} 있는 것도 사실이다."@ko ;
    kno:frequency kno:KN2020-0080-freq-NN-2019 ;
    kno:frequency kno:KN2020-0080-freq-NN-2021 ;
    kno:frequency kno:KN2020-0080-freq-NN-2022 ;
