    kno:component kno:KN2024-0120-c2 ;
    a ontolex:Word ;
    kno:example "¶당장 올해 대입부터 대학교 입학을 위한 최종 등록을 포기하고 바로 재수에 돌입하는 수험생이 증가할 것이라는 분석이 있는 반면 수험생들이 {생재수의} 위험을 감수하기보다는 대학교에 등록한 후 반수를 택할 것이라는 분석이 엇갈렸다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
