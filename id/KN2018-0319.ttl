# KN2018-0319 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0319 kno:origin "(出店絕壁)" ;
    kno:registration "우리말샘"@ko ;
    kno:indexForm "출점절벽"@ko ;
    kno:frequency kno:KN2018-0319-freq-NN-total ;
