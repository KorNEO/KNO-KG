kno:KN2021-0065 kno:activeYears "3"^^xsd:integer ;
    skos:definition "가까운 동네에서 중고로 물건을 사고파는 일. 중고 거래 애플리케이션인 ‘당근 마켓’에서 비롯된 말이다."@ko ;
