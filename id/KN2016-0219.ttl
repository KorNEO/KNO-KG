# KN2016-0219 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0219 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "부채^저항^운동"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B6%80%EC%B1%84%EC%A0%80%ED%95%AD%EC%9A%B4%EB%8F%99> ;
    skos:definition "부당한 채무로 인한 압력이나 부채를 통해 유지되는 사회 체제에 맞서 싸우는 민중 운동. 단순히 부당한 채무를 거부하는 것에 그치지 않고 2차 세계 대전 이후 형성된 부채의 지배 논리 자체를 거부한다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2016-0219-c1 ;
    kno:component kno:KN2016-0219-c2 ;
    kno:component kno:KN2016-0219-c3 ;
    kno:componentString "부채(負債), 저항(抵抗), 운동(運動)"@ko ;
    kno:example "¶{부채 저항 운동의} 구호인 “당신은 빚이 아니다.”가 “당신은 혼자가 아니다.”와 같은 발음으로 읽힌다는 것은 의미심장하다."@ko ;
    kno:frequency kno:KN2016-0219-freq-NN-2016 ;
