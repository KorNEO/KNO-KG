kno:KN2019-0309 kno:pos "「명」"@ko ;
    kno:componentString "피, 뽑(히다), 탈(락)(脫)"@ko ;
    rdfs:label "피뽑탈"@ko ;
    kno:languageType "고+고+한" ;
    kno:unitType "단어"@ko ;
    kno:example "¶청와대 국민 청원 게시판에, 취업 준비생에게 ‘희망 고문’을 멈춰 달라며 “{‘피뽑탈’이} 없어져야 한다.”라는 글이 올라와 있다."@ko ;
    a ontolex:Word ;
    kno:component kno:KN2019-0309-c3 ;
