# F005570 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005570 kno:urimalTargetCode "261238" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=261238> ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    kno:semanticTag kno:usas-L3 ;
    kno:surfaceForm "장미"@ko ;
    rdfs:label "장미(薔薇)"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "장미"@ko ;
    kno:origin "薔薇" ;
    kno:urimalDefinition "장미과 장미속의 관목을 통틀어 이르는 말. 높이는 2~3미터이며, 잎은 어긋나고 깃 모양이다. 5~6월에 담홍색, 담자색, 흰색 따위의 꽃이 핀다. 개량 품종이 많은 관상 꽃나무이다. 북반구의 온대와 아한대에 주로 분포한다. 〔명사〕"@ko .
kno:KN2017-0240-c1 kno:formative kno:F005570 .
