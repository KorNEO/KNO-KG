# F003261 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003261 kno:truncated "true"^^xsd:boolean ;
    kno:urimalDefinition "중생대 쥐라기와 백악기에 걸쳐 번성하였던 거대한 파충류를 통틀어 이르는 말. 몸의 길이가 30미터에 달하는 것도 있고 육상에서 살았다. 화석에 의하여 400여 종 이상이 알려져 있다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=414094> ;
    kno:parallelFullForm kno:LEX-공룡 ;
    kno:fullFormLexeme kno:LEX-공룡 ;
    kno:fullForm "공룡"@ko ;
    kno:registration "우리말샘"@ko ;
    a kno:Formative ;
    rdfs:label "(공)룡(恐龍)"@ko ;
    kno:origin "恐龍" ;
    kno:surfaceForm "룡"@ko ;
    kno:semanticTag kno:usas-L2 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A3%A1> ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalTargetCode "414094" .
