# KN2023-0132 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0132 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "선가후고"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%84%A0%EA%B0%80%ED%9B%84%EA%B3%A0> ;
    skos:definition "‘선 가입 후 고민’을 줄여 이르는 말. 금리가 높은 적금에 가입부터 한 후, 다른 상품과 비교하며 정기 납입 여부를 결정하는 것을 말한다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
