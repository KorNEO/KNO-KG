    rdfs:label "카캉스"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415928> ;
    skos:definition "카페에서 여유롭게 휴식을 취하며 보내는 휴가. ‘카페(café)’와 ‘휴가’를 뜻하는 ‘바캉스(vacance)’를 결합하여 만든 말이다."@ko ;
    kno:activeYears "7"^^xsd:integer ;
