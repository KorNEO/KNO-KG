# KN2025-0270 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0270 kno:unitType "단어"@ko ;
    kno:component kno:KN2025-0270-c1 ;
    skos:definition "(LLM) 특정 단체나 진영으로부터 금전ㆍ물품 따위를 ‘배급받는다’는 의혹을 근거로, 그들의 입장을 대변하며 온라인에서 댓글ㆍ여론전에 가담하는 사람을 비하하여 이르는 말."@ko ;
    kno:indexForm "배급견"@ko ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:frequency kno:KN2025-0270-freq-NN-total ;
    kno:year "2025"^^xsd:gYear ;
    kno:registration "신어DB"@ko ;
    a ontolex:Word ;
    kno:activeYears "1"^^xsd:integer ;
    kno:pos "「명」"@ko ;
    kno:example "(LLM) 같은 문구의 댓글이 한꺼번에 달리자 이용자들은 {배급견들이} 또 몰려왔다며 반발했다."@ko ;
    kno:instantiates kno:S000245 ;
