# F001175 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001175 kno:urimalDefinition "고등 교육을 베푸는 교육 기관. 국가와 인류 사회 발전에 필요한 학술 이론과 응용 방법을 교수하고 연구하며, 지도적 인격을 도야한다. 고등학교 졸업자 또는 이와 동등한 학력이 있다고 인정된 사람이 입학하며 수업 연한은 2년에서 6년까지이다. 〔명사〕"@ko ;
    a kno:Formative ;
    kno:surfaceForm "대학"@ko ;
    kno:semanticTag kno:usas-P1 ;
    kno:origin "大學" ;
    kno:truncated "false"^^xsd:boolean ;
    kno:caseCount "2"^^xsd:integer ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=7195> ;
    rdfs:label "대학(大學)"@ko ;
    kno:urimalTargetCode "7195" ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "대학"@ko .
kno:KN2025-0156-c1 kno:formative kno:F001175 .
