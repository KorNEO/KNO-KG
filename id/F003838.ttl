# F003838 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003838 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=496845> ;
    kno:origin "甓" ;
    kno:urimalDefinition "진흙과 모래를 차지게 반죽하여 틀에 박아서 600~1,100℃에서 구워 만들거나, 시멘트와 모래를 버무려 틀에 박아 건조한 네모진 건축 재료. 표준 크기는 190×90×57mm이다. ⇒규범 표기는 ‘벽돌’이다. 〔명사〕"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:surfaceForm "벽"@ko ;
    kno:urimalTargetCode "496845" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "벽"@ko ;
    kno:semanticTag kno:usas-H1 ;
    rdfs:label "벽(甓)"@ko ;
    a kno:Formative ;
