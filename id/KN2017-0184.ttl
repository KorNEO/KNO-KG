# KN2017-0184 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0184 kno:component kno:KN2017-0184-c1 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380748> ;
    kno:componentString "악(마)(惡), 편(집)(編)"@ko ;
    kno:registration "우리말샘"@ko ;
    a kno:Neologism ;
    kno:urimalTargetCode "1380748" ;
    kno:pos "「명」"@ko ;
    kno:origin "(惡編)" ;
    kno:activeYears "0"^^xsd:integer ;
    kno:formation kno:W06 ;
    kno:year "2017"^^xsd:gYear ;
    skos:definition "‘악마의 편집’을 줄여 이르는 말. 제작자나 편집자의 목적에 따라 영상물을 의도적으로 편집하여 출현자가 한 말이나 행동이 사실과 다르게 시청자들에게 전달되도록 하는 것을 이른다."@ko ;
    kno:component kno:KN2017-0184-c2 ;
    rdfs:label "악편"@ko ;
    a ontolex:Word ;
    kno:unitType "단어"@ko ;
    kno:indexForm "악편"@ko ;
    kno:example "¶잘하는 것을 포착하지 않고, 못하는 것은 반복해 보여 주는 수법도 {악편의} 한 방식이다."@ko ;
    kno:languageType "한+한" .
