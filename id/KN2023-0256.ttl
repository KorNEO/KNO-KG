# KN2023-0256 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0256 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "조력^존엄사법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A1%B0%EB%A0%A5%EC%A1%B4%EC%97%84%EC%82%AC%EB%B2%95> ;
    skos:definition "회복 가능성이 없는 환자가 의료진의 도움으로 약물 등을 제공받아 인간으로서 지녀야 하는 최소한의 품위를 지키면서 스스로 삶을 마칠 수 있도록 하고자 제정한 법률. 정식 명칭은 ‘호스피스ㆍ완화 의료 및 임종 과정에 있는 환자의 연명 의료 결정에 관한 법률 일부 개정 법률안’이다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2023-0256-c1 ;
    kno:component kno:KN2023-0256-c2 ;
    kno:componentString "조력(助力), 존엄사법(尊嚴死法)"@ko ;
    kno:example "¶말기 환자의 삶에 대한 자기 결정권을 증진하는 데 초점을 둔 {조력 존엄사법이} 국회 발의를 앞두고 있다."@ko ;
