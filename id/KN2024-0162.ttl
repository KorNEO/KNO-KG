# KN2024-0162 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0162 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "안러경중"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%95%88%EB%9F%AC%EA%B2%BD%EC%A4%91> ;
    skos:definition "안보는 러시아와, 경제는 중국과 협력하는 것을 이르는 말. 북한이 러시아와의 군사 협력을 강화하고, 중국과의 경제 협력을 중시하는 전략을 의미한다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2024-0162-c1 ;
    kno:component kno:KN2024-0162-c2 ;
    kno:component kno:KN2024-0162-c3 ;
    kno:component kno:KN2024-0162-c4 ;
    kno:componentString "안(보)(安保), 러(시아)(Russia), 경(제)(經濟), 중(국)(中國)"@ko ;
    kno:example "¶북한이 {안러경중에} 바탕을 두고 있지만, 자국의 이익을 위해서는 언제든 행보를 달리할 수 있을 것이라는 해석이 나오고 있다."@ko ;
