# KN2022-0053 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0053 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "국가^유산^기본법"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1801736> ;
    skos:definition "국가 유산 체제의 변화를 위하여 문화 유산의 유형별 특성에 맞게 필요한 사항을 정한 법률."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2022-0053-c1 ;
