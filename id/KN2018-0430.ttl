kno:KN2018-0430 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "횰로-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1405501> ;
    skos:definition "현재의 행복을 중요하게 여기며 혼자서 즐기면서 살아가는 사람. 또는 그런 무리."@ko ;
