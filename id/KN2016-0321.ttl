# KN2016-0321 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0321 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "식품^나트륨^표시법"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372756> ;
    skos:definition "식품에 함유된 나트륨의 양을 권장량과 비교 가능하게 표시하는 법."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2016-0321-c1 ;
    kno:component kno:KN2016-0321-c2 ;
    kno:component kno:KN2016-0321-c3 ;
    kno:componentString "식품(食品), 나트륨(natrium), 표시법(標示法)"@ko ;
    kno:example "¶{식품 나트륨 표시법을} 발의한 OOO OO당 의원도 “한 끼 식사를 라면으로 때우는 사람들을 보면서 어떻게 하면 이들이 좀 더 낮은 함량의 나트륨이 든 라면을 선택할 수 있을지 고민했다.”라고 강조했다."@ko ;
    kno:frequency kno:KN2016-0321-freq-NN-2015 ;
