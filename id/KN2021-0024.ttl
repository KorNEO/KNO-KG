# KN2021-0024 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0024 kno:componentString "공(공)(公共), 민지"@ko ;
    kno:indexForm "공민지"@ko ;
    kno:component kno:KN2021-0024-c2 ;
    a kno:Neologism ;
    kno:example "¶딱딱하고 경직되었던 공공 기관의 문화가 {공민지들에} 의해 변화될 조짐을 보이고 있다."@ko ;
    rdfs:label "공민지"@ko ;
    kno:formation kno:W05 ;
    kno:origin "(公민지)" ;
    skos:definition "공공 기관에서 일하는 엠제트(MZ) 세대를 이르는 말. ‘공공 기관’의 첫 음절인 ‘공’, ‘밀레니엄 세대’의 첫머리 문자인 엠(M)을 활용한 ‘민’, ‘제트 세대’의 제트(Z)를 활용한 ‘지’를 결합하여 만든 말로 , 최근 공공 기관에 채용되어 일하는 1980년대 초부터 2000년대 초반에 태어난 세대를 이르는 말이다."@ko ;
    kno:registration "신어DB"@ko ;
    kno:component kno:KN2021-0024-c1 ;
    kno:activeYears "0"^^xsd:integer ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B3%B5%EB%AF%BC%EC%A7%80> ;
