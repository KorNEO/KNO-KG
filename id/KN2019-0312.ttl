# KN2019-0312 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0312 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "피크니케이션"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1470513> ;
    skos:definition "집이나 집 근처에서 휴가와 소풍을 즐기는 일. ‘소풍’을 뜻하는 ‘피크닉(picnic)’과 휴가철에 먼 곳으로 떠나지 않고 집이나 집 근처에서 휴가를 즐기는 일을 뜻하는 ‘스테이케이션(staycation)’을 결합하여 만든 말이다. ⇒ 규범 표기는 미확정이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2019-0312-c1 ;
    kno:component kno:KN2019-0312-c2 ;
    kno:componentString "피크닉(picnic), (스테이)케이션(staycation)"@ko ;
    kno:example "¶업계 관계자는 “미세 먼지로 지친 사람들이 봄을 맞아 나들이로 몸과 마음을 재충전하는 {‘피크니케이션’에} 주목할 것으로 보인다.”라면서 “서울을 비롯한 각 지역의 명소나 봄꽃 축제 일정을 확인하면 더욱 만족스러운 야외 활동을 즐길 수 있을 것.”이라고 말했다."@ko ;
    kno:formation kno:W05 ;
    kno:frequency kno:KN2019-0312-freq-NN-2019 ;
    kno:frequency kno:KN2019-0312-freq-NN-2020 ;
    kno:frequency kno:KN2019-0312-freq-NN-total ;
