@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0173 a ontolex:Word ;
    frac:attestation kno:KN2022-0173-att-nn ;
    ontolex:canonicalForm kno:KN2022-0173-form ;
    ontolex:sense kno:KN2022-0173-sense .

kno:KN2022-0173-att-nn a frac:Attestation ;
    dcterms:date "2021-09-02"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/025/0003131804> .

kno:KN2022-0173-form a ontolex:Form ;
    frac:frequency kno:KN2022-0173-freq-nn,
        kno:KN2022-0173-freq-yt ;
    ontolex:writtenRep "삼현에엘"@ko .

kno:KN2022-0173-freq-nn a frac:CorpusFrequency ;
    rdf:value 6 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0173-freq-yt a frac:CorpusFrequency ;
    rdf:value 2 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0173-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%82%BC%EC%8A%BC%ED%98%84> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

