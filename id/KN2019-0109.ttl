# KN2019-0109 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0109 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "미포-족"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%AF%B8%ED%8F%AC%EC%A1%B1> ;
    skos:definition "미세 먼지로 인해 받는 피해를 해결하지 않고 포기하는 사람. 또는 그런 무리. ‘미세 먼지 포기’를 줄여 이르는 말에 접미사 ‘-족(族)’을 결합해 만든 말로, 높은 농도의 미세 먼지가 일상화됨으로 인해 미세 먼지 문제에 둔감해진 사람들을 가리킨다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2019-0109-c1 ;
    kno:component kno:KN2019-0109-c2 ;
    kno:component kno:KN2019-0109-c3 ;
    kno:componentString "미(세 먼지)(微), 포(기)(暴), -족(族)"@ko ;
    kno:example "¶덤덤한 모습의 O 씨는 미세 먼지가 일상화되면서 마스크 착용마저 포기한 {‘미포족’이} 된 것이다."@ko ;
