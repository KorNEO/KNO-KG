# KN2021-0031 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0031 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "국가^치료^격리^병상"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B5%AD%EA%B0%80%EC%B9%98%EB%A3%8C%EA%B2%A9%EB%A6%AC%EB%B3%91%EC%83%81> ;
    skos:definition "감염병 환자들을 일반 환자들과 따로 수용하여 치료하기 위해 국가에서 설치ㆍ운영하는 병상을 이르는 말. 코로나19의 전 세계적 확산 상황에서 사용되기 시작하였다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
