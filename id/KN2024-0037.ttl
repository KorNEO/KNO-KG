    kno:indexForm "네카엘스크"@ko ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:example "¶국내 AI 생태계에서의 지원은 대부분 {네카엘스크} 대기업들이 주도하는 초거대 AI 및 반도체 경쟁에 편중되어 있다는 비판이 나온다."@ko ;
    kno:formation kno:W06 ;
    kno:instantiates kno:S000583 ;
