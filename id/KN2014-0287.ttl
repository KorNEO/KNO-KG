# KN2014-0287 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0287 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "트로피^아이"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8A%B8%EB%A1%9C%ED%94%BC%EC%95%84%EC%9D%B4> ;
    skos:definition "부모의 집중적인 양육으로 인해 뛰어난 성취를 보이게 된 아이를 이르는 말. 트로피와 아이를 동일시한 표현이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2014-0287-c1 ;
    kno:component kno:KN2014-0287-c2 ;
    kno:componentString "트로피(trophy), 아이"@ko ;
    kno:example "¶트로피 아내는 능력과 재력을 갖춘 남자가 성공에 대한 보상으로 얻는 젊고 아름다운 아내를 가리킵니다. 풍자적인 의미가 담겨 있습니다. 이와 비슷하게 {트로피 아이는} 자녀가 이룩한 비범한 성취를 자랑하고 싶은 부모들을 꼬집습니다."@ko ;
    kno:frequency kno:KN2014-0287-freq-NN-2014 ;
    kno:frequency kno:KN2014-0287-freq-NN-2025 ;
    kno:frequency kno:KN2014-0287-freq-NN-total ;
    kno:indexForm "트로피아이"@ko ;
    kno:languageType "영^고" ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
