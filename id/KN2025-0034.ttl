# KN2025-0034 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0034 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "경량 문명"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B2%BD%EB%9F%89%20%EB%AC%B8%EB%AA%85> ;
    skos:definition "(LLM) 인공 지능ㆍ디지털 기술을 바탕으로 적은 인력과 간소한 조직ㆍ절차로도 기획, 생산, 유통, 협업 등이 가능해지면서 사회ㆍ경제의 운영 방식이 가볍고 민첩하게 재편되는 흐름."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2025-0034-c1 ;
    kno:component kno:KN2025-0034-c2 ;
    kno:componentString "경량(輕量), 문명(文明)"@ko ;
    kno:example "(LLM) 자동화 도구와 플랫폼이 보편화되자 소규모 팀도 제품을 기획해 바로 판매할 수 있게 되었고, 이런 변화는 {경량문명을} 앞당기고 있다."@ko ;
    kno:frequency kno:KN2025-0034-freq-NN-2025 ;
