# KN2018-0043 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0043 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "국민 육아템"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415824> ;
    skos:definition "국민 대다수가 좋아하고 즐겨 쓰는 육아용품을 이르는 말."@ko ;
    kno:activeYears "9"^^xsd:integer ;
    kno:component kno:KN2018-0043-c1 ;
    kno:component kno:KN2018-0043-c2 ;
    kno:component kno:KN2018-0043-c3 ;
    kno:componentString "국민(國民), 육아(育兒), (아이)템(item)"@ko ;
    kno:example "¶O 사업 부장은 “부모가 행복해야 아이도 행복하다는 말이 있듯이, 육아를 하는 부모도 행복하고 아이들도 행복한 가전을 만드는 것이 목표였다.”라면서 “자신 있게 만든 제품인 만큼, OO 베이비 케어 제품이 ‘{국민 육아템’이} 되었으면 하는 바람.”이라고 말했다."@ko ;
