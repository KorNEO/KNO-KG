# KN2018-0280 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0280 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "음악가^근육^긴장^이상"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416332> ;
    skos:definition "음악가들에게서 생기는 근육 골격 계통의 다양한 이상 장애. 한 부분을 과도하게 사용하거나 반복적인 스트레스로 인해 비정상적인 근육 수축이 나타나는 증후군이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2018-0280-c1 ;
    kno:component kno:KN2018-0280-c2 ;
    kno:component kno:KN2018-0280-c3 ;
    kno:component kno:KN2018-0280-c4 ;
    kno:componentString "음악가(音樂家), 근육(筋肉), 긴장(緊張), 이상(異常)"@ko ;
    kno:example "¶보도에 따르면 OOO은 ‘{음악가 근육 긴장 이상’이라} 불리는 증상 때문에 한쪽 손에 쥐가 나서 제대로 기타를 연주할 수 없었다고 한다."@ko ;
