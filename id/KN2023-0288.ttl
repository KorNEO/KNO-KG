# KN2023-0288 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0288 a kno:Neologism ;
    rdfs:label "컴프테크"@ko ;
    kno:slotFiller "컴프(라이언스)(compliance) (1성분)"@ko ;
