# KN2020-0291 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0291 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "재난^생계^수당"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9E%AC%EB%82%9C%EC%83%9D%EA%B3%84%EC%88%98%EB%8B%B9> ;
    skos:definition "전국적인 재난 사태로 인해 경제적으로 어려운 상황에 처한 사람을 돕기 위해 정부에서 지급하는 수당. 코로나19의 대유행으로 인한 경제적 위기 상황을 극복하기 위해 정부에서 국민들에게 지원금을 지급하는 방안을 논의하는 과정에서 나온 말이다. =재난 극복 수당, 재난 수당."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2020-0291-c1 ;
    kno:component kno:KN2020-0291-c2 ;
    kno:component kno:KN2020-0291-c3 ;
    kno:componentString "재난(災難), 생계(生計), 수당(手當)"@ko ;
    kno:example "¶정부는 전년 같은 기간 대비 매출액이 10% 이상 줄어든 소상공인과 자영업자에게 {재난 생계 수당으로} 약 200만 원씩 지급하겠다고 발표했다."@ko ;
