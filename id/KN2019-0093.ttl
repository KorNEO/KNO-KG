# KN2019-0093 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0093 kno:year "2019"^^xsd:gYear ;
    kno:slotFiller "진료(診療) (1성분)"@ko ;
    kno:slotFiller "먹튀 (1성분)"@ko ;
    skos:definition "건강 보험료를 내지 않으면서 건강 보험의 혜택을 받아 진료를 받는 일. 주로 해외에 장기간 체류하는 동안 건강 보험료를 면제받고 있던 사람이 짧은 기간 동안 귀국하여 진료를 받고 건강 보험료가 부과되기 전에 다시 해외로 출국하는 경우를 말한다."@ko ;
    kno:instantiates kno:S000509 ;
    kno:componentString "먹튀, 진료(診療)"@ko ;
