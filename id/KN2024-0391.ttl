@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0391 a ontolex:Word ;
    frac:attestation kno:KN2024-0391-att-nn ;
    ontolex:canonicalForm kno:KN2024-0391-form ;
    ontolex:sense kno:KN2024-0391-sense .

kno:KN2024-0391-att-nn a frac:Attestation ;
    dcterms:date "2023-12-18"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/015/0004926335> .

kno:KN2024-0391-form a ontolex:Form ;
    frac:frequency kno:KN2024-0391-freq-nn,
        kno:KN2024-0391-freq-yt ;
    ontolex:writtenRep "협수용강"@ko .

kno:KN2024-0391-freq-nn a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0391-freq-yt a frac:CorpusFrequency ;
    rdf:value 36 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0391-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%98%91%EC%88%98%EC%9A%A9%EA%B0%95> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

