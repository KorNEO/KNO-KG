# KN2017-0116 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0116 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "배려-식"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380459> ;
    skos:definition "음식물 섭취에 각별히 주의를 기울여야 하는 고령자를 대상으로 하여, 영양분이나 식감에 마음을 써서 만든 음식."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2017-0116-c1 ;
    kno:component kno:KN2017-0116-c2 ;
    kno:componentString "배려(配慮), 식(食)"@ko ;
    kno:example "¶고령식 공급 사업은 ‘OO’이라는 브랜드를 내세워 {배려식을} 판매하는 것이 골자로, OO대 식품 영양학과와 공동 연구를 진행하고 있다."@ko ;
    kno:formation kno:W01 ;
