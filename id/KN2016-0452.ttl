# KN2016-0452 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0452 rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A0%9C%EA%B5%AD%EC%84%9C%EC%82%AC%EA%B7%B9> ;
    kno:component kno:KN2016-0452-c2 ;
    kno:unitType "구"@ko ;
