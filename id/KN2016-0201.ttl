# KN2016-0201 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0201 kno:activeYears "1"^^xsd:integer ;
    kno:componentString "베이컨(bacon), (아마)겟돈(Harmagedon)"@ko ;
    kno:component kno:KN2016-0201-c2 ;
    kno:formation kno:W05 ;
    kno:unitType "단어"@ko ;
    kno:example "¶27일 OO 통신에 따르면 OO에서 ‘#자유 베이컨’, ‘#{베이컨겟돈}’, ‘#나는 베이컨이다’ 등 베이컨 관련 해시 태그가 이틀 연속 톱 스레딩을 주도하고 있다."@ko ;
    kno:instantiates kno:S000345 ;
    kno:frequency kno:KN2016-0201-freq-NN-total ;
    kno:pos "「명」"@ko ;
    kno:languageType "영+영" ;
    skos:definition "국제 암 연구 기관에서 가공육을 일급 발암 물질로 지정한 일에 대하여 누리꾼들이 반대 의사를 표하기 위하여 만든 표현. 가공육의 하나인 ‘베이컨(bacon)’과 선과 악이 싸우는 전쟁터를 뜻하는 ‘아마겟돈(Harmagedon)’을 결합하여 만든 말이다."@ko ;
