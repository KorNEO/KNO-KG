# F007137 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F007137 a kno:Formative ;
    kno:semanticTag kno:usas-Y2 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=323679> ;
    kno:urimalDefinition "높은 온도의 기체, 액체, 고체, 화염 따위에 데었을 때에 일어나는 피부의 손상. 경증(輕症)은 피부가 벌겋게 된 상태, 제1도는 물집이 생긴 상태, 제2도는 피부가 익어서 갈색이 된 상태, 제3도는 숯덩이같이 된 상태로 화상의 면적이 온몸의 30%에 이르면 생명이 위험하다. 〔명사〕"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:truncated "false"^^xsd:boolean ;
    kno:origin "火傷" ;
    kno:fullForm "화상"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:surfaceForm "화상"@ko ;
    kno:semanticTag kno:usas-Q1.3 ;
    rdfs:label "화상(火傷)"@ko ;
    kno:urimalTargetCode "323679" .
kno:KN2020-0404-c1 kno:formative kno:F007137 .
