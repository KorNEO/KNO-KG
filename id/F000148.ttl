# F000148 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000148 kno:semanticTag kno:usas-S5 ;
    rdfs:label "위원회(委員會)"@ko ;
    kno:fullForm "위원회"@ko ;
    kno:surfaceForm "위원회"@ko ;
    kno:registration "우리말샘"@ko ;
    a kno:Formative ;
    kno:urimalDefinition "일반 행정과는 달리 어느 정도 독립된 분야에서 기획, 조사, 입안, 권고, 쟁송의 판단, 규칙의 제정 따위를 담당하는 합의제 기관. 특수한 행정 분야에서 일반 행정청의 권한에 소속시키는 것이 적당하지 않은 행정 사무를 맡아보기 위하여 등장한 제도이다. 〔명사〕"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=244222> ;
    kno:caseCount "9"^^xsd:integer ;
    kno:origin "委員會" ;
    kno:urimalTargetCode "244222" .
