# F003263 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003263 kno:semanticTag kno:usas-L2 ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalDefinition "포유류 캥거루과 동물을 통틀어 이르는 말. 여러 종류가 있는데 토끼만 한 것에서부터 2미터나 되는 것까지 있으며, 몸빛은 대개 회색과 붉은색이다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=406663> ;
    a kno:Formative ;
    kno:parallelFullForm kno:LEX-캥거루 ;
    kno:fullForm "캥거루"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullFormLexeme kno:LEX-캥거루 ;
    kno:truncated "true"^^xsd:boolean ;
    kno:origin "kangaroo" ;
