# KN2017-0089 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0089 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "로테크 테러"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380432> ;
    skos:definition "고도의 기술이 필요하지 않은 수법으로 저지르는 테러. 예를 들어, 일상에서 쉽게 구할 수 있는 차량으로 대규모 인파가 있는 곳에 돌진하여 사상자를 내는 방식의 폭력 행위 등이 이에 해당한다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2017-0089-c1 ;
    kno:component kno:KN2017-0089-c2 ;
    kno:componentString "로테크(low-tech), 테러(terror)"@ko ;
    kno:example "¶폭탄이 아닌 차량을 이용한 이른바 ‘{로테크 테러’가} 잇따르면서 테러 공포가 유럽 전역으로 확산되고 있습니다."@ko ;
    kno:frequency kno:KN2017-0089-freq-NN-2017 ;
