# KN2021-0237 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0237 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "주가^꿈^비율"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1598910> ;
    skos:definition "10년 후 해당 산업 전체의 시장 규모 예상값과 10년 후 기업의 시장 점유율 예상값을 곱한 값으로 기업의 현재 시가 총액을 나눈 비율. 기업의 미래 가치를 평가하기 위한 지표이다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2021-0237-c1 ;
    kno:component kno:KN2021-0237-c2 ;
    kno:component kno:KN2021-0237-c3 ;
    kno:componentString "주가(株價), 꿈, 비율(比率)"@ko ;
    kno:example "¶최근에는 메타버스 관련주가 계속 상승세에 있는데, 이는 이미 주식 시장에서 어떤 기업의 미래 가치를 미리 평가하기 위해 {주가 꿈 비율을} 반영하고 있다는 의미다."@ko ;
