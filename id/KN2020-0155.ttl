# KN2020-0155 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0155 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "생활 지원사"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1497992> ;
    skos:definition "노인 복지 관련 기관에서 노인에게 맞춤형 돌봄 서비스를 제공하는 사람. 전화나 방문을 통해 안부를 확인하고 기초적인 일상생활을 도와주는 일 등을 한다."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2020-0155-c1 ;
    kno:component kno:KN2020-0155-c2 ;
    kno:componentString "생활(生活), 지원사(支援士)"@ko ;
    kno:example "¶{생활 지원사로} 일하는 O 씨는 홀로 사시는 어르신들의 말벗이 되어 주면서 많은 보람을 느낀다고 하였다."@ko ;
