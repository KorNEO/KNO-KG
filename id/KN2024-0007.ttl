# KN2024-0007 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0007 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "개^식용^종식^특별법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B0%9C%EC%8B%9D%EC%9A%A9%EC%A2%85%EC%8B%9D%ED%8A%B9%EB%B3%84%EB%B2%95> ;
    skos:definition "식용할 목적으로 개를 사육, 유통, 도살하는 것을 금지하기 위해 2024년 2월 6일 제정된 법률. 정식 명칭은 ‘개의 식용 목적의 사육ㆍ도살 및 유통 등 종식에 관한 특별법’이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2024-0007-c1 ;
    kno:component kno:KN2024-0007-c2 ;
    kno:component kno:KN2024-0007-c3 ;
    kno:component kno:KN2024-0007-c4 ;
    kno:componentString "개, 식용(食用), 종식(終熄), 특별법(特別法)"@ko ;
    kno:example "¶{개 식용 종식 특별법이} 시행되면 개를 식용 목적으로 사육하거나 도살, 유통, 판매하는 행위 등은 모두 금지된다."@ko ;
    kno:frequency kno:KN2024-0007-freq-NN-2023 ;
