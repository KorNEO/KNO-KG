# F003364 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003364 kno:registration "우리말샘"@ko ;
    kno:fullForm "만나"@ko ;
    rdfs:label "만(나)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=147979> ;
    kno:urimalDefinition "이스라엘 민족이 모세의 인도로 이집트에서 탈출하여 가나안 땅으로 가던 도중, 광야에서 먹을 음식과 마실 물이 없어 방황하고 있을 때에 여호와가 하늘에서 날마다 내려 주었다고 하는 기적의 음식. 〔명사〕"@ko ;
    kno:parallelFullForm kno:LEX-만나 ;
    a kno:Formative ;
    kno:caseCount "1"^^xsd:integer ;
    kno:truncated "true"^^xsd:boolean ;
    kno:fullFormLexeme kno:LEX-만나 ;
