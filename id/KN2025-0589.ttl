    kno:frequency kno:KN2025-0589-freq-NN-total ;
    a ontolex:MultiwordExpression ;
    kno:origin "(<영>click fake)" ;
    kno:example "(LLM) 채용 담당자를 사칭한 계정이 화상 면접용 프로그램 설치 링크를 보내 와, 피해자는 {클릭페이크를} 의심하며 경찰에 신고했다."@ko ;
