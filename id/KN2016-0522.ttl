    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%86%A0%EC%A7%80%20%EC%9E%91%EC%97%85%EB%8B%A8> ;
    kno:component kno:KN2016-0522-c2 ;
