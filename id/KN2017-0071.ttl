# KN2017-0071 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0071 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "도른-미"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8F%84%EB%A5%B8%EB%AF%B8> ;
    skos:definition "이상한 행동을 하면서 웃음을 주는 사람이 풍기는 매력. 정신에 이상이 생김을 속되게 이르는 동사 ‘돌다’의 비규범 활용형인 ‘돌은’을 발음대로 쓴 ‘도른’과 아름다움을 뜻하는 ‘미(美)’를 결합하여 만든 말이다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2017-0071-c1 ;
    kno:component kno:KN2017-0071-c2 ;
    kno:componentString "도른, 미(美)"@ko ;
    kno:example "¶OO의 익살스런 장난 모습을 본 누리꾼들은…“섹시미, 청순미는 가라. {도른미의} 최강자 OO이 온다.”, “아 진짜 귀엽다.” 등의 반응을 보였다."@ko ;
    kno:formation kno:W01 ;
