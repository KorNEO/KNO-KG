kno:KN2020-0201 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "아동^돌봄^쿠폰"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%95%84%EB%8F%99%EB%8F%8C%EB%B4%84%EC%BF%A0%ED%8F%B0> ;
    skos:definition "아동 양육 가구의 부담을 덜기 위해 정부에서 지급하는 지원금. 코로나19로 인한 재난 상황에서 지급되기 시작했다. =아동 양육 쿠폰, 아이 돌봄 쿠폰."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2020-0201-c1 ;
