# KN2022-0237 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0237 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "일자리^도약^장려금"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9D%BC%EC%9E%90%EB%A6%AC%EB%8F%84%EC%95%BD%EC%9E%A5%EB%A0%A4%EA%B8%88> ;
    skos:definition "청년 고용 활성화를 위하여, 취업에 어려움을 겪고 있는 청년들을 고용하는 기업에게 정부가 지급하는 장려금. 5인 이상의 중소 기업 등에서 취업에 어려움을 겪는 청년을 정규직으로 채용하고 6개월 이상 고용 유지 시, 최장 2년간 최대 1,200만 원을 지원한다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2022-0237-c1 ;
