# KN2018-0194 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0194 a ontolex:MultiwordExpression ;
    kno:pos "「구」"@ko ;
    kno:frequency kno:KN2018-0194-freq-NN-total ;
    kno:year "2018"^^xsd:gYear ;
    a kno:Neologism ;
    kno:frequency kno:KN2018-0194-freq-NN-2023 ;
    kno:example "¶특히 농사와 태양광 발전을 겸하는 {솔라 셰어링을} 하면 농가 소득이 10배 이상이 된다."@ko ;
    kno:origin "(<영>solar sharing)" ;
    kno:languageType "영^영" ;
    kno:indexForm "솔라셰어링"@ko ;
    kno:frequency kno:KN2018-0194-freq-NN-2017 ;
    skos:definition "작물 재배와 전기 생산에 태양의 열이나 빛을 주된 에너지원으로 이용하는 시스템을 공유하는 농법. 태양광으로 농작물과 발전을 공유한다는 뜻으로, 농지에 지주를 세우고 농사를 지으면서 농지 상부에는 태양광 발전 시설을 설치하고, 하부에서는 농작물을 재배하는 시스템을 말한다. ⇒규범 표기는 미확정이다."@ko ;
