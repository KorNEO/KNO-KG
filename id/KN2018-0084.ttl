# KN2018-0084 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0084 kno:activeYears "8"^^xsd:integer ;
    kno:indexForm "데이터옵스"@ko ;
    kno:languageType "영^영" ;
    kno:slotFiller "옵스(ops) (1성분)"@ko ;
    kno:frequency kno:KN2018-0084-freq-NN-2022 ;
    rdfs:label "데이터^옵스"@ko ;
    kno:example "¶{데이터 옵스는} 데브옵스와 데이터 과학자를 합친 용어로, 빅데이터 운영 및 분석의 통합을 가속화하고 민첩성을 지원해 높은 가치의 데이터를 신속하게 제공할 수 있는 방법론이다."@ko ;
    kno:urimalTargetCode "1416111" ;
    kno:frequency kno:KN2018-0084-freq-NN-2025 ;
    kno:frequency kno:KN2018-0084-freq-NN-2024 ;
    skos:definition "아이티업계에서, 개발 팀과 운영 팀 그리고 데이터 분석 전문가 사이의 적극적인 의사소통과 협업ㆍ통합을 강조하는 기업 내의 업무 환경이나 문화. ‘데이터(data)’와 개발 팀과 운영 팀 간의 의사소통과 협업, 통합을 강조하는 기업 내의 업무 환경이나 문화를 뜻하는 ‘데브옵스(devops)’를 결합하여 만든 말이다. ⇒규범 표기는 미확정이다."@ko ;
