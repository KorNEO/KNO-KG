# KN2016-0111 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0111 kno:component kno:KN2016-0111-c1 ;
    a kno:Neologism ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372546> ;
    kno:frequency kno:KN2016-0111-freq-NN-total ;
    skos:definition "사업 계획지의 토지 소유권자가 토지를 현물로 내놓고, 이와 동일한 공급 면적의 새로 건축될 아파트를 맞교환하는 방식의 지역 주택 조합. 대구광역시에서 처음 시도된 방식으로, 헌 집을 주고 새집을 받는다는 의미가 동요 ‘두꺼비’의 가사와 비슷하여 생긴 말이다. 기존 지역 주택 조합에 비해 사업 부지의 확보가 쉽고, 가입과 탈퇴가 자유롭다는 장점이 있다."@ko ;
    kno:registration "우리말샘"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:pos "「구」"@ko ;
    kno:component kno:KN2016-0111-c3 ;
    a ontolex:MultiwordExpression ;
    kno:lastAttestationYear "2016"^^xsd:gYear ;
    kno:urimalTargetCode "1372546" ;
    kno:instantiates kno:S000961 ;
    kno:example "¶{두꺼비 주택 조합은} 지역 주택 조합의 최대 복병으로 꼽히는 사업 부지 확보가 다소 쉬워졌다는 점에서 기존 주택 조합 개발 방식의 문제를 일부 보완했다는 평가를 받는다."@ko ;
    kno:indexForm "두꺼비주택조합"@ko ;
    kno:languageType "고^한^한" ;
    rdfs:label "두꺼비^주택^조합"@ko ;
