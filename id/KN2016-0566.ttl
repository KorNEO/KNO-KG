    kno:activeYears "2"^^xsd:integer ;
    kno:languageType "영_영" ;
    kno:example "¶맛, 영양, 기능 등 식품에 대한 소비자들의 니즈가 다양해지면서 최근에는 첨단 기술력이 접목된 이른바 {하이테크 푸드가} 주목받고 있다."@ko ;
