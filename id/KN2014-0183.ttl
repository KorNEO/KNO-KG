# KN2014-0183 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0183 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "여미-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1370948> ;
    skos:definition "도시에 거주하는 젊은 남성. 주로 외모나 패션 따위에 관심이 많은 남성을 일컫는다."@ko ;
