# KN2021-0279 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0279 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "턱스크-족"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%84%B1%EC%8A%A4%ED%81%AC%EC%A1%B1> ;
    skos:definition "마스크를 올바르게 착용하지 않고 턱에 걸친 사람. 또는 그런 무리. ‘턱스크’는 여러 사람이 모이는 장소에서 코로나19의 확산을 방지하기 위해 마스크가 입과 코를 완전히 덮도록 착용해야 한다는 정부의 방역 지침에 어긋나는 행위이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2021-0279-c1 ;
    kno:component kno:KN2021-0279-c2 ;
    kno:componentString "턱스크(턱←mask), -족(族)"@ko ;
    kno:example "¶날씨가 더워지면서 코와 입을 완벽하게 가리지 않은 {턱스크족이} 늘고 있다."@ko ;
    kno:formation kno:W02 ;
