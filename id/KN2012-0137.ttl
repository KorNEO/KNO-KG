# KN2012-0137 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0137 kno:languageType "한+영" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1356938> ;
    kno:slotFiller "미(美) (1성분)"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:pos "「명」"@ko ;
    skos:definition "미국의 대중가요. 일반 대중들이 즐겨 부르는 통속적인 성격의 미국 음악을 이르는 말이다."@ko ;
    kno:componentString "미(美), 팝(pop)"@ko ;
    kno:example "¶OOO는 OO를 통해 {미팝} 아티스트들의 아시아 시장 진출과 내한 공연을 추진하고 케이팝 신인을 개발해 미팝 시장으로 진출시키는 작업을 진행할 계획이다."@ko ;
