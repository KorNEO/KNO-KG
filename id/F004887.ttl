    kno:registration "우리말샘"@ko ;
    rdfs:label "액정(液晶)"@ko ;
    a kno:Formative ;
    kno:urimalDefinition "액체와 고체의 중간 상태에 있는 물질. 결정과 같은 광학 이성(光學異性)의 복굴절을 하며 액체와 같은 유동성을 가진다. 전자기력, 압력, 온도 따위에 민감하게 반응하므로 시계, 탁상 계산기의 문자 표시나 텔레비전의 화면 따위에 응용한다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-Y2 ;
    kno:urimalTargetCode "428586" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "액정"@ko .
