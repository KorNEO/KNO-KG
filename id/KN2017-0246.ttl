kno:KN2017-0246 kno:unitType "구"@ko ;
    a ontolex:MultiwordExpression ;
    kno:example "¶매체에 따르면 {젠틀 제왕 절개를} 통해 산모는 출산에 기여하고 아이와 좀 더 가까워진 느낌을 받을 수 있다고 한다."@ko ;
