# KN2021-0281 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0281 kno:frequency kno:KN2021-0281-freq-NN-2021 ;
    skos:definition "공공 기관이나 국가가 토지의 소유권을 가지면서 최소한의 임대료를 받고 수요자에게 주택을 공급하는 법안. 2021년 3월에 국회에서 발의되었다."@ko ;
    kno:pos "「구」"@ko ;
    kno:component kno:KN2021-0281-c7 ;
    kno:lastAttestationYear "2021"^^xsd:gYear ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%86%A0%EC%A7%80%EC%9E%84%EB%8C%80%EB%B6%80%EA%B8%B0%EB%B3%B8%EC%A3%BC%ED%83%9D%EA%B3%B5%EA%B8%89%EC%B4%89%EC%A7%84%ED%8A%B9%EB%B3%84%EB%B2%95> ;
    kno:example "¶한 대선 후보가 여야 국회 의원들에게 입법을 촉구한 ‘{토지 임대부 기본 주택 공급 촉진 특별법’을} 위시한 ‘기본 주택법’은 논란이 분분한 사안이다."@ko ;
    kno:registration "신어DB"@ko ;
    kno:origin "(土地賃貸附基本住宅供給促進特別法)" ;
    kno:languageType "한^한^한^한^한^한^한" ;
