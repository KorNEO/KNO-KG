# KN2020-0017 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0017 kno:component kno:KN2020-0017-c3 ;
    kno:frequency kno:KN2020-0017-freq-NN-2020 ;
    kno:frequency kno:KN2020-0017-freq-NN-2022 ;
    a kno:Neologism ;
    kno:origin "(公的<영>mask制度)" ;
