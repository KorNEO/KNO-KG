# KN2023-0045 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0045 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "금융^안정^계정"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%88%EC%9C%B5%EC%95%88%EC%A0%95%EA%B3%84%EC%A0%95> ;
    skos:definition "금융 회사가 일시적인 자금난을 겪게 되거나 재무 구조의 개선 또는 자본의 확충이 필요한 경우에 금융 당국이 선제적으로 자금을 지원하기 위한 계정. =금안 계정."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2023-0045-c1 ;
    kno:component kno:KN2023-0045-c2 ;
    kno:component kno:KN2023-0045-c3 ;
    kno:componentString "금융(金融), 안정(安定), 계정(計定)"@ko ;
    kno:example "¶OO는 {금융 안정 계정을} 통하여 유동성의 공급에 문제를 겪고 있는 금융사를 대상으로 대출이나 채무 보증을 지원하고, 자본의 확충에 어려움이 있는 경우에는 우선주를 매입하는 등의 방식으로 도움을 줄 계획이다."@ko ;
