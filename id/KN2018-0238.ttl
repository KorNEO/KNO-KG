# KN2018-0238 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0238 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "언택트"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416281> ;
    skos:definition "판매자와 고객이 직접적으로 만나지 않고 거래를 하는 일. 영어의 부정 접두사 ‘언(un-)’과 ‘접촉’을 뜻하는 ‘콘택트(contact)’를 결합하여 만든 말이다."@ko ;
    kno:activeYears "9"^^xsd:integer ;
    kno:component kno:KN2018-0238-c1 ;
    kno:component kno:KN2018-0238-c2 ;
    kno:componentString "언(un), (콘)택트(contact)"@ko ;
    kno:example "¶{언택트는} 4차 산업 혁명 및 인공 지능, 증강 현실과 맞물려 더 심화되는 추세다."@ko ;
