    kno:registration "신어DB"@ko ;
    skos:definition "‘코로나19가 끝나면 모이자.’를 줄여 이르는 말. 코로나19의 확산과 그에 따른 사회적 거리 두기의 시행으로 인해 대면 모임이 힘들어진 상황에서 나온 말로, 주로 누리 소통망 서비스 따위에서 인사말로 사용된다."@ko ;
    kno:languageType "영+고+고" ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%BD%94%EB%81%9D%EB%AA%A8> ;
