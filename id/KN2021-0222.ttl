    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9E%AC%EB%82%9C%EC%8B%9C%EA%B8%B0%EC%83%81%EA%B0%80%EC%9E%84%EB%8C%80%EB%A3%8C%EA%B0%90%EB%A9%B4%EB%B2%95> ;
