# KN2018-0369 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0369 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "팡탈"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8C%A1%ED%83%88> ;
    skos:definition "인터넷 게시판 따위에서 ‘빛의 속도와 같이 빠른 속도로 탈락함’을 의미하는 ‘광탈(光脫)’의 뜻으로 쓰는 말. ‘광탈’과 글자 모양을 비슷하게 변형한 것이다."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2018-0369-c1 ;
    kno:componentString "팡탈(光脫)"@ko ;
    kno:example "¶이를 본 네티즌들은…“솔로 음원 {팡탈} 예상!”…등의 반응을 보였다."@ko ;
