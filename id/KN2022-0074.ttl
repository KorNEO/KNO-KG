# KN2022-0074 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0074 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "규제^심판제"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B7%9C%EC%A0%9C%EC%8B%AC%ED%8C%90%EC%A0%9C> ;
    skos:definition "민간 전문가가 참여하여 현행 규제의 개선 및 중립적인 심사를 권고하기 위해 마련한 제도. 주로 투자 계획이 신속하게 실현되도록 하기 위하여 투자에 걸림돌이 될 수 있는 각종 규제를 개선하는 것을 말한다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2022-0074-c1 ;
    kno:component kno:KN2022-0074-c2 ;
    kno:componentString "규제(規制), 심판제(審判制)"@ko ;
    kno:example "¶정부는 경제 체질을 개선하여 재도약의 계기를 마련하고자 산업 현장에서 실제 규제 내용에 대해 살펴본 후에 판단하는 ‘{규제 심판제’를} 도입한다."@ko ;
