# KN2021-0238 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0238 kno:indexForm "주불"@ko ;
    kno:frequency kno:KN2021-0238-freq-NN-2021 ;
    kno:formation kno:W06 ;
    kno:frequency kno:KN2021-0238-freq-NN-2020 ;
    kno:example "¶우리 회사에서 이번 추석 선물은 한우 세트를 보내 준다고 하니, 다들 {주불}!"@ko ;
    rdfs:label "주불"@ko ;
    kno:year "2021"^^xsd:gYear ;
    a ontolex:Word ;
    kno:pos "「명」"@ko ;
    kno:unitType "단어"@ko ;
    skos:definition "‘주소 불러.’를 줄여 이르는 말. 주로 문자 메시지나 채팅 따위를 통한 의사소통에서, 상대방에게 물건을 택배로 보내기 위해 상대방의 주소를 알려 달라는 뜻으로 쓰는 말이다. 간혹 온라인상에서 시비가 붙었을 때 상대방이 있는 곳에 직접 가서 물리적 충돌을 할 수도 있다는 의미를 위협적으로 전달하기 위해 쓰기도 한다."@ko ;
    a kno:Neologism ;
    kno:languageType "한+고" ;
