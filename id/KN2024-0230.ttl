# KN2024-0230 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0230 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "의마스"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9D%98%EB%A7%88%EC%8A%A4> ;
    skos:definition "‘의사’와 팔레스타인 무장 단체 ‘하마스’를 결합해 만든 말로, 의사를 비하하여 이르는 말. 정부의 의대 정원 확대 정책 등에 반대해 집단 진료 거부나 사직, 응급 의료 중단 등의 강경한 집단 행동을 벌이는 일부 의사들을 하마스에 빗대어 비판적으로 이르는 말이다. 차별 및 비하하는 의미가 포함되어 있으므로 사용에 주의가 필요하다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2024-0230-c1 ;
    kno:component kno:KN2024-0230-c2 ;
    kno:componentString "의(사)(醫師), (하)마스(Hamas)"@ko ;
    kno:example "¶일부 온라인 커뮤니티에서는 집단 행동에 참여한 의사들을 ‘{의마스’라} 부르며 비판했다."@ko ;
