# KN2022-0100 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0100 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "농^접근권"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%86%8D%EC%A0%91%EA%B7%BC%EA%B6%8C> ;
    skos:definition "어떠한 정보에도 접근할 수 있는 청각 장애인의 권리. 주로 음성 언어로 의사소통이 이루어지는 환경에서 청각 장애인의 원활한 정보 접근을 위하여 수어 통역 따위를 제공하는 등 청각 장애인의 권리를 보장할 수 있는 방안의 필요성이 제기되는 상황에서 나온 말이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2022-0100-c1 ;
    kno:component kno:KN2022-0100-c2 ;
    kno:componentString "농(聾), 접근권(接近權)"@ko ;
    kno:example "¶{농 접근권은} 쉬이 보장되지 않으므로, 농인 당사자의 의견을 귀담아 들으면서 그 내용과 형식에 대해 깊은 고민이 필요하다."@ko ;
    kno:frequency kno:KN2022-0100-freq-NN-2022 ;
    kno:frequency kno:KN2022-0100-freq-NN-2023 ;
    kno:frequency kno:KN2022-0100-freq-NN-total ;
    kno:indexForm "농접근권"@ko ;
    kno:languageType "한^한" ;
    kno:lastAttestationYear "2023"^^xsd:gYear ;
    kno:origin "(聾接近權)" ;
    kno:pos "「구」"@ko ;
    kno:registration "신어DB"@ko ;
    kno:unitType "구"@ko ;
    kno:year "2022"^^xsd:gYear .
