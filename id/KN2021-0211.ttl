# KN2021-0211 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0211 kno:origin "(<와>mtoto)" ;
    kno:componentString "음토토(mtoto)"@ko ;
    kno:formation kno:W07 ;
    kno:component kno:KN2021-0211-c1 ;
    kno:pos "「명」"@ko ;
    kno:example "¶중동 지역과 유럽에서는 약 12만 년 전의 매장 유적이 발굴되었으나 선사 시대 무덤의 발굴이 드문 아프리카에서는 {음토토의} 무덤이 가장 오래된 것으로 기록되었다."@ko ;
    kno:indexForm "음토토"@ko ;
