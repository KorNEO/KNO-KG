# KN2012-0279 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0279 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "약국형 스토어"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1357190> ;
    skos:definition "의약품뿐만 아니라 화장품, 건강용품, 식료품, 생활용품 등 다양한 품목을 판매하는 소매점."@ko ;
    kno:activeYears "0"^^xsd:integer ;
