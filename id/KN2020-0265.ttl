# KN2020-0265 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0265 kno:component kno:KN2020-0265-c3 ;
    kno:frequency kno:KN2020-0265-freq-NN-total ;
    kno:instantiates kno:S000688 ;
    skos:definition "직접 병원에 방문하여 검사를 받기 어려운 환자를 위해 의료진이 병원 밖의 환자가 있는 곳으로 가서 검체를 받는 일. 코로나19의 의심 증상이 있는 환자를 신속하게 진단하여 질병의 확산을 방지하기 위해 시작되었다."@ko ;
    a ontolex:MultiwordExpression ;
    kno:pos "「구」"@ko ;
    kno:registration "신어DB"@ko ;
    kno:origin "(移動檢體採取)" ;
