# F004675 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004675 a kno:Formative ;
    kno:fullForm "시퀘스터"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "미국 연방 정부가 재정 긴축을 위하여 지출 예산을 자동으로 삭감하는 조치. 재정 적자의 규모가 다음 회계 연도에 허용된 최대 재정 적자 규모를 초과하면, 지출 예산을 처음에 설정한 목표에 따라 삭감되도록 법으로 규정한 것이다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-I1 ;
    kno:urimalTargetCode "1258358" ;
    kno:origin "sequester" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1258358> ;
    rdfs:label "시퀘스터(sequester)"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "시퀘스터"@ko .
kno:KN2013-0276-c1 kno:formative kno:F004675 .
