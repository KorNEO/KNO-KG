# KN2018-0044 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0044 kno:frequency kno:KN2018-0044-freq-NN-2018 ;
    kno:indexForm "국영수코"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:frequency kno:KN2018-0044-freq-NN-2019 ;
    kno:example "¶인터넷 학부모 커뮤니티에서는 코딩이 향후 필수 과목이 될 것이라는 점을 반영해 “앞으로는 ‘국영수’가 아닌 ‘{국영수코’가} 될 것.”이라는 우스갯소리를 어렵지 않게 볼 수 있다."@ko ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:formation kno:W06 ;
    kno:languageType "한+영" ;
    kno:unitType "단어"@ko ;
    kno:urimalTargetCode "1384335" ;
    rdfs:label "국영수코"@ko ;
    kno:component kno:KN2018-0044-c2 ;
    kno:frequency kno:KN2018-0044-freq-NN-2023 ;
    skos:definition "국어, 영어, 수학, 코딩을 아울러 이르는 말. 대학 입시의 주요 과목인 국어, 영어, 수학을 뜻하는 ‘국영수’에 코딩(coding)의 앞 글자인 ‘코’를 결합하여 만든 말로, 코딩 교육에 관심이 많아지면서 생긴 말이다."@ko ;
    kno:frequency kno:KN2018-0044-freq-NN-2020 ;
    a ontolex:Word ;
    kno:pos "「명」"@ko ;
    kno:frequency kno:KN2018-0044-freq-NN-2022 ;
