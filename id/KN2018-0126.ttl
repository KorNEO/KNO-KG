# KN2018-0126 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0126 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "무민^세대"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1383707> ;
    skos:definition "의미 있고 무거운 것에서 벗어나 별 의미 없고 가벼운 생각이나 행동을 통해 즐거움과 가치를 찾는 젊은 세대. ‘없음’을 뜻하는 ‘무(無)’와 ‘의미’를 뜻하는 ‘민(mean)’에 ‘세대(世代)’를 결합하여 만든 말이다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2018-0126-c1 ;
    kno:component kno:KN2018-0126-c2 ;
    kno:component kno:KN2018-0126-c3 ;
    kno:componentString "무(無)-, 민(mean), 세대(世代)"@ko ;
    kno:example "¶모든 것을 누리고 살 것 같은 지금의 20대들은 그러나 많은 것을 포기해야 하는 ‘엔포 세대’, 어떤 것에도 의미를 부여하지 않는 ‘{무민 세대’가} 됐다."@ko ;
    kno:frequency kno:KN2018-0126-freq-NN-2017 ;
