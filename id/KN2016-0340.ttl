# KN2016-0340 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0340 kno:frequency kno:KN2016-0340-freq-NN-2020 ;
    kno:unitType "단어"@ko ;
    kno:slotFiller "아재 (1성분)"@ko ;
    kno:year "2016"^^xsd:gYear ;
    kno:componentString "아재, 춤"@ko ;
    skos:definition "중년 남자를 연상시키는 듯한 춤. 또는 중년 남자가 추는 춤. 다소 촌스러운 인상을 풍기는 춤을 말한다."@ko ;
    kno:frequency kno:KN2016-0340-freq-NN-2023 ;
    kno:formation kno:W01 ;
    a kno:Neologism ;
    kno:example "¶한국 청소년 12명은 각자의 흥과 고민을 춤으로 풀어냈고,…중년 남성들은 격렬한 한국식 ‘{아재춤’을} 선보였다."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372778> ;
