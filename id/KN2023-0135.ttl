# KN2023-0135 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0135 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "센타백"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%84%BC%ED%83%80%EB%B0%B1> ;
    skos:definition "‘센터 백업(center back-up)’을 줄여 이르는 말. 와인, 위스키 등 고급 주류를 자체적으로 할인하여 판매하는 것을 지지하는 편의점 점주들의 모임. 자체 할인을 최초로 시작한 편의점을 백업한다는 의미로 만들어진 말이다. ⇒규범 표기는 ‘센터백’이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2023-0135-c1 ;
    kno:component kno:KN2023-0135-c2 ;
    kno:componentString "센타(center), 백(←back-up)"@ko ;
    kno:example "¶평소 마셔 보고 싶었던 와인이 할인한다고 하기에 집 주변 {센타백에} 전화로 예약한 후 구매하였다."@ko ;
    kno:formation kno:W06 ;
    kno:frequency kno:KN2023-0135-freq-NN-2023 ;
    kno:frequency kno:KN2023-0135-freq-NN-2025 ;
    kno:frequency kno:KN2023-0135-freq-NN-total ;
