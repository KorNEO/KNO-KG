# KN2012-0179 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0179 skos:definition "‘뿌리 염색’을 줄여 이르는 말. 염색을 한 뒤에 시간이 흘러 새로 자란 부분에만 하는 염색을 말한다."@ko ;
    kno:componentString "뿌(리), 염(색)(染)"@ko ;
    kno:component kno:KN2012-0179-c2 ;
    kno:year "2012"^^xsd:gYear ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1379475> ;
    kno:unitType "단어"@ko ;
    rdfs:label "뿌염"@ko ;
    a kno:Neologism ;
    kno:indexForm "뿌염"@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:example "¶‘{뿌염’이라는} 말을 처음 들었을 땐 ‘뿌잉뿌잉’의 또 다른 표현일 줄 알았다. 하지만 ‘{뿌염’은} 뿌리 염색의 줄임말."@ko ;
