# KN2024-0218 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0218 a kno:Neologism ;
    kno:unitType "단어"@ko ;
    kno:component kno:KN2024-0218-c1 ;
    skos:definition "영화감독 ‘웨스 앤더슨’만의 특징적인 화면 구조와 색채 등을 이르는 말. ‘웨스 앤더슨’과 ‘미장센’을 결합한 말이다."@ko ;
    kno:origin "(←Wes Anderson<프>←mise-en-scène)" ;
    a ontolex:Word ;
    kno:registration "신어DB"@ko ;
    rdfs:label "웨장센"@ko ;
