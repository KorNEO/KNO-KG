# KN2016-0579 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0579 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "핵-인정"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1373014> ;
    skos:definition "남의 감정, 의견, 주장 따위에 대하여 매우 확실히 자기도 그렇다고 여김. 또는 그런 일."@ko ;
