kno:KN2019-0080 kno:year "2019"^^xsd:gYear ;
    skos:definition "얼얼하면서 매운 맛을 내는 ‘마라’라는 향신료가 들어간 음식을 먹을 수 있는 식당에 가까운 지역의 범위. ⇒규범 표기는 미확정이다."@ko ;
    a ontolex:Word ;
