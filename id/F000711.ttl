# F000711 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000711 kno:urimalDefinition "매우 질기고 두껍고 뻣뻣한 평직 또는 변화 평직인 바스켓(basket) 조직의 직물. 보통 면이나 마를 소재로 하여 만들고 텐트, 범포, 차양, 신발, 심지 따위에 쓰인다. 〔명사〕"@ko ;
    kno:caseCount "3"^^xsd:integer ;
    kno:truncated "false"^^xsd:boolean ;
    kno:fullForm "덕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=906214> ;
    kno:surfaceForm "덕"@ko ;
    kno:semanticTag kno:usas-L2 ;
    kno:registration "우리말샘"@ko ;
