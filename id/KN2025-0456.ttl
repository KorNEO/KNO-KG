# KN2025-0456 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0456 kno:languageType "한_한_고" ;
    kno:component kno:KN2025-0456-c1 ;
    kno:unitType "구"@ko ;
    a kno:Neologism ;
    kno:activeYears "1"^^xsd:integer ;
    skos:definition "(LLM) 빛의 위상을 조절하면서 측정한 광 강도(세기) 신호들을 곱해 처리해, 미세한 변화나 주파수 성분을 더 민감하게 구분하려는 광학 계측 기법(또는 신호 처리 방식)."@ko ;
    kno:instantiates kno:S000561 ;
    kno:componentString "위상(位相), 조절(調節), 세기곱"@ko ;
