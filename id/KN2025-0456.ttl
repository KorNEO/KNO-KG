    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9C%84%EC%83%81%20%EC%A1%B0%EC%A0%88%20%EC%84%B8%EA%B8%B0%EA%B3%B1> ;
    rdfs:label "위상 조절 세기곱"@ko ;
    kno:example "(LLM) 연구팀은 간섭계에서 위상을 단계적으로 바꾸며 얻은 신호를 {위상조절세기곱으로} 분석해, 복잡한 장치 없이도 측정 감도가 개선됐다고 설명했다."@ko ;
    a ontolex:MultiwordExpression ;
    kno:lastAttestationYear "2025"^^xsd:gYear .
