# KN2020-0100 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0100 kno:frequency kno:KN2020-0100-freq-NN-2020 ;
    rdfs:label "랜선여행-족"@ko ;
    kno:frequency kno:KN2020-0100-freq-NN-total ;
    kno:indexForm "랜선여행족"@ko ;
    a kno:Neologism ;
    kno:pos "「명」"@ko ;
    kno:lastAttestationYear "2021"^^xsd:gYear ;
    kno:formation kno:W02 ;
    a ontolex:Word ;
    kno:year "2020"^^xsd:gYear ;
    skos:definition "현실 공간이 아닌 온라인상에서 간접적으로 여행을 하는 사람. 또는 그러한 무리. 코로나19의 확산으로 인해 현실 공간에서의 여행이 제한되자 집 안에서 여행하고 싶은 장소와 관련된 영상을 보거나 누리 소통망 서비스(SNS)에 여행했던 사진을 게시하는 행위 따위를 하는 사람들을 이르는 말이다."@ko ;
    kno:componentString "랜선(LAN線), 여행(旅行), -족(族)"@ko ;
    kno:instantiates kno:S000001 ;
    kno:example "¶최근 유통업계는 코로나19로 해외여행을 가지 못하고 온라인에서 간접적으로 여행을 즐기는 {랜선 여행족을} 위해 기내식 도시락 등 이색 마케팅을 펼치고 있다."@ko ;
    kno:unitType "단어"@ko ;
    kno:frequency kno:KN2020-0100-freq-NN-2021 ;
