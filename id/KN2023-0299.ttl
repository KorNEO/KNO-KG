kno:KN2023-0299 kno:unitType "구"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:example "¶러시아의 화폐는 현재 ‘{퀸 루블’로} 불릴 정도로 올해 초에 비해 달러와 비교해서 20% 이상의 가치 상승세를 보이고 있다."@ko ;
    kno:languageType "영^러" ;
    kno:frequency kno:KN2023-0299-freq-NN-total ;
