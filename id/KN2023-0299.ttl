    kno:lastAttestationYear "2022"^^xsd:gYear ;
    kno:componentString "퀸(queen), 루블(ruble)"@ko ;
    skos:definition "러ㆍ우 전쟁에도 불구하고 러시아의 화폐 단위인 루블화의 가치가 소폭 상승하는 현상을 이르는 말. 달러화 가치의 강세를 의미하는 ‘킹 달러’에 빗대어 이르는 말이다."@ko ;
    kno:component kno:KN2023-0299-c1 ;
