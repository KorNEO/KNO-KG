    kno:urimalTargetCode "1966" ;
    kno:urimalDefinition "콩과의 한해살이풀. 열매는 땅속에서 두꺼운 껍질 속에 둘이나 셋씩 들어 있고, 자라서 익으면 속껍질은 얇고 불그레하고 알맹이는 하얗다. 〔명사〕"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    a kno:Formative ;
    kno:fullForm "땅콩"@ko ;
