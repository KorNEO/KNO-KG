# F001728 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001728 kno:urimalTargetCode "332998" ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "자기 자신에 대한 의식이나 관념. 정신 분석학에서는 이드(id), 초자아와 함께 성격을 구성하는 한 요소로, 현실 원리에 따라 이드의 원초적 욕망과 초자아의 양심을 조정한다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=332998> ;
    kno:fullForm "자아"@ko ;
    kno:surfaceForm "자아"@ko ;
    kno:semanticTag kno:usas-X2.1 ;
    kno:origin "自我" ;
    kno:caseCount "2"^^xsd:integer ;
    rdfs:label "자아(自我)"@ko .
