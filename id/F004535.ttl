# F004535 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004535 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=427016> ;
    kno:truncated "true"^^xsd:boolean ;
    kno:fullForm "스크롤"@ko ;
    kno:urimalDefinition "컴퓨터 따위에서, 모니터의 화면에 나타난 내용이 상하 또는 좌우로 움직이는 것. 화면에 표현되는 정보의 양이 한 화면 분량을 넘으면 이미 화면에 표현된 내용 전체가 상하 또는 좌우로 움직인다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:parallelFullForm kno:LEX-스크롤 ;
    rdfs:label "스(크롤)(scroll)"@ko ;
    kno:fullFormLexeme kno:LEX-스크롤 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%8A%A4> ;
