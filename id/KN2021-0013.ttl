kno:KN2021-0013 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "개인^대주^제도"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B0%9C%EC%9D%B8%EB%8C%80%EC%A3%BC%EC%A0%9C%EB%8F%84> ;
    skos:definition "증권 시장에서 개인 투자자에게 매도 증권을 빌려줌으로써 안정적으로 주식을 차입하여 공매도 거래를 할 수 있도록 지원하는 제도."@ko ;
