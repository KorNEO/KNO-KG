# KN2018-0217 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0217 kno:frequency kno:KN2018-0217-freq-NN-total ;
    kno:component kno:KN2018-0217-c1 ;
