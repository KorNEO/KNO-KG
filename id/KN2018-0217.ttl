    rdfs:label "시한부 아이돌"@ko ;
    kno:componentString "시한부(時限附), 아이돌(idol)"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:example "¶20년 전과 비교하면 팬덤 문화가 더욱 과열된 면도 있다. OO이나 걸그룹 OO와 같이 처음부터 정해진 기간만 활동하는 이른바 ‘{시한부 아이돌’이} 나오기 시작하면서 팬 활동의 밀도가 한층 높아졌기 때문이다."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415681> ;
