# KN2018-0077 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0077 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "대안 관계"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416094> ;
    skos:definition "타인과 오랜 시간 깊은 관계를 맺지 않고 필요에 의해 짧고 얕게 맺는 인간관계를 이르는 말. 관계를 위해 에너지를 낭비하고 싶지는 않으나 외로움은 해결하고 싶은 이들이 추구하는 관계로, ‘랜선 이모’나 ‘반려 식물’ 등이 이에 해당한다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2018-0077-c1 ;
    kno:component kno:KN2018-0077-c2 ;
    kno:componentString "대안(代案), 관계(官界)"@ko ;
    kno:example "¶대인 관계에 구속되지 않는 {대안 관계가} 새롭게 등장했습니다. 이런 새로운 가족 관계의 종류를 ‘대안 가족’이라 부릅니다."@ko ;
    kno:frequency kno:KN2018-0077-freq-NN-2017 ;
