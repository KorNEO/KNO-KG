# KN2019-0300 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0300 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "풀-여비"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%92%80%EC%97%AC%EB%B9%84> ;
    skos:definition "여러 기관 또는 조직이 공동으로 관리하는 여비. 각 부서별로 책정된 예산 외의 지출이 있거나 예산이 부족할 때 쓰기 위해 모든 부서에서 공동으로 사용할 수 있도록 따로 갖추어 둔 여비 항목을 가리킨다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2019-0300-c1 ;
    kno:component kno:KN2019-0300-c2 ;
    kno:componentString "풀(pool), 여비(旅費)"@ko ;
    kno:example "¶{풀여비는} 공무원의 출장비 등 상황에 따라서 부서에서 요청하면 그때그때 지출하는 예산으로 OO군은 지난해까지 연간 5천만 원의 {풀여비를} 편성, 운영해 왔으며 올해는 4천만 원을 편성했다."@ko ;
    kno:formation kno:W01 ;
