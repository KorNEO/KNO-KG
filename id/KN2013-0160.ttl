# KN2013-0160 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0160 kno:componentString "맞-, 방(송)(放)"@ko ;
    kno:instantiates kno:S000210 ;
    skos:definition "‘맞는 방송’을 줄여 이르는 말. 출연진이 맞는 것을 중심으로 하는 방송을 가리킨다."@ko ;
    kno:component kno:KN2013-0160-c1 ;
    kno:languageType "고+한" ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A7%9E%EB%B0%A9> ;
