# KN2021-0199 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0199 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "영끌 매수"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%98%81%EB%81%8C%20%EB%A7%A4%EC%88%98> ;
    skos:definition "영혼을 끌어모으듯이 자신이 받을 수 있는 최대한의 대출을 받아 물건을 사들임. 주로 최대한의 대출을 받아 주택을 사는 행위를 이르는 말이다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2021-0199-c1 ;
    kno:component kno:KN2021-0199-c2 ;
    kno:componentString "영끌(靈끌), 매수"@ko ;
    kno:example "¶전셋값이나 주택 매맷값이 상승한 데에 놀라서 {영끌 매수를} 하기보다는 자신의 능력을 고려한 부동산 구매가 필요하다."@ko ;
