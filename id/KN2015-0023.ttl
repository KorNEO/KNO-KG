# KN2015-0023 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0023 kno:indexForm "남혐"@ko ;
    kno:languageType "한" ;
    kno:componentString "남혐(男嫌)"@ko ;
    a ontolex:Word ;
    skos:definition "남성을 싫어하고 미워함."@ko ;
    kno:pos "「명」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:origin "(男嫌)" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1369691> ;
    kno:unitType "단어"@ko ;
    kno:example "¶본보가 650여 명에게 설문 조사해 이성 혐오를 다룬 이유는 ‘도대체 여혐, {남혐이} 왜 번지는지, 그 해법은 뭔지’에 대해 단편적 사례나 전문가 분석의 한계에서 벗어나 보통 사람들의 다양한 생각을 듣고 싶어서였다."@ko ;
