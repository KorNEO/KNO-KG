# KN2016-0300 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0300 kno:component kno:KN2016-0300-c1 ;
    kno:frequency kno:KN2016-0300-freq-NN-total ;
    kno:componentString "스와핑(swapping), 낙하산(落下傘)"@ko ;
    a kno:Neologism ;
    skos:definition "공직자가 퇴직 후, 퇴직 전 소속되었던 부처와 관련이 없는 다른 부처의 기관으로 옮겨가는 것. 공직자가 퇴직 전 5년 동안 수행한 업무와 관련이 있는 기관에 재취업하는 것을 3년간 제한하는 ‘공직자 윤리법’이 발의되자, 고위 공직자들이 이를 피하기 위해 연관 없는 기관으로 이동하여 재취업하며 은밀하게 직위를 주고받는 것을 일컫는 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:frequency kno:KN2016-0300-freq-NN-2016 ;
    kno:component kno:KN2016-0300-c2 ;
    kno:urimalTargetCode "1373481" ;
    a ontolex:MultiwordExpression ;
    kno:registration "우리말샘"@ko ;
    kno:example "¶퇴직 공무원들이 업무 연관성이 있다는 이유로 취업이 제한된 자기 부처 산하 기관ㆍ협회 대신 타 부처 산하 기관으로 가고 있는 것이다. 이른바 ‘{스와핑 낙하산’이} 횡행하고 있다."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1373481> ;
    kno:pos "「구」"@ko ;
    kno:languageType "영^한" ;
    kno:activeYears "1"^^xsd:integer ;
