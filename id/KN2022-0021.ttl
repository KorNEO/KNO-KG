@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0021 a ontolex:Word ;
    frac:attestation kno:KN2022-0021-att-nn ;
    ontolex:canonicalForm kno:KN2022-0021-form ;
    ontolex:sense kno:KN2022-0021-sense .

kno:KN2022-0021-att-nn a frac:Attestation ;
    dcterms:date "2021-08-20"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/449/0000213665> .

kno:KN2022-0021-form a ontolex:Form ;
    frac:frequency kno:KN2022-0021-freq-nn,
        kno:KN2022-0021-freq-yt ;
    ontolex:writtenRep "검수완박-법"@ko .

kno:KN2022-0021-freq-nn a frac:CorpusFrequency ;
    rdf:value 11890 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0021-freq-yt a frac:CorpusFrequency ;
    rdf:value 5554 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0021-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EA%B2%80%EC%B0%B0%20%EC%88%98%EC%82%AC%EA%B6%8C%20%EC%99%84%EC%A0%84%20%EB%B0%95%ED%83%88> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

