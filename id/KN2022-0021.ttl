    kno:componentString "검(찰)(檢察), 수(사권)(搜査權), 완(전)(完全), 박(탈)(剝奪), 법(法)"@ko ;
    kno:languageType "한+한" ;
    kno:frequency kno:KN2022-0021-freq-NN-2022 ;
