    kno:frequency kno:KN2022-0021-freq-NN-2025 ;
    skos:definition "‘검찰의 수사권을 완전히 박탈하는 법안’을 줄여 이르는 말. 검찰의 수사권과 기소권을 분리하도록 한 법안으로, 검찰은 법률에서 정한 경우를 제외하고는 기소와 공판 업무만 하게 된다."@ko ;
    kno:component kno:KN2022-0021-c4 ;
    kno:registration "신어DB"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B2%80%EC%88%98%EC%99%84%EB%B0%95%EB%B2%95> ;
