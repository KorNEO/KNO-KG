# KN2020-0024 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0024 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "교육^재난^지원금"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1503375> ;
    skos:definition "전국적인 재난 사태로 인해 학교에서 정상적인 수업을 받지 못한 학생들에게 지원하여 주는 돈. 코로나19의 확산으로 학생들이 학교에 가지 못하고 가정에서 온라인 학습 등을 함에 따라 가정에 전가된 경제적 부담을 덜어 주기 위해 일부 지방 자치 단체에서 지급하는 교육 지원금이다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2020-0024-c1 ;
    kno:component kno:KN2020-0024-c2 ;
    kno:component kno:KN2020-0024-c3 ;
    kno:componentString "교육(敎育), 재난(災難), 지원금(支援金)"@ko ;
    kno:example "¶OO시는 가계 부담을 덜기 위한 목적으로 전체 초ㆍ중ㆍ고등학생을 대상으로 1명당 10만 원씩의 ‘{교육 재난 지원금’을} 지급하기로 결정했다."@ko ;
    kno:frequency kno:KN2020-0024-freq-NN-2020 ;
