# F005348 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005348 kno:surfaceForm "을"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1386285> ;
    rdfs:label "을(지대학교)"@ko ;
    kno:urimalDefinition "대전광역시 중구에 있는 사립 종합 대학교. 1967년과 1997년에 각각 설립된 ‘서울 보건 대학’과 ‘을지 의과 대학’을 통합하여 2007년에 개교하였다. 대전 외에도 경기도 성남에 캠퍼스가 있다."@ko ;
    kno:semanticTag kno:usas-P1 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9D%84> ;
