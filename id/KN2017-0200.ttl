kno:KN2017-0200 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "역피셜"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380764> ;
    skos:definition "사극 등 역사 관련 극에서 이미 알고 있는 역사적 사실을 통해 다음 내용을 알아내는 일."@ko ;
