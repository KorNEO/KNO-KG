    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=440303> ;
    kno:urimalDefinition "일정한 형의 집행 대신에 다른 형을 집행함. 또는 그런 일. 벌금, 과료를 물지 못하는 사람을 노역장에 유치하는 일 따위이다. 〔명사〕"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "환형"@ko ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "false"^^xsd:boolean ;
