# KN2021-0182 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0182 kno:pos "「구」"@ko ;
    a ontolex:MultiwordExpression ;
    kno:instantiates kno:S001508 ;
    kno:lastAttestationYear "2021"^^xsd:gYear ;
    kno:indexForm "아동특별돌봄지원"@ko ;
    kno:frequency kno:KN2021-0182-freq-NN-total ;
    kno:component kno:KN2021-0182-c1 ;
    skos:definition "재난 따위로 인하여 어린 자녀를 돌보는 데 부담이 늘어난 가정을 돕기 위하여 일시적으로 양육비 등을 지원하는 일. 코로나19의 대유행으로 인해 학교, 어린이집, 유치원 등이 휴교 및 휴원하는 기간이 길어짐에 따라 늘어난 가정의 양육 부담을 줄이기 위하여 정부가 2020년 9월에 초등학생 이하의 아동이 있는 가정에 지원금을 지급했다. =아동 돌봄 특별 지원."@ko ;
    kno:registration "신어DB"@ko ;
    kno:slotFiller "지원(支援) (1성분)"@ko ;
    kno:origin "(兒童特別돌봄支援)" ;
