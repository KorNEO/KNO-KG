# KN2017-0098 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0098 kno:activeYears "6"^^xsd:integer ;
    kno:slotFiller "(알)고리즘(algorism) (1성분)"@ko ;
    kno:pos "「명」"@ko ;
    kno:instantiates kno:S000147 ;
    skos:definition "여성이 육아를 전담하고 생애 주기별로 육아를 반복하게 되는 일련의 과정. ‘엄마’를 의미하는 ‘맘(mom)’과 문제 해결을 위한 절차나 규칙을 의미하는 ‘알고리즘(algorithm)’을 결합하여 만든 말이다."@ko ;
    kno:languageType "영+영" ;
    kno:unitType "단어"@ko ;
    kno:component kno:KN2017-0098-c1 ;
    kno:frequency kno:KN2017-0098-freq-NN-2022 ;
