# KN2022-0141 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0141 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "메타^모빌리티"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A9%94%ED%83%80%EB%AA%A8%EB%B9%8C%EB%A6%AC%ED%8B%B0> ;
    skos:definition "자동차 등의 이동 수단을 매개로 웹상에 구축된 가상 세계 플랫폼의 가상 공간 내에서 이동과 관련된 경험을 하거나 개인적인 시간을 보내는 일. 가상 세계와 현실 세계의 혼합을 뜻하는 ‘메타버스(metaverse)’와 이동을 뜻하는 ‘모빌리티(mobility)’를 결합하여 만든 말이다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2022-0141-c1 ;
    kno:component kno:KN2022-0141-c2 ;
    kno:componentString "메타(meta), 모빌리티(mobility)"@ko ;
    kno:example "¶OO자동차는 로보틱스 등의 핵심 역량을 집결하여 이동 경험을 혁신적으로 확장할 수 있는 {메타 모빌리티를} 현실화할 계획이라고 발표하였다."@ko ;
