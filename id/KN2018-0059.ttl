# KN2018-0059 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0059 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "나일리지"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1397524> ;
    skos:definition "나이가 많은 것을 앞세워 대우받기를 바라는 행동. 또는 그러한 사람. ‘나이’와 ‘마일리지(mileage)’를 결합하여 만든 말로, 마일리지가 쌓이듯이 나이가 많아질수록 그에 따른 권리나 이득을 당연한 것으로 생각하고 누리고자 하는 기성세대의 행동을 비판하여 이르는 말이다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2018-0059-c1 ;
    kno:component kno:KN2018-0059-c2 ;
    kno:componentString "나(이), (마)일리지(mileage)"@ko ;
    kno:example "¶그때마다 ‘내가 인제 여지없이 늙어 가는구나.’ 하는 불안에 휩싸일 수밖에. ‘고답이’가 되고 마는 것이다. 그런다고 나이 들었으니 무조건 우대해 주길 바라는 ‘{나일리지’가} 되기는 싫다."@ko ;
