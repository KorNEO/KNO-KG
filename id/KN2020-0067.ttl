# KN2020-0067 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0067 kno:instantiates kno:S001017 ;
    kno:frequency kno:KN2020-0067-freq-NN-2020 ;
    kno:registration "우리말샘"@ko ;
    kno:component kno:KN2020-0067-c3 ;
    skos:definition "전국적인 재난 사태로 인해 경제적으로 어려운 상황에 처한 사람이 기본 생활을 유지할 수 있도록 정부에서 긴급하게 지급하는 소득. 코로나19의 대유행으로 인한 경제적 위기 상황을 극복하기 위해 정부에서 국민들에게 지원금을 지급하는 방안을 논의하는 과정에서 나온 말이다. =긴급 재난 기본 소득, 긴급 재난 지원 소득."@ko ;
    kno:predicate "지급하다"@ko ;
    kno:pos "「구」"@ko ;
    kno:frequency kno:KN2020-0067-freq-NN-2022 ;
    kno:component kno:KN2020-0067-c2 ;
    kno:languageType "한^한^한" ;
    kno:unitType "구"@ko ;
    kno:origin "(緊急災難所得)" ;
    kno:example "¶O 지사는 “가용 가능한 재원을 총동원하여 {긴급 재난 소득을} 포함한 다양한 경제 대책을 추진할 것이지만 정부와 국회의 보편적인 지원이 절실하다.”라고 말했다."@ko ;
    rdfs:label "긴급^재난^소득"@ko ;
    kno:indexForm "긴급재난소득"@ko ;
