@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0044 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2024-0044-att-nn ;
    ontolex:canonicalForm kno:KN2024-0044-form ;
    ontolex:sense kno:KN2024-0044-sense .

kno:KN2024-0044-att-nn a frac:Attestation ;
    dcterms:date "2023-08-19"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/022/0003846674> .

kno:KN2024-0044-form a ontolex:Form ;
    frac:frequency kno:KN2024-0044-freq-nn,
        kno:KN2024-0044-freq-yt ;
    ontolex:writtenRep "노 탕후루 존"@ko .

kno:KN2024-0044-freq-nn a frac:CorpusFrequency ;
    rdf:value 82 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0044-freq-yt a frac:CorpusFrequency ;
    rdf:value 12 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0044-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

