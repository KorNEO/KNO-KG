# KN2024-0214 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0214 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "원격^사격^무기^통제^체계"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9B%90%EA%B2%A9%EC%82%AC%EA%B2%A9%EB%AC%B4%EA%B8%B0%ED%86%B5%EC%A0%9C%EC%B2%B4%EA%B3%84> ;
    skos:definition "사수가 원격으로 조작하고 통제하는 사격 장치. 또는 그러한 체계. 전차, 장갑차, 전술 차량 등의 외부에 기관총이나 유탄 발사기 등을 장착하고, 이를 사수가 전투 위험으로부터 보호된 상태에서 원격으로 운용한다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2024-0214-c1 ;
    kno:component kno:KN2024-0214-c2 ;
    kno:component kno:KN2024-0214-c3 ;
