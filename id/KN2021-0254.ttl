# KN2021-0254 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0254 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "차박튀"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B0%A8%EB%B0%95%ED%8A%80> ;
    skos:definition "‘차를 박고 튀다.’를 줄여 이르는 말로, 주차되어 있는 다른 사람의 차를 들이박고 달아나는 일. 또는 그런 사람."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2021-0254-c1 ;
    kno:component kno:KN2021-0254-c2 ;
    kno:component kno:KN2021-0254-c3 ;
    kno:componentString "차(車), 박(다), 튀(다)"@ko ;
    kno:example "¶뺑소니와 달리 {차박튀라는} 말은 주차된 차를 들이박고 달아난다는 특정 상황에 한하여 사용된다."@ko ;
    kno:formation kno:W06 ;
