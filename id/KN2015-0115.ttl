# KN2015-0115 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0115 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "센송"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%84%BC%EC%86%A1> ;
    skos:definition "자신이 한국인인 사실을 자조적으로 이르는 말. ‘조선인’의 일본식 발음인 ‘조센진’과 ‘죄송’을 결합하여 만든 말이다."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2015-0115-c1 ;
    kno:component kno:KN2015-0115-c2 ;
    kno:componentString "센(←조센징)(sen), (죄)송(悚)"@ko ;
    kno:example "¶총 3만 2,289표 중 1만 7,560표를 얻은 ‘{센송’은}…일부 한국 젊은이들이 자신의 자괴감과 열등의식을 표현할 때 사용한 단어로, 한국인이 외국에서 사고를 치거나 일본과 관련된 글의 댓글에 해당 단어가 달리면서 유행어가 되었다."@ko ;
    kno:formation kno:W05 ;
    kno:indexForm "센송"@ko ;
    kno:languageType "일+한" ;
    kno:origin "(<일>sen[鮮]悚)" ;
    kno:pos "「명」"@ko ;
    kno:registration "신어DB"@ko ;
    kno:unitType "단어"@ko ;
    kno:year "2015"^^xsd:gYear .
kno:KN2015-0115-c1 a kno:Component ;
    rdfs:label "센(←조센징)(sen)"@ko ;
    kno:formative kno:F004366 ;
