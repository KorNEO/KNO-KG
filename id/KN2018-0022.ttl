# KN2018-0022 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0022 kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2018-0022-c1 ;
    skos:definition "게임 아이템을 사고팔아 돈을 벌거나, 게임을 하면서 적은 비용으로 여가를 즐기는 것을 이르는 말."@ko ;
    kno:indexForm "겜테크"@ko ;
    kno:componentString "겜(←game), (재)테크(tech)"@ko ;
    kno:unitType "구"@ko ;
    kno:instantiates kno:S000756 ;
    kno:pos "「구」"@ko ;
    kno:year "2018"^^xsd:gYear ;
    a kno:Neologism ;
    kno:example "¶게임을 즐기는 직장인이 늘면서 ‘{겜 테크’라는} 신조어도 생겼다. ‘게임+재테크’의 줄임말로 좁게는 게임 아이템을 사고팔아 돈을 버는 것에서부터, 넓게는 퇴근 후 게임을 즐기며 여가에 드는 비용을 아끼는 것을 통칭한다."@ko ;
    rdfs:label "겜^테크"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B2%9C%ED%85%8C%ED%81%AC> ;
    kno:component kno:KN2018-0022-c2 ;
    kno:languageType "영^영" ;
    kno:slotFiller "겜(←game) (1성분)"@ko ;
    kno:origin "(<영>←game tech)" ;
    a ontolex:MultiwordExpression ;
    kno:registration "신어DB"@ko .
kno:KN2018-0022-c1 kno:position "1"^^xsd:integer ;
    kno:role "슬롯 채움"@ko ;
