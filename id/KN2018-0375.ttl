# KN2018-0375 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0375 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "펜스 법칙"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415977> ;
    skos:definition "남성들이 성추행이나 성폭행 등에 관련되는 일을 사전에 막기 위하여 처음부터 여성들과 거리를 두는 일. 지하철에서 여성 뒤에 서지 않는 일, 여성을 업무나 회식 자리에서 배제하는 일 등이 이에 해당된다. =펜스 룰."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2018-0375-c1 ;
    kno:component kno:KN2018-0375-c2 ;
    kno:componentString "펜스(Pence), 법칙(法則)"@ko ;
    kno:example "¶‘{펜스 법칙’이란} 지난 2002년 OOO 부통령이 “아내 외의 여자와는 절대로 단둘이 식사를 하지 않는다.”라고 말한 데서 비롯됐다."@ko ;
