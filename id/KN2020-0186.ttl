# KN2020-0186 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0186 kno:languageType "한^한" ;
    a kno:Neologism ;
    skos:definition "차에 탄 채로 전염병의 감염 여부를 검사받을 수 있도록 마련한 시설이나 장소. 코로나19의 감염 여부를 검사하기 위한 선별 진료소의 한 유형이다."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1482072> ;
    kno:component kno:KN2020-0186-c2 ;
    kno:registration "우리말샘"@ko ;
    kno:pos "「구」"@ko ;
    kno:lastAttestationYear "2021"^^xsd:gYear ;
    kno:year "2020"^^xsd:gYear ;
    kno:component kno:KN2020-0186-c1 ;
    a ontolex:MultiwordExpression ;
    kno:activeYears "2"^^xsd:integer ;
    kno:origin "(乘車診療所)" ;
    kno:example "¶정부는 코로나19 감염 의심 환자를 신속하게 검사하기 위해 더 많은 {승차 진료소를} 설치하겠다고 밝혔다."@ko ;
    kno:frequency kno:KN2020-0186-freq-NN-total ;
    kno:frequency kno:KN2020-0186-freq-NN-2021 ;
    kno:slotFiller "승차(乘車) (1성분)"@ko ;
    kno:componentString "승차(乘車), 진료소(診療所)"@ko ;
