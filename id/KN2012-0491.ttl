# KN2012-0491 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0491 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "회의주의-자"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1368830> ;
    skos:definition "특별한 이유나 목적 없이 회의를 소집하는 상사나 선배 직원들을 비꼬아 이르는 말."@ko ;
    kno:activeYears "14"^^xsd:integer ;
    kno:component kno:KN2012-0491-c1 ;
    kno:component kno:KN2012-0491-c2 ;
    kno:componentString "회의주의(會議主義), -자(者)"@ko ;
    kno:example "¶즉 틈만 나면 별 의미 없이 미팅을 소집하는 상사나 선배 직원들을 {회의주의자라고} 비꼬아 부르는 것. 보통 상사의 뜻대로 끝나버리는 경우가 많은 회의(會議)에 회의(懷疑)를 느끼는 직장인이 많은 현실을 반영한 신조어라고 할 수 있다."@ko ;
    kno:formation kno:W02 ;
