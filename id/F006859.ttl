    kno:urimalTargetCode "585999" ;
    kno:urimalDefinition "밀가루 반죽 위에 토마토, 치즈, 피망, 고기, 향료 따위를 얹어 둥글고 납작하게 구운 파이. 이탈리아 남부 나폴리 지방에서 유래한 음식이다. 〔명사〕"@ko ;
    kno:fullForm "피자"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    kno:registration "우리말샘"@ko ;
    kno:surfaceForm "피"@ko ;
    kno:semanticTag kno:usas-F1 ;
    rdfs:label "피(자)(pizza)"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:parallelFullForm kno:LEX-피자 ;
    kno:fullFormLexeme kno:LEX-피자 ;
    kno:origin "pizza" .
