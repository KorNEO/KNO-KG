# KN2024-0283 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0283 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "지기비소"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A7%80%EA%B8%B0%EB%B9%84%EC%86%8C> ;
    skos:definition "‘지역구 의원 투표는 기권하고, 비례 대표 의원 투표는 소신대로 함’을 줄여 이르는 말. 2024년 4월 10일에 실시된 대한민국 제22대 국회 의원 선거에서 나온 표현이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
