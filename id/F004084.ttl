# F004084 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004084 kno:truncated "false"^^xsd:boolean ;
    kno:surfaceForm "비침습"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:label "비침습(非侵襲)"@ko ;
    a kno:Formative ;
    kno:urimalTargetCode "817637" ;
    kno:semanticTag kno:usas-B3 ;
    kno:registration "우리말샘"@ko ;
    kno:origin "非侵襲" ;
    kno:urimalDefinition "피부를 관통하지 않거나 신체의 어떤 구멍도 통과하지 않고 질병 따위를 진단하거나 치료하는 방법. 예를 들면 초음파 검사 따위와 같이 신체에 상처를 내지 않고 행하는 검사를 비침습적 검사라고 한다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=817637> ;
    kno:fullForm "비침습"@ko .
kno:KN2024-0103-c1 kno:formative kno:F004084 .
