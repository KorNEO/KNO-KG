kno:KN2020-0263 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "이 시국 여행"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9D%B4%20%EC%8B%9C%EA%B5%AD%20%EC%97%AC%ED%96%89> ;
    skos:definition "많은 사람들이 코로나19의 확산을 방지하기 위해 노력하는 가운데 굳이 떠나는 여행을 비난조로 이르는 말."@ko ;
