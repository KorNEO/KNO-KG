kno:KN2020-0069 kno:component kno:KN2020-0069-c1 ;
    kno:year "2020"^^xsd:gYear ;
    kno:indexForm "긴급재난지원소득"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    rdfs:label "긴급^재난^지원^소득"@ko ;
    kno:predicate "지급하다"@ko ;
