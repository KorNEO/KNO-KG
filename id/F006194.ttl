# F006194 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006194 rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B9%B4%EB%A9%9C%EB%A0%88> ;
    rdfs:label "카멜레(온)(chameleon)"@ko ;
    a kno:Formative ;
    kno:fullFormLexeme kno:LEX-카멜레온 ;
    kno:urimalDefinition "카멜레온과의 파충류. 도마뱀과 비슷하나 머리는 투구 모양에 네 다리와 꼬리가 길고, 피부에 좁쌀 모양의 돌기가 많다. 몸은 보통 회색, 누런 갈색 또는 녹색인데 주위의 환경, 광선, 온도 따위에 따라 변한다. 북아프리카, 시리아, 소아시아, 에스파냐 등지에 분포한다. 〔명사〕"@ko ;
    kno:parallelFullForm kno:LEX-카멜레온 ;
    kno:origin "chameleon" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "카멜레"@ko ;
    kno:fullForm "카멜레온"@ko ;
    kno:semanticTag kno:usas-L2 ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=298963> ;
    kno:urimalTargetCode "298963" .
