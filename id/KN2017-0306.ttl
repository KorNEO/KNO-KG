# KN2017-0306 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0306 rdfs:label "팩트리어트 미사일"@ko ;
    kno:predicate "지적하다"@ko ;
    kno:pos "「구」"@ko ;
    kno:component kno:KN2017-0306-c2 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380567> ;
    a kno:Neologism ;
    skos:definition "사실에 입각해 상대방이 감추고 싶어 하는 사실을 아주 강하게 지적하는 행위. 사실을 뜻하는 ‘팩트(fact)’와 미사일의 한 종류인 ‘패트리엇 미사일(patriot missile)’의 비규범 형태인 ‘패트리어트 미사일’을 결합하여 만든 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    a ontolex:MultiwordExpression ;
    kno:frequency kno:KN2017-0306-freq-NN-2016 ;
    kno:year "2017"^^xsd:gYear ;
    kno:componentString "팩트리어트(←fact patriot), 미사일(missile)"@ko ;
    kno:example "¶요즘 온라인에선 팩트로 무장한 ‘{팩트리어트 미사일’이} 이곳저곳 날아다닌다."@ko ;
