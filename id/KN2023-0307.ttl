# KN2023-0307 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0307 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "킹산직"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%82%B9%EC%82%B0%EC%A7%81> ;
    skos:definition "대형 자동차 기업인 ‘현대’의 생산 분야 직무의 급여나 처우가 매우 좋음을 강조하여 이르는 말. 영어 단어 ‘킹(king)’과 ‘생산직’을 결합하여 만든 말이다. =킹차킹산직."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2023-0307-c1 ;
    kno:component kno:KN2023-0307-c2 ;
    kno:componentString "킹(king), (생)산직(生産職)"@ko ;
    kno:example "¶이른바 ‘{킹산직’에} 채용되려는 구직자들이 대거 몰리자 채용 홈페이지가 먹통이 되는 현상이 발생했다."@ko ;
