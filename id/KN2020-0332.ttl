@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0332 a ontolex:Word ;
    frac:attestation kno:KN2020-0332-att-nn ;
    ontolex:canonicalForm kno:KN2020-0332-form ;
    ontolex:sense kno:KN2020-0332-sense .

kno:KN2020-0332-att-nn a frac:Attestation ;
    dcterms:date "2020-02-03"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/025/0002972378> .

kno:KN2020-0332-form a ontolex:Form ;
    frac:frequency kno:KN2020-0332-freq-nn,
        kno:KN2020-0332-freq-yt ;
    ontolex:writtenRep "코돌이"@ko .

kno:KN2020-0332-freq-nn a frac:CorpusFrequency ;
    rdf:value 354 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0332-freq-yt a frac:CorpusFrequency ;
    rdf:value 266 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0332-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%9D%B4%EC%BC%80%EB%85%B8%20%EC%A3%A0%EC%9A%B0%ED%83%80> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

