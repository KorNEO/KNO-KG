# KN2021-0242 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0242 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "줌술-족"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A4%8C%EC%88%A0%EC%A1%B1> ;
    skos:definition "사람들을 직접 만나지 않고 화상 회의 플랫폼인 ‘줌(Zoom)’에 접속하여 술을 마시는 사람. 또는 그런 무리. 코로나19로 대면 활동이 제한되면서 생겨난 말로, 각자의 공간에서 화상 카메라로 서로를 보면서 술을 마시는 사람들을 의미한다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2021-0242-c1 ;
    kno:component kno:KN2021-0242-c2 ;
    kno:component kno:KN2021-0242-c3 ;
    kno:componentString "줌(Zoom), 술, -족(族)"@ko ;
    kno:example "¶사회적 거리 두기가 강화되면서 화상 회의 플랫폼인 줌(Zoom)에서 하는 비대면 모임이 증가하여 {줌술족이} 크게 늘어났다."@ko ;
    kno:formation kno:W02 ;
