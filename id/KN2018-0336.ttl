# KN2018-0336 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0336 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "코피 공격"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415940> ;
    skos:definition "제한된 범위를 먼저 공격하여 상대에게 타격을 주는 행동. 상대방이 미리 겁을 먹고 항복하도록 코피를 흘릴 정도로 약하게 공격하는 일을 이르는 말이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2018-0336-c1 ;
    kno:component kno:KN2018-0336-c2 ;
    kno:componentString "코피, 공격(攻擊)"@ko ;
    kno:example "¶만약 OOO 행정부가 북한에 대해 {코피 공격을} 가할 경우 전면전으로 확대할 위험성이 크며 이는 결과적으로 미국의 전체 동맹 외교를 위험에 빠트릴 수 있다는 지적이다."@ko ;
    kno:frequency kno:KN2018-0336-freq-NN-2018 ;
    kno:frequency kno:KN2018-0336-freq-NN-total ;
    kno:indexForm "코피공격"@ko ;
