# KN2023-0109 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0109 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "뱅보드^차트"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B1%85%EB%B3%B4%EB%93%9C%EC%B0%A8%ED%8A%B8> ;
    skos:definition "일반에게 널리 알리기 위하여 예금 상품의 금리를 비교해 만든 표. 은행을 의미하는 ‘뱅크(bank)’와 미국 대중음악의 순위를 집계한 순위표를 뜻하는 ‘빌보드 차트’를 결합하여 만든 말이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2023-0109-c1 ;
    kno:component kno:KN2023-0109-c2 ;
    kno:component kno:KN2023-0109-c3 ;
    kno:componentString "뱅, 보드(board), 차트(chart)"@ko ;
    kno:example "¶고금리의 특판 가입에 성공하기 위해서는 사전 정보가 가장 중요한데, 인터넷 포털 사이트에서 {뱅보드 차트를} 검색하면 일자별 예금 금리의 순위가 정리된 게시물을 확인할 수 있다."@ko ;
    kno:frequency kno:KN2023-0109-freq-NN-2022 ;
    kno:frequency kno:KN2023-0109-freq-NN-2023 ;
    kno:frequency kno:KN2023-0109-freq-NN-total ;
    kno:indexForm "뱅보드차트"@ko ;
    kno:instantiates kno:S000977 ;
    kno:languageType "영^영" ;
    kno:lastAttestationYear "2023"^^xsd:gYear ;
    kno:origin "(<영>←bank board chart)" ;
    kno:pos "「구」"@ko ;
    kno:registration "신어DB"@ko ;
    kno:slotFiller "뱅+보드(board) (2성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:year "2023"^^xsd:gYear .
