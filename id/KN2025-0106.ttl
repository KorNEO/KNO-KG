# KN2025-0106 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0106 kno:componentString "낭(만), 만(남), 추(구)"@ko ;
    skos:definition "(LLM) ‘낭만적인 만남을 추구함’을 줄여 이르는 말. 계산적이거나 조건 중심의 만남보다 설렘, 우연, 분위기 같은 낭만을 중시하는 연애관을 말한다."@ko ;
    kno:unitType "단어"@ko ;
    kno:frequency kno:KN2025-0106-freq-NN-total ;
    kno:component kno:KN2025-0106-c1 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%82%AD%EB%A7%8C%EC%B6%94> ;
