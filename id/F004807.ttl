# F004807 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004807 kno:parallelFullForm kno:LEX-아보카도 ;
    a kno:Formative ;
    kno:urimalDefinition "녹나뭇과의 상록 과실나무. 높이는 15미터 정도이며, 잎은 타원형으로 어긋난다. 여름에 녹색의 꽃이 총상(總狀) 화서로 피고 열매는 서양배 모양으로 자색 또는 자갈색인데 3~10일간 저장하였다가 먹는다. 멕시코에서 안데스산맥에 이르는 서반구 대륙이 원산지이다. 〔명사〕"@ko ;
    kno:fullForm "아보카도"@ko ;
    kno:semanticTag kno:usas-F1 ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalTargetCode "465098" ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%95%84%EB%B3%B4> ;
    kno:registration "우리말샘"@ko ;
    rdfs:label "아보(카도)(avocado)"@ko ;
    kno:surfaceForm "아보"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    kno:fullFormLexeme kno:LEX-아보카도 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=465098> ;
    kno:origin "avocado" .
