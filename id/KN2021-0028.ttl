kno:KN2021-0028 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "관음-충"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B4%80%EC%9D%8C%EC%B6%A9> ;
    skos:definition "다른 사람을 몰래 훔쳐봄으로써 성적 만족을 얻는 사람을 벌레에 빗대어 이르는 말. 차별 및 비하하는 의미가 포함되어 있으므로 사용에 주의가 필요하다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
