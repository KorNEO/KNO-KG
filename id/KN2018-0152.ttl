# KN2018-0152 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0152 kno:frequency kno:KN2018-0152-freq-NN-total ;
    kno:instantiates kno:S000050 ;
    kno:unitType "구"@ko ;
    kno:year "2018"^^xsd:gYear ;
    a kno:Neologism ;
    rdfs:label "브랜닉 마케팅"@ko ;
    kno:component kno:KN2018-0152-c2 ;
    kno:lastAttestationYear "2017"^^xsd:gYear ;
    skos:definition "소비자가 제품이나 서비스를 구매해야 한다는 압박감이나 부담감을 느끼지 않도록 하면서 매장에 다양한 이벤트 공간 따위를 마련하여 소비자가 해당 브랜드의 매장을 즐거운 장소로 인식하게 하는 마케팅. 소비자가 소풍을 가듯이 매장에 갈 수 있도록 복합적인 문화 공간을 조성하여 소비자에게 브랜드의 정체성을 알리고 좋은 이미지를 형성하고자 하는 기획 활동을 가리킨다."@ko ;
    kno:origin "(<영>▼←brand picnic marketing)" ;
    kno:registration "우리말샘"@ko ;
    kno:indexForm "브랜닉마케팅"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1419979> ;
    kno:component kno:KN2018-0152-c1 ;
    kno:languageType "영_영" ;
    kno:componentString "브랜(드)(brand), (피크)닉(picnic), 마케팅(marketing)"@ko ;
    kno:pos "「구」"@ko ;
    kno:example "¶{브랜닉 마케팅이}…결정적 우위에 설 수 있는 이유는 단골 소비자에게는 해당 제품을 사용한다는 자부심을, 뜨내기 소비자에게는 진심 하나를 얹어 줌으로써…브랜드의 지속성을 늘려 주고 넓혀 줄 수 있다는 점이다."@ko ;
