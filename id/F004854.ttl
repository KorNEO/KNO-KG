kno:F004854 kno:fullForm "알약"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=16195> ;
    kno:urimalDefinition "가루나 결정성 약을 뭉쳐서 원판이나 원뿔, 원통 따위의 모양으로 만든 약제. 젖당, 초콜릿, 아라비아고무 따위를 섞어 만든다. 〔명사〕"@ko ;
    rdfs:label "알약(알藥)"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalTargetCode "16195" ;
    a kno:Formative ;
    kno:origin "藥" ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-B3 ;
