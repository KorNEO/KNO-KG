# KN2018-0302 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0302 kno:urimalTargetCode "1382358" ;
    kno:predicate "부과하다"@ko ;
    kno:frequency kno:KN2018-0302-freq-NN-2017 ;
    kno:slotFiller "존경(尊敬) (1성분)"@ko ;
    kno:frequency kno:KN2018-0302-freq-NN-2020 ;
    kno:origin "(尊敬課稅)" ;
    skos:definition "대기업이나 소득 또는 자산이 많은 계층에게 세율을 높여 세금을 부과하는 일. 대기업이나 부자들이 세금을 많이 내면 국민들에게 존경을 받을 수 있다는 뜻에서 비롯되었다."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1382358> ;
    kno:instantiates kno:S000359 ;
    kno:frequency kno:KN2018-0302-freq-NN-total ;
