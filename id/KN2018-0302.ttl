    kno:componentString "존경(尊敬), 과세(課稅)"@ko ;
    kno:registration "우리말샘"@ko ;
    a kno:Neologism ;
    kno:unitType "구"@ko ;
    kno:example "¶그는 “초고소득자 증세로 세금을 더 내면 부자들이 국민으로부터 존경받는 ‘{존경 과세’는} 어떠냐?”라고도 했다."@ko ;
    kno:component kno:KN2018-0302-c2 ;
    kno:pos "「구」"@ko ;
    kno:indexForm "존경과세"@ko ;
    a ontolex:MultiwordExpression ;
