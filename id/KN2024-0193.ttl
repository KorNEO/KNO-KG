kno:KN2024-0193 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "예스-족"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%98%88%EC%8A%A4%EC%A1%B1> ;
    skos:definition "외국인 이민자 중에서 젊고, 교육을 받았으며, 숙련된 기술을 가진 사람. 또는 그런 무리."@ko ;
