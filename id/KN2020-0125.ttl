# KN2020-0125 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0125 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "분노 방정식"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B6%84%EB%85%B8%20%EB%B0%A9%EC%A0%95%EC%8B%9D> ;
    skos:definition "집값 폭등 이후 주택 보유 수에 따라 유주택자였던 사람, 무주택자, 1주택자, 다주택자가 각자의 상황에 따라 서로를 보는 태도를 나타낸 도식. 몇 년 전 집을 판 유주택자와 다주택자가 만나면 큰 전쟁이 일어나고, 무주택자와 1주택자 간에는 작은 전투가 일어나며, 다주택자는 무주택자를 멍청한 놈으로 여기고, 무주택자는 다주택자를 나쁜 놈으로 생각한다는 등의 내용이 포함된다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2020-0125-c1 ;
    kno:component kno:KN2020-0125-c2 ;
    kno:componentString "분노(憤怒), 방정식(方程式)"@ko ;
    kno:example "¶{분노 방정식을} 보면 무주택자끼리 만나면 서로 신세를 한탄하다가 마지막에는 분노를 한다는데, 뭔가 웃기면서도 맞는 말인 것 같아 씁쓸하다."@ko ;
    kno:frequency kno:KN2020-0125-freq-NN-2019 ;
    kno:frequency kno:KN2020-0125-freq-NN-2020 ;
    kno:frequency kno:KN2020-0125-freq-NN-total ;
    kno:indexForm "분노방정식"@ko ;
    kno:instantiates kno:S001325 ;
    kno:languageType "한_한" ;
    kno:lastAttestationYear "2020"^^xsd:gYear ;
    kno:origin "(憤怒方程式)" ;
    kno:pos "「구」"@ko ;
    kno:predicate "유주택자였던"@ko ;
