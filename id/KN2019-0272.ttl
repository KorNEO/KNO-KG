# KN2019-0272 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0272 a ontolex:MultiwordExpression ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:origin "(<영>tarmac delay)" ;
    kno:registration "신어DB"@ko ;
    kno:component kno:KN2019-0272-c2 ;
