    kno:activeYears "6"^^xsd:integer ;
    a ontolex:Word ;
    kno:example "¶코로나19로 인해 실내 운동에 대한 부담이 커지면서 최근 20대ㆍ30대 중심의 {등린이들이} 증가하고 있다."@ko ;
