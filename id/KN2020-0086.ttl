# KN2020-0086 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0086 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "도슨트^북"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8F%84%EC%8A%A8%ED%8A%B8%EB%B6%81> ;
    skos:definition "공연이나 전시회 따위에서 관람객에게 공연이나 전시와 관련한 설명을 제공하는 종이책, 전자책, 오디오 북 등을 통틀어 이르는 말. 미술관 혹은 박물관 등에서 관람객에게 전시와 관련된 설명을 해 주는 사람인 도슨트에서 따온 말이다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2020-0086-c1 ;
    kno:component kno:KN2020-0086-c2 ;
    kno:componentString "도슨트(docent), 북(book)"@ko ;
    kno:example "¶이번 공연의 마케팅에서 주목할 점은 국내에서 처음 서비스된 공연용 {도슨트 북으로}, 관객들은 이를 통해 공연에 필요한 배경지식을 10분이면 쌓을 수 있다."@ko ;
    kno:frequency kno:KN2020-0086-freq-NN-2019 ;
