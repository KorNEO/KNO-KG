# KN2023-0124 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0124 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "사회^서비스^진흥법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%82%AC%ED%9A%8C%EC%84%9C%EB%B9%84%EC%8A%A4%EC%A7%84%ED%9D%A5%EB%B2%95> ;
    skos:definition "적정한 사회 서비스의 공급을 유인하고 사회 서비스 분야의 육성 기반과 체계적 지원이 마련되기 위하여 제정한 법률. 정식 명칭은 ‘사회 서비스 지원 및 진흥에 관한 법률안’이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2023-0124-c1 ;
    kno:component kno:KN2023-0124-c2 ;
    kno:component kno:KN2023-0124-c3 ;
    kno:componentString "사회(社會), 서비스(service), 진흥법(振興法)"@ko ;
    kno:example "¶{사회 서비스 진흥법은} 돌봄 등 사회 서비스의 육성 및 품질 향상 방안을 담고 있으며, 사회 서비스의 공급을 늘리고 혁신을 이끌어 나가겠다는 취지로 법안의 제정을 추진 중이다."@ko ;
    kno:frequency kno:KN2023-0124-freq-NN-2023 ;
