    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:example "(LLM) 원재료 단가가 급등하자 구내식당은 대체 식자재를 활용한 {헤징메뉴를} 내놓아 가격 인상 압박을 낮췄다."@ko ;
