kno:KN2013-0259 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "스마트 앤드 커넥티드 자동차"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%8A%A4%EB%A7%88%ED%8A%B8%20%EC%95%A4%EB%93%9C%20%EC%BB%A4%EB%84%A5%ED%8B%B0%EB%93%9C%20%EC%9E%90%EB%8F%99%EC%B0%A8> ;
    skos:definition "스마트폰과 자동으로 연동되고, 운전자의 상태를 감지하는 등 다양한 신기술이 적용된 차세대 자동차."@ko ;
