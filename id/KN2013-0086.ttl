    rdfs:label "노-답"@ko ;
    kno:componentString "노(no), 답(答)"@ko ;
    a ontolex:Word ;
    kno:example "¶이어 OOO가 OOO에게 “아빠를 닮아 좋은 점과 싫은 점이 무엇인지?” 라고 묻자, OOO은 “아빠의 선한 눈 닮아 좋다. 아빠를 닮은 내 얼굴을 보며 ‘{노답’이라고} 놀리는데 그럴 땐 아빠를 닮아 슬픈 것 같다.”라고 말했다."@ko ;
    kno:registration "우리말샘"@ko ;
    skos:definition "해결 방법이 마련되거나 떠오르지 아니 함."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1368816> ;
