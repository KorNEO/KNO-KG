# KN2016-0331 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0331 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "아웃-백"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1396777> ;
    skos:definition "석차나 순위가 100등을 넘어감. 또는 그런 석차나 순위. 정원이 적어 내신 성적을 받기 어려운 특수 목적 고등학교에서는 전교 석차가 100위 밖으로 떨어지면 좋은 대학에 진학하기 어려움을 이르는 말이다."@ko ;
    kno:activeYears "11"^^xsd:integer ;
    kno:component kno:KN2016-0331-c1 ;
    kno:component kno:KN2016-0331-c2 ;
    kno:componentString "아웃(out), 백(百)"@ko ;
    kno:example "¶과학고와 외국어 고등학교 같은 ‘특목고’에서는 ‘{아웃백’이라는} 말이 유행했습니다."@ko ;
