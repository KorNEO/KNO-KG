# F005344 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005344 kno:origin "銀" ;
    kno:fullForm "은"@ko ;
    kno:semanticTag kno:usas-Z5 ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalDefinition "금속 원소의 하나. 흰 광택이 있고 무르며 늘어나고 펴지는 성질이 금 다음으로 강하고, 전기 전도율과 열전도율은 금속 가운데 가장 높다. 공기 중에서는 산화하지 않으나 유황 화합물에 닿으면 검은색으로 변한다. 멕시코·미국·캐나다·페루 등지에서 나며, 화학용 기구나 화폐·장식품 따위로 쓴다. 원자 기호는 Ag, 원자 번호는 47, 원자량은 107.868. 〔명사〕"@ko ;
    kno:surfaceForm "은"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "394682" ;
    kno:registration "우리말샘"@ko ;
    rdfs:label "은(銀)"@ko ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=394682> .
kno:KN2017-0228-c1 kno:formative kno:F005344 .
