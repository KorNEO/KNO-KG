# KN2018-0237 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0237 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "언어힐링족"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%96%B8%EC%96%B4%ED%9E%90%EB%A7%81%EC%A1%B1> ;
    skos:definition "취미로 외국어를 배우면서 지친 몸과 마음을 치유하는 사람. 또는 그런 무리."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2018-0237-c1 ;
    kno:component kno:KN2018-0237-c2 ;
    kno:component kno:KN2018-0237-c3 ;
    kno:componentString "언어(言語), 힐링(healing), -족(族)"@ko ;
    kno:example "¶영어를 못하면 대학 가기가 힘들고, 승진은커녕 취직조차 어렵다…OO가 만난 ‘{언어 힐링족’은} 여기서 한참 동떨어진 이들이다. 이들은 언어를 출세의 도구가 아닌 스트레스 해소법으로 삼는다."@ko ;
    kno:frequency kno:KN2018-0237-freq-NN-2018 ;
