# KN2017-0072 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0072 a ontolex:MultiwordExpression ;
    kno:pos "「구」"@ko ;
    skos:definition "도서관이나 독서실 따위에서 작은 소리에도 민감하게 반응하는 사람을 비유적으로 이르는 말. ⇒규범 표기는 미확정이다."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8F%84%EC%84%9C%EA%B4%80%20%EB%AF%B8%EC%96%B4%EC%BA%A3> ;
