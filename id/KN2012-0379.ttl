# KN2012-0379 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0379 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "주택 관리 버틀러"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1371037> ;
    skos:definition "주택을 관리해 주는 집사. 전구를 갈아주는 사소한 일에서부터 대리 주차, 청소, 택배 및 세탁물 보관, 아침 식사 배달 등 다양한 서비스를 제공해 주는 사람을 말한다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2012-0379-c1 ;
    kno:component kno:KN2012-0379-c2 ;
    kno:component kno:KN2012-0379-c3 ;
    kno:componentString "주택(住宅), 관리(管理), 버틀러(butler)"@ko ;
    kno:example "¶17일 관련업계에 따르면 최근 분양하고 있는 수익형 부동산들은 자산 관리, {주택 관리 버틀러} 등 다양한 관리 서비스를 도입하고 있다."@ko ;
