# F005757 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005757 kno:parallelFullForm kno:LEX-졸라 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A1%B8> ;
    kno:fullFormLexeme kno:LEX-졸라 ;
    kno:semanticTag kno:usas-A13.3 ;
    kno:surfaceForm "졸"@ko ;
    kno:urimalDefinition "에밀 졸라, 프랑스의 소설가·비평가(1840~1902). 자연주의 문학을 확립하였으며, 사회의 어두운 면이나 군중의 집단적인 심리를 세밀하게 묘사하였다. 작품에 &lt;목로주점&gt;, &lt;나나&gt;, &lt;루공가의 운명&gt; 따위가 있고, 저서에 ≪실험 소설론≫, ≪자연주의 소설가≫ 따위가 있다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=471035> ;
    a kno:Formative ;
    kno:fullForm "졸라"@ko ;
    rdfs:label "졸(라)"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "471035" ;
