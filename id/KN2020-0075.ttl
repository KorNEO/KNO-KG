kno:KN2020-0075 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "끼니 노동"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%81%BC%EB%8B%88%20%EB%85%B8%EB%8F%99> ;
    skos:definition "가정주부가 가족들의 끼니를 챙기기 위하여 들이는 노력. 또는 그러한 일."@ko ;
