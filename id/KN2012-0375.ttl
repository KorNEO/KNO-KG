    a kno:Neologism ;
    kno:origin "(種特)" ;
    kno:example "¶흑인 {종특은} ‘스포츠’, 베네수엘라 {종특은} ‘미 녀’, 재미 교포 {종특은} ‘공부’라는 등의 용례를 들 수 있다."@ko ;
