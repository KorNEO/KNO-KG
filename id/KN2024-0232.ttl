@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0232 a ontolex:Word ;
    frac:attestation kno:KN2024-0232-att-nn ;
    ontolex:canonicalForm kno:KN2024-0232-form ;
    ontolex:sense kno:KN2024-0232-sense .

kno:KN2024-0232-att-nn a frac:Attestation ;
    dcterms:date "2024-02-21"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/088/0000863478> .

kno:KN2024-0232-form a ontolex:Form ;
    frac:frequency kno:KN2024-0232-freq-nn,
        kno:KN2024-0232-freq-yt ;
    ontolex:writtenRep "의-주빈"@ko .

kno:KN2024-0232-freq-nn a frac:CorpusFrequency ;
    rdf:value 61 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0232-freq-yt a frac:CorpusFrequency ;
    rdf:value 1456 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0232-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%9D%98%EC%83%88> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

