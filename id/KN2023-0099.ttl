    a kno:Neologism ;
    rdfs:label "무진동^항온^항습^차"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%AC%B4%EC%A7%84%EB%8F%99%ED%95%AD%EC%98%A8%ED%95%AD%EC%8A%B5%EC%B0%A8> ;
    skos:definition "진동이 적고 온도와 습도가 일정하게 유지되도록 설계한 차. 반도체나 동물 따위를 운반할 때 사용한다."@ko ;
