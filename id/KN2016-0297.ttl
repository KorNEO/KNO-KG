kno:KN2016-0297 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "스마트^핵무기"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372732> ;
    skos:definition "정밀한 유도와 폭격이 가능하여 여러 가지 상황에 활용할 수 있도록 만든 핵무기. 명중률을 높이는 대신 위력은 낮춘 핵무기이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2016-0297-c1 ;
    kno:component kno:KN2016-0297-c2 ;
    kno:componentString "스마트(smart), 핵무기(核武器)"@ko ;
    kno:example "¶‘{스마트 핵무기’로} 불리는 ‘비(B)61-12’는 향후 30년간 1조 달러를 투입하는 OOO 행정부의 핵무기 현대화 계획의 일환이다."@ko ;
