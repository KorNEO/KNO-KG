# F001018 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001018 rdfs:label "헌법(憲法)"@ko ;
    kno:urimalTargetCode "517627" ;
    kno:urimalDefinition "국가 통치 체제의 기초에 관한 각종 근본 법규의 총체. 모든 국가의 법의 체계적 기초로서 국가의 조직, 구성 및 작용에 관한 근본법이며 다른 법률이나 명령으로써 변경할 수 없는 한 국가의 최고 법규이다. 〔명사〕"@ko ;
    kno:caseCount "3"^^xsd:integer ;
    kno:origin "憲法" ;
    kno:semanticTag kno:usas-G2.1 ;
    a kno:Formative ;
    kno:surfaceForm "헌법"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=517627> ;
    kno:fullForm "헌법"@ko .
