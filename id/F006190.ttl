# F006190 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006190 kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "카니발라이제이션"@ko ;
    a kno:Formative ;
    kno:urimalDefinition "특정 기업의 탁월한 신상품이 해당 기업에서 먼저 출시한 동일 계열의 상품이 점유한 시장을 잠식하거나 싼 노동력을 바탕으로 생산된 해외의 저가 상품과의 경쟁에서 특정 기업의 국내 고가 상품이 밀리는 현상. ⇒규범 표기는 ‘캐니벌라이제이션’이다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=754878> ;
    kno:surfaceForm "카니발라이제이션"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "754878" ;
    kno:semanticTag kno:usas-I2.1 ;
    kno:registration "우리말샘"@ko ;
    kno:origin "carnibalization" ;
    rdfs:label "카니발라이제이션(carnibalization)"@ko .
