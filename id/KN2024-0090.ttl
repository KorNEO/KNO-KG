# KN2024-0090 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0090 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "불꽃-주"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B6%88%EA%BD%83%EC%A3%BC> ;
    skos:definition "주가가 단기간에 급등락을 반복하며 불꽃이 튀듯 화려하지만 불안정한 흐름을 보이는 주식. 주로 이차 전지, 바이오 등 투기적 수요가 집중되는 종목을 말한다."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2024-0090-c1 ;
    kno:component kno:KN2024-0090-c2 ;
    kno:componentString "불꽃, 주(株)"@ko ;
    kno:example "¶{불꽃주라} 불리는 이차 전지 주식이 앞으로도 강세를 이어가며 뜨겁게 불타오를지가 투자자들의 최대 관심사로 떠오르고 있다."@ko ;
    kno:formation kno:W01 ;
