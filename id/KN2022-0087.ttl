# KN2022-0087 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0087 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "내검남네"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%82%B4%EA%B2%80%EB%82%A8%EB%84%A4> ;
    skos:definition "‘내가 하면 검증, 남이 하면 네거티브’를 줄여 이르는 말. 주로 정치에서, 남이 할 때는 상대방의 부정적인 면만을 크게 부각시키는 방식이라고 비난하던 행위를 정작 자신이 할 때는 합리화하는 태도를 말한다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
