# KN2023-0245 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0245 kno:registration "신어DB"@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:year "2023"^^xsd:gYear ;
    kno:indexForm "전세사기특별법"@ko ;
    kno:component kno:KN2023-0245-c2 ;
