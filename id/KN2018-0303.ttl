kno:KN2018-0303 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "종합^기상^관측소"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A2%85%ED%95%A9%EA%B8%B0%EC%83%81%EA%B4%80%EC%B8%A1%EC%86%8C> ;
    skos:definition "여러 가지 기상 관측 장비를 사용하여 날씨나 대기 현상과 관련된 기상 요소들을 관찰하고 측정하며 그러한 자료를 종합적으로 기록하고 해석ㆍ통보하는 곳. 또는 그런 기관."@ko ;
    kno:activeYears "3"^^xsd:integer ;
