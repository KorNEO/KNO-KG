    kno:frequency kno:KN2016-0158-freq-NN-2016 ;
    kno:indexForm "멀티악역"@ko ;
    kno:component kno:KN2016-0158-c2 ;
    skos:definition "놀이ㆍ연극ㆍ영화 따위에서, 나쁜 일뿐만 아니라 여러 가지 다양한 일을 맡아 하는 배역."@ko ;
