# KN2020-0101 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0101 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "랜선 운동"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%9E%9C%EC%84%A0%20%EC%9A%B4%EB%8F%99> ;
    skos:definition "온라인상에 있는 영상이나 글을 보면서 집 안에서 하는 운동. 혹은 집 안에서 화상 회의 프로그램을 통해 다른 사람들과 함께 하는 운동. 코로나19의 확산과 그에 따른 사회적 거리 두기의 시행으로 인해 현실 공간의 체육 시설 따위의 사용이 제한되자 전파되었다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2020-0101-c1 ;
    kno:component kno:KN2020-0101-c2 ;
    kno:componentString "랜선(LAN線), 운동(運動)"@ko ;
    kno:example "¶신규 프로그램 OO은 출연자들이 다양한 운동을 하면서 전후의 몸무게를 비교해 시청자들의 {랜선 운동을} 도와준다."@ko ;
    kno:frequency kno:KN2020-0101-freq-NN-2020 ;
    kno:frequency kno:KN2020-0101-freq-NN-2021 ;
    kno:frequency kno:KN2020-0101-freq-NN-total ;
    kno:indexForm "랜선운동"@ko ;
    kno:instantiates kno:S000030 ;
    kno:instantiates kno:S000053 ;
    kno:languageType "(영+한)_한" ;
    kno:lastAttestationYear "2021"^^xsd:gYear ;
    kno:origin "(<영>LAN線運動)" ;
    kno:pos "「구」"@ko ;
