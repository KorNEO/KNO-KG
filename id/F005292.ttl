# F005292 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005292 a kno:Formative ;
    kno:parallelFullForm kno:LEX-유니버스 ;
    kno:urimalDefinition "스위스의 그래픽 디자이너 <FL>프루티거</FL>가 1957년 고안한 서체 또는 서체 시스템. 스물한 가지의 서체의 종류를 숫자로 구분하여 활자 디자인 역사상 최초로 체계적인 분류 체계를 적용한 활자 패밀리이다. 〔명사〕"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    kno:fullForm "유니버스"@ko ;
    kno:origin "universe" ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9C%A0> ;
