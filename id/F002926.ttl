# F002926 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002926 a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1468479> ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "강원특별자치도 삼척시 신기면에 있는 이. 신기면의 서쪽에 위치해 있으며, 대부분 산지이다. 남서쪽에 덕항산이 솟아 있으며, 중앙을 흐르는 하천 주변에 주거지와 농경지가 형성되어 있다. 대이 동굴, 대금굴, 관음굴, 환선굴 등의 동굴이 있으며, 국가유산으로 삼척 대이리 너와집(三陟大耳里너와집), 삼척 대이리 통방아(三陟大耳里통방아) 등이 있다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-P1 ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "대이"@ko ;
    kno:origin "大二" ;
    kno:fullForm "대이"@ko ;
    kno:urimalTargetCode "1468479" ;
    rdfs:label "대이(大二)"@ko .
kno:KN2016-0094-c1 kno:formative kno:F002926 .
