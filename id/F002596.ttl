    kno:surfaceForm "기승전"@ko ;
    a kno:Formative ;
    kno:semanticTag kno:usas-Q1.2 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%B0%EC%8A%B9%EC%A0%84> ;
