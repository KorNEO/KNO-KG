    kno:component kno:KN2018-0041-c2 ;
    kno:frequency kno:KN2018-0041-freq-NN-2019 ;
    kno:year "2018"^^xsd:gYear ;
    kno:frequency kno:KN2018-0041-freq-NN-total ;
