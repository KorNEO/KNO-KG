# KN2018-0041 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0041 kno:instantiates kno:S000701 ;
    a kno:Neologism ;
    kno:frequency kno:KN2018-0041-freq-NN-2017 ;
    kno:languageType "한+영" ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:predicate "형성하다"@ko ;
    kno:slotFiller "관(官) (1성분)"@ko ;
    kno:urimalTargetCode "1415820" ;
    kno:unitType "단어"@ko ;
    kno:example "¶주민들은 “다 차려 놓은 밥상에 관이 숟가락을 얹더니 밥상마저 빼앗았다.”, “이게 관이 주도해 가난한 주민들과 작가들을 내쫓는 젠트리피케이션, ‘{관트리피케이션’이} 아니면 뭐냐.”라고 언성을 높였다."@ko ;
    kno:origin "(官<영>←gentrification)" ;
