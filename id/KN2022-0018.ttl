# KN2022-0018 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0018 kno:slotFiller "단(계)(段階) (1성분)"@ko ;
    kno:component kno:KN2022-0018-c4 ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    rdfs:label "검수단박"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B2%80%EC%88%98%EB%8B%A8%EB%B0%95> ;
    skos:definition "‘검찰의 수사권을 단계적으로 박탈함’을 줄여 이르는 말. 검찰이 수사권을 가진 6대 범죄 중 4개 분야를 이관하고 2대 범죄에 해당하는 부패 및 경제 범죄로 수사권을 축소하는 것이 주요 내용이다."@ko ;
    kno:registration "신어DB"@ko ;
    a ontolex:Word ;
    kno:languageType "한+한+한+한" ;
    kno:unitType "단어"@ko ;
    kno:formation kno:W06 ;
    kno:frequency kno:KN2022-0018-freq-NN-2025 ;
    kno:instantiates kno:S000284 ;
    kno:year "2022"^^xsd:gYear ;
    kno:example "¶여야가 합의한 ‘{검수단박’은} 검찰이 수사권을 가지고 있는 6대 범죄 중 경제 및 부패 범죄는 한시적으로 남겨 두고 대형 참사와 선거ㆍ공직자ㆍ방위 사업 범죄는 박탈하는 것을 골자로 한다."@ko ;
    kno:pos "「명」"@ko ;
