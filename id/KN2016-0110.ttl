    kno:urimalTargetCode "1372545" ;
    kno:example "¶OOO 노무사는…“발품까지 팔아 가며 {동전 월급을} 주는 것은 직원들을 비인격적으로 대우하는 것.”이라고 지적했다."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372545> ;
    a kno:Neologism ;
