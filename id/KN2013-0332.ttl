# KN2013-0332 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0332 kno:languageType "고+한" ;
    skos:definition "윷놀이 문화를 계승하고 발전시키기 위해 윷에 대해 연구하는 학문."@ko ;
    rdfs:label "윷-학"@ko ;
    kno:formation kno:W02 ;
    kno:componentString "윷, -학(學)"@ko ;
    kno:instantiates kno:S000197 ;
    kno:example "¶이날 학술대회에서 OOO 소장은 ‘윷 문화 계승의 당위성과 {윷학의} 필요성’이란 주제 발표를 통해, “윷은…고대 문명의 상징으로서 최소 1만 년 전 아메리카 대륙 및 인도 지역에 전파됐다.”라고 주장했다."@ko ;
    kno:year "2013"^^xsd:gYear ;
