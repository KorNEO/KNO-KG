# F001163 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001163 a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=491635> ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "꿩과의 새. 머리에 붉은 볏이 있고 날개는 퇴화하여 잘 날지 못하며 다리는 튼튼하다. 육용과 난용으로 육종된 수많은 품종이 있으며, 가금으로 가장 많이 사육한다. 원종은 인도, 말레이시아 등지의 들꿩이다. 〔명사〕"@ko ;
    kno:surfaceForm "닭"@ko ;
    kno:caseCount "2"^^xsd:integer ;
    kno:semanticTag kno:usas-L2 ;
    rdfs:label "닭"@ko ;
    kno:fullForm "닭"@ko ;
    kno:urimalTargetCode "491635" .
