# KN2020-0237 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0237 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "오케팅"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%98%A4%EC%BC%80%ED%8C%85> ;
    skos:definition "온라인 쇼핑몰에서, 저렴하게 판매하는 오징어를 사기 위해 한꺼번에 많은 사람이 몰려 경쟁이 벌어지는 일을 이르는 말. 2020년 3월 30일, 코로나19로 인한 재난 상황으로 경제적 어려움을 겪는 어민을 돕기 위해 지자체와 유통업계가 협력하여 마련한 행사에서 비롯하였다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
