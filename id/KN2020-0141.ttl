# KN2020-0141 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0141 a kno:Neologism ;
    kno:unitType "구"@ko ;
    kno:frequency kno:KN2020-0141-freq-NN-2020 ;
    kno:slotFiller "차단(遮斷) (1성분)"@ko ;
    kno:year "2020"^^xsd:gYear ;
    skos:definition "병원체의 감염을 매개할 수 있는 침방울의 유입을 차단하기 위해 쓰는 마스크. 주로 비말을 매개로 전파되는 코로나19를 예방하기 위해 쓰는 마스크의 한 종류이다. 보건 마스크에 비해 두께가 얇아 숨쉬기 편하면서도 덴탈 마스크와 비슷한 수준의 침방울 차단 효과가 있다. =비말 마스크, 비말 차단용 마스크."@ko ;
    kno:componentString "비말(飛沫), 차단(遮斷), 마스크(mask)"@ko ;
    kno:pos "「구」"@ko ;
    rdfs:label "비말^차단^마스크"@ko ;
    a ontolex:MultiwordExpression ;
    kno:component kno:KN2020-0141-c2 ;
    kno:origin "(飛沫遮斷<영>mask)" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1507074> ;
    kno:example "¶코로나19의 재확산으로 {비말 차단 마스크를} 쓰던 사람들도 다시 보건용 마스크를 찾기 시작했다."@ko ;
