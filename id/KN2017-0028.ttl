# KN2017-0028 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0028 kno:urimalTargetCode "1380331" ;
    kno:activeYears "0"^^xsd:integer ;
    kno:formation kno:W06 ;
    kno:example "¶최근에는 꼰대라는 단어도 세분화되면서 {굉꼰}, 젊꼰 등의 신조어도 생겨났다."@ko ;
    kno:component kno:KN2017-0028-c1 ;
    a kno:Neologism ;
    skos:definition "‘굉장한 꼰대’를 줄여 이르는 말. 자신의 경험을 일반화하여 그것만이 옳다고 지나치게 주장하며 남을 가르치려 드는 사람을 말한다."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380331> ;
    kno:componentString "굉(장하다)(宏), 꼰(대)"@ko ;
