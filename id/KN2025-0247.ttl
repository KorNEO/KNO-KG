# KN2025-0247 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0247 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "물티슈라이팅"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%AC%BC%ED%8B%B0%EC%8A%88%EB%9D%BC%EC%9D%B4%ED%8C%85> ;
    skos:definition "(LLM) 상대가 특정 소비(특히 물티슈 사용)를 불필요하거나 문제적인 것으로 느끼게 만들어, 죄책감ㆍ의심을 유도하며 사용을 줄이거나 끊도록 설득하는 말이나 행동을 이르는 말."@ko ;
    kno:activeYears "1"^^xsd:integer ;
