@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0609 a ontolex:Word ;
    frac:attestation kno:KN2025-0609-att-nn ;
    ontolex:canonicalForm kno:KN2025-0609-form ;
    ontolex:sense kno:KN2025-0609-sense .

kno:rule-x-남 a morph:Rule ;
    morph:generates kno:KN2025-0609-form .

kno:KN2025-0609-att-nn a frac:Attestation ;
    dcterms:date "2025-03-24"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/031/0000918433> .

kno:KN2025-0609-freq-nn a frac:CorpusFrequency ;
    rdf:value 1160 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0609-freq-yt a frac:CorpusFrequency ;
    rdf:value 8748 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0609-m1 a morph:Morph ;
    ontolex:writtenRep "테토"@ko .

kno:KN2025-0609-m2 a morph:Morph ;
    ontolex:writtenRep "-남"@ko .

kno:KN2025-0609-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%85%8C%ED%86%A0-%EC%97%90%EA%B2%90%20%EC%84%B1%EA%B2%A9%20%EC%9C%A0%ED%98%95> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

kno:KN2025-0609-form a ontolex:Form ;
    frac:frequency kno:KN2025-0609-freq-nn,
        kno:KN2025-0609-freq-yt ;
    morph:consistsOf kno:KN2025-0609-m1,
        kno:KN2025-0609-m2 ;
    ontolex:writtenRep "테토남"@ko .

