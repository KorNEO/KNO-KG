# KN2018-0142 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0142 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "법-블레스유"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1386971> ;
    skos:definition "‘법이 너를 살렸다.’라는 뜻으로 상대방에게 하는 말. 몹시 화가 나 있지만 법이 있기 때문에 참는다는 뜻으로 상대방에게 우회적으로 하는 말이다."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2018-0142-c1 ;
    kno:component kno:KN2018-0142-c2 ;
    kno:component kno:KN2018-0142-c3 ;
    kno:componentString "법(法), 블레스(bless), 유(you)"@ko ;
    kno:example "¶‘{법블레스유’가} 유행이 된 배경은 투명하고 엄격한 법 집행이 있기 때문이다."@ko ;
