# KN2022-0107 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0107 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "달파멸콩"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8B%AC%ED%8C%8C%EB%A9%B8%EC%BD%A9> ;
    skos:definition "‘달걀, 파, 멸치, 콩’을 아울러 이르는 말. 주로 정치에서, 좌파 성향의 정당을 타파하고 공산주의 또는 공산주의자를 멸하는 기조를 이르는 말이다. 차별 및 비하하는 의미가 포함되어 있으므로 사용에 주의가 필요하다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2022-0107-c1 ;
    kno:component kno:KN2022-0107-c2 ;
    kno:component kno:KN2022-0107-c3 ;
    kno:component kno:KN2022-0107-c4 ;
    kno:componentString "달(걀), 파, 멸(치), 콩"@ko ;
    kno:example "¶보수 정권의 지지자들이 모인 온라인 커뮤니티에서는 {달파멸콩} 챌린지에 동참한다는 의미로 ‘달걀, 파, 멸치, 콩’을 장바구니에 담은 후 인증 사진을 찍어 업로드하고 있다."@ko ;
    kno:formation kno:W05 ;
