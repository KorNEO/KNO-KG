kno:KN2016-0083 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "다크^스노우"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8B%A4%ED%81%AC%EC%8A%A4%EB%85%B8%EC%9A%B0> ;
    skos:definition "화산재, 산불 연기, 미세 먼지나 황사로 인한 티끌이 설원에 내려앉아, 탁한 빛을 띠는 눈. 눈 색깔이 어두워 햇빛을 잘 흡수하기 때문에 기상 이변을 가중시킨다."@ko ;
