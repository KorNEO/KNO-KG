kno:KN2024-0150 kno:indexForm "스팔완"@ko ;
    kno:frequency kno:KN2024-0150-freq-NN-2023 ;
    kno:componentString "스(레드)(Threads), 팔(로우)(follow), 완(료)(完了)"@ko ;
    a ontolex:Word ;
    skos:definition "‘스레드 팔로우 완료’를 줄여 이르는 말. 소셜 네트워크 서비스 중 하나인 스레드에서 특정 이용자의 게시물을 지속적으로 볼 수 있도록 구독하는 것을 의미한다. ⇒규범 표기는 ‘스폴완’이다."@ko ;
    kno:component kno:KN2024-0150-c2 ;
    kno:slotFiller "팔(로우)(follow)+완(료)(完了) (2성분)"@ko ;
