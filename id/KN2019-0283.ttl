# KN2019-0283 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0283 kno:unitType "구"@ko ;
    kno:year "2019"^^xsd:gYear ;
    kno:slotFiller "트래시(trash)+태그(tag) (2성분)"@ko ;
    kno:component kno:KN2019-0283-c2 ;
    skos:definition "청소가 필요한 곳의 쓰레기를 모두 치운 후 치우기 전과 후를 비교한 사진을 그런 사진 아래에 달기로 다른 사람들과 미리 정한 태그와 함께 누리 소통망 서비스(SNS)에 올리는 활동. ⇒규범 표기는 미확정이다."@ko ;
    kno:indexForm "트래시태그운동"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8A%B8%EB%9E%98%EC%8B%9C%20%ED%83%9C%EA%B7%B8%20%EC%9A%B4%EB%8F%99> ;
    kno:pos "「구」"@ko ;
    a kno:Neologism ;
    kno:example "¶{트래시 태그 운동은} 해양 쓰레기 등으로 인한 환경 오염에 대한 경각심을 불러일으키고 있다고 OO은 보도했다."@ko ;
