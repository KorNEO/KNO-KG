# KN2021-0020 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0020 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "검체^로봇"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B2%80%EC%B2%B4%EB%A1%9C%EB%B4%87> ;
    skos:definition "검사, 시험, 분석 따위를 위해 생물이나 물질을 채취하는 로봇. 코로나19 감염 여부를 검사하기 위해 면봉을 사람 콧속까지 넣어 자동으로 검체를 채취하는 용도로 개발되었다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2021-0020-c1 ;
    kno:component kno:KN2021-0020-c2 ;
    kno:componentString "검체(檢體), 로봇(robot)"@ko ;
    kno:example "¶의료진은 {검체 로봇을} 이용하여 환자와 대면하지 않고 안전하게 검체를 채취할 수 있게 되었다."@ko ;
    kno:frequency kno:KN2021-0020-freq-NN-2020 ;
    kno:frequency kno:KN2021-0020-freq-NN-2023 ;
    kno:frequency kno:KN2021-0020-freq-NN-2024 ;
    kno:frequency kno:KN2021-0020-freq-NN-total ;
    kno:indexForm "검체로봇"@ko ;
    kno:instantiates kno:S000156 ;
    kno:languageType "한^영" ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:origin "(檢體<영>robot)" ;
    kno:pos "「구」"@ko ;
    kno:predicate "채취하다"@ko ;
    kno:registration "신어DB"@ko ;
    kno:slotFiller "검체(檢體) (1성분)"@ko ;
    kno:unitType "구"@ko ;
