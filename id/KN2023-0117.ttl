    kno:frequency kno:KN2023-0117-freq-NN-total ;
    kno:slotFiller "보장(保障) (1성분)"@ko ;
    kno:example "¶여당의 한 국회의원은 기자 회견을 열어 노동조합 및 노동 관계 조정법에 대한 개정안이 ‘{불법 파업 보장법’으로} 활용될 수 있다며 상정 철회를 요구하였다."@ko ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:instantiates kno:S000523 ;
    kno:component kno:KN2023-0117-c2 ;
