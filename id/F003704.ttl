# F003704 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003704 kno:fullForm "발효"@ko ;
    kno:surfaceForm "발효"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "163647" ;
    a kno:Formative ;
    kno:urimalDefinition "효모나 세균 따위의 미생물이 유기 화합물을 분해하여 알코올류, 유기산류, 이산화 탄소 따위를 생기게 하는 작용. 좁은 뜻으로는 산소가 없는 상태에서 미생물이 탄수화물을 분해하여 에너지를 얻는 작용을 이른다. 술, 된장, 간장, 치즈 따위를 만드는 데에 쓴다. 〔명사〕"@ko ;
    kno:origin "醱酵" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=163647> ;
    kno:semanticTag kno:usas-A2.1 ;
    kno:caseCount "1"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    rdfs:label "발효(醱酵)"@ko .
kno:KN2014-0234-c3 kno:formative kno:F003704 .
