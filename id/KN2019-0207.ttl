kno:KN2019-0207 kno:year "2019"^^xsd:gYear ;
    kno:component kno:KN2019-0207-c2 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%98%A4%EC%9C%A0%EC%A3%BC> ;
