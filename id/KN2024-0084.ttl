# KN2024-0084 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0084 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "벚꽃 개강"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B2%9A%EA%BD%83%20%EA%B0%9C%EA%B0%95> ;
    skos:definition "의료 파업이나 집단 휴학 등 사회적ㆍ정치적 갈등으로 인해 3월 개강이 지연되어, 벚꽃이 피는 4월에 강의가 시작하게 된 상황을 비유적으로 이르는 말."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2024-0084-c1 ;
    kno:component kno:KN2024-0084-c2 ;
    kno:componentString "벚꽃, 개강(開講)"@ko ;
    kno:example "¶대학들은 {벚꽃 개강} 시점 전까지 사태가 정리되면, 계절 학기를 활용해 수업 일수를 채우겠다는 입장이다. 【2024년 월3 신어】 <2024년 빈도: 1> 보더리스-족(<영>borderless族) 영+한 「명」 『사회 일반』 〔인간〕 국경이나 문화적 경계 의식을 크게 느 끼지 않고, 해외 콘텐츠ㆍ관광 등을 자유롭게 소비하며 생활하는 사람. 또 는 그런 무리. ¶이들은 국경 의식이 옅은 보더리스족으로, 온라인으로 접 한 한국 콘텐츠를 실제 현지에서 체험하려는 욕구가 크다."@ko ;
    kno:frequency kno:KN2024-0084-freq-NN-2024 ;
    kno:frequency kno:KN2024-0084-freq-NN-total ;
    kno:indexForm "벚꽃개강"@ko ;
    kno:instantiates kno:S001316 ;
    kno:languageType "고_한" ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:origin "(벚꽃開講)" ;
