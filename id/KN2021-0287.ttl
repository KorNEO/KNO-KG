# KN2021-0287 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0287 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "피코질"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%94%BC%EC%BD%94%EC%A7%88> ;
    skos:definition "‘피해자 코스프레질’을 줄여 이르는 말. 피해자가 아닌 사람이 피해자인 척을 하는 것을 비하하는 말이다."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2021-0287-c1 ;
    kno:component kno:KN2021-0287-c2 ;
    kno:component kno:KN2021-0287-c3 ;
    kno:componentString "피(해자)(被害者), 코(스프레)(kosupure), -질"@ko ;
    kno:example "¶자신이 좋아하는 가수가 힘들어 보여 걱정된다는 내용의 게시글에 누리꾼들은 “다른 가수들도 모두 똑같다. 본인만 그런 것처럼 {피코질은} 그만해라.”라고 하는 등의 여러 댓글들을 남기며 갑론을박을 펼쳤다."@ko ;
    kno:formation kno:W06 ;
    kno:indexForm "피코질"@ko ;
    kno:instantiates kno:S000183 ;
    kno:languageType "(한+일)+고" ;
    kno:origin "(被<일>←kosupure질)" ;
    kno:pos "「명」"@ko ;
