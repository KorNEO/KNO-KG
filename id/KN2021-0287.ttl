@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0287 a ontolex:Word ;
    frac:attestation kno:KN2021-0287-att-nn ;
    ontolex:canonicalForm kno:KN2021-0287-form ;
    ontolex:sense kno:KN2021-0287-sense .

kno:KN2021-0287-att-nn a frac:Attestation ;
    dcterms:date "2023-10-26"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/144/0000921133> .

kno:KN2021-0287-form a ontolex:Form ;
    frac:frequency kno:KN2021-0287-freq-nn,
        kno:KN2021-0287-freq-yt ;
    ontolex:writtenRep "피코-질"@ko .

kno:KN2021-0287-freq-nn a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0287-freq-yt a frac:CorpusFrequency ;
    rdf:value 489 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0287-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%94%BC%ED%95%B4%EC%9E%90%20%EC%BD%94%EC%8A%A4%ED%94%84%EB%A0%88> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

