# F000610 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000610 rdfs:label "콜(call)"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "299508" ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "금융 기관이나 증권 회사 간에 하루나 이틀 정도 서로 뀌어주고 돌려받는 단기성 자금. 대여하는 측에서는 콜론, 차용하는 측에서는 콜머니라고 부른다. 〔명사〕"@ko ;
    kno:origin "call" ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=299508> ;
    kno:fullForm "콜"@ko ;
    kno:surfaceForm "콜"@ko ;
    kno:caseCount "4"^^xsd:integer ;
    kno:semanticTag kno:usas-I1 .
