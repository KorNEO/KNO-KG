# F001613 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001613 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=225921> ;
    kno:semanticTag kno:usas-L2 ;
    kno:fullForm "연어"@ko ;
    kno:origin "鰱魚" ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "연어과의 바닷물고기. 몸의 길이는 70~90cm이고 방추형이다. 등은 남회색, 배는 은백색이고 생식기(生殖期)에 붉은 무늬가 생긴다. 가을에 강 상류에 올라와 모랫바닥에 알을 낳고 죽는다. 우리나라에는 동해 북부의 일부 하천에 회귀하며 일본 북부 등지에 분포한다. 〔명사〕"@ko ;
    kno:caseCount "2"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "225921" ;
    a kno:Formative ;
    rdfs:label "연어(鰱魚)"@ko ;
    kno:surfaceForm "연어"@ko .
