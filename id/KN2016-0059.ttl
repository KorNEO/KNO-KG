# KN2016-0059 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0059 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "깃발라시코"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B9%83%EB%B0%9C%EB%9D%BC%EC%8B%9C%EC%BD%94> ;
    skos:definition "프로 축구 팀인 성남과 수원의 경기를 스페인 리그의 ‘엘 클라시코(el clásico)’에 빗대어 이르는 말. 전통적인 경기라는 뜻으로, 스페인 프로 축구 팀인 레알 마드리드와 에프시(FC) 바르셀로나의 경기를 뜻하는 ‘엘 클라시코(el clásico)’와 ‘깃발’을 결합하여 만든 말이다."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2016-0059-c1 ;
    kno:component kno:KN2016-0059-c2 ;
    kno:component kno:KN2016-0059-c3 ;
    kno:componentString "깃발(旗발), 라(←el), (클라)시코(clásico)"@ko ;
    kno:example "¶한동안 뜸했던 OOO OO 시장의 축구 이야기가 ‘{깃발라시코’를} 앞두고 다시 시작됐다."@ko ;
