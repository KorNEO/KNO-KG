# KN2022-0179 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0179 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "소상공인^긴급^금융^구조안"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%86%8C%EC%83%81%EA%B3%B5%EC%9D%B8%EA%B8%B4%EA%B8%89%EA%B8%88%EC%9C%B5%EA%B5%AC%EC%A1%B0%EC%95%88> ;
    skos:definition "코로나19로 인해 대출 이자의 부담이 늘어난 소상공인을 위하여 제시한 방안. 대출 금리의 부담을 낮추고 상환 기간은 늘리며, 과잉 부채를 감면하는 것이 주요 내용이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2022-0179-c1 ;
    kno:component kno:KN2022-0179-c2 ;
    kno:component kno:KN2022-0179-c3 ;
