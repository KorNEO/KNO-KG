# F005679 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005679 kno:semanticTag kno:usas-B2m ;
    kno:urimalTargetCode "397180" ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:label "정신병(精神病)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=397180> ;
    kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "정신의 장애나 이상으로 말이나 행동이 병적인 상태. 특히 인격에 장애가 있고, 스스로 병이라고 느끼는 자각과 자기비판력을 잃은 상태를 이른다. 외상·중독·질병에 의한 외인성의 것과, 유전·체질에 의한 내인성의 것이 있다. 〔명사〕"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "정신병"@ko ;
    a kno:Formative ;
    kno:origin "精神病" ;
    kno:surfaceForm "정신병"@ko .
kno:KN2025-0006-c2 kno:formative kno:F005679 .
