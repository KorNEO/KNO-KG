kno:KN2016-0167 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "모나미^룩"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%AA%A8%EB%82%98%EB%AF%B8%EB%A3%A9> ;
    skos:definition "흰색 상의에 검은색 하의를 착용하는 옷차림. 흰색과 검은색으로만 이루어진 특정 회사의 볼펜을 연상하게 하여 만들어진 말이다."@ko ;
    kno:activeYears "11"^^xsd:integer ;
    kno:component kno:KN2016-0167-c1 ;
    kno:component kno:KN2016-0167-c2 ;
    kno:componentString "모나미, 룩(look)"@ko ;
    kno:example "¶지난해 가을 모나미 볼펜처럼 흰색 셔츠에 검정 바지를 입은 ‘{모나미 룩’은} 20대 남성들이 가장 사랑한 패션이었다."@ko ;
