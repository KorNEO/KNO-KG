# KN2022-0045 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0045 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "공직^후보자^역량^자격시험"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B3%B5%EC%A7%81%ED%9B%84%EB%B3%B4%EC%9E%90%EC%97%AD%EB%9F%89%EC%9E%90%EA%B2%A9%EC%8B%9C%ED%97%98> ;
    skos:definition "국민의힘 소속으로 선거에 출마하려는 기초 의원 또는 광역 의원 예비 출마자를 대상으로 정당법, 지방 자치법, 당헌, 당규 등의 직무 수행 능력 및 시사 현안을 묻는 시험. 2022년에 처음 도입되었으며, 공직 후보자 기초 자격 평가, 공천 시험, 공천 자격 시험, 공직 후보자 자격 시험 등으로 불린다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2022-0045-c1 ;
    kno:component kno:KN2022-0045-c2 ;
    kno:component kno:KN2022-0045-c3 ;
    kno:component kno:KN2022-0045-c4 ;
    kno:componentString "공직(公職), 후보자(候補者), 역량(力量), 자격시험(資格試驗)"@ko ;
    kno:example "¶공천 신청자들은 곧 시행될 {공직 후보자 역량 자격시험에} 참여하여 동등한 기준으로 지방 선거에 출마하는 것을 합의하였다."@ko ;
    kno:frequency kno:KN2022-0045-freq-NN-2022 ;
