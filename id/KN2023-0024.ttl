# KN2023-0024 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0024 kno:lastAttestationYear "2022"^^xsd:gYear ;
    rdfs:label "고특-법"@ko ;
    kno:frequency kno:KN2023-0024-freq-NN-2022 ;
    kno:example "¶당초 정부는 학령 인구의 감소로 여유가 생긴 초중등학교의 예산을 대학과 평생 교육에 투자하겠다는 취지로 {고특법}의 추진을 발표하였다."@ko ;
    a ontolex:Word ;
