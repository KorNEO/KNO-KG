# KN2012-0413 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0413 kno:unitType "구"@ko ;
    rdfs:label "카톡 쏘우"@ko ;
    kno:instantiates kno:S000227 ;
    kno:year "2012"^^xsd:gYear ;
    kno:component kno:KN2012-0413-c2 ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2012-0413-c1 ;
    a kno:Neologism ;
    kno:componentString "카톡(←kakaotalk), 쏘우(saw)"@ko ;
    kno:registration "신어DB"@ko ;
    kno:slotFiller "쏘우(saw) (1성분)"@ko ;
    skos:definition "모바일 메신저의 단체 대화방에 강제로 초대를 당해 원하지 않지만 계속해서 메시지 도착 알람을 받아야 하는 경우를 영화 ‘쏘우’에 빗대어 이르는 말. ‘쏘우’는 아무 이유 없이 사람들을 납치, 감금하는 내용의 영화이다."@ko ;
    kno:pos "「구」"@ko ;
    a ontolex:MultiwordExpression ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B9%B4%ED%86%A1%20%EC%8F%98%EC%9A%B0> ;
    kno:origin "(←kakakotalk saw)" ;
    kno:indexForm "카톡쏘우"@ko ;
    kno:languageType "영_영" ;
    kno:example "¶네티즌들은 채팅방의 알람을 꺼 놔도 새로운 사람이 초대되면 다시 알람이 울리고, 채팅방을 나가도 무한 초대되는 특징을 들어 이 같은 공동 채팅방을 ‘카톡 지옥, {카톡 쏘우’라는} 별칭으로 부르고 있다."@ko .
