# KN2021-0019 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0019 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "검수완박"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B2%80%EC%88%98%EC%99%84%EB%B0%95> ;
    skos:definition "‘검찰의 수사권을 완전히 박탈함’을 줄여 이르는 말. 검찰은 법률에서 정한 예외적인 경우에 한해 수사 업무를 수행하며, 기소 및 공판 업무를 전담한다는 것이 주요 내용이다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2021-0019-c1 ;
    kno:component kno:KN2021-0019-c2 ;
