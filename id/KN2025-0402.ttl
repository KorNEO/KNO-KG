@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0402 a ontolex:Word ;
    frac:attestation kno:KN2025-0402-att-nn ;
    ontolex:canonicalForm kno:KN2025-0402-form ;
    ontolex:sense kno:KN2025-0402-sense .

kno:KN2025-0402-att-nn a frac:Attestation ;
    dcterms:date "2025-01-19"^^xsd:date ;
    frac:locus <https://m.entertain.naver.com/article/003/0013023310> .

kno:KN2025-0402-form a ontolex:Form ;
    frac:frequency kno:KN2025-0402-freq-nn,
        kno:KN2025-0402-freq-yt ;
    ontolex:writtenRep "언 럭키비키"@ko .

kno:KN2025-0402-freq-nn a frac:CorpusFrequency ;
    rdf:value 11 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0402-freq-yt a frac:CorpusFrequency ;
    rdf:value 81 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0402-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

