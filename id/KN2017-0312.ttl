# KN2017-0312 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0312 kno:pos "「명」"@ko ;
    skos:definition "여성이 정치ㆍ경제ㆍ사회ㆍ문화의 중심에서 권력을 가지고 스스로 그 권력을 행사하는 제도. 또는 그런 장치. 여성주의를 뜻하는 독일어 ‘페미니스무스(feminismus)’와 민주주의를 뜻하는 ‘데모크라티(demokratie)’를 결합하여 만든 말이다."@ko ;
    a kno:Neologism ;
    kno:frequency kno:KN2017-0312-freq-NN-total ;
    kno:predicate "행사하다"@ko ;
    kno:lastAttestationYear "2017"^^xsd:gYear ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8E%98%EB%AA%A8%ED%81%AC%EB%9D%BC%ED%8B%B0> ;
    kno:example "¶‘{페모크라티’라는} 신조어가 생길 정도로 곳곳에서 여성 지도자의 활약이 돋보였지만 미국 최초의 여성 대통령은 실패로 끝났다."@ko ;
    rdfs:label "페모크라티"@ko ;
