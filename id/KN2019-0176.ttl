# KN2019-0176 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0176 a kno:Neologism ;
    rdfs:label "스피드^팩토어"@ko ;
    kno:origin "(<영>speed factore)" ;
    kno:component kno:KN2019-0176-c3 ;
