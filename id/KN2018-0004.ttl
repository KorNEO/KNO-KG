# KN2018-0004 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0004 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "가잼비"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415702> ;
    skos:definition "‘가격 대비 재미의 비율’을 줄여 이르는 말. 어떤 품목이나 상품에 대하여 기대할 수 있는 재미의 정도를 말한다."@ko ;
    kno:activeYears "8"^^xsd:integer ;
    kno:component kno:KN2018-0004-c1 ;
    kno:component kno:KN2018-0004-c2 ;
    kno:component kno:KN2018-0004-c3 ;
    kno:componentString "가(격)(價), 잼, 비(율)(比)"@ko ;
    kno:example "¶‘{가잼비’를} 중요시하는 소비자들은 소장 욕구를 자극하는 디자인이나 예쁜 캐릭터를 담은 제품들을 구매하는 경향이 있다."@ko ;
    kno:formation kno:W06 ;
