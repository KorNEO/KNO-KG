    kno:truncated "false"^^xsd:boolean ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "스닉"@ko ;
    rdfs:label "스닉(sneak)"@ko ;
    kno:urimalDefinition "애니메이션에서 일반적으로 많은 프레임이 요구되는 매우 느리고 조심스러운 동작. 한 사이클은 보통 16~24프레임 정도가 필요하다. 동작의 상하로의 급격한 변화와 앞뒤의 큰 이동이 표현된다. ⇒규범 표기는 ‘스니크’이다. 〔명사〕"@ko ;
    kno:surfaceForm "스닉"@ko ;
    kno:urimalTargetCode "1167169" ;
    kno:origin "sneak" .
kno:KN2025-0364-c1 kno:formative kno:F004548 .
