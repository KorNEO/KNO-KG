# KN2019-0183 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0183 kno:frequency kno:KN2019-0183-freq-NN-2020 ;
    a ontolex:MultiwordExpression ;
    kno:registration "신어DB"@ko ;
    skos:definition "고용 보험에 가입하기 어려워 실업 급여 혜택을 받지 못하는 저소득층을 지원하기 위한 구직자 취업 촉진 및 생활 지원에 관한 법률안. 고용 안전망 사각지대를 해소하기 위해 2019년 4월에 국회에서 발의되었다."@ko ;
    kno:languageType "한^한" ;
    kno:component kno:KN2019-0183-c3 ;
    kno:origin "(失業扶助法)" ;
    kno:activeYears "2"^^xsd:integer ;
    kno:frequency kno:KN2019-0183-freq-NN-total ;
    kno:lastAttestationYear "2020"^^xsd:gYear ;
    kno:example "¶이에 OOO 의원은 사회 초년생, 장기 경력 단절자, 특수 형태 고용 종사자 등 고용 보험에 가입하지 않은 국민들의 고용 안전망 사각지대를 해소하기 위해 ‘한국형 {실업 부조법’을} 발의하게 되었다."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%8B%A4%EC%97%85%EB%B6%80%EC%A1%B0%EB%B2%95> ;
