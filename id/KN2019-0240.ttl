# KN2019-0240 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0240 a kno:Neologism ;
    kno:frequency kno:KN2019-0240-freq-NN-total ;
    skos:definition "자녀가 어떤 일을 성취하는 데 어려움이 없도록 자녀에 대한 모든 일에 나서서 문제를 직접 해결해 주는 유형의 부모. 자녀가 목표를 달성하는 과정에서 직면하게 될 장해들을 먼저 나서서 없애 버리는 행동을 길에 쌓인 눈을 치워 없애는 기계인 제설기에 비유하여 이르는 말이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:year "2019"^^xsd:gYear ;
    kno:example "¶얼마 전 명문대 진학을 위해 대학교수가 논문에 공동 저자로 자녀의 이름을 넣거나, 제자들에게 논문과 스펙을 대신 만들게 한 부모는 {제설기 부모라} 할 수 있다."@ko ;
    a ontolex:MultiwordExpression ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A0%9C%EC%84%A4%EA%B8%B0%EB%B6%80%EB%AA%A8> ;
