# KN2018-0299 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0299 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "정서적 흙수저"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A0%95%EC%84%9C%EC%A0%81%20%ED%9D%99%EC%88%98%EC%A0%80> ;
    skos:definition "정신이 건강하지 않고 인성이 바르지 않아 정서적으로 빈곤한 사람을, 경제적으로 좋지 않은 환경을 누리는 사람을 뜻하는 흙수저에 빗대어 이르는 말. 주로 부모와 정서적으로 유대감을 갖지 못하고, 애착이 제대로 형성되지 않아 성숙한 자아 정체성을 형성하지 못한 사람을 뜻한다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2018-0299-c1 ;
    kno:component kno:KN2018-0299-c2 ;
    kno:componentString "정서적(情緖的), 흙수저"@ko ;
    kno:example "¶‘{정서적 흙수저’는} 평생 계속해서 수많은 문제 행동을 낳는다는 점에서 위험하다."@ko ;
