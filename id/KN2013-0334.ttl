kno:KN2013-0334 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "의란성 쌍둥이"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1368527> ;
    skos:definition "의사에 의해 태어난 쌍둥이. 성형 수술을 통하여 외모가 쌍둥이처럼 매우 비슷하게 닮게 된 사람들을 가리킨다."@ko ;
