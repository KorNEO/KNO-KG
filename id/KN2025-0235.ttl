# KN2025-0235 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0235 kno:unitType "구"@ko ;
    kno:languageType "일_영" ;
    a kno:Neologism ;
    skos:definition "(LLM) 손가락으로 브이(V) 모양을 만든 뒤 그 사이에 볼을 끼우거나 얼굴 가까이에 대어, 볼이 말랑해 보이도록 귀엽게 연출하는 사진 포즈."@ko ;
    kno:component kno:KN2025-0235-c1 ;
