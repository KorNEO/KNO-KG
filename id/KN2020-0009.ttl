    kno:component kno:KN2020-0009-c3 ;
    kno:slotFiller "선별(選別)+진료소(診療所) (2성분)"@ko ;
    kno:example "¶OO시는 감염병이 재확산되자 {공공 선별 진료소를} 마흔 개에서 백 개 이상으로 확대하였다."@ko ;
    a ontolex:MultiwordExpression ;
    kno:origin "(公共選別診療所)" ;
