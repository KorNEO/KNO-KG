# KN2023-0047 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0047 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "기초^연금^확대법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%B0%EC%B4%88%EC%97%B0%EA%B8%88%ED%99%95%EB%8C%80%EB%B2%95> ;
    skos:definition "부부가 함께 기초 연금을 받는 경우 남편 몫과 아내 몫의 연금 수령액을 각각 20%를 감액하는 기초 연금의 부부 감액 제도를 폐지하고, 기초 연금을 월 40만원으로 인상하기 위하여 제정한 법률."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2023-0047-c1 ;
    kno:component kno:KN2023-0047-c2 ;
    kno:component kno:KN2023-0047-c3 ;
    kno:componentString "기초(基礎), 연금(年金), 확대법(擴大法)"@ko ;
    kno:example "¶{기초 연금 확대법은} 연금 수령의 대상을 100%로 확대하는 안과 만 65세 이상이면서 소득 하위 70%인 경우 기초 연금을 월 30만 원에서 월 40만 원으로 높이는 안으로 각각 발의되어 있다."@ko ;
