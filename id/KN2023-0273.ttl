# KN2023-0273 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0273 kno:component kno:KN2023-0273-c1 ;
    kno:instantiates kno:S000323 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B0%B8%EC%8A%A4%ED%94%BC> ;
    skos:definition "참치 선물 세트를 되팔 때의 시세를 수치로 나타낸 것. 고물가에 경기 침체의 우려까지 겹치면서 명절 선물을 온라인상에서 되팔아 생활비 등에 보태려고 하는 현상이 나타나며 등장한 말이다."@ko ;
    kno:origin "(참<영>←KOSPI)" ;
    rdfs:label "참스피"@ko ;
    kno:registration "신어DB"@ko ;
    kno:example "¶평소에는 100그램당 1,500원에서 1,600원대로 거래되는 {참스피가} 명절이 되면 참치 선물 세트의 공급이 늘어나면서 1,300원까지 떨어지기도 한다."@ko ;
    kno:unitType "단어"@ko ;
