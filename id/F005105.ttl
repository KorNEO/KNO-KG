# F005105 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005105 kno:urimalTargetCode "234782" ;
    kno:surfaceForm "오"@ko ;
    kno:semanticTag kno:usas-F1 ;
    rdfs:label "오(징어)"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    kno:fullForm "오징어"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%98%A4> ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-L2 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=234782> ;
    kno:fullFormLexeme kno:LEX-오징어 ;
    kno:urimalDefinition "연체동물문 두족강 갑오징어목과 살오징어목의 일부 종들을 통틀어 이르는 말. 머리 부분에 다섯 쌍의 다리가 있고, 그중 한 쌍의 촉완에 있는 빨판으로 먹이를 잡는다. 몸통의 끝에 지느러미가 있으며 적을 만나면 먹물을 토하고 달아난다. 참오징어, 물오징어, 쇠갑오징어, 귀꼴뚜기 따위가 있다. 〔명사〕"@ko ;
    kno:parallelFullForm kno:LEX-오징어 ;
    kno:caseCount "1"^^xsd:integer ;
    a kno:Formative .
kno:KN2020-0237-c1 kno:formative kno:F005105 .
