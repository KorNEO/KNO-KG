# KN2022-0249 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0249 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "제로^코로나"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1613084> ;
    skos:definition "중국이 코로나19 바이러스를 완전히 박멸하기 위해 시행한 엄격한 방역 정책. 국경을 봉쇄하여 전 세계에 경제 및 사회적 영향을 미쳤으며 시행된지 3년만인 2022년 12월 폐지되었다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2022-0249-c1 ;
    kno:component kno:KN2022-0249-c2 ;
    kno:componentString "제로(zero), 코로나(바이러스)(corona virus)"@ko ;
    kno:example "¶지난 5월에는 중국이 국경을 봉쇄한 {제로 코로나} 방역 이후로 첫 범죄자 송환이 이루어졌다."@ko ;
