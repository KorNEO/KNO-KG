# F001639 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001639 kno:origin "wife" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=356863> ;
    kno:surfaceForm "와이프"@ko ;
