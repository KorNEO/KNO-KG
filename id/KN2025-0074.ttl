# KN2025-0074 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0074 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "국민 깡 통 펀드"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B5%AD%EB%AF%BC%20%EA%B9%A1%20%ED%86%B5%20%ED%8E%80%EB%93%9C> ;
    skos:definition "(LLM) 정부가 출자ㆍ조성한 정책성 펀드가 운용 성과 부진으로 손실을 내거나 원금 회수가 어려워져, 그 부담이 국민에게 돌아갈 수 있음을 비판적으로 이르는 말."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2025-0074-c1 ;
