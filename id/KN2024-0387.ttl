@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0387 a ontolex:Word ;
    frac:attestation kno:KN2024-0387-att-nn ;
    ontolex:canonicalForm kno:KN2024-0387-form ;
    ontolex:sense kno:KN2024-0387-sense .

kno:KN2024-0387-att-nn a frac:Attestation ;
    dcterms:date "2020-08-23"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/421/0004828658> .

kno:KN2024-0387-form a ontolex:Form ;
    frac:frequency kno:KN2024-0387-freq-nn,
        kno:KN2024-0387-freq-yt ;
    ontolex:writtenRep "현기까"@ko .

kno:KN2024-0387-freq-nn a frac:CorpusFrequency ;
    rdf:value 4 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0387-freq-yt a frac:CorpusFrequency ;
    rdf:value 2277 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0387-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%98%84%EA%B8%B0%EA%B9%8C> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

