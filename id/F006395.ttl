# F006395 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006395 a kno:Formative ;
    kno:origin "tatto" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalTargetCode "790018" ;
    rdfs:label "타투(tatto)"@ko ;
    kno:semanticTag kno:usas-B4 ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "살갗을 바늘로 찔러 먹물이나 물감으로 글씨, 그림, 무늬 따위를 새김. 또는 그렇게 새긴 것. 보통, 맹세의 표시나 치레 따위를 하느라고 새기며 미개 사회에서는 주술이나 장식의 의도로 행하였다. ⇒규범 표기는 ‘터투/태투’이다. 〔명사〕"@ko ;
    kno:fullForm "타투"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:surfaceForm "타투"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=790018> .
kno:KN2018-0180-c2 kno:formative kno:F006395 .
