kno:F004018 kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "12460" ;
    kno:urimalDefinition "선반이나 탁자 따위의 널빤지를 버티어 받치기 위하여 수직면에 대는 직각 삼각형 모양의 나무나 쇠. 빗변이 널빤지에서 누르는 힘을 받도록 되어 있다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-O2 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=12460> ;
    kno:fullForm "브래킷"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:label "브래킷(bracket)"@ko ;
    kno:surfaceForm "브래킷"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    a kno:Formative ;
