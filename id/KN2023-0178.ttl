@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0178 a ontolex:Word ;
    frac:attestation kno:KN2023-0178-att-nn ;
    ontolex:canonicalForm kno:KN2023-0178-form ;
    ontolex:sense kno:KN2023-0178-sense .

kno:KN2023-0178-att-nn a frac:Attestation ;
    dcterms:date "2023-04-12"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/003/0011800310> .

kno:KN2023-0178-form a ontolex:Form ;
    frac:frequency kno:KN2023-0178-freq-nn,
        kno:KN2023-0178-freq-yt ;
    ontolex:writtenRep "애사비"@ko .

kno:KN2023-0178-freq-nn a frac:CorpusFrequency ;
    rdf:value 1815 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0178-freq-yt a frac:CorpusFrequency ;
    rdf:value 6298 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0178-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%95%A0%ED%94%8C%20%EC%82%AC%EC%9D%B4%EB%8B%A4%20%EB%B9%84%EB%8B%88%EA%B1%B0> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

