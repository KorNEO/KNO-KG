@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0264 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2020-0264-att-nn ;
    ontolex:canonicalForm kno:KN2020-0264-form ;
    ontolex:sense kno:KN2020-0264-sense .

kno:KN2020-0264-att-nn a frac:Attestation ;
    dcterms:date "2020-04-06"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/022/0003454005> .

kno:KN2020-0264-form a ontolex:Form ;
    frac:frequency kno:KN2020-0264-freq-nn,
        kno:KN2020-0264-freq-yt ;
    ontolex:writtenRep "이^학습터"@ko .

kno:KN2020-0264-freq-nn a frac:CorpusFrequency ;
    rdf:value 38 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0264-freq-yt a frac:CorpusFrequency ;
    rdf:value 848 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0264-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/e%ED%95%99%EC%8A%B5%ED%84%B0> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

