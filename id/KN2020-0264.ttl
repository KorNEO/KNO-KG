# KN2020-0264 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0264 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "이^학습터"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9D%B4%ED%95%99%EC%8A%B5%ED%84%B0> ;
    skos:definition "초중등학교의 학생들과 교사들이 이용할 수 있는 온라인 교수 학습 사이트. 동영상 강의나 실시간 화상 수업을 통해 자율 보충 학습, 방과 후 수업, 학습 관리 등 학교 정규 수업의 보조적 수단으로 활용한다. 교육부와 전국 17개 시도 교육청에서 운영하며, 코로나19의 확산을 방지하기 위해 2020년 4월 온라인 개학을 하는 데에 이용되면서 학교 정규 수업의 보조적 수단뿐만 아니라 주 수단으로서도 활용되기 시작했다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2020-0264-c1 ;
    kno:component kno:KN2020-0264-c2 ;
    kno:component kno:KN2020-0264-c3 ;
    kno:componentString "이(E), 학습(學習), 터"@ko ;
    kno:example "¶정부는 온라인 개학을 대비하여 {이 학습터에} 미리 로그인할 것을 학생들에게 권장했다."@ko ;
