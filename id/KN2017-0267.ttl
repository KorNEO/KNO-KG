# KN2017-0267 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0267 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "취업 인류"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B7%A8%EC%97%85%20%EC%9D%B8%EB%A5%98> ;
    skos:definition "일정한 직업을 잡아 직장을 구한 사람들을 ‘인류’에 비유하여 이르는 말. 독서실에서 공부하는 취업 준비생들을 가리키는 ‘독서실 원시인’에 상대하여 이르는 말이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2017-0267-c1 ;
    kno:component kno:KN2017-0267-c2 ;
    kno:componentString "취업(就業), 인류(人類)"@ko ;
    kno:example "¶이외에도 공무원 시험에 합격 후 취업을 해야 비로소 인류로 진화한다는 ‘{취업 인류’도} 공무원 시험을 준비하는 세태를 풍자하기 위해 생겨났다."@ko ;
    kno:frequency kno:KN2017-0267-freq-NN-2017 ;
    kno:frequency kno:KN2017-0267-freq-NN-2018 ;
    kno:frequency kno:KN2017-0267-freq-NN-total ;
