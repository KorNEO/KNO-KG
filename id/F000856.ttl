    kno:fullForm "에이아이"@ko ;
    rdfs:label "에이아이(AI)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "539992" ;
    a kno:Formative ;
    kno:urimalDefinition "인간의 지능이 가지는 학습, 추리, 적응, 논증 따위의 기능을 갖춘 컴퓨터 시스템. 전문가 시스템, 자연 언어의 이해, 음성 번역, 로봇 공학, 인공 시각, 문제 해결, 학습과 지식 획득, 인지 과학 따위에 응용한다. 〔명사〕"@ko ;
    kno:surfaceForm "에이아이"@ko ;
    kno:caseCount "3"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    kno:origin "ai" ;
