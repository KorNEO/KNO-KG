kno:KN2016-0186 kno:indexForm "믿보녀"@ko ;
    a kno:Neologism ;
    kno:unitType "단어"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372621> ;
    kno:activeYears "2"^^xsd:integer ;
    skos:definition "‘믿고 보는 여자’를 줄여 이르는 말. 주로 드라마나 예능 프로그램에서, 항상 기대를 저버리지 않을 만큼 좋은 연기를 하거나 재밌는 행동을 하는 여자를 가리키는 말이다."@ko ;
    rdfs:label "믿보녀"@ko ;
    kno:component kno:KN2016-0186-c2 ;
    kno:component kno:KN2016-0186-c1 ;
    kno:instantiates kno:S001389 ;
    kno:formation kno:W06 ;
    kno:example "¶OO는…{믿보녀} 캐릭터 4명의 엠시로 구성되어 방영 전부터 화제를 불러일으키고 있다."@ko ;
