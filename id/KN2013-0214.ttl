# KN2013-0214 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0214 a ontolex:Word ;
    kno:activeYears "1"^^xsd:integer ;
    skos:definition "‘블라인드 테스트 걸’을 줄여 이르는 말. 소비자가 브랜드나 회사를 알 수 없도록 가린 상태에서 제품을 사용한 후에 품질을 평가하는 여성을 이른다."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B8%94%ED%85%8C%EA%B1%B8> ;
    kno:lastAttestationYear "2013"^^xsd:gYear ;
    kno:component kno:KN2013-0214-c1 ;
    kno:instantiates kno:S000161 ;
    kno:year "2013"^^xsd:gYear ;
    kno:languageType "영+영+영" ;
    kno:registration "신어DB"@ko ;
    rdfs:label "블테걸"@ko ;
    kno:pos "「명」"@ko ;
    kno:unitType "단어"@ko ;
    kno:indexForm "블테걸"@ko ;
    kno:origin "(▼←blind test girl)" ;
    kno:formation kno:W06 ;
    a kno:Neologism ;
    kno:example "¶‘OO’ 담당 OOO 피디(PD)는 “25명의 {블테걸이} 함께하는 장기 블라인드 테스트를 통해 그동안 여성들이 궁금해 했던 기초 제품들에 대한 궁금증을 말끔히 해소시켜 줄 것으로 보인다.”라며 “앞으로 장기 블라인드 테스트 외에도 특정 뷰티 제품을 많이 소비하는 특정 소비층을 대상으로 한 게릴라 블라인드 테스트도 진행될 예정이니 많은 기대를 바란다.”라고 소감을 전했다."@ko ;
    kno:component kno:KN2013-0214-c2 ;
    kno:frequency kno:KN2013-0214-freq-NN-2013 ;
    kno:component kno:KN2013-0214-c3 ;
    kno:slotFiller "블(라인드)(blind)+테(스트)(test) (2성분)"@ko ;
    kno:componentString "블(라인드)(blind), 테(스트)(test), 걸(girl)"@ko ;
    kno:frequency kno:KN2013-0214-freq-NN-total .
