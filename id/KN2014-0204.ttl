# KN2014-0204 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0204 a kno:Neologism ;
    kno:instantiates kno:S000090 ;
    skos:definition "운동을 하고 있는 자신의 모습을 스스로 찍는 일. 또는 그렇게 찍은 사진."@ko ;
