# KN2017-0201 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0201 kno:predicate "생각하다"@ko ;
    a ontolex:MultiwordExpression ;
    kno:example "¶‘{연애 정상성’이라는} 개념에서 벗어난 성향의 사람들은 연애 권하기를 넘어 연애를 강요하는 사회와 부딪칠 수밖에 없다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:component kno:KN2017-0201-c1 ;
    kno:indexForm "연애정상성"@ko ;
    kno:unitType "구"@ko ;
    kno:year "2017"^^xsd:gYear ;
    a kno:Neologism ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380765> ;
    kno:frequency kno:KN2017-0201-freq-NN-2017 ;
    kno:componentString "연애(戀愛), 정상성(正常性)"@ko ;
    kno:urimalTargetCode "1380765" ;
    kno:frequency kno:KN2017-0201-freq-NN-2016 ;
    kno:languageType "한_한" ;
    skos:definition "남자와 여자가 서로 사랑해서 사귀는 것만이 정상 범주에 속하는 것이라고 생각하는 태도. 미국에서, 사랑하는 사람을 뜻하는 이탈리아 어 ‘아마토(amato)’와 정상성을 뜻하는 영어 ‘노머티비티(normative)’를 결합하여 만든 말인 ‘아마토노머티비티(amatonormativity)’를 한국어로 번역한 말이다."@ko ;
    rdfs:label "연애 정상성"@ko ;
