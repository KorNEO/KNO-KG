# KN2025-0284 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0284 kno:indexForm "벚꽃세권"@ko ;
    skos:definition "(LLM) 집 주변에서 벚꽃길ㆍ벚꽃 명소를 가까이 두고 봄철에 벚꽃을 쉽게 즐길 수 있는 주거 입지."@ko ;
    kno:languageType "(고+한)+한" ;
    kno:example "(LLM) 봄 이사철을 앞두고 부동산 카페에서는 집 근처에 벚꽃길이 있는 {벚꽃세권을} 선호한다는 글이 잇따랐다."@ko ;
