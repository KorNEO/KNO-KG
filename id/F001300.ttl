# F001300 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001300 kno:parallelFullForm kno:LEX-멸치 ;
    kno:urimalTargetCode "150709" ;
    kno:truncated "true"^^xsd:boolean ;
    kno:urimalDefinition "멸칫과의 바닷물고기. 몸의 길이는 13cm 정도이며, 등은 검푸르고 배는 은빛을 띤 백색이다. 몸은 길고 원통 모양이며 비늘은 둥글둥글하다. 연안 회유성 물고기로 플랑크톤을 주로 먹고 산다. 한국, 일본, 중국 등지에 분포한다. 〔명사〕"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A9%B8> ;
    kno:fullForm "멸치"@ko ;
    kno:surfaceForm "멸"@ko ;
    kno:caseCount "2"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=150709> ;
    a kno:Formative ;
    kno:semanticTag kno:usas-F1 ;
    rdfs:label "멸(치)"@ko ;
    kno:fullFormLexeme kno:LEX-멸치 .
kno:KN2022-0107-c3 kno:formative kno:F001300 .
