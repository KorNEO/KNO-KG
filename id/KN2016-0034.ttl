    kno:urimalTargetCode "1372469" ;
    kno:example "¶‘플랜 제트’는 최선인 플랜 에이, 차선인 플랜 비가 모두 실패할 경우를 대비한 최후의 보루를 뜻하는 것으로 일명 ‘{구명보트 전략’이라고} 해석할 수 있다."@ko ;
    kno:unitType "구"@ko ;
    kno:lastAttestationYear "2020"^^xsd:gYear ;
