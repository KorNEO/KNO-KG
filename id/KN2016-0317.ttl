    kno:component kno:KN2016-0317-c1 ;
    kno:indexForm "시나리오접근방법"@ko ;
    kno:year "2016"^^xsd:gYear ;
    skos:definition "발생 가능한 여러 가지 미래의 상황을 예측하고 분석하여 시나리오를 만들고, 그에 맞게 사업 단계별 전략을 마련하는 접근 방법. 예측하기 힘든 불확실한 미래에 대비하기 위하여 다양한 대응책을 미리 준비하는 경영 기법을 말한다."@ko ;
    rdfs:label "시나리오^접근^방법"@ko ;
