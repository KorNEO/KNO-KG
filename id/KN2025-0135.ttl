@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0135 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2025-0135-att-nn ;
    ontolex:canonicalForm kno:KN2025-0135-form ;
    ontolex:sense kno:KN2025-0135-sense .

kno:KN2025-0135-att-nn a frac:Attestation ;
    dcterms:date "2025-05-18"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/082/0001326236> .

kno:KN2025-0135-form a ontolex:Form ;
    frac:frequency kno:KN2025-0135-freq-nn,
        kno:KN2025-0135-freq-yt ;
    ontolex:writtenRep "노쇼 경제학"@ko .

kno:KN2025-0135-freq-nn a frac:CorpusFrequency ;
    rdf:value 85 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0135-freq-yt a frac:CorpusFrequency ;
    rdf:value 200 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0135-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%98%B8%ED%85%94%EA%B2%BD%EC%A0%9C%ED%95%99> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

