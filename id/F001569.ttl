# F001569 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001569 a kno:Formative ;
    rdfs:label "아마존(Amazon)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=217735> ;
    kno:caseCount "2"^^xsd:integer ;
    kno:fullForm "아마존"@ko ;
