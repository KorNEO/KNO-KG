# KN2019-0162 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0162 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "수소^차^육성법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%88%98%EC%86%8C%EC%B0%A8%EC%9C%A1%EC%84%B1%EB%B2%95> ;
    skos:definition "수소 차 따위의 친환경 자동차 충전 시설을 설치할 때 국공유 재산의 임대료를 최대 50%까지 낮추는 법안. 2018년 12월 국회 본회의를 통과하였다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2019-0162-c1 ;
