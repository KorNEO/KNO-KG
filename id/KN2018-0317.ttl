# KN2018-0317 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0317 rdfs:label "초기^코인^제공"@ko ;
    skos:definition "블록체인 기반의 가상 암호 화폐를 발행할 때 사업자가 이를 투자자들에게 판매하여 자금을 확보하는 일. 감사가 없고 누구나 자금을 조달할 수 있기 때문에 투자 위험성이 매우 높다."@ko ;
    kno:indexForm "초기코인제공"@ko ;
    kno:componentString "초기(初期), 코인(coin), 제공(提供)"@ko ;
    kno:frequency kno:KN2018-0317-freq-NN-2022 ;
    a ontolex:MultiwordExpression ;
    kno:predicate "확보하다"@ko ;
    kno:origin "(初期<영>coin提供)" ;
    kno:component kno:KN2018-0317-c1 ;
    kno:example "¶블록체인은 모든 OO 거래 내역이 기록된 공개 장부인데, 이 아이티(IT) 회사는 이번 달 토큰 판매 및 {초기 코인 제공을} 시작으로 모든 조직에 분산된 데이터 교환을 제공하고…대량 채택을 가능하게 하도록 할 예정이다."@ko ;
