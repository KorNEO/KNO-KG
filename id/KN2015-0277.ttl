kno:KN2015-0277 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "힙찔이"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1369470> ;
    skos:definition "힙합을 하며 지질하게 못난 사람을 속되게 이르는 말."@ko ;
