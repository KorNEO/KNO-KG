# F006401 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006401 kno:fullForm "탄수화물"@ko ;
    a kno:Formative ;
    rdfs:label "탄수화물(炭水化物)"@ko ;
    kno:origin "炭水化物" ;
    kno:surfaceForm "탄수화물"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalDefinition "수소, 산소, 탄소로 이루어진 유기 화합물. 수소 원자와 산소 원자의 비율이 2 대 1이다. 삼대 영양소 가운데 하나로, 녹색식물의 광합성으로 생긴다. 포도당, 과당, 녹말 따위가 있다. 〔명사〕"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "474534" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=474534> ;
    kno:semanticTag kno:usas-F1 ;
    kno:registration "우리말샘"@ko .
