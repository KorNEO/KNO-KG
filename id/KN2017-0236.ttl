kno:KN2017-0236 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "일코노미-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380800> ;
    skos:definition "일인 가구를 이루며 혼자서 경제생활을 꾸려 나가는 사람. 또는 그런 무리."@ko ;
