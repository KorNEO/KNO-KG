# F005060 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005060 kno:origin "煉炭" ;
    kno:urimalTargetCode "503444" ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=503444> ;
