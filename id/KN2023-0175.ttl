@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0175 a ontolex:Word ;
    frac:attestation kno:KN2023-0175-att-nn ;
    ontolex:canonicalForm kno:KN2023-0175-form ;
    ontolex:sense kno:KN2023-0175-sense .

kno:KN2023-0175-att-nn a frac:Attestation ;
    dcterms:date "2022-12-04"^^xsd:date ;
    frac:locus <https://m.sports.naver.com/article/018/0005380161> .

kno:KN2023-0175-form a ontolex:Form ;
    frac:frequency kno:KN2023-0175-freq-nn,
        kno:KN2023-0175-freq-yt ;
    ontolex:writtenRep "알빠임"@ko .

kno:KN2023-0175-freq-nn a frac:CorpusFrequency ;
    rdf:value 65 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0175-freq-yt a frac:CorpusFrequency ;
    rdf:value 3319 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0175-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%95%8C%EB%B9%A0%EC%9E%84%3F> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

