kno:KN2022-0226 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "와이노믹스"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%99%80%EC%9D%B4%EB%85%B8%EB%AF%B9%EC%8A%A4> ;
    skos:definition "윤석열 대통령이 시행한 경제 정책. 민간이 주도하고 정부가 뒷받침하는 경제 성장 정책으로, 윤석열 대통령의 이니셜 와이(Y)에 경제를 의미하는 ‘이코노믹스(economics)’를 결합하여 만든 말이다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2022-0226-c1 ;
    kno:component kno:KN2022-0226-c2 ;
    kno:componentString "와이(Y), (이코)노믹스(economics)"@ko ;
    kno:example "¶당선인의 이니셜을 딴 ‘{와이노믹스’의} 핵심은 민간이 주도하고 정부가 뒷받침하는 경제 성장이다."@ko ;
