# KN2013-0333 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0333 a ontolex:Word ;
    kno:example "¶이렇게 갑에 둘러싸여 사는 우리나라, 참 갑갑해요.…차라리 {을을하다} 말하는 게 낫겠네요."@ko ;
    kno:instantiates kno:S000034 ;
    kno:pos "「형」"@ko ;
    skos:definition "일이 뜻대로 되지 않아 답답하다. ‘갑갑하다’에서 ‘갑’ 대신 갑을 관계 중 상대적으로 불리한 위치에 있는 ‘을’을 사용하여 비유적으로 이르는 말이다."@ko ;
    rdfs:label "을을-하다"@ko ;
    kno:origin "(乙乙하다)" ;
    kno:activeYears "0"^^xsd:integer ;
