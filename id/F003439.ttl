# F003439 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003439 kno:urimalTargetCode "1084969" ;
    kno:surfaceForm "메이크"@ko ;
    kno:origin "make" ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1084969> ;
    kno:urimalDefinition "하나의 소프트웨어를 여러 부분으로 나누어 개발할 때 각 부분들 사이에 존재하는 의존성 관계를 이용하여, 소프트웨어의 일부가 수정되더라도 모든 부분을 다시 컴파일하는 것이 아니라 필요한 부분만을 다시 컴파일하여 연결해 주는 프로그램. 복잡하고 방대한 프로그램을 개발할 때 편리하다. 〔명사〕"@ko ;
    rdfs:label "메이크(make)"@ko ;
    kno:semanticTag kno:usas-B4 ;
    kno:truncated "false"^^xsd:boolean ;
    kno:fullForm "메이크"@ko ;
    a kno:Formative ;
    kno:caseCount "1"^^xsd:integer .
kno:KN2025-0382-c3 kno:formative kno:F003439 .
