# KN2024-0107 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0107 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "빗살^모공"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B9%97%EC%82%B4%EB%AA%A8%EA%B3%B5> ;
    skos:definition "피부 탄력 저하로 확장된 모공이 세로로 처져 여러 모공이 연결되어 빗살 모양의 주름처럼 보이는 상태. 주로 피부 노화의 징후로 나타난다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2024-0107-c1 ;
    kno:component kno:KN2024-0107-c2 ;
    kno:componentString "빗살, 모공(毛孔)"@ko ;
    kno:example "¶{빗살 모공은} 피부 탄력이 떨어지며 모공이 세로 방향으로 늘어난 뒤 서로 이어져 잔주름처럼 보이는 현상으로, 노화의 초기 신호로 간주된다."@ko ;
