# KN2019-0114 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0114 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "바이토 테러"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1424563> ;
    skos:definition "아르바이트 직원이 자신이 근무하는 매장이나 회사에 해를 입히는 행위. 주로 매장에서 판매하는 음식이나 물건 따위로 장난하는 영상을 누리 소통망에 올려서, 매장 또는 회사가 비난을 받게 되는 경우가 많아지면서 생겨난 말이다. ‘바이토’는 ‘아르바이트’의 일본식 줄임 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2019-0114-c1 ;
    kno:component kno:KN2019-0114-c2 ;
    kno:componentString "(아르)바이토(Arubaito), 테러(terror)"@ko ;
    kno:example "¶유명 초밥 체인점 OO, 편의점 OO도 {바이토 테러를} 당했다."@ko ;
