# KN2017-0063 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0063 kno:unitType "구"@ko ;
    a ontolex:MultiwordExpression ;
    rdfs:label "닉슨 해법"@ko ;
    kno:frequency kno:KN2017-0063-freq-NN-2017 ;
    kno:component kno:KN2017-0063-c2 ;
    kno:componentString "닉슨(Nixon), 해법(解法)"@ko ;
    kno:origin "(Nixon解法)" ;
    kno:languageType "영_한" ;
    skos:definition "탄핵 이전에 대통령ㆍ국무 위원ㆍ법관 등이 스스로 관직이나 정계에서 물러나는 방식으로 사태를 해결하는 방법을 이르는 말. 1972년 워터게이트 사건으로 인해 탄핵 위기에 몰린 미국의 닉슨 대통령이, 스스로 대통령직에서 물러나는 조건으로 미국 의회가 탄핵을 추진하지 않는다는 합의를 도출한 데서 나온 말이다."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8B%89%EC%8A%A8%20%ED%95%B4%EB%B2%95> ;
    kno:indexForm "닉슨해법"@ko ;
    kno:example "¶여야와 청와대가 O 대통령에 대한 사법적 처리를 면제하는 것을 조건으로 자진 하야를 합의하자는 것으로, 미국 OOO 대통령의 ‘워터게이트 사건’ 때의 ‘{닉슨 해법’과} 유사한 정치적 해법이다."@ko ;
    kno:lastAttestationYear "2017"^^xsd:gYear ;
    kno:activeYears "1"^^xsd:integer ;
    kno:year "2017"^^xsd:gYear ;
