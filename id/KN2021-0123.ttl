# KN2021-0123 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0123 kno:year "2021"^^xsd:gYear ;
    kno:unitType "단어"@ko ;
    kno:instantiates kno:S000030 ;
    kno:frequency kno:KN2021-0123-freq-NN-2024 ;
    kno:frequency kno:KN2021-0123-freq-NN-2023 ;
    kno:example "¶코로나19의 확산으로 집에 있는 시간이 길어지면서, 파티션과 수납장을 통해 방을 정리하거나 화사한 무늬의 커튼을 치는 등 {방꾸가} 유행하고 있다."@ko ;
    kno:slotFiller "꾸(미다) (1성분)"@ko ;
    rdfs:label "방꾸"@ko ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:slotFiller "방(房) (1성분)"@ko ;
    kno:origin "(房꾸)" ;
    kno:languageType "한+고" ;
    kno:registration "신어DB"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B0%A9%EA%BE%B8> ;
    skos:definition "‘방 꾸미기’를 줄여 이르는 말. 커튼이나 수납장 등 방에 필요한 제품을 새로 배치하거나 장식하는 것을 통해 방 안을 꾸미는 행위를 이르는 말이다. 코로나19로 인해 외부 활동을 하기 어려워진 상황에서 생겨난 말이다."@ko ;
    kno:pos "「명」"@ko ;
    kno:component kno:KN2021-0123-c2 ;
