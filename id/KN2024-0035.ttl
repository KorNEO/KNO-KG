    a kno:Neologism ;
    rdfs:label "내세가불"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%82%B4%EC%84%B8%EA%B0%80%EB%B6%88> ;
    skos:definition "‘내가 세상에서 가장 불쌍하다’를 줄여 이르는 말로, 자신의 처지를 자조적으로 이르는 표현이다."@ko ;
