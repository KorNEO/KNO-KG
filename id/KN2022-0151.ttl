    kno:languageType "한^영" ;
    kno:example "¶일부 전문가들은 방역 패스의 시행이 코로나19와 관련된 경각심을 낮추어, 방역 패스가 오히려 {방심 패스가} 될 수도 있다고 지적하였다."@ko ;
    kno:registration "신어DB"@ko ;
    rdfs:label "방심^패스"@ko ;
