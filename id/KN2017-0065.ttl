    rdfs:label "당떨시"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8B%B9%EB%96%A8%EC%8B%9C> ;
    skos:definition "‘당이 떨어지는 시간’을 줄여 이르는 말. 주로 오후에 가지는 간식 시간을 이르는 말이다."@ko ;
