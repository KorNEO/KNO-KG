    kno:surfaceForm "이"@ko ;
    kno:urimalDefinition "우리나라 성(姓)의 하나. 본관은 전주(全州), 경주(慶州), 성주(星州), 광주(廣州), 연안(延安), 한산(韓山), 전의(全義), 덕수(德水), 수안(遂安) 등 240여 본이 현존한다. 〔명사〕"@ko ;
    kno:urimalTargetCode "505195" ;
    rdfs:label "이(李)"@ko ;
    kno:registration "우리말샘"@ko ;
