@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0675 a ontolex:Word ;
    frac:attestation kno:KN2025-0675-att-nn ;
    ontolex:canonicalForm kno:KN2025-0675-form ;
    ontolex:sense kno:KN2025-0675-sense .

kno:KN2025-0675-att-nn a frac:Attestation ;
    dcterms:date "2025-06-16"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/144/0001046641> .

kno:KN2025-0675-form a ontolex:Form ;
    frac:frequency kno:KN2025-0675-freq-nn,
        kno:KN2025-0675-freq-yt ;
    ontolex:writtenRep "허얇엉큰"@ko .

kno:KN2025-0675-freq-nn a frac:CorpusFrequency ;
    rdf:value 12 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0675-freq-yt a frac:CorpusFrequency ;
    rdf:value 32 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0675-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%97%88%EC%96%87%EC%97%89%ED%81%B0> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

