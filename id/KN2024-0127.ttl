# KN2024-0127 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0127 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "선원^구하라법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%84%A0%EC%9B%90%EA%B5%AC%ED%95%98%EB%9D%BC%EB%B2%95> ;
    skos:definition "선원이 조업 중에 사망하여 장례를 치르는 경우, 실제로 장례를 치른 유족에게 장례비를 지급하도록 규정한 법률. 정식 명칭은 ‘선원법ㆍ어선원 및 어선 재해 보상 보험법’이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2024-0127-c1 ;
    kno:component kno:KN2024-0127-c2 ;
    kno:component kno:KN2024-0127-c3 ;
    kno:componentString "선원(船員), 구하라, 법(法)"@ko ;
    kno:example "¶{선원 구하라법이} 통과되면 선원뿐만 아니라 모든 분야에서 어린 자녀를 버리고 도망갔다가 그 자녀의 사망 후에 갑자기 등장하여 보험금 및 합의금, 재산 등을 모두 가져가는 비인간적인 행위들이 줄어들 것이라고 기대하고 있다."@ko ;
    kno:frequency kno:KN2024-0127-freq-NN-2023 ;
