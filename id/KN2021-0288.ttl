# KN2021-0288 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0288 a ontolex:Word ;
    kno:example "¶최근 에스엔에스(SNS)에서는 인플레이션이 인기 주제로 떠올랐고, 이에 따라 사람들에게 금융 관련 조언을 해 주는 {핀플루언서들이} 급부상하였다."@ko ;
    kno:predicate "미치다"@ko ;
    kno:slotFiller "핀(←finance) (1성분)"@ko ;
    rdfs:label "핀플루언서"@ko ;
    kno:formation kno:W07 ;
    kno:urimalTargetCode "1656711" ;
    kno:unitType "단어"@ko ;
    kno:frequency kno:KN2021-0288-freq-NN-2022 ;
