# F003320 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003320 kno:origin "litmus" ;
    kno:truncated "false"^^xsd:boolean ;
    kno:surfaceForm "리트머스"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "리트머스"@ko ;
    kno:urimalTargetCode "143345" ;
    kno:urimalDefinition "리트머스이끼 따위의 이끼 종류의 식물에서 짜낸 자줏빛 색소. 염기를 만나면 푸른색이 되고, 산을 만나면 붉은색이 되므로, 수용액의 산성 또는 염기성을 검사하는 지시약으로 쓰인다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-Y1 ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=143345> ;
    rdfs:label "리트머스(litmus)"@ko ;
    kno:caseCount "1"^^xsd:integer .
