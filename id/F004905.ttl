# F004905 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004905 kno:origin "yama" ;
    rdfs:label "야마(yama)"@ko ;
    kno:urimalDefinition "인도 신화에 나오는 죽은 자들의 신. 저승 세계에 들어오는 자들을 심판하며, 근친상간의 욕망을 억압하기 위해 불사의 존재가 되었다. ⇒규범 표기는 미확정이다. 〔명사〕"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "1314290" ;
    kno:semanticTag kno:usas-E3m ;
    a kno:Formative ;
    kno:surfaceForm "야마"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "야마"@ko ;
