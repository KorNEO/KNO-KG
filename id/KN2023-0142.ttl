    kno:registration "신어DB"@ko ;
    kno:pos "「명」"@ko ;
    kno:componentString "숄(츠)(Scholz), -칭(←-ing)"@ko ;
    a kno:Neologism ;
    kno:example "¶숄츠 독일 총리가 우크라이나에 대한 레오파드 전차 지원을 주저하며 빠른 결정을 내리지 못하자 사람들은 ‘{숄칭(Scholzing)’이라는} 말을 만들어 그의 행동을 비꼬기 시작했다."@ko ;
    kno:indexForm "숄칭"@ko ;
    kno:year "2023"^^xsd:gYear ;
