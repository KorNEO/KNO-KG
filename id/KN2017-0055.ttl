kno:KN2017-0055 kno:year "2017"^^xsd:gYear ;
    kno:unitType "구"@ko ;
    kno:pos "「구」"@ko ;
    kno:example "¶OO당의 선전은 지난 대선에서 {노마드 보수를} 이끌었던 OOㆍOO의 높은 지지 때문이다."@ko ;
    a kno:Neologism ;
    kno:instantiates kno:S000385 ;
    skos:definition "정치적으로 특정 후보를 일정하게 지지하지 않고 여러 후보에 대해 지지를 옮겨 다니는 보수층을 이르는 말. ⇒규범 표기는 미확정이다."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380365> ;
