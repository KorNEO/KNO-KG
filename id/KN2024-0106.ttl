    kno:slotFiller "빗(썸)(Bithumb) (1성분)"@ko ;
    rdfs:label "빗무원"@ko ;
    kno:indexForm "빗무원"@ko ;
    kno:instantiates kno:S000671 ;
    kno:origin "(←Bithumb務員)" ;
    kno:activeYears "1"^^xsd:integer ;
