# KN2024-0106 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0106 a kno:Neologism ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:languageType "영+한" ;
    kno:componentString "빗(썸)(Bithumb), (공)무원(公務員)"@ko ;
    kno:frequency kno:KN2024-0106-freq-NN-2024 ;
    kno:example "¶암호 화폐 커뮤니티에서는 매일 출석 체크만으로 혜택을 받는 정책을 두고 {빗무원이라는} 조롱과 함께, 사용자의 무분별한 참여 유도로 이어진다는 비판도 제기되고 있다."@ko ;
    kno:frequency kno:KN2024-0106-freq-NN-total ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B9%97%EB%AC%B4%EC%9B%90> ;
