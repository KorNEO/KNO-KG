    kno:frequency kno:KN2013-0409-freq-NN-2021 ;
    skos:definition "자신의 피부색보다 지나치게 밝은 색의 화장품을 선호하는 증상."@ko ;
    kno:slotFiller "쿨톤(cool tone) (1성분)"@ko ;
