    kno:lastAttestationYear "2020"^^xsd:gYear ;
    kno:formation kno:W05 ;
    kno:indexForm "뽕디엠"@ko ;
    kno:componentString "뽕(짝), (이)디엠(EDM)"@ko ;
    kno:component kno:KN2018-0164-c2 ;
    kno:example "¶소속사 관계자는 “지난 앨범 ‘OO’에서 트로트와 이디엠(EDM)을 믹스 매치한 일명 ‘{뽕디엠’을} 선보였던 OOO은…공백기 동안 성숙해진 그만의 아티스트적 면모까지 제대로 보여 줄 예정이다.”라고 전했다."@ko ;
    kno:languageType "고+영" ;
    a ontolex:Word ;
    kno:origin "(뽕<영>←EDM)" .
