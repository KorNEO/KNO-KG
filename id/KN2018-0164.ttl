# KN2018-0164 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0164 kno:frequency kno:KN2018-0164-freq-NN-2020 ;
    skos:definition "트로트와 이디엠을 혼합한 음악 장르. 트로트를 속되게 이르는 말인 ‘뽕짝’과 일렉트로닉 댄스 뮤직(electronic dance music)을 뜻하는 ‘이디엠(EDM)’을 결합하여 만든 말이다."@ko ;
    kno:unitType "단어"@ko ;
    kno:year "2018"^^xsd:gYear ;
    a kno:Neologism ;
    rdfs:label "뽕디엠"@ko ;
    kno:frequency kno:KN2018-0164-freq-NN-2017 ;
    kno:frequency kno:KN2018-0164-freq-NN-2018 ;
