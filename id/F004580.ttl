# F004580 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004580 a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=427093> ;
    kno:urimalDefinition "일정한 길이로 자른 털실을 갈고리 모양의 바늘로 망사에 걸어서 수를 놓는 자수. 방석, 벽걸이 따위를 만드는 데 쓴다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-X9.1p ;
    rdfs:label "스킬(skill)"@ko ;
    kno:urimalTargetCode "427093" ;
    kno:origin "skill" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "스킬"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:surfaceForm "스킬"@ko .
