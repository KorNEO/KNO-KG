@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0230 a ontolex:Word ;
    frac:attestation kno:KN2022-0230-att-nn ;
    ontolex:canonicalForm kno:KN2022-0230-form ;
    ontolex:sense kno:KN2022-0230-sense .

kno:KN2022-0230-att-nn a frac:Attestation ;
    dcterms:date "2021-12-07"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/213/0001201554> .

kno:KN2022-0230-form a ontolex:Form ;
    frac:frequency kno:KN2022-0230-freq-nn,
        kno:KN2022-0230-freq-yt ;
    ontolex:writtenRep "웃-수저"@ko .

kno:KN2022-0230-freq-nn a frac:CorpusFrequency ;
    rdf:value 1375 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0230-freq-yt a frac:CorpusFrequency ;
    rdf:value 9273 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0230-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%88%98%EC%A0%80%EA%B3%84%EA%B8%89%EB%A1%A0> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

