# F000267 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000267 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=8795> ;
    a kno:Formative ;
    rdfs:label "문화(文化)"@ko ;
    kno:urimalDefinition "자연 상태에서 벗어나 일정한 목적 또는 생활 이상을 실현하고자 사회 구성원에 의하여 습득, 공유, 전달되는 행동 양식이나 생활 양식의 과정 및 그 과정에서 이룩하여 낸 물질적·정신적 소득을 통틀어 이르는 말. 의식주를 비롯하여 언어, 풍습, 종교, 학문, 예술, 제도 따위를 모두 포함한다. 〔명사〕"@ko ;
    kno:urimalTargetCode "8795" ;
    kno:semanticTag kno:usas-S1.1.1 ;
    kno:surfaceForm "문화"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:origin "文化" ;
    kno:caseCount "6"^^xsd:integer ;
    kno:truncated "false"^^xsd:boolean ;
    kno:fullForm "문화"@ko .
