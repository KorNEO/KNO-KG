kno:KN2022-0256 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "지역^산업^위기^대응법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A7%80%EC%97%AD%EC%82%B0%EC%97%85%EC%9C%84%EA%B8%B0%EB%8C%80%EC%9D%91%EB%B2%95> ;
    skos:definition "산업 위기 대응 특별 지역 제도를 확대 및 개편한 법. 산업 위기 예방 조치, 산업 위기 선제 대응, 지역 경제 연착륙 지원 등의 산업 위기 단계별 대응 수단과 그에 따른 지원 수단을 규정하고 있다."@ko ;
