# F002534 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002534 kno:origin "極樂鳥" ;
    kno:urimalDefinition "참새목 풍조과의 새를 통틀어 이르는 말. 부리와 꽁지가 길며, 수컷은 몸의 빛깔이 화려하고 여러 가지 동작으로 구애의 춤을 춘다. 40여 종이 뉴기니에 분포한다. 〔명사〕"@ko ;
    rdfs:label "극락조(極樂鳥)"@ko ;
    a kno:Formative ;
    kno:urimalTargetCode "415303" ;
    kno:registration "우리말샘"@ko ;
    kno:surfaceForm "극락조"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=415303> ;
    kno:semanticTag kno:usas-L2 ;
    kno:fullForm "극락조"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:truncated "false"^^xsd:boolean .
