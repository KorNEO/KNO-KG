# KN2017-0351 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0351 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "호모 체어쿠스"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380641> ;
    skos:definition "오랜 시간 동안 의자에 앉아서 생활하는 인간을 비유적으로 이르는 말. 주로 장시간 동안 앉아서 업무를 보는 직장인을 가리킨다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2017-0351-c1 ;
    kno:component kno:KN2017-0351-c2 ;
    kno:component kno:KN2017-0351-c3 ;
    kno:componentString "호모(homo), 체어(chair), (피테)쿠스(pithecus)"@ko ;
    kno:example "¶이번에 선보인 신규 티브이 광고 캠페인은 ‘{호모 체어쿠스’라는} 참신한 콘셉트를 활용했다."@ko ;
