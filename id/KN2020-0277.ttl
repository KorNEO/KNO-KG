# KN2020-0277 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0277 kno:origin "(自家隔離<영>app)" ;
    kno:pos "「구」"@ko ;
    skos:definition "해외에서 입국한 후 자가 격리 중인 사람들을 보호하고 관리하여 감염병의 확산을 방지하기 위해서 정부에서 만든 애플리케이션. 사용자에게 자가 격리 생활 수칙, 감염병 증상에 대한 자가 진단, 전담 공무원의 비상 연락망 등의 정보를 제공한다. 코로나19의 확산을 방지하기 위해 사용되기 시작했다."@ko ;
    a kno:Neologism ;
    kno:year "2020"^^xsd:gYear ;
    kno:component kno:KN2020-0277-c3 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9E%90%EA%B0%80%20%EA%B2%A9%EB%A6%AC%20%EC%95%B1> ;
    kno:indexForm "자가격리앱"@ko ;
    kno:slotFiller "자가(自家)+격리(隔離) (2성분)"@ko ;
    a ontolex:MultiwordExpression ;
    kno:registration "신어DB"@ko ;
    kno:unitType "구"@ko ;
    kno:instantiates kno:S000172 ;
    kno:lastAttestationYear "2022"^^xsd:gYear ;
    rdfs:label "자가 격리 앱"@ko ;
    kno:slotFiller "앱(app) (1성분)"@ko ;
    kno:componentString "자가(自家), 격리(隔離), 앱(app)"@ko ;
    kno:component kno:KN2020-0277-c1 ;
    kno:frequency kno:KN2020-0277-freq-NN-total ;
    kno:example "¶{자가 격리 앱은} 사용자가 매일 자가 진단을 한 결과를 전담 공무원에게 전달하고 사용자가 지정된 위치를 벗어나면 경보음을 울려 사용자와 전담 공무원에게 알려 준다."@ko ;
