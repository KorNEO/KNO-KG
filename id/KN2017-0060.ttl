# KN2017-0060 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0060 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "뉴^노멀^중년"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380370> ;
    skos:definition "젊은 세대와 비슷한 삶의 방식과 취미 활동을 추구하는 중년. 주로 자기 관리나 자기 계발을 하는 데에 돈을 아끼지 않는 중년 세대를 의미한다."@ko ;
    kno:activeYears "8"^^xsd:integer ;
    kno:component kno:KN2017-0060-c1 ;
    kno:component kno:KN2017-0060-c2 ;
    kno:component kno:KN2017-0060-c3 ;
    kno:componentString "뉴(new), 노멀(normal), 중년(中年)"@ko ;
    kno:example "¶이른바 젊은 세대와 취미 생활을 공유하는 40, 50대를 일컫는 ‘{뉴 노멀 중년’들이} 증가하고 있다. 이들은 온라인 쇼핑을 즐기며 피부, 미용 등에 적극적인 관심을 가지고 있어 새로운 소비군으로 부상하고 있다."@ko ;
    kno:frequency kno:KN2017-0060-freq-NN-2016 ;
    kno:frequency kno:KN2017-0060-freq-NN-2017 ;
    kno:frequency kno:KN2017-0060-freq-NN-2018 ;
    kno:frequency kno:KN2017-0060-freq-NN-2019 ;
    kno:frequency kno:KN2017-0060-freq-NN-2020 ;
    kno:frequency kno:KN2017-0060-freq-NN-2022 ;
    kno:frequency kno:KN2017-0060-freq-NN-2023 ;
    kno:frequency kno:KN2017-0060-freq-NN-2025 ;
    kno:frequency kno:KN2017-0060-freq-NN-total ;
    kno:indexForm "뉴노멀중년"@ko ;
    kno:instantiates kno:S000971 ;
    kno:instantiates kno:S001222 ;
    kno:languageType "영^영^한" ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:origin "(<영>new normal中年)" ;
    kno:pos "「구」"@ko ;
    kno:predicate "추구하다"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:slotFiller "뉴(new)+노멀(normal) (2성분)"@ko ;
    kno:slotFiller "중년(中年) (1성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:urimalTargetCode "1380370" ;
