# KN2024-0190 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0190 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "영프스이"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%98%81%ED%94%84%EC%8A%A4%EC%9D%B4> ;
    skos:definition "유럽의 여행지로 인기를 끌고 있는 서유럽 4개국을 이르는 말. 영국, 프랑스, 스위스, 이탈리아의 앞 글자를 따서 만든 말이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
