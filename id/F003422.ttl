# F003422 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003422 kno:urimalDefinition "케이블을 앞의 맨 위 또는 맨 아래에 있는 잭에 ‘Y’ 자 모양으로 연결시키거나 신호를 분할시키는 방법. 신호는 맨 위 뒷부분에서 맨 아래 뒷부분에 있는 패치 베이 잭으로 계속 이동한다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-N5p ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:surfaceForm "멀"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    kno:parallelFullForm kno:LEX-멀티 ;
