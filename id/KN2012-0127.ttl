    kno:pos "「명」"@ko ;
    kno:year "2012"^^xsd:gYear ;
    kno:urimalTargetCode "1388252" ;
    skos:definition "‘모태 솔로’를 줄여 이르는 말. 이성 친구를 한 번도 사귀어 본 적이 없는 사람을 놀림조로 이르는 말이다."@ko ;
    a ontolex:Word ;
    kno:componentString "모(태)(母), 솔(로)(solo)"@ko ;
    kno:indexForm "모솔"@ko ;
    kno:unitType "단어"@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:formation kno:W06 ;
    a kno:Neologism ;
    kno:origin "(母←solo)" ;
    rdfs:label "모솔"@ko ;
    kno:component kno:KN2012-0127-c1 ;
    kno:slotFiller "모(태)(母) (1성분)"@ko ;
    kno:languageType "한+영" ;
    kno:example "¶OOO 모태 솔로 고백에 누리꾼들은 “애교 많은 OOO는 남자친구에게도 만점 여자친구일 듯.”, “OOO {모솔} 하루 빨리 탈출 하길.” 등 다양한 반응을 보였다."@ko ;
