# F004559 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004559 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1369932> ;
    kno:surfaceForm "스밍"@ko ;
    a kno:Formative ;
    kno:urimalDefinition "음악 파일이나 동영상 파일을 스마트폰 따위의 휴대용 단말기나 컴퓨터에 내려받거나 저장하여 재생하지 않고, 인터넷에 연결된 상태에서 실시간으로 재생하는 일. 또는 그런 재생 기술이나 기법. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "스밍"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:label "스밍(←streaming)"@ko ;
    kno:semanticTag kno:usas-Y2 ;
    kno:urimalTargetCode "1369932" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:origin "streaming" .
