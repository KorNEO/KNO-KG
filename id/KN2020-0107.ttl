# KN2020-0107 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0107 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "마스크 없무새"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A7%88%EC%8A%A4%ED%81%AC%20%EC%97%86%EB%AC%B4%EC%83%88> ;
    skos:definition "“마스크 없어요.”라는 말을 앵무새처럼 반복하는 약사를 이르는 말. 코로나19의 확산으로 보건 마스크의 구입이 어렵던 시기에, 공적 마스크 판매를 맡은 약사가 마스크가 부족해서 손님에게 “마스크 없어요.”라는 말을 계속 반복했다는 데에서 비롯되었다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2020-0107-c1 ;
    kno:component kno:KN2020-0107-c2 ;
    kno:componentString "마스크(mask), 없무새"@ko ;
    kno:example "¶시민들의 잦은 마스크 문의에 {마스크 없무새가} 되었다며 약사들의 자조 섞인 목소리가 나오고 있다."@ko ;
