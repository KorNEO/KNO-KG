# F001531 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001531 rdfs:label "스트림(stream)"@ko ;
    kno:urimalDefinition "동영상을 보고 음악을 들을 수 있도록 지속적으로 적은 양의 데이터를 사용자에게 전달하는 기술. 소규모의 컴퓨터 군에서 인터넷에 이르기까지 다양하게 사용되고 있다. 〔명사〕"@ko ;
    a kno:Formative ;
    kno:fullForm "스트림"@ko ;
    kno:semanticTag kno:usas-Y2 ;
    kno:surfaceForm "스트림"@ko ;
    kno:caseCount "2"^^xsd:integer ;
    kno:semanticTag kno:usas-Q4.3 ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1010750> ;
