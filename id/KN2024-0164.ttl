# KN2024-0164 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0164 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "알리깡"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%95%8C%EB%A6%AC%EA%B9%A1> ;
    skos:definition "해외 직구 전자 상거래 플랫폼인 ‘알리익스프레스(AliExpress)’에서 물건을 대량으로 구매한 뒤 이를 개봉하는 영상 콘텐츠. 또는 그러한 영상 콘텐츠를 업로드하는 행위. 구독자 수와 클릭 수를 쉽게 늘려 곧바로 수익을 얻는 현상을 ‘카드깡’에 빗대어 이르는 말이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2024-0164-c1 ;
    kno:component kno:KN2024-0164-c2 ;
    kno:componentString "알리(익스프레스)(AliExpress), 깡"@ko ;
    kno:example "¶그는 구매자들이 직접 사용해 보고 검증한 상품의 정보를 얻기 위해서 출퇴근길에 종종 {알리깡을} 챙겨 본다."@ko ;
