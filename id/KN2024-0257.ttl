    dcterms:date "2023-08-03"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/656/0000059163> .

kno:KN2024-0257-form a ontolex:Form ;
    frac:frequency kno:KN2024-0257-freq-nn,
        kno:KN2024-0257-freq-yt ;
    ontolex:writtenRep "전세^사기^피해자법"@ko .

