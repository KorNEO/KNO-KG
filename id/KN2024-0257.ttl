kno:KN2024-0257 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2024-0257-att-nn ;
    ontolex:canonicalForm kno:KN2024-0257-form ;
    ontolex:sense kno:KN2024-0257-sense .

