    rdf:value 846 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0257-freq-yt a frac:CorpusFrequency ;
    rdf:value 3 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0257-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%A0%84%EC%84%B8%EC%82%AC%EA%B8%B0%ED%94%BC%ED%95%B4%EC%9E%90%20%EC%A7%80%EC%9B%90%20%EB%B0%8F%20%EC%A3%BC%EA%B1%B0%EC%95%88%EC%A0%95%EC%97%90%20%EA%B4%80%ED%95%9C%20%ED%8A%B9%EB%B3%84%EB%B2%95> .

