# KN2017-0240 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0240 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "장미 대선"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1374477> ;
    skos:definition "장미가 많이 피는 시기에 실시되는 대통령 선거를 이르는 말. 한국 사회에서 2016년 탄핵으로 인해 대통령 자리가 공석이 되자 원래 2017년 12월에 실시될 예정이었던 대통령 선거가 5월로 앞당겨져 실시되면서 만들어진 말이다."@ko ;
    kno:activeYears "9"^^xsd:integer ;
    kno:component kno:KN2017-0240-c1 ;
    kno:component kno:KN2017-0240-c2 ;
    kno:componentString "장미(薔薇), 대선(大選)"@ko ;
    kno:example "¶지난 10일 헌법 재판소가 OOO 전 대통령에 대한 파면 선고를 하면서 5월 ‘{장미 대선’은} 현실화됐다."@ko ;
