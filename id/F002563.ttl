# F002563 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002563 kno:surfaceForm "금안"@ko ;
    kno:urimalDefinition "전라남도 나주시 노안면에 있는 이. 노안면의 남서부에 위치해 있으며, 대부분 평지와 구릉지이다. 남쪽에 금성산이 걸쳐 있으며, 중남부에 금성산 생태 숲이 있다. 북동쪽에 노안천이 흐른다. 북동쪽 경계를 따라 822번 지방도가 지나며, 국가유산으로 나주 쌍계정(羅州雙溪亭), 나주 경렬사(羅州景烈祠) 등이 있다. 〔명사〕"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:truncated "false"^^xsd:boolean ;
    kno:semanticTag kno:usas-I1 ;
    kno:origin "金安" ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "금안"@ko ;
    a kno:Formative ;
    kno:urimalTargetCode "1480911" ;
    rdfs:label "금안(金安)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1480911> .
kno:KN2023-0043-c1 kno:formative kno:F002563 .
