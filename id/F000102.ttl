# F000102 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000102 kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1379205> ;
    kno:fullForm "인싸"@ko ;
    kno:urimalDefinition "‘인사이더’라는 뜻으로, 각종 행사나 모임에 적극적으로 참여하면서 사람들과 잘 어울려 지내는 사람을 이르는 말. ‘인사이더’를 세게 발음하면서 다소 변형한 형태로 표기한 것이다. 〔명사〕"@ko ;
    kno:surfaceForm "인싸"@ko ;
    rdfs:label "인싸(←insider)"@ko ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-S5 ;
    kno:origin "insider" ;
    kno:urimalTargetCode "1379205" ;
    kno:caseCount "11"^^xsd:integer .
