# F001614 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001614 kno:caseCount "2"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "필기도구의 하나. 흑연과 점토의 혼합물을 구워 만든 가느다란 심을 속에 넣고, 겉은 나무로 둘러싸서 만든다. 1565년에 영국에서 처음으로 만들었다. 〔명사〕"@ko ;
    kno:origin "鉛筆" ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=232661> ;
    kno:fullForm "연필"@ko ;
    kno:surfaceForm "연필"@ko ;
    kno:semanticTag kno:usas-Q1.2 ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:label "연필(鉛筆)"@ko ;
    kno:urimalTargetCode "232661" .
