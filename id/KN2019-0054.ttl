# KN2019-0054 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0054 kno:languageType "고+한" ;
    kno:component kno:KN2019-0054-c2 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8C%88%EC%9E%85> ;
    kno:indexForm "댈입"@ko ;
    kno:unitType "단어"@ko ;
    kno:origin "(댈入)" ;
    skos:definition "‘대리 입금’을 줄여 이르는 말로, 돈이 필요한 사람에게 돈을 빌려주고 고액의 이자를 받는 일. 주로 누리 소통망 서비스(SNS)에서 청소년 등에게 적은 돈을 빌려주고 큰 이자를 챙기는 일이 많아 사회적 문제가 되고 있다."@ko ;
    kno:formation kno:W06 ;
    kno:example "¶급전이 필요한 이들이 {댈입을} 신청하면 요청한 계좌로 돈을 입금한다."@ko ;
