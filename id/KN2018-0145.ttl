kno:KN2018-0145 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "베드케이션"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416212> ;
    skos:definition "밖에 나가지 않고 침대 위에서 휴가를 즐기는 일."@ko ;
