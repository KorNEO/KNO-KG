# KN2017-0319 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0319 kno:year "2017"^^xsd:gYear ;
    kno:componentString "프랑켄슈타인(Frankenstein), 바이러스(virus)"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:frequency kno:KN2017-0319-freq-NN-2017 ;
    kno:slotFiller "프랑켄슈타인(Frankenstein) (1성분)"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    rdfs:label "프랑켄슈타인^바이러스"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380580> ;
    kno:urimalTargetCode "1380580" ;
    kno:predicate "있다"@ko ;
    kno:example "¶지구상에 있는 모든 생물은 세포막을 갖고 있는 ‘진핵생물’과 세포막이 없는 ‘원핵생물’ 그리고 ‘바이러스’로 나뉜다. 과학계에서는 이를 ‘생명의 영역’이라고 부르는데 {프랑켄슈타인 바이러스는} 이와 별도인 제4의 생명일 가능성이 높다."@ko ;
    skos:definition "생물이 아니지만 생물과 비슷한 특성을 가지고 있는 바이러스. 무생물의 바이러스가 생물과 유사한 기능을 갖게 된 것이, 소설 속 프랑켄슈타인 박사가 생물이 아닌 것에 생명을 불어 넣은 것과 비슷한 데에서 유래한 말이다."@ko ;
