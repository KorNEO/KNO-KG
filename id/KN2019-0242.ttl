    a kno:Neologism ;
    kno:unitType "단어"@ko ;
    kno:origin "(尊<영>←mode)" ;
    kno:example "¶OOO은…퀴즈에서 {‘존모’에} 대한 답을 비속어와 함께 당당하게 외쳤고, OOO은 자신이 외치려 했던 답이라며 아쉬워하는 모습을 보였다."@ko ;
    kno:pos "「명」"@ko ;
