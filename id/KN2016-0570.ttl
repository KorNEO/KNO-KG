# KN2016-0570 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0570 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "한완얼"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%95%9C%EC%99%84%EC%96%BC> ;
    skos:definition "‘한복을 완성하는 것은 얼굴’을 줄여 이르는 말. 얼굴이 잘생기거나 예쁘면 어떤 한복 모양도 잘 어울림을 뜻한다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
