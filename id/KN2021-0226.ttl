# KN2021-0226 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0226 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "전^국민^재난^지원^패키지"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A0%84%EA%B5%AD%EB%AF%BC%EC%9E%AC%EB%82%9C%EC%A7%80%EC%9B%90%ED%8C%A8%ED%82%A4%EC%A7%80> ;
    skos:definition "전국적인 재난 사태로 인해 침체된 경기를 부양하기 위해 도입한 ‘재난 지원금ㆍ상생 소비 지원금ㆍ소상공인 손실 지원금’의 세 가지 정책을 이르는 말. 코로나19의 대유행으로 인한 경제적 위기 상황을 극복하기 위한 방안으로, 전 국민이 세 가지 가운데 적어도 한 가지는 지원받을 수 있다는 의미로 나온 말이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2021-0226-c1 ;
    kno:component kno:KN2021-0226-c2 ;
    kno:component kno:KN2021-0226-c3 ;
    kno:component kno:KN2021-0226-c4 ;
    kno:component kno:KN2021-0226-c5 ;
    kno:componentString "전(全), 국민(國民), 재난(災難), 지원(支援), 패키지(package)"@ko ;
    kno:example "¶{전 국민 재난 지원 패키지는} 내수 경기를 활성화하기 위한 종합 대책으로, 코로나19로 인해 피해를 입은 중소기업과 소상공인을 위한 손실 보상 피해 지원, 가계의 어려움을 돕기 위한 현금 직접 지원, 그리고 국민들의 소비를 촉진하기 위한 상생 소비 지원을 모두 합친 것이라고 여당 원내 대표가 설명하였다."@ko ;
    kno:frequency kno:KN2021-0226-freq-NN-2021 ;
    kno:frequency kno:KN2021-0226-freq-NN-total ;
    kno:indexForm "전국민재난지원패키지"@ko ;
