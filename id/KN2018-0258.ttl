# KN2018-0258 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0258 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "영츠하이머"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415176> ;
    skos:definition "젊은 나이에도 경험한 일을 기억하지 못하거나 어느 시기 동안의 일을 드문드문 기억하는 기억 장애. 주로 심한 스트레스를 받거나 우울증의 일환으로 나타나는 현상이며 ‘젊은’을 뜻하는 ‘영(young)’과 ‘기억력 장애’를 뜻하는 ‘알츠하이머병(Alzheimer病)’을 결합하여 만든 말이다."@ko ;
    kno:activeYears "8"^^xsd:integer ;
    kno:component kno:KN2018-0258-c1 ;
    kno:componentString "영츠하이머(youngzheimer)"@ko ;
    kno:example "¶스트레스 탓에 청년들이 건망증에 시달립니다. 자조적으로 ‘{영츠하이머’라고} 부르죠."@ko ;
