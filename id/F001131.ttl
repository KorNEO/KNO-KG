# F001131 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001131 kno:surfaceForm "꽃게"@ko ;
    kno:urimalTargetCode "379289" ;
    kno:urimalDefinition "꽃겟과의 하나. 몸은 검은 자주색에 푸른 무늬가 있으며 등딱지는 마름모꼴이다. 집게발이 크고 길며 나머지 발은 모두 넓적하다. 6~7월에 산란하며 식용한다. 얕은 바다의 모래땅에 떼 지어 사는데 낮에는 숨어 있다가 밤에 활동한다. 한국·일본·중국 등지에 분포한다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "꽃게"@ko ;
    a kno:Formative ;
    kno:semanticTag kno:usas-F1 ;
    kno:semanticTag kno:usas-L2 ;
    rdfs:label "꽃게"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=379289> ;
    kno:caseCount "2"^^xsd:integer .
