# KN2019-0293 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0293 a ontolex:Word ;
    kno:component kno:KN2019-0293-c2 ;
    kno:frequency kno:KN2019-0293-freq-NN-2024 ;
    kno:pos "「명」"@ko ;
    kno:year "2019"^^xsd:gYear ;
    kno:indexForm "펀슈머"@ko ;
    skos:definition "재미있는 제품이나 콘텐츠 따위를 선호하는 소비자. 재미를 뜻하는 ‘펀(fun)’과 소비자를 뜻하는 ‘컨슈머(consumer)’를 결합하여 만든 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:component kno:KN2019-0293-c1 ;
    kno:frequency kno:KN2019-0293-freq-NN-2023 ;
    kno:slotFiller "펀(fun) (1성분)"@ko ;
