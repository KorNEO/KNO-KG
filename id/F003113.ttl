# F003113 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003113 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=136377> ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalDefinition "딱총새웃과의 갑각류. 몸은 5cm 정도이며 연한 황색이다. 집게발은 좌우 비대칭이며 연한 황색으로, 큰 집게발을 여닫아 ‘딱딱딱’ 소리를 낸다. 한국, 일본 등지에 분포한다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-L2 ;
    a kno:Formative ;
    kno:truncated "false"^^xsd:boolean ;
    kno:origin "銃" ;
    kno:urimalTargetCode "136377" ;
    kno:fullForm "딱총새우"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:surfaceForm "딱총새우"@ko ;
