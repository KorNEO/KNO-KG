# KN2024-0033 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0033 kno:formation kno:W02 ;
    kno:registration "신어DB"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%82%99%EC%88%98%EA%B3%BC> ;
    kno:frequency kno:KN2024-0033-freq-NN-2025 ;
    skos:definition "산부인과, 흉부외과, 응급 의학과 등의 필수 의료과를 낮잡아 이르는 말. 성적이나 능력 부족으로 상위 인기 의료과의 지원 경쟁에 밀려 ‘낙수되었다’는 의미에서 비롯된 표현으로, 조롱과 자조의 의미를 담고 있다."@ko ;
    kno:languageType "한+한" ;
    kno:year "2024"^^xsd:gYear ;
    kno:unitType "단어"@ko ;
    kno:component kno:KN2024-0033-c2 ;
