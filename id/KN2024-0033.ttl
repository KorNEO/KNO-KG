    kno:origin "(落水科)" ;
    rdfs:label "낙수-과"@ko ;
    kno:component kno:KN2024-0033-c1 ;
    kno:pos "「명」"@ko ;
    kno:example "¶O 회장은 단순히 의과 대학 정원을 늘려 낙수 효과를 기대한다면 필수 의료 종사자에게 {낙수과} 의사라는 자괴감을 줄 것이라는 우려를 표명했다."@ko ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:indexForm "낙수과"@ko ;
