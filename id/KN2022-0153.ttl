# KN2022-0153 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0153 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "배꼽^착륙"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B0%B0%EA%BC%BD%EC%B0%A9%EB%A5%99> ;
    skos:definition "‘동체 착륙’을 달리 이르는 말. 비행기 따위의 착륙 장치가 작동이 안 될 때, 비행기 동체의 중앙 부분을 직접 땅에 대어 착륙하는 것을 배꼽이 땅에 닿는 것에 빗대어 표현한 말이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2022-0153-c1 ;
    kno:component kno:KN2022-0153-c2 ;
    kno:componentString "배꼽, 착륙(着陸)"@ko ;
    kno:example "¶{배꼽 착륙을} 하기 위해서는 마찰열로 인한 화재 발생에 대비하여 공중에서 최대한 연료를 비워야 한다."@ko ;
