# KN2025-0111 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0111 kno:year "2025"^^xsd:gYear ;
    kno:pos "「구」"@ko ;
    skos:definition "(LLM) 내란 혐의를 받는 사람들을 두둔하거나 권익을 과도하게 옹호하는 듯한 태도를 보인다고 여겨지는 기관ㆍ단체를 비판하거나 조롱하여 이르는 말."@ko ;
    kno:languageType "한_한_한" ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2025-0111-c2 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%82%B4%EB%9E%80%EB%B2%94%20%EB%B3%B4%ED%98%B8%20%EC%9C%84%EC%9B%90%ED%9A%8C> ;
