# KN2016-0622 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0622 kno:activeYears "3"^^xsd:integer ;
    kno:year "2016"^^xsd:gYear ;
    kno:unitType "구"@ko ;
    kno:example "¶이처럼 해킹 관련 국민들의 불안이 갈수록 커지고 있지만, 아직 음지에서는 스파이 앱ㆍ{흥신소 앱으로} 불리는 해킹 프로그램들이 활발히 거래 중인 것으로 나타났다."@ko ;
    kno:predicate "하다"@ko ;
    kno:pos "「구」"@ko ;
    kno:indexForm "흥신소앱"@ko ;
    kno:componentString "흥신소(興信所), 앱(app)"@ko ;
    skos:definition "고객의 요청에 따라 대가를 받고 기업이나 개인의 신용, 재산 상태, 개인적인 비행 따위를 몰래 조사하여 알려 주는 일을 하는 앱. 주로 해킹 프로그램을 이용하여 다른 사람의 정보를 빼내는 일을 하는 애플리케이션이다."@ko ;
    rdfs:label "흥신소^앱"@ko ;
