kno:KN2018-0035 kno:indexForm "공공기관채용부정근절법"@ko ;
    kno:unitType "구"@ko ;
    kno:component kno:KN2018-0035-c1 ;
    a ontolex:MultiwordExpression ;
    kno:instantiates kno:S001215 ;
    kno:componentString "공공(公共), 기관(機關), 채용(採用), 부정(不正), 근절(根絕), 법(法)"@ko ;
    kno:registration "우리말샘"@ko ;
