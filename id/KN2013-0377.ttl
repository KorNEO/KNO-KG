# KN2013-0377 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0377 rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B0%BB%EB%82%B4> ;
    skos:definition "차의 냄새라는 뜻으로, 바른말로 훈수 두려는 일을 비유적으로 이르는 말."@ko ;
    rdfs:label "찻-내"@ko ;
    a ontolex:Word ;
