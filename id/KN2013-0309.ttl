kno:KN2013-0309 kno:indexForm "역볼커모멘텀"@ko ;
    kno:frequency kno:KN2013-0309-freq-NN-2024 ;
    skos:definition "중앙은행이 물가 안정을 최우선해야 한다는 폴 볼커(Paul adolph Volcker, 전 미국 중앙은행의장)와는 반대로 물가 안정보다 고용 창출을 해야 한다는 밴 버냉키(Ben Bernanke, 2013년 미국 중앙 은행의장)의 신념."@ko ;
    kno:year "2013"^^xsd:gYear ;
    kno:activeYears "4"^^xsd:integer ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:origin "(逆<영>Volcker momentum)" ;
