# F007015 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F007015 kno:truncated "false"^^xsd:boolean ;
    rdfs:label "핸드(hand)"@ko ;
    kno:urimalDefinition "말의 체고를 측정하는 단위. 1핸드는 4인치(in) 정도이다. 대부분의 국가에서는 미터로 나타내지만, 영국과 미국 일부 지역에서는 핸드를 공식 단위로 사용한다. 〔의존 명사〕"@ko ;
    kno:surfaceForm "핸드"@ko ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1041350> ;
    kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "핸드"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:origin "hand" ;
    kno:semanticTag kno:usas-B1 ;
    kno:urimalTargetCode "1041350" .
