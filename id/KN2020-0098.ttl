# KN2020-0098 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0098 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "랜선 문화"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%9E%9C%EC%84%A0%20%EB%AC%B8%ED%99%94> ;
    skos:definition "현실 공간이 아닌 온라인을 통하여 이루어지는 문화. 코로나19의 확산으로 인해 현실 공간에서 이루어졌던 일, 교육, 사회생활, 문화생활 따위가 온라인상에서 이루어지는 것을 통틀어 이르는 말이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2020-0098-c1 ;
    kno:component kno:KN2020-0098-c2 ;
    kno:componentString "랜선(LAN線), 문화(文化)"@ko ;
    kno:example "¶코로나19의 확산으로 젊은 세대에 온라인 졸업 작품 전시회, 비대면 수업 등 ‘{랜선 문화’가} 일상이 되었다."@ko ;
    kno:frequency kno:KN2020-0098-freq-NN-2020 ;
