# KN2020-0276 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0276 kno:component kno:KN2020-0276-c3 ;
    kno:registration "신어DB"@ko ;
    kno:year "2020"^^xsd:gYear ;
