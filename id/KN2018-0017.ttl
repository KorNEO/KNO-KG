# KN2018-0017 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0017 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "건강^무시^증후군"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1384333> ;
    skos:definition "자신의 건강을 위해 무엇을 해야 하는지 알고 있지만, 이를 실제 행동으로 옮기지 않는 현상."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2018-0017-c1 ;
    kno:component kno:KN2018-0017-c2 ;
    kno:component kno:KN2018-0017-c3 ;
    kno:componentString "건강(健剛), 무시(無視), 증후군(症候群)"@ko ;
    kno:example "¶전문가들은 {건강 무시 증후군} 극복을 위해 획기적인 변신보다는 일상생활에서 실천 가능하고, 계속 지킬 수 있는 건강 계획을 세워 점진적인 변화를 만들어야 한다고 조언한다."@ko ;
    kno:frequency kno:KN2018-0017-freq-NN-2018 ;
    kno:frequency kno:KN2018-0017-freq-NN-total ;
    kno:indexForm "건강무시증후군"@ko ;
    kno:instantiates kno:S000031 ;
    kno:languageType "한^한^한" ;
    kno:lastAttestationYear "2018"^^xsd:gYear ;
