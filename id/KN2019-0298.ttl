# KN2019-0298 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0298 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "폰라니"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8F%B0%EB%9D%BC%EB%8B%88> ;
    skos:definition "길거리에서 스마트폰을 보며 주변을 살피지 않고 걷다가 자동차 따위에 치여 교통사고를 당하는 사람. ‘스마트폰(smart phone)’과 간혹 도로에 뛰어들어 자동차 따위에 치여 목숨을 잃는 야생 동물인 ‘고라니’를 결합하여 만든 말이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2019-0298-c1 ;
    kno:component kno:KN2019-0298-c2 ;
    kno:componentString "(스마트)폰(smart phone), (고)라니"@ko ;
    kno:example "¶특히 스마트폰을 보며 길을 걷는 이른바 ‘스몸비족’으로도 불리는 {‘폰라니’들로} 인한 교통사고가 급증하고 있다."@ko ;
