@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0117 a ontolex:Word ;
    frac:attestation kno:KN2022-0117-att-nn ;
    ontolex:canonicalForm kno:KN2022-0117-form ;
    ontolex:sense kno:KN2022-0117-sense .

kno:KN2022-0117-att-nn a frac:Attestation ;
    dcterms:date "2022-01-09"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/422/0000522572> .

kno:KN2022-0117-form a ontolex:Form ;
    frac:frequency kno:KN2022-0117-freq-nn,
        kno:KN2022-0117-freq-yt ;
    ontolex:writtenRep "델타크론"@ko .

kno:KN2022-0117-freq-nn a frac:CorpusFrequency ;
    rdf:value 1261 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0117-freq-yt a frac:CorpusFrequency ;
    rdf:value 58 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0117-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/SARS-CoV-2/%EB%8D%B8%ED%83%80%ED%81%AC%EB%A1%A0%20%EB%B3%80%EC%9D%B4> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

