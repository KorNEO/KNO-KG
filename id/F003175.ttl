# F003175 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003175 kno:surfaceForm "랜섬"@ko ;
    kno:urimalDefinition "존 크로 랜섬, 미국의 시인·비평가(1888~1974). 케니언 대학의 시학 교수이며 남부의 신시 운동의 대표자로 1939년에 ≪케니언 리뷰(Kenyon Review)≫지를 창간하여 신비평의 유력한 중심인물이 되었으며 공업화된 현대 사회에 대한 비판과 과거 농업 중심이었던 남부 사회를 노래하였다. 시집에는 ≪신에 대한 시≫가 있고, 저서에 ≪세계의 육체≫, ≪신비평≫이 있다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-I1 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=137529> ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "137529" ;
    kno:origin "ransom" ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:label "랜섬(ransom)"@ko ;
    a kno:Formative ;
    kno:fullForm "랜섬"@ko .
kno:KN2018-0101-c1 kno:formative kno:F003175 .
