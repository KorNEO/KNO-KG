    kno:component kno:KN2024-0228-c4 ;
    skos:definition "‘을지 대학교, 평택 대학교, 성공회 대학교, 대진 대학교’를 아울러 이르는 말. 각 학교명의 첫 글자를 조합해 만든 말이다."@ko ;
    kno:origin "(乙平聖大)" ;
    kno:lastAttestationYear "2023"^^xsd:gYear ;
