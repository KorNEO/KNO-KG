@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0303 a ontolex:Word ;
    frac:attestation kno:KN2023-0303-att-nn ;
    ontolex:canonicalForm kno:KN2023-0303-form ;
    ontolex:sense kno:KN2023-0303-sense .

kno:KN2023-0303-att-nn a frac:Attestation ;
    dcterms:date "2023-03-22"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/020/0003486732> .

kno:KN2023-0303-form a ontolex:Form ;
    frac:frequency kno:KN2023-0303-freq-nn,
        kno:KN2023-0303-freq-yt ;
    ontolex:writtenRep "키드코어"@ko .

kno:KN2023-0303-freq-nn a frac:CorpusFrequency ;
    rdf:value 15 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0303-freq-yt a frac:CorpusFrequency ;
    rdf:value 6 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0303-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%82%A4%EB%93%9C%EC%BD%94%EC%96%B4> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

