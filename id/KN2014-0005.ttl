# KN2014-0005 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0005 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "갓수 시대"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1358060> ;
    skos:definition "경제 활동을 하지 않고 부모가 주는 용돈으로 직장인보다 풍족한 생활을 하는 사람이 많은 시대."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2014-0005-c1 ;
    kno:component kno:KN2014-0005-c2 ;
    kno:component kno:KN2014-0005-c3 ;
    kno:componentString "갓(god), (백)수(手), 시대(時代)"@ko ;
    kno:example "¶최선을 다하고 있는 다른 청춘들을 생각해서라도 {갓수 시대를} 밀어내야 한다."@ko ;
    kno:indexForm "갓수시대"@ko ;
    kno:instantiates kno:S000017 ;
    kno:languageType "(영+한)_한" ;
    kno:origin "(<영>god手時代)" ;
    kno:pos "「구」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:slotFiller "갓(god)+(백)수(手) (2성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:urimalTargetCode "1358060" ;
    kno:year "2014"^^xsd:gYear .
kno:KN2014-0005-c1 a kno:Component ;
    rdfs:label "갓(god)"@ko ;
