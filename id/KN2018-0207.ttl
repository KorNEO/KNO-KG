    kno:origin "(<영>smog<프>couture)" ;
    kno:registration "신어DB"@ko ;
    kno:example "¶이를 겨냥해 패션업계에서는 최근 ‘{스모그 쿠튀르}’ 제품들을 출시하고 있다."@ko ;
