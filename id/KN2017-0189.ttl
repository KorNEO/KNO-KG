# KN2017-0189 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0189 kno:languageType "한^영^한" ;
    a kno:Neologism ;
    kno:frequency kno:KN2017-0189-freq-NN-total ;
    skos:definition "애국심을 빌미로 노동력을 착취하고 그에 대한 임금을 제대로 지급하지 않는 일을 근절하는 법안. 병역의 의무를 다하면서도 열악한 대우를 받는 한국 병사들의 임금 문제를 개선하고자 2016년 12월 국회에서 발의된 군인 월급 인상안으로, ‘군인 보수법 개정안’이라고도 한다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    rdfs:label "애국^페이^근절법"@ko ;
    kno:component kno:KN2017-0189-c2 ;
    kno:pos "「구」"@ko ;
    kno:componentString "애국(愛國), 페이(pay), 근절(根絕), 법(法)"@ko ;
    kno:lastAttestationYear "2017"^^xsd:gYear ;
    kno:example "¶O 의원은 “{애국 페이 근절법을} 통해 병사 사기를 진작하고 군 복무의 충실을 기함은 물론 병역 의무 이행에 대해 정당한 대가를 받을 수 있도록 해야 한다.”라고 강조했다."@ko ;
    a ontolex:MultiwordExpression ;
    kno:origin "(愛國<영>pay根絕法)" ;
    kno:year "2017"^^xsd:gYear ;
    kno:frequency kno:KN2017-0189-freq-NN-2016 ;
    kno:instantiates kno:S001443 ;
    kno:slotFiller "페이(pay)+근절(根絕)+법(法) (3성분)"@ko ;
