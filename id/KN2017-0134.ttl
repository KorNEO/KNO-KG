    a kno:Neologism ;
    rdfs:label "비 플러스 프리미엄"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B9%84%20%ED%94%8C%EB%9F%AC%EC%8A%A4%20%ED%94%84%EB%A6%AC%EB%AF%B8%EC%97%84> ;
    skos:definition "최고급은 아니지만 기능과 품질이 뛰어나면서 합리적인 가격을 지녀 특별한 가치를 더한 제품을 이르는 말."@ko ;
