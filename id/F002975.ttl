kno:F002975 rdfs:label "도너(donor)"@ko ;
    kno:surfaceForm "도너"@ko ;
    kno:urimalDefinition "원자 또는 분자 사이에서 전자의 주고받기가 이루어지는 경우, 양전하(陽電荷)나 전자쌍이 결여된 부분에 전자를 공여하는 이온, 원자, 분자를 통틀어 이르는 말. 〔명사〕"@ko ;
    kno:origin "donor" ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "130180" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:semanticTag kno:usas-S8p ;
    kno:fullForm "도너"@ko ;
    a kno:Formative ;
    kno:truncated "false"^^xsd:boolean ;
