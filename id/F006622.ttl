# F006622 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006622 kno:registration "우리말샘"@ko ;
    a kno:Formative ;
    kno:surfaceForm "파탈"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    rdfs:label "(팜)파탈(femme fatale)"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:origin "femme" ;
    kno:urimalTargetCode "734444" ;
    kno:urimalDefinition "남성들에게 ‘치명적인 여자’란 뜻으로, 필름 누아르 장르에 필연적으로 등장하는 여성 캐릭터를 이르는 말. 19세기 문학 작품에서 쓰이기 시작한 이 용어는 영화에서 악녀나 요부를 의미하게 되었다. 필름 느와르에서는 사악한 내적 욕망을 숨긴 채 아름답고 매혹적인 외모로 주인공 남성에게 다가가 자신의 욕망을 이루기 위해 그를 파멸로 몰아넣는 인물로 그려진다."@ko ;
    kno:fullForm "팜파탈"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8C%8C%ED%83%88> ;
    kno:fullFormLexeme kno:LEX-팜파탈 ;
    kno:parallelFullForm kno:LEX-팜파탈 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=734444> ;
    kno:semanticTag kno:usas-S2.1 .
kno:KN2017-0252-c2 kno:formative kno:F006622 .
