kno:KN2023-0174 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "알빠노"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%95%8C%EB%B9%A0%EB%85%B8> ;
    skos:definition "‘내가 알 바가 아님’이라는 뜻으로 쓰는 말. 주로 어떤 상황에 대해 냉소적으로 반응할 때 쓰는 말이다. =알빠임."@ko ;
