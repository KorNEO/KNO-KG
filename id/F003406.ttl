# F003406 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003406 kno:surfaceForm "맥"@ko ;
    kno:urimalDefinition "알코올성 음료의 하나. 엿기름가루를 물과 함께 가열하여 당화한 후, 홉(hop)을 넣어 향(香)과 쓴맛이 나게 한 뒤 발효하여 만든다. 오래 보존하기 위하여 가열한 병맥주와 가열하지 않은 생맥주가 있다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=150140> ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A7%A5> ;
    kno:origin "麥酒" ;
    kno:fullFormLexeme kno:LEX-맥주 ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    kno:semanticTag kno:usas-F2 ;
    a kno:Formative ;
    rdfs:label "맥(주)(麥酒)"@ko ;
    kno:fullForm "맥주"@ko ;
    kno:urimalTargetCode "150140" ;
    kno:parallelFullForm kno:LEX-맥주 .
