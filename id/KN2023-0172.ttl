# KN2023-0172 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0172 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "알고스피크"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%95%8C%EA%B3%A0%EC%8A%A4%ED%94%BC%ED%81%AC> ;
    skos:definition "소셜 미디어를 활용할 때, 단어 필터링 알고리즘을 우회하기 위해 기존 단어를 대체하는 단어. ‘알고리즘(algorism)’과 ‘스피크(speak)’를 결합하여 만든 말로, 알고리즘이 탐지하지 못하도록, ‘죽다’ 대신 ‘살아 있지 않다’를 입력하여 차단된 콘텐츠를 검색하는 것이 그 예시이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2023-0172-c1 ;
    kno:component kno:KN2023-0172-c2 ;
    kno:componentString "알고(리즘)(algorism), 스피크(speak)"@ko ;
    kno:example "¶욕설이나 인종 차별 발언을 식별해 차단하는 인공 지능 기술이 개발되고 있지만, 여전히 특이한 억양이나 {알고스피크는} 탐지하지 못하고 있다."@ko ;
