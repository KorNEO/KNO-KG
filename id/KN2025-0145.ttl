# KN2025-0145 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0145 kno:origin "(多情한虐待)" ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    skos:definition "(LLM) 상대를 배려하고 위하는 것처럼 보이는 말이나 행동이 결과적으로는 상대의 자율성을 약화시키거나 의존ㆍ불안을 키워 정신적 부담을 주는 일."@ko ;
    kno:component kno:KN2025-0145-c2 ;
    kno:component kno:KN2025-0145-c1 ;
    rdfs:label "다정 한 학대"@ko ;
    kno:languageType "(한+고)_한" ;
    kno:example "(LLM) 혼자 두면 불쌍하다고 매번 안아 주고 요구를 다 들어줬더니, 강아지가 분리불안을 보이는 {다정한학대가} 되어 버렸다."@ko ;
