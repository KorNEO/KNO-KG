@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0155 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2021-0155-att-nn ;
    ontolex:canonicalForm kno:KN2021-0155-form ;
    ontolex:sense kno:KN2021-0155-sense .

kno:KN2021-0155-att-nn a frac:Attestation ;
    dcterms:date "2021-06-25"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/016/0001853120> .

kno:KN2021-0155-form a ontolex:Form ;
    frac:frequency kno:KN2021-0155-freq-nn,
        kno:KN2021-0155-freq-yt ;
    ontolex:writtenRep "상생^소비^지원금"@ko .

kno:KN2021-0155-freq-nn a frac:CorpusFrequency ;
    rdf:value 3794 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0155-freq-yt a frac:CorpusFrequency ;
    rdf:value 46 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0155-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

