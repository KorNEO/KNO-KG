# KN2018-0357 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0357 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "토큰^경제학"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415960> ;
    skos:definition "가상 화폐를 수단으로 재화나 서비스를 거래할 수 있는 경제 활동의 생태계. 주로 블록 체인 기술에 기반하여 경제 시스템을 연구, 설계, 구현하는 일을 의미한다. =토크노믹스."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2018-0357-c1 ;
    kno:component kno:KN2018-0357-c2 ;
    kno:componentString "토큰(token), 경제학(經濟學)"@ko ;
    kno:example "¶텔레비전 시리즈에 ‘토큰 가치’가 존재하고 여기에서 {토큰 경제학에} 대한 인식이 늘어나면, 제작자들은 그 가치를 암호화된 교환 수단으로 바꾸어 시리즈의 차기 시즌 제작 비용에 충당할 수 있다."@ko ;
