# F002180 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002180 kno:urimalDefinition "상품, 유가 증권 따위를 대량으로 거래하는 상설 시장. 비영리 법인으로, 회원 또는 거래원만 직접 거래할 수 있으며 일반인은 이에 위탁하여 거래한다. 〔명사〕"@ko ;
    a kno:Formative ;
    rdfs:label "거래소(去來所)"@ko ;
    kno:urimalTargetCode "81355" ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=81355> ;
    kno:fullForm "거래소"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:origin "去來所" ;
    kno:semanticTag kno:usas-I2.1 ;
