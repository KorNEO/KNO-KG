# KN2025-0442 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0442 kno:year "2025"^^xsd:gYear ;
    kno:unitType "구"@ko ;
    kno:languageType "(한+고)_영" ;
    skos:definition "(LLM) 귀에 필러를 주입하여 귓불이나 귀 윤곽의 볼륨을 보완하거나, 누운 귀를 상대적으로 도드라져 보이게 해 얼굴이 작아 보이는 효과를 노리는 미용 시술."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    rdfs:label "요정 귀 필러"@ko ;
    kno:registration "신어DB"@ko ;
