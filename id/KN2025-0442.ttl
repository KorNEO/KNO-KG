    kno:frequency kno:KN2025-0442-freq-NN-2025 ;
    a kno:Neologism ;
    kno:frequency kno:KN2025-0442-freq-NN-total ;
    kno:example "(LLM) 옆모습 사진에서 귀가 너무 붙어 보인다는 말을 듣고 {요정귀필러를} 상담받는 사람이 늘고 있다."@ko ;
