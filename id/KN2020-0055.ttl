# KN2020-0055 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0055 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "긴급^돌봄^지원단"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%B4%EA%B8%89%EB%8F%8C%EB%B4%84%EC%A7%80%EC%9B%90%EB%8B%A8> ;
    skos:definition "전국적인 재난 사태로 인해 발생한 노인이나 장애인, 아동 등의 돌봄 공백을 해소하기 위해 지방 자치 단체와 고용 계약을 맺고 채용된 인력. 코로나19의 확산에 따라 자가 격리 대상자 또는 확진자로 분류된 노인 및 장애인과 지정된 전문 시설에 동반 입소하여 돌봄 서비스를 제공한다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2020-0055-c1 ;
    kno:component kno:KN2020-0055-c2 ;
    kno:component kno:KN2020-0055-c3 ;
    kno:componentString "긴급(緊急), 돌봄, 지원단(支援團)"@ko ;
    kno:example "¶OO시는 코로나19로 인한 돌봄 활동의 공백을 막기 위해 노인 및 장애인에 대한 {긴급 돌봄 지원단을} 모집하기로 결정했다."@ko ;
    kno:frequency kno:KN2020-0055-freq-NN-2020 ;
    kno:frequency kno:KN2020-0055-freq-NN-2021 ;
    kno:frequency kno:KN2020-0055-freq-NN-2022 ;
    kno:frequency kno:KN2020-0055-freq-NN-2023 ;
    kno:frequency kno:KN2020-0055-freq-NN-2024 ;
    kno:frequency kno:KN2020-0055-freq-NN-total ;
    kno:indexForm "긴급돌봄지원단"@ko ;
