# F001636 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001636 kno:origin "omni" ;
    kno:urimalTargetCode "1355993" ;
    rdfs:label "옴니(omni)"@ko ;
    kno:registration "우리말샘"@ko ;
    a kno:Formative ;
    kno:surfaceForm "옴니"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1355993> ;
    kno:semanticTag kno:usas-N5p ;
    kno:urimalDefinition "지상 송신소에서 동시에 송신한 신호를 자석 북극 송신소 지점에 위치한 곳에서 수신할 때, 신호가 겹치는 것을 비교하는 장치. 조종사가 옴니 베어링 선택기를 원하는 방향으로 선택하면 진행 편차 지시계가 항공기의 방향을 지시한다. 〔명사〕"@ko ;
    kno:caseCount "2"^^xsd:integer ;
    kno:fullForm "옴니"@ko ;
    kno:truncated "false"^^xsd:boolean .
