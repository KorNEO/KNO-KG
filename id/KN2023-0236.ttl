@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0236 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2023-0236-att-nn ;
    ontolex:canonicalForm kno:KN2023-0236-form ;
    ontolex:sense kno:KN2023-0236-sense .

kno:KN2023-0236-att-nn a frac:Attestation ;
    dcterms:date "2022-10-04"^^xsd:date ;
    frac:locus <https://m.entertain.naver.com/article/015/0004757434> .

kno:KN2023-0236-form a ontolex:Form ;
    frac:frequency kno:KN2023-0236-freq-nn,
        kno:KN2023-0236-freq-yt ;
    ontolex:writtenRep "잘파^세대"@ko .

kno:KN2023-0236-freq-nn a frac:CorpusFrequency ;
    rdf:value 4910 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0236-freq-yt a frac:CorpusFrequency ;
    rdf:value 220 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0236-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%9E%98%ED%8C%8C%EC%84%B8%EB%8C%80> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

