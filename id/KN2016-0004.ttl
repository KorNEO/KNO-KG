# KN2016-0004 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0004 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "갓물주"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372439> ;
    skos:definition "건물을 소유한 사람의 능력을 신의 능력에 비유하여 이르는 말."@ko ;
    kno:activeYears "10"^^xsd:integer ;
    kno:component kno:KN2016-0004-c1 ;
    kno:component kno:KN2016-0004-c2 ;
    kno:componentString "갓(god), (건)물주(建物主)"@ko ;
    kno:example "¶그는 “전 국민이 전세난에 고통스러워하고 있어 정부가 전세를 확대해 주택 시장의 연착륙을 모색해도 모자란 시점에 거꾸로 월세 장사를 하겠다고 나서고 있다.”라며 “세입자는 안중에도 없고 자기 수익만 생각하는 ‘{갓물주’들과} OO가 뭐가 다르냐. 가난한 사람들의 주거 안정을 도모해야 하는 OO의 존재 이유에 역행하는 것 같다.”라고 비판했다."@ko ;
