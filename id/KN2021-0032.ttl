# KN2021-0032 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0032 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "국방^유공자^예우법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B5%AD%EB%B0%A9%EC%9C%A0%EA%B3%B5%EC%9E%90%EC%98%88%EC%9A%B0%EB%B2%95> ;
    skos:definition "군 복무자를 유공자로서 대우하여 국가가 합당하게 예우하는 데에 필요한 사항을 규정한 법안. 정식 명칭은 ‘국방 유공자 예우에 관한 법률’이다. 2021년 4월에 국회에서 발의되었다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2021-0032-c1 ;
    kno:component kno:KN2021-0032-c2 ;
    kno:component kno:KN2021-0032-c3 ;
