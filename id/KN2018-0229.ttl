# KN2018-0229 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0229 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "아벡시트"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%95%84%EB%B2%A1%EC%8B%9C%ED%8A%B8> ;
    skos:definition "정치 스캔들로 인해 일본의 ‘아베’ 총리가 퇴진할 경우 일본 증시에 투자한 외국인 투자자들이 급속도로 투자금을 회수하는 현상을 이르는 말. ‘아베 신조’ 총리의 성(姓)인 ‘아베(安倍)’와 퇴진을 뜻하는 ‘엑시트(exit)’를 결합하여 만든 말이다. ⇒규범 표기는 미확정이다. =아베그지트."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2018-0229-c1 ;
    kno:component kno:KN2018-0229-c2 ;
    kno:componentString "아베(安倍), (엑)시트(exit)"@ko ;
    kno:example "¶연이은 사학 스캔들 등으로 최근 아베 신조 일본 총리의 지지율이 급락하면서 ‘{아벡시트’에} 대한 우려감이 다시 고개를 들고 있기 때문이다."@ko ;
    kno:formation kno:W05 ;
