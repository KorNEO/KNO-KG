# KN2024-0176 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0176 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "엔시트-화"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%97%94%EC%8B%9C%ED%8A%B8%ED%99%94> ;
    skos:definition "사용자에게 무료로 양질의 콘텐츠를 제공하던 온라인 플랫폼이 수익의 창출을 우선시하게 되면서 사용자의 만족도 및 서비스 품질이 하락하는 현상. =엔시티피케이션."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2024-0176-c1 ;
    kno:component kno:KN2024-0176-c2 ;
    kno:component kno:KN2024-0176-c3 ;
    kno:componentString "엔(en)-, 시트(shit), -화(化)"@ko ;
    kno:example "¶인공 지능이 소셜 미디어와 포털 등 플랫폼의 종류를 가리지 않고 ‘대격변’을 일으키고 있는 가운데 플랫폼 성격이 서로 비슷해지는 동질화와 콘텐츠 품질이 떨어지는 {엔시트화가} 이뤄진다는 분석이 나왔다."@ko ;
