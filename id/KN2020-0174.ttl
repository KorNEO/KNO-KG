# KN2020-0174 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0174 kno:year "2020"^^xsd:gYear ;
    kno:component kno:KN2020-0174-c2 ;
    kno:languageType "한^한^한" ;
    kno:pos "「구」"@ko ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:component kno:KN2020-0174-c5 ;
    skos:definition "소재ㆍ부품ㆍ장비와 관련한 산업의 대외 의존도를 낮추고 경쟁력을 강화하기 위해 제정한 법률. 2019년 7월부터 일본 정부가 반도체 생산에 필수적인 품목들을 한국으로 수출하는 데에 규제를 강화하였고, 이에 대응하기 위해 한국 정부에서 시행하였다. 2001년 제정된 ‘소재ㆍ부품 특별법’을 전면 개편하여 2019년 9월 국회에 발의되고 2020년 4월에 시행되었다. 정식 명칭은 ‘소재ㆍ부품ㆍ장비 산업 경쟁력 강화를 위한 특별 조치법’이다. =소부장 특별법."@ko ;
    a ontolex:MultiwordExpression ;
    kno:component kno:KN2020-0174-c1 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%86%8C%EC%9E%AC%E3%86%8D%EB%B6%80%ED%92%88%E3%86%8D%EC%9E%A5%EB%B9%84%EC%82%B0%EC%97%85%ED%8A%B9%EB%B3%84%EB%B2%95> ;
