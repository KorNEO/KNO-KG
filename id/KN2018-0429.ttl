# KN2018-0429 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0429 a ontolex:Word ;
    kno:slotFiller "욜로(YOLO) (1성분)"@ko ;
    kno:componentString "홀(로), 욜로(YOLO)"@ko ;
    a kno:Neologism ;
    kno:unitType "단어"@ko ;
    rdfs:label "횰로"@ko ;
    kno:languageType "고+영" ;
    kno:year "2018"^^xsd:gYear ;
    kno:component kno:KN2018-0429-c2 ;
    kno:component kno:KN2018-0429-c1 ;
    skos:definition "현재의 행복을 중요하게 여기며 혼자서 즐기면서 살아가는 방식. ‘홀로’와 현재의 행복을 중요하게 여기는 생활 방식을 뜻하는 ‘욜로(YOLO)’를 결합하여 만든 말이다."@ko ;
    kno:predicate "살아가다"@ko ;
    kno:pos "「명」"@ko ;
    kno:formation kno:W05 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1381214> ;
    kno:example "¶셀프 인테리어 확대가 {횰로의} 대표적인 현상인데 카페, 책방, 리조트 등 혼자 사는 집을 특별한 테마로 인테리어하고 OO 등 소셜 네트워크 서비스로 공유함으로써 만족감을 느낀다."@ko ;
    kno:registration "우리말샘"@ko ;
    kno:instantiates kno:S001781 ;
    kno:urimalTargetCode "1381214" ;
    kno:origin "(홀<영>←YOLO)" ;
    kno:indexForm "횰로"@ko ;
    kno:activeYears "0"^^xsd:integer .
