# F004855 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004855 kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-B1 ;
    kno:origin "rna" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1535180> ;
    kno:urimalDefinition "오탄당의 하나인 리보스를 함유하는 핵산. 디엔에이의 유전 정보를 세포질로 나르고, 아미노산을 수송하거나 단백질과 결합하여 세포질 속에서 리보솜의 주요 성분을 이룬다. 알칼리에 분해되기 쉬우며, 단백질 합성에 중요한 역할을 한다. 〔명사〕"@ko ;
    kno:fullForm "알엔에이"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:label "알엔에이(RNA)"@ko ;
    kno:urimalTargetCode "1535180" ;
    a kno:Formative ;
