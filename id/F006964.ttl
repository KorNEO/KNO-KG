# F006964 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006964 rdfs:label "한남동(漢南洞)"@ko ;
    kno:urimalDefinition "서울특별시 용산구에 있는 동. 용산구의 동부에 위치해 있으며, 남쪽으로 한강에 접해 있다. 강남과 강북 지역을 연결하는 교통 요지로, 국내외 외교 공관이 많이 들어서 있다. 이태원 관광 특구에 포함되어 관광·유흥업소들이 밀집해 있다. 〔명사〕"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "한남동"@ko ;
    kno:surfaceForm "한남동"@ko ;
    kno:semanticTag kno:usas-Z2 ;
