# KN2016-0445 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0445 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "전화^변론^금지법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A0%84%ED%99%94%EB%B3%80%EB%A1%A0%EA%B8%88%EC%A7%80%EB%B2%95> ;
    skos:definition "전관 변호사가 선임되기도 전에 검찰에 전화를 걸어 변론하는 것을 금지하는 법안. 선임서를 제출하지 않고 변론을 할 수 없으며, 전화로 변론을 하는 경우 구두 변론 관리 대장에 이를 기재해야 한다는 내용을 담고 있다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2016-0445-c1 ;
    kno:component kno:KN2016-0445-c2 ;
    kno:component kno:KN2016-0445-c3 ;
    kno:componentString "전화(電話), 변론(辯論), 금지법(禁止法)"@ko ;
    kno:example "¶법원ㆍ검찰 공무원이 특정 사건과 관련해 전관 변호사로부터 로비를 받는 경우 소속 기관장에게 신고하도록 하는 내용의 이른바 ‘{전화 변론 금지법’이} 추진된다."@ko ;
    kno:frequency kno:KN2016-0445-freq-NN-2015 ;
    kno:frequency kno:KN2016-0445-freq-NN-total ;
    kno:indexForm "전화변론금지법"@ko ;
    kno:instantiates kno:S000055 ;
    kno:languageType "한^한^한" ;
    kno:lastAttestationYear "2015"^^xsd:gYear ;
