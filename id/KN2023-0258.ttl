kno:KN2023-0258 a ontolex:Word ;
    frac:attestation kno:KN2023-0258-att-nn ;
    ontolex:canonicalForm kno:KN2023-0258-form ;
    ontolex:sense kno:KN2023-0258-sense .

kno:KN2023-0258-att-nn a frac:Attestation ;
    dcterms:date "2022-12-01"^^xsd:date ;
    frac:locus <https://m.sports.naver.com/article/410/0000909774> .

kno:KN2023-0258-form a ontolex:Form ;
    frac:frequency kno:KN2023-0258-freq-nn,
        kno:KN2023-0258-freq-yt ;
    ontolex:writtenRep "중꺾마"@ko .

kno:KN2023-0258-freq-nn a frac:CorpusFrequency ;
    rdf:value 2892 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0258-freq-yt a frac:CorpusFrequency ;
    rdf:value 3394 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0258-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%A4%91%EC%9A%94%ED%95%9C%20%EA%B2%83%EC%9D%80%20%EA%BA%BE%EC%9D%B4%EC%A7%80%20%EC%95%8A%EB%8A%94%20%EB%A7%88%EC%9D%8C> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

