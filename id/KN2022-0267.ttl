@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0267 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2022-0267-att-nn ;
    ontolex:canonicalForm kno:KN2022-0267-form ;
    ontolex:sense kno:KN2022-0267-sense .

kno:KN2022-0267-att-nn a frac:Attestation ;
    dcterms:date "2021-10-21"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/366/0000768338> .

kno:KN2022-0267-form a ontolex:Form ;
    frac:frequency kno:KN2022-0267-freq-nn,
        kno:KN2022-0267-freq-yt ;
    ontolex:writtenRep "청년^도약^계좌"@ko .

kno:KN2022-0267-freq-nn a frac:CorpusFrequency ;
    rdf:value 19963 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0267-freq-yt a frac:CorpusFrequency ;
    rdf:value 2312 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0267-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%B2%AD%EB%85%84%EB%8F%84%EC%95%BD%EA%B3%84%EC%A2%8C> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

