# KN2016-0458 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0458 kno:component kno:KN2016-0458-c2 ;
    rdfs:label "주차장^이론"@ko ;
    kno:languageType "한^한" ;
    kno:example "¶배우자를 찾을 때도 똑같아서 너무 욕심내다 보면 적당한 배우자감들을 놓친다는 게 바로 {주차장 이론이라는데요}, 요즘 이런 결혼에 필요한 전략을 들으려고 부모들이 결혼 정보업체 강의에 구름 떼처럼 몰려든다고 합니다."@ko ;
    kno:lastAttestationYear "2021"^^xsd:gYear ;
    kno:unitType "구"@ko ;
    kno:indexForm "주차장이론"@ko ;
