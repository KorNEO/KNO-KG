# KN2020-0051 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0051 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "긴급^고용^안정^지원금"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1521658> ;
    skos:definition "전국적인 재난 사태로 인해 소득 혹은 매출이 감소한 특수 형태 근로 종사자 및 프리랜서, 영세 자영업자 등의 취약 계층을 지원하기 위해 정부가 긴급하게 지급하는 지원금. 코로나19의 확산과 그에 따른 경제 위기로 인해 마련된 제도이다. =긴급 고용 지원금."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2020-0051-c1 ;
    kno:component kno:KN2020-0051-c2 ;
    kno:component kno:KN2020-0051-c3 ;
    kno:component kno:KN2020-0051-c4 ;
    kno:componentString "긴급(緊急), 고용(雇傭), 안정(安定), 지원금(支援金)"@ko ;
    kno:example "¶정부는 코로나19로 직접 타격을 입은 고용 시장에 대한 대비책의 하나로 “고용 지원 제도의 사각지대로 여겨졌던 영세 사업자, 특수 고용직 노동자, 프리랜서 등의 90만 명에게 3개월 동안 50만 원씩의 {긴급 고용 안정 지원금을} 지급하겠다.”라고 계획을 밝혔다."@ko ;
    kno:frequency kno:KN2020-0051-freq-NN-2020 ;
    kno:frequency kno:KN2020-0051-freq-NN-2021 ;
    kno:frequency kno:KN2020-0051-freq-NN-2022 ;
