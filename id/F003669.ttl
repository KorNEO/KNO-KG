kno:F003669 a kno:Formative ;
    rdfs:label "박사(博士)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=368437> ;
    kno:caseCount "1"^^xsd:integer ;
