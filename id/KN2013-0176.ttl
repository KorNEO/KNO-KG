    a kno:Neologism ;
    rdfs:label "몰캉스-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1383212> ;
    skos:definition "쇼핑몰에서 바캉스를 즐기며 휴가를 즐기는 사람."@ko ;
