# KN2024-0365 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0365 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "필수^의료^유지^명령"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%95%84%EC%88%98%EC%9D%98%EB%A3%8C%EC%9C%A0%EC%A7%80%EB%AA%85%EB%A0%B9> ;
    skos:definition "국민의 생명권과 건강 보호를 위해, 정부가 의료 기관에 필수 진료를 중단하지 않도록 강제하는 행정 명령. 2024년 의과 대학 입학 정원 확대에 반발하여 전공의들이 집단 연가를 신청하자 발령되었다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2024-0365-c1 ;
