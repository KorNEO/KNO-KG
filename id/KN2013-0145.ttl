    kno:pos "「명」"@ko ;
    skos:definition "롤러코스터를 타는 것 같이, 변화가 크고 다양한 표정."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A1%A4%ED%8E%98> ;
