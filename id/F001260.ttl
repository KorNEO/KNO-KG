# F001260 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001260 kno:urimalTargetCode "143129" ;
    kno:semanticTag kno:usas-Y1 ;
    kno:caseCount "2"^^xsd:integer ;
    kno:urimalDefinition "은백색의 광택이 있는 알칼리 금속 원소의 하나. 비중 0.534의 가장 가벼운 금속으로, 건조한 공기 속에서는 안정하지만, 가열하면 강한 빛을 내며 타고, 물과 작용하면 수산화물이 되면서 수소를 발생한다. 유기 화합물의 환원제, 원자로의 제어봉, 합금 재료, 의약 따위로 쓴다. 원자 기호는 Li. 원자 번호는 3, 원자량은 6.941. 〔명사〕"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:origin "lithium" ;
    a kno:Formative ;
    rdfs:label "리튬(lithium)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=143129> ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "리튬"@ko ;
    kno:surfaceForm "리튬"@ko .
kno:KN2016-0065-c2 kno:formative kno:F001260 .
kno:KN2024-0270-c2 kno:formative kno:F001260 .
