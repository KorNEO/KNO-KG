# KN2018-0307 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0307 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "지아르더블유엠"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A7%80%EC%95%84%EB%A5%B4%EB%8D%94%EB%B8%94%EC%9C%A0%EC%97%A0> ;
    skos:definition "외출하기 전에 단장하는 과정을 보여 주는 콘텐츠를 이르는 말. 주로 인터넷 개인 방송에서, 개인 방송 진행자가 외출하기 전에 얼굴, 머리, 옷차림 따위를 꾸미는 과정을 영상을 통해 보면서 시청자도 함께 외출할 준비를 하자는 뜻의 ‘겟 레디 위드 미(get ready with me)’를 줄여 이르는 말이다."@ko ;
    kno:activeYears "9"^^xsd:integer ;
    kno:component kno:KN2018-0307-c1 ;
    kno:componentString "지아르더블유엠(GRWM)"@ko ;
    kno:example "¶OO는 광고 모델 OOO의 겨울 스킨케어 비법을 담은 광고 영상 ‘겨울잠 크림 케어 {지아르더블유엠’을} 공개한다고 29일 밝혔다."@ko ;
