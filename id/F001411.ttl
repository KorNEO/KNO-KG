# F001411 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001411 kno:semanticTag kno:usas-B3 ;
    kno:origin "vitamin" ;
    rdfs:label "비타민(vitamin)"@ko ;
    kno:caseCount "2"^^xsd:integer ;
    kno:surfaceForm "비타민"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=179512> ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "동물체의 주 영양소가 아니면서 동물의 정상적인 발육과 생리 작용을 유지하는 데 없어서는 안 되는 유기 화합물을 통틀어 이르는 말. 비교적 소량이 필요하지만 체내에서 생성되지 않는다. 크게 수용성 비타민과 지용성 비타민으로 나누어지고, 부족하면 특유의 결핍 증상이 나타난다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "비타민"@ko ;
    kno:urimalTargetCode "179512" ;
    a kno:Formative .
