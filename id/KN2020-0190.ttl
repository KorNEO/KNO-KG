# KN2020-0190 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0190 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "신속 사용 승인"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%8B%A0%EC%86%8D%20%EC%82%AC%EC%9A%A9%20%EC%8A%B9%EC%9D%B8> ;
    skos:definition "공중 보건의 위기 상황에 대응하기 위해, 의료 제품을 신속하게 사용할 수 있도록 승인하는 일. 코로나19의 전 세계적인 확산으로, 코로나19의 백신과 치료제 등에 대한 신속 사용 승인이 요구되었다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2020-0190-c1 ;
    kno:component kno:KN2020-0190-c2 ;
    kno:component kno:KN2020-0190-c3 ;
    kno:componentString "신속(迅速), 사용(使用), 승인(承認)"@ko ;
    kno:example "¶국내 보건 당국도 코로나19 치료제의 효과가 확인되면 {신속 사용 승인을} 통해 국내에서 사용할 수 있겠다고 밝혔다."@ko ;
    kno:frequency kno:KN2020-0190-freq-NN-2020 ;
    kno:frequency kno:KN2020-0190-freq-NN-2021 ;
    kno:frequency kno:KN2020-0190-freq-NN-2022 ;
    kno:frequency kno:KN2020-0190-freq-NN-2023 ;
    kno:frequency kno:KN2020-0190-freq-NN-total ;
    kno:indexForm "신속사용승인"@ko ;
    kno:instantiates kno:S000141 ;
    kno:languageType "한_한_한" ;
    kno:lastAttestationYear "2023"^^xsd:gYear ;
    kno:origin "(迅速使用承認)" ;
    kno:pos "「구」"@ko ;
    kno:predicate "승인하다"@ko ;
