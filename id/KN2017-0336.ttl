# KN2017-0336 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0336 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "할류 열풍"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380626> ;
    skos:definition "할아버지나 할머니가 고가의 유아용품을 구매해 소비 시장의 주류를 이루는 현상. ‘할아버지’ 또는 ‘할머니’와 해외에서 한국의 대중문화를 열렬히 좋아하고 선망하는 현상을 뜻하는 ‘한류 열풍’을 결합하여 만든 말이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2017-0336-c1 ;
    kno:component kno:KN2017-0336-c2 ;
    kno:component kno:KN2017-0336-c3 ;
    kno:componentString "할(아버지), (한)류(流), 열풍(烈風)"@ko ;
    kno:example "¶{할류 열풍을} 일으키는 할빠, 할마들은 언제나 멋지다."@ko ;
