# KN2018-0427 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0427 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "화재-적운"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416031> ;
    skos:definition "화산 분출이나 큰 화재로 인해 발생한 연기가 수직으로 피어올라 생기는 구름. 세계 기상 기구가 신종 구름으로 공식 인정했으며 기후 변화가 심해져 나타난 뭉게구름으로 주로 검은색, 회색, 갈색을 띤다."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2018-0427-c1 ;
    kno:component kno:KN2018-0427-c2 ;
    kno:componentString "화재(火災), 적운(積雲)"@ko ;
    kno:example "¶이 멋진 {화재적운은} 2014년 미 오리건 협곡 화재 당시 생긴 구름이다."@ko ;
