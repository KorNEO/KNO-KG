# F005146 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005146 kno:semanticTag kno:usas-M7 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1373710> ;
    kno:urimalDefinition "제주 지역의 풍경과 정취를 느낄 수 있도록 걷기 좋게 조성한 길. 마을의 큰길과 연결된 집 앞의 골목길을 이르는 제주도 방언에서 유래한 말이다. 〔명사〕"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "올레길"@ko ;
    rdfs:label "올레길"@ko ;
