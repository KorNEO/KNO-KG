# F004155 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004155 kno:origin "casanova" ;
    kno:fullForm "카사노바"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%82%AC%EB%85%B8%EB%B0%94> ;
