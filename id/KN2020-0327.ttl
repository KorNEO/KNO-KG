# KN2020-0327 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0327 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "친환경 집밥"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B9%9C%ED%99%98%EA%B2%BD%20%EC%A7%91%EB%B0%A5> ;
    skos:definition "자연환경에 해를 주지 않으면서 생산한 식재료를 사용하여 집에서 직접 만들어 먹는 음식. 코로나19의 확산과 그에 따른 사회적 거리 두기의 시행으로 인해 외식 대신 집에서 건강한 식재료로 음식을 만들어서 식사를 하는 일에 관심이 높아지는 상황에서 나온 말이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2020-0327-c1 ;
    kno:component kno:KN2020-0327-c2 ;
    kno:componentString "친환경(親環境), 집밥"@ko ;
    kno:example "¶사회적 거리 두기 캠페인을 시행한 후 외식보다는 건강한 식자재로 만든 집밥을 선호하는 사람들이 많아지면서 {친환경 집밥이} 하나의 트렌드로 자리를 잡고 있다."@ko ;
