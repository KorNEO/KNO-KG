# KN2020-0327 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0327 kno:registration "신어DB"@ko ;
    kno:frequency kno:KN2020-0327-freq-NN-2020 ;
    kno:origin "(親環境집밥)" ;
    kno:frequency kno:KN2020-0327-freq-NN-2025 ;
    a kno:Neologism ;
    skos:definition "자연환경에 해를 주지 않으면서 생산한 식재료를 사용하여 집에서 직접 만들어 먹는 음식. 코로나19의 확산과 그에 따른 사회적 거리 두기의 시행으로 인해 외식 대신 집에서 건강한 식재료로 음식을 만들어서 식사를 하는 일에 관심이 높아지는 상황에서 나온 말이다."@ko ;
    kno:unitType "구"@ko ;
    kno:indexForm "친환경집밥"@ko ;
