    kno:registration "신어DB"@ko ;
    kno:lastAttestationYear "2019"^^xsd:gYear ;
    a kno:Neologism ;
    skos:definition "‘낮에는 기업에 투자를 요구하고 밤에는 압수 수색을 실시함’이라는 뜻으로, 정부에서 경제 성장을 위해 기업의 투자를 장려하면서 다른 한편으로는 기업에 대한 압수 수색을 진행하여 기업에 압력을 가하는 것을 이르는 말."@ko ;
    kno:frequency kno:KN2019-0246-freq-NN-total ;
    kno:componentString "주투야압(晝投夜押)"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:example "¶{‘주투야압’이란} 말이 이미 공공연하게 돌고 있다. OO 그룹만 봐도 지난해와 올해 벌써 스무 번 이상의 압수 수색을 받았다."@ko ;
