# KN2018-0182 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0182 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "설거지옥"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416248> ;
    skos:definition "너무 많은 설거짓거리로 인해 힘든 상황을 ‘지옥’에 비유하여 이르는 말."@ko ;
    kno:activeYears "9"^^xsd:integer ;
    kno:component kno:KN2018-0182-c1 ;
    kno:component kno:KN2018-0182-c2 ;
    kno:componentString "설거지, (지)옥(地獄)"@ko ;
    kno:example "¶알바생들은 “잔이 무거워 손목이 시큰거린다.”, “컵이 자주 깨져 손을 다칠 수밖에 없다.”라며 {설거지옥에} 빠지게 된 생활에 대해 토로했다."@ko ;
