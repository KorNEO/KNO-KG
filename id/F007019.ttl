kno:F007019 kno:origin "hamburger" ;
    kno:urimalDefinition "서양 요리의 하나. 쇠고기나 돼지고기를 잘게 다져 빵가루와 양파, 달걀 따위를 넣고 동글납작하게 뭉쳐 굽는다. 〔명사〕"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=27691> ;
    rdfs:label "햄버거(hamburger)"@ko ;
    kno:surfaceForm "햄버거"@ko ;
    kno:urimalTargetCode "27691" ;
    kno:truncated "false"^^xsd:boolean ;
    kno:fullForm "햄버거"@ko ;
