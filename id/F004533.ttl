# F004533 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004533 kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "스위스"@ko ;
    kno:parallelFullForm kno:LEX-스위스 ;
    rdfs:seeAlso <http://www.wikidata.org/entity/Q39> ;
