# F004530 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004530 kno:origin "sri" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=207226> ;
    kno:parallelFullForm kno:LEX-스리랑카 ;
    kno:fullFormLexeme kno:LEX-스리랑카 ;
    kno:semanticTag kno:usas-Z2 ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalTargetCode "207226" ;
    a kno:Formative ;
    kno:urimalDefinition "인도반도의 동남쪽에 있는, 섬으로 이루어진 공화국. 1948년 영국에서 독립하여 국명을 실론(Ceylon)이라 하였다가 1972년 지금의 이름으로 고쳤다. 주산업은 농업으로 차·고무·쌀·코코넛 따위를 생산하며, 주민은 대부분 신할리즈족으로 불교도이고 주요 언어는 신할리즈어와 영어, 타밀어이다. 상업 수도는 콜롬보, 행정 수도는 스리자야와르데네푸라코테이다. 면적은 6만 5610㎢. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <https://ko.wikipedia.org/wiki/%EC%8A%A4%EB%A6%AC%EB%9E%91%EC%B9%B4> ;
    kno:truncated "true"^^xsd:boolean ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%8A%A4> ;
    rdfs:label "스(리랑카)(Sri Lanka)"@ko ;
