kno:KN2023-0077 kno:frequency kno:KN2023-0077-freq-NN-2022 ;
    kno:activeYears "4"^^xsd:integer ;
    a kno:Neologism ;
    kno:indexForm "도심복합개발지원법"@ko ;
    kno:example "¶{도심 복합 개발 지원법이} 국회의 문턱을 넘으면서, 민간 사업자의 주도로 문화ㆍ상업 등의 복합 시설과 주택을 신속하게 지을 수 있을 것이라는 기대가 높아지고 있다."@ko ;
