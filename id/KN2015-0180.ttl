# KN2015-0180 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0180 kno:componentString "윈윈(win-win), 페이(pay)"@ko ;
    kno:indexForm "윈윈페이"@ko ;
    kno:frequency kno:KN2015-0180-freq-NN-2016 ;
    kno:origin "(<영>win-win pay)" ;
    kno:example "¶이제는 고용주와 피고용주가 합심해서 함께 성장한다는 개념으로 {윈윈 페이가} 될 수 있도록 사회 문화가 바뀌어야 한다고 생각합니다."@ko ;
    kno:predicate "받다"@ko ;
    kno:year "2015"^^xsd:gYear ;
    skos:definition "고용자는 피고용자에게 알맞은 임금을 지급하고, 피고용자는 노동한 대가로 합당한 임금을 받는 것."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1359800> ;
