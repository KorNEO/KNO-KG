kno:KN2013-0380 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "체고시다"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B2%B4%EA%B3%A0%EC%8B%9C%EB%8B%A4> ;
    skos:definition "‘최고이시다(最高이시다)’를 변형한 말로, 가장 으뜸이다."@ko ;
