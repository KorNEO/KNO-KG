# F006648 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006648 kno:surfaceForm "팥"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=438160> ;
    kno:semanticTag kno:usas-F1 ;
    kno:urimalDefinition "콩과의 한해살이풀. 높이는 30~60cm이며, 잎은 어긋나고 세 쪽 겹잎인데 잔잎은 달걀 모양으로 뾰족하다. 여름에 노란 꽃이 잎겨드랑이에서 피고 가늘고 둥근 통 모양의 긴 꼬투리에 4~15개의 씨가 들어 있다. 씨는 유용한 잡곡이다. 인도가 원산지로 한국, 일본, 중국 등지에서 널리 분포한다. 〔명사〕"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "438160" ;
    rdfs:label "팥"@ko ;
    kno:fullForm "팥"@ko .
kno:KN2022-0287-c1 kno:formative kno:F006648 .
