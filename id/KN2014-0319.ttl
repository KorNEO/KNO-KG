# KN2014-0319 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0319 kno:languageType "한+고" ;
    kno:registration "우리말샘"@ko ;
    kno:unitType "단어"@ko ;
    kno:instantiates kno:S000612 ;
    skos:definition "‘현실 웃음’을 줄여 이르는 말. ‘ㅋㅋ’ 따위를 타자로 쳐서 웃음을 표현하는 것이 아니라 실제 웃음을 가리킬 때 쓰인다."@ko ;
    kno:indexForm "현웃"@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:componentString "현(실)(現), 웃(음)"@ko ;
    a ontolex:Word ;
    kno:example "¶요일마다 연재되는 많은 코미디 장르의 웹툰 중에서도 매주 화ㆍ금요일 엄지족들의 {현웃을} 자아내는 클래스가 다른 ‘OO’가 개그 웹툰의 대표작이라고 할 수 있다."@ko ;
    kno:component kno:KN2014-0319-c1 ;
    kno:year "2014"^^xsd:gYear ;
    rdfs:label "현웃"@ko ;
    kno:urimalTargetCode "1369068" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1369068> ;
    kno:component kno:KN2014-0319-c2 ;
    kno:slotFiller "웃(음) (1성분)"@ko ;
    kno:formation kno:W06 ;
    kno:origin "(現웃)" ;
    a kno:Neologism ;
