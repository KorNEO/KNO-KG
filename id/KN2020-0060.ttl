# KN2020-0060 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0060 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "긴급^재난^기본^소득"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%B4%EA%B8%89%EC%9E%AC%EB%82%9C%EA%B8%B0%EB%B3%B8%EC%86%8C%EB%93%9D> ;
    skos:definition "전국적인 재난 사태로 인해 경제적으로 어려운 상황에 처한 사람이 기본 생활을 유지할 수 있도록 정부에서 긴급하게 지급하는 소득. 코로나19의 대유행으로 인한 경제적 위기 상황을 극복하기 위해 정부에서 국민들에게 지원금을 지급하는 방안을 논의하는 과정에서 나온 말이다. =긴급 재난 소득, 긴급 재난 지원 소득."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2020-0060-c1 ;
    kno:component kno:KN2020-0060-c2 ;
    kno:component kno:KN2020-0060-c3 ;
    kno:component kno:KN2020-0060-c4 ;
    kno:componentString "긴급(緊急), 재난(災難), 기본(基本), 소득(所得)"@ko ;
    kno:example "¶OO당은 “{긴급 재난 기본 소득으로} 일 인당 백만 원 정도는 지급해야 한다.”라며 지급 수준과 지급 대상 확대를 주장했다."@ko ;
    kno:frequency kno:KN2020-0060-freq-NN-2020 ;
    kno:frequency kno:KN2020-0060-freq-NN-2021 ;
    kno:frequency kno:KN2020-0060-freq-NN-2022 ;
    kno:frequency kno:KN2020-0060-freq-NN-2025 ;
