kno:KN2025-0571 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "카톡 계엄령"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B9%B4%ED%86%A1%20%EA%B3%84%EC%97%84%EB%A0%B9> ;
    skos:definition "(LLM) 모바일 메신저 카카오톡에서의 대화 내용이나 메시지 유통을 문제 삼아 처벌ㆍ고발하겠다는 움직임을, 표현의 자유를 과도하게 제한하는 조치에 빗대어 비판적으로 이르는 말."@ko ;
    kno:activeYears "1"^^xsd:integer ;
