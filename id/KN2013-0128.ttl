# KN2013-0128 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0128 kno:component kno:KN2013-0128-c2 ;
    a kno:Neologism ;
    kno:example "¶이처럼 최근 캠핑 인구가 급증하면서 밤에도 음주와 고성방가를 일삼는 사례가 잦아 주변에 스트레스를 주는 경우가 비일비재하다. 특히 이 같은 현상은 단체로 캠핑하는 ‘{떼캠’족이} 증가하면서 더욱 심해지고 있다."@ko ;
    kno:year "2013"^^xsd:gYear ;
    kno:pos "「명」"@ko ;
    rdfs:label "떼캠-족"@ko ;
    kno:frequency kno:KN2013-0128-freq-NN-total ;
    kno:predicate "캠핑하다"@ko ;
    kno:slotFiller "떼+캠(프)(camp) (2성분)"@ko ;
    skos:definition "여럿이 무리 지어 캠핑하는 사람. 또는 그런 무리."@ko ;
