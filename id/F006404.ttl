# F006404 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006404 kno:caseCount "1"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "화자가 청자를 놀리기 위하여 한 말이 의도치 않게 청자의 가족을 조롱한 것이 된 상황에서 화자가 급하게 태도를 바꾸며 재치 있게 변명하는 일. 어떤 영화의 한 장면에서, 친구가 제안한 ‘<FL>탈룰라</FL>’라는 이름을 비웃었다가 친구의 엄마 이름이라는 것을 알고 곧바로 예쁜 이름이라고 칭찬하며 태도를 바꾼 것에서 유래한 말이다. ⇒규범 표기는 미확정이다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-Q2.2 ;
    kno:surfaceForm "탈룰라"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1385220> ;
    kno:origin "tallulah" ;
    kno:fullForm "탈룰라"@ko ;
    kno:urimalTargetCode "1385220" ;
    rdfs:label "탈룰라(Tallulah)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative .
kno:KN2018-0351-c1 kno:formative kno:F006404 .
