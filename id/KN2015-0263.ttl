# KN2015-0263 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0263 kno:year "2015"^^xsd:gYear ;
    kno:activeYears "3"^^xsd:integer ;
    skos:definition "혁신 도시에 거주하며 가족과 떨어져 혼자 사는 사람. 주로 공공기관이 혁신 도시로 이전하면서 가족과 떨어져 생활하게 된 공공기관 근무자를 가리키는 말이다."@ko ;
    a ontolex:MultiwordExpression ;
    kno:component kno:KN2015-0263-c1 ;
    kno:frequency kno:KN2015-0263-freq-NN-2017 ;
    kno:languageType "한^고" ;
    kno:example "¶실제로 지난해부터 시작된 공공기관 지방 이전은 수많은 ‘{혁신 기러기’를} 양산하고 있다."@ko ;
