# KN2014-0271 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0271 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "콤섹^지수"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%BD%A4%EC%84%B9%EC%A7%80%EC%88%98> ;
    skos:definition "호주의 코먼웰스 은행이 전 세계의 55개국에서 판매되는 애플사의 아이팟 가격을 근거로 각국의 구매력과 물가를 쉽게 비교할 수 있도록 만든 지수."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2014-0271-c1 ;
    kno:component kno:KN2014-0271-c2 ;
    kno:componentString "콤섹(commsec), 지수(指數)"@ko ;
    kno:example "¶{콤섹 지수에} 따르면 와이파이가 되고 레티나 디스플레이를 장착한 16기가바이트 OO의 소비자 가격은 아르헨티나에서는 1094.11달러인 데 비해 말레이시아에서는 473.77달러로 나타났다."@ko ;
    kno:frequency kno:KN2014-0271-freq-NN-2013 ;
    kno:frequency kno:KN2014-0271-freq-NN-total ;
    kno:indexForm "콤섹지수"@ko ;
    kno:instantiates kno:S000024 ;
    kno:languageType "영^한" ;
    kno:lastAttestationYear "2013"^^xsd:gYear ;
    kno:origin "(<영>commsec指數)" ;
