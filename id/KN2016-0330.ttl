    kno:origin "(<영>←snow<일>tsunami[津波])" ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%93%B0%EB%85%B8%EC%9A%B0%EB%82%98%EB%AF%B8> ;
