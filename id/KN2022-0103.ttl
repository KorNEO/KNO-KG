# KN2022-0103 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0103 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "눕코노미"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%88%95%EC%BD%94%EB%85%B8%EB%AF%B8> ;
    skos:definition "항공기 내에서 여러 개의 빈 좌석에 누워서 이동하는 것. ‘눕다’와 항공기의 일반석을 뜻하는 ‘이코노미(economy)’를 결합하여 만든 말로, 코로나19의 확산으로 인해 항공기 탑승객이 줄어들자 일반석에서도 주위의 빈 좌석을 이용해 누워서 이동할 수 있게 된 상황에서 나온 말이다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2022-0103-c1 ;
    kno:component kno:KN2022-0103-c2 ;
    kno:componentString "눕(다), (이)코노미(economy)"@ko ;
    kno:example "¶코로나19의 확산으로 인해 탑승객이 적은 항공편에서는 좌우로 빈 세 좌석을 한 명의 승객이 이용하는 {눕코노미의} 혜택을 볼 수 있었다."@ko ;
