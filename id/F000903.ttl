# F000903 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000903 kno:surfaceForm "자기"@ko ;
    kno:urimalDefinition "쇠붙이를 끌어당기거나 남북을 가리키는 등 자석이 갖는 작용이나 성질. 자하(磁荷)는 존재하지 않고, 운동하는 전하가 자기장을 만들거나 반대로 자기장이 운동하는 전하에 힘을 미치게 함으로써 자기 현상이 일어난다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=255084> ;
    kno:fullForm "자기"@ko ;
    kno:caseCount "3"^^xsd:integer ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    rdfs:label "자기(磁氣)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:origin "磁氣" ;
    kno:urimalTargetCode "255084" ;
    kno:semanticTag kno:usas-Z8 .
