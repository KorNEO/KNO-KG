# KN2020-0063 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0063 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "긴급^재난^생계^지원금"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%B4%EA%B8%89%EC%9E%AC%EB%82%9C%EC%83%9D%EA%B3%84%EC%A7%80%EC%9B%90%EA%B8%88> ;
    skos:definition "전국적인 재난 사태로 인해 생계에 어려움을 겪는 국민들에게 정부가 긴급하게 지급하는 지원금. 코로나19의 확산으로 인한 경제 위축이 장기화되자 국민들의 생계를 지원하고 위축된 소비 심리를 진작하기 위해 마련된 제도로, 지급 주체가 지방 자치 단체일 경우 각 지방 자치 단체에 따라 지급 내용과 용어가 조금씩 다르다. =긴급 재난 생활 지원금, 재난 긴급 생활 지원금."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2020-0063-c1 ;
    kno:component kno:KN2020-0063-c2 ;
