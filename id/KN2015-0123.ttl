# KN2015-0123 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0123 kno:component kno:KN2015-0123-c2 ;
    kno:formation kno:W05 ;
    kno:indexForm "소취"@ko ;
    kno:languageType "한+한" ;
    kno:example "¶이를 본 네티즌들은 “OOO 씨. 가수로 보는 그날 기다릴게요.”, “작곡가 OOO 너무 재밌고 착해 보여. 꼭 데뷔했으면.”, “OOO 씨 가수 데뷔 {소취}.” 등의 반응을 보였다."@ko ;
    a kno:Neologism ;
    kno:pos "「명」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:unitType "단어"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1386912> ;
    rdfs:label "소취"@ko ;
    skos:definition "‘소원 성취’를 줄여 이르는 말. 주로 어떤 희망이나 기대가 꼭 이루어지기를 바람을 나타낸다."@ko ;
