# KN2012-0399 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0399 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "채록-가"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1357270> ;
    skos:definition "기록으로 남아 있지 않은 신화나 설화, 민요 따위를 제보자를 통해 직접 듣고 그 구술 내용을 적거나 녹음하는 사람."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2012-0399-c1 ;
    kno:component kno:KN2012-0399-c2 ;
    kno:componentString "채록(採錄), -가(家)"@ko ;
    kno:example "¶‘한국 구전 설화’에는 1920년대부터 전국을 돌며 옛이야기를 탐구한 {채록가들의} 채록본이 담겨있다."@ko ;
