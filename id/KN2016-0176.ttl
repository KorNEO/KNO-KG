# KN2016-0176 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0176 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "무인 스터디 카페"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372611> ;
    skos:definition "특별히 지키거나 관리하는 사람 없이 공부를 할 수 있도록 만든 카페. 무인 자판기 따위로 비용을 지불할 수 있도록 한다."@ko ;
    kno:activeYears "10"^^xsd:integer ;
    kno:component kno:KN2016-0176-c1 ;
    kno:component kno:KN2016-0176-c2 ;
    kno:component kno:KN2016-0176-c3 ;
    kno:componentString "무인(無人), 스터디(study), 카페(café)"@ko ;
    kno:example "¶고등학생 O 모 양은 “…{무인 스터디 카페는} 자판기로 비용을 지불하고 비용도 시간당 1천 원 정도라 부담스럽지 않다.”라고 했다."@ko ;
