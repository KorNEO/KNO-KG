# KN2017-0314 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0314 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "펨펫-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380575> ;
    skos:definition "반려동물을 가족처럼 여기는 사람. 또는 그런 무리. ⇒규범 표기는 미확정이다."@ko ;
