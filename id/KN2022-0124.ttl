# KN2022-0124 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0124 kno:instantiates kno:S000001 ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    skos:definition "특정 분야에 깊이 파고들어 시간과 돈을 소비하며 만족감을 느끼는 사람. 또는 그런 무리. 무언가를 파는 행동을 의미하는 영어 단어 ‘디깅(digging)’과 ‘족’을 결합하여 만든 말이다."@ko ;
    kno:frequency kno:KN2022-0124-freq-NN-2025 ;
    kno:pos "「명」"@ko ;
    a kno:Neologism ;
    kno:frequency kno:KN2022-0124-freq-NN-2021 ;
    kno:indexForm "디깅족"@ko ;
    rdfs:label "디깅-족"@ko ;
    kno:frequency kno:KN2022-0124-freq-NN-2023 ;
    kno:example "¶최근 자신이 좋아하는 분야를 깊게 파고드는 {디깅족이} 늘면서 생활용품 업체들이 다양한 취향을 맞추기 위한 여러 제품들을 내놓고 있다."@ko ;
    kno:languageType "영+한" ;
    kno:slotFiller "-족(族) (1성분)"@ko ;
    kno:componentString "디깅(digging), -족(族)"@ko ;
