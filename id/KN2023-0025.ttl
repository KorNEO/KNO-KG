# KN2023-0025 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0025 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "고특^회계"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B3%A0%ED%8A%B9%ED%9A%8C%EA%B3%84> ;
    skos:definition "지방 교육 재정 교부금 중 유치원 및 초중등 교육에 지원하던 지원금을 대학 지원에도 사용하기 위하여 특별히 수립한 회계. =고등 평생 교육 특별 회계."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2023-0025-c1 ;
    kno:component kno:KN2023-0025-c2 ;
    kno:componentString "고특(高特), 회계(會計)"@ko ;
    kno:example "¶{고특 회계의} 재원은 교육세와 일반 재정으로, 재원 조달 방식 등은 2016년 말에 국회를 통과한 유아 교육 지원 특별 회계와 거의 동일하다."@ko ;
