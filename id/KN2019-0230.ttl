# KN2019-0230 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0230 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "임밍아웃"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1516504> ;
    skos:definition "임신 사실을 공개적으로 밝히는 일. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2019-0230-c1 ;
    kno:component kno:KN2019-0230-c2 ;
    kno:componentString "임(신)(妊), (커)밍아웃(coming-out)"@ko ;
    kno:example "¶그는 “육아 휴직도 3개월만 쓰려고 한다.”라며 “출산 후 주요 업무에서 배제되며 결국 회사를 떠나야 했던 선배 사원들을 여럿 봤다. 임신 사실을 알리는 {‘임밍아웃’이} 주저되는 이유.”라고 말했다."@ko ;
