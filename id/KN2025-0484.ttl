# KN2025-0484 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0484 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "임장 보수제"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9E%84%EC%9E%A5%20%EB%B3%B4%EC%88%98%EC%A0%9C> ;
    skos:definition "(LLM) 부동산 매물을 직접 보러 가는 현장 방문(임장)에서 공인중개사가 제공한 안내ㆍ설명 등의 서비스에 대해, 계약 성사 여부와 무관하게 일정 금액을 받도록 하는 보수 제도."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2025-0484-c1 ;
    kno:component kno:KN2025-0484-c2 ;
    kno:componentString "임장(臨場), 보수제(報酬制)"@ko ;
    kno:example "(LLM) 일부 중개업계에서는 계약이 성사되지 않더라도 현장 안내에 든 시간과 노력을 보상받아야 한다며 {임장보수제} 도입을 주장하고 있다."@ko ;
    kno:frequency kno:KN2025-0484-freq-NN-2025 ;
