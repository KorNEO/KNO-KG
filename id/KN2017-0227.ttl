# KN2017-0227 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0227 skos:definition "‘육아 퇴근’을 줄여 이르는 말. 주로 아이가 밤잠이 들고 난 뒤 육아에서 잠시 벗어나는 일을 퇴근에 비유하여 쓰는 말이다."@ko ;
    kno:formation kno:W06 ;
    a ontolex:Word ;
    kno:urimalTargetCode "1385567" ;
    kno:pos "「명」"@ko ;
    kno:componentString "육(아)(育), 퇴(근)(退)"@ko ;
    kno:registration "우리말샘"@ko ;
