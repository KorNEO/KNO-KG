    kno:component kno:KN2018-0219-c1 ;
    kno:urimalTargetCode "1416262" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416262> ;
    rdfs:label "신냉전^벨트"@ko ;
    kno:example "¶미국과 중ㆍ러가 대결하는 ‘{신냉전 벨트’는} 한반도를 비롯한 동북아뿐 아니라 동남아, 중동, 동유럽에 이르기까지 광범위하게 펼쳐지고 있다."@ko ;
    kno:component kno:KN2018-0219-c2 ;
    kno:year "2018"^^xsd:gYear ;
    kno:unitType "구"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:componentString "신(新)-, 냉전(冷戰), 벨트(belt)"@ko ;
    skos:definition "탈냉전 시대 이후에 또다시, 직접적으로 무력을 사용하지 않고, 경제ㆍ외교ㆍ정보 따위를 수단으로 하는 국제적 대립이 나타나는 지역. 특히 탈냉전 시대 이후 패권 국가가 된 미국과 이를 견제하는 중국, 러시아와 같은 나라가 이념이나 이데올로기가 아닌 서로의 국익을 위하여 대립하는 양상이 표면적으로 드러나는 지역을 가리킨다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:frequency kno:KN2018-0219-freq-NN-2017 ;
    kno:frequency kno:KN2018-0219-freq-NN-total .
