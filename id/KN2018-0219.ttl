# KN2018-0219 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0219 kno:instantiates kno:S000158 ;
    kno:origin "(新冷戰<영>belt)" ;
    a kno:Neologism ;
    kno:slotFiller "냉전(冷戰)+벨트(belt) (2성분)"@ko ;
