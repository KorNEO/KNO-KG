# KN2023-0160 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0160 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "썰 스포츠"@ko ;
