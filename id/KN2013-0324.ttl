    rdfs:label "원^스크라이크^직무^아웃제"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9B%90%EC%8A%A4%ED%81%AC%EB%9D%BC%EC%9D%B4%ED%81%AC%EC%A7%81%EB%AC%B4%EC%95%84%EC%9B%83%EC%A0%9C> ;
    skos:definition "공금 횡령, 금품 및 향응 수수 등의 비리 를 저지른 공무원에게 중징계 처분을 내려 직무를 정지시키는 제도."@ko ;
