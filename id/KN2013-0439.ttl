# KN2013-0439 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0439 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "편순이"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1368099> ;
    skos:definition "편의점에서 아르바이트하는 여자를 낮잡아 이르는 말."@ko ;
    kno:activeYears "12"^^xsd:integer ;
    kno:component kno:KN2013-0439-c1 ;
    kno:component kno:KN2013-0439-c2 ;
    kno:componentString "편(의점)(便), 순이"@ko ;
    kno:example "¶또한, OOO이라는 필명의 네티즌은 지난 3일 올린 글에서 자신을 ‘OO {편순이’라고} 소개하며 실내 청소, 바깥 파라솔 청소, 냉장고 채우기, 재고 조사 등 “시급에 비해서 열심히 하는 것 같은데 유독 꼼꼼한 점장 탓에 개고생 중임.”이라고 말했다."@ko ;
