# KN2025-0123 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0123 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "내란 좀비 당"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%82%B4%EB%9E%80%20%EC%A2%80%EB%B9%84%20%EB%8B%B9> ;
    skos:definition "(LLM) 헌정 질서를 무너뜨리는 내란ㆍ쿠데타를 옹호하거나 그에 동조한다고 여겨지는 특정 정당 또는 그 지지층을 비난하여 이르는 말. 비하의 의미가 포함되어 있어 사용에 주의가 필요하다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2025-0123-c1 ;
    kno:component kno:KN2025-0123-c2 ;
    kno:component kno:KN2025-0123-c3 ;
    kno:componentString "내란(內亂), 좀비(zombie), 당(黨)"@ko ;
    kno:example "(LLM) 그는 해당 정당이 과거의 내란을 미화한다며, 온라인에서는 아예 {내란좀비당}이라는 말까지 나온다고 지적했다."@ko ;
