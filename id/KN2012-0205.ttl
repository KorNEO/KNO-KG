# KN2012-0205 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0205 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "소방 훈련 지역"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%86%8C%EB%B0%A9%20%ED%9B%88%EB%A0%A8%20%EC%A7%80%EC%97%AD> ;
    skos:definition "화재가 발생하였을 때 효율적으로 피난하거나 대처할 수 있는 훈련을 실시하는 지역."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2012-0205-c1 ;
    kno:component kno:KN2012-0205-c2 ;
    kno:component kno:KN2012-0205-c3 ;
    kno:componentString "소방(消防), 훈련(訓鍊), 지역(地域)"@ko ;
    kno:example "¶이중 정중앙 지역은 콘크리트가 덮힌 {소방 훈련 지역이고} 우측의 직사각형 모양은 자동차 바퀴 세척 지역으로 시멘트 콘크리트 내의 철망으로 인해 이상 징후가 발견된 것으로 분석됐다."@ko ;
    kno:indexForm "소방훈련지역"@ko ;
    kno:instantiates kno:S000168 ;
    kno:instantiates kno:S001381 ;
    kno:languageType "한_한_한" ;
    kno:origin "(消防訓鍊地域)" ;
    kno:pos "「구」"@ko ;
