# F003434 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003434 rdfs:label "메기"@ko ;
    kno:surfaceForm "메기"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=551855> ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-L2 ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "메깃과의 민물고기. 몸의 길이는 25~30cm가 보통이나 간혹 1미터가 넘는 것도 있다. 어두운 갈색이고 불규칙한 얼룩무늬가 있으며, 비늘이 없고 미끈거린다. 머리는 넓적하고 입은 매우 크며 네 개의 긴 수염이 있다. 한국, 일본, 중국, 대만 등지에 분포한다. 〔명사〕"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    a kno:Formative ;
    kno:fullForm "메기"@ko ;
    kno:urimalTargetCode "551855" .
kno:KN2018-0119-c1 kno:formative kno:F003434 .
