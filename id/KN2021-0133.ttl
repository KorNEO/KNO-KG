kno:KN2021-0133 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "백신^디바이드"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1542942> ;
    skos:definition "백신을 확보한 나라와 그렇지 않은 나라 간에 발생하는 사회 경제적 격차. 코로나19가 전 세계적으로 유행한 상황에서 나온 말이다."@ko ;
