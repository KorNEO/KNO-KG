# KN2022-0121 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0121 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "동맹^쇼어링"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8F%99%EB%A7%B9%EC%87%BC%EC%96%B4%EB%A7%81> ;
    skos:definition "글로벌 경제 위기에 대비하기 위해 동맹국이나 우방국끼리 공급망을 공동으로 구축하는 일. 코로나19 팬데믹의 영향으로 글로벌 공급망이 불안정해진 상황에서 나온 말이다. =깐부 쇼어링, 프렌드 쇼어링."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2022-0121-c1 ;
    kno:component kno:KN2022-0121-c2 ;
    kno:componentString "동맹(同盟), 쇼어링(shoring)"@ko ;
    kno:example "¶코로나19 확산 초기에 중국과 서구 사회의 대립이 심화되자, 미국을 중심으로 {동맹 쇼어링이} 논의되기 시작하였다."@ko ;
