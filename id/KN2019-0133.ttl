    kno:activeYears "0"^^xsd:integer ;
    kno:example "¶또한, OOO 형제의 부모로 촉발된 {‘빚투’가} 연예계 전반으로 확산될 조짐이라는 점에서 향후 관련 문제가 쉽게 수습되기는 어려워 보인다."@ko ;
    kno:languageType "고+영" ;
    kno:component kno:KN2019-0133-c2 ;
    kno:instantiates kno:S000112 ;
    a kno:Neologism ;
    skos:definition "빚과 ‘나도 당했다’는 의미의 ‘미 투(me too)’를 결합하여 만든 말로, 타인에게 빌려준 돈을 받지 못한 경험을 밝히는 일. ⇒규범 표기는 미확정이다."@ko ;
    kno:unitType "단어"@ko ;
    kno:predicate "밝히다"@ko .
