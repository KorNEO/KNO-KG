    rdfs:label "두부(豆腐)"@ko ;
    kno:urimalDefinition "콩으로 만든 식품의 하나. 물에 불린 콩을 갈아서 짜낸 콩 물을 끓인 다음 간수를 넣어 엉기게 하여 만든다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=381852> ;
    kno:urimalTargetCode "381852" ;
