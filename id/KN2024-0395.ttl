@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0395 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2024-0395-att-nn ;
    ontolex:canonicalForm kno:KN2024-0395-form ;
    ontolex:sense kno:KN2024-0395-sense .

kno:KN2024-0395-att-nn a frac:Attestation ;
    dcterms:date "2023-11-14"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/001/0014329952> .

kno:KN2024-0395-form a ontolex:Form ;
    frac:frequency kno:KN2024-0395-freq-nn,
        kno:KN2024-0395-freq-yt ;
    ontolex:writtenRep "호주 런"@ko .

kno:KN2024-0395-freq-nn a frac:CorpusFrequency ;
    rdf:value 103 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0395-freq-yt a frac:CorpusFrequency ;
    rdf:value 80 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0395-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%9C%A4%EC%84%9D%EC%97%B4%20%EC%9D%B4%EC%A2%85%EC%84%AD%20%ED%98%B8%EC%A3%BC%20%EB%8C%80%EC%82%AC%20%EC%9E%84%EB%AA%85%20%EB%85%BC%EB%9E%80> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

