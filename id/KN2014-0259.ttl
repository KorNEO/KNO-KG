# KN2014-0259 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0259 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "카운터 다이닝"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1373889> ;
    skos:definition "카운터에 앉아 요리사와 대화를 나누며 하는 식사."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2014-0259-c1 ;
    kno:component kno:KN2014-0259-c2 ;
    kno:componentString "카운터(counter), 다이닝(dining)"@ko ;
    kno:example "¶몇 년 전만 하더라도 고급 고깃집 예약 시 룸 또는 일반석과 좀 떨어져 있는 테이블 좌석을 선호했으나, 현재는 ‘{카운터 다이닝’이라는} 신조어가 생겨날 정도로 키친을 바로 앞에서 접할 수 있는 바에 앉아 셰프가 직접 구워 주는 고기를 먹으며 대화를 즐기는 고객들이 늘고 있다."@ko ;
