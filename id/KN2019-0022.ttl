# KN2019-0022 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0022 kno:year "2019"^^xsd:gYear ;
    kno:frequency kno:KN2019-0022-freq-NN-2024 ;
    kno:instantiates kno:S001081 ;
    skos:definition "귀밑 아래턱 모양이 완만하지 않고 ‘ㄴ’ 자 모양에 가깝게 각진 턱. 지적이면서 우아한 분위기를 풍기는 턱을 이르는 말이다."@ko ;
    kno:slotFiller "귀족(貴族) (1성분)"@ko ;
    a ontolex:Word ;
    kno:activeYears "3"^^xsd:integer ;
    kno:componentString "귀족(貴族), 턱"@ko ;
    kno:frequency kno:KN2019-0022-freq-NN-2021 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B7%80%EC%A1%B1%ED%84%B1> ;
    kno:example "¶그는…“마침 OO 방송에서 내 턱이 엘(L) 라인이라며 부귀를 부르는 {귀족턱이라고} 칭찬해 주었다. 더욱 사랑해야지.…”라고 했다."@ko ;
