    rdfs:label "스닉플레이션"@ko ;
    a kno:Neologism ;
    kno:year "2025"^^xsd:gYear ;
    kno:component kno:KN2025-0364-c1 ;
    kno:example "(LLM) 관세 인상 소식이 있었지만 당장 가격표는 그대로였고, 몇 달 뒤 장바구니 비용이 눈에 띄게 늘자 사람들은 {스닉플레이션이} 진행 중이라고 말했다."@ko ;
