    kno:frequency kno:KN2018-0253-freq-NN-2019 ;
    kno:pos "「명」"@ko ;
    kno:registration "신어DB"@ko ;
    skos:definition "‘여행에 대해 잘 아는 사람’을 줄여 이르는 말. 여행에 대해 지식이 많은 사람을 가리키는 말이다."@ko ;
