# KN2023-0177 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0177 a kno:Neologism ;
    kno:origin "(壓縮消滅)" ;
    kno:pos "「구」"@ko ;
    kno:frequency kno:KN2023-0177-freq-NN-2025 ;
