# KN2018-0228 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0228 kno:formation kno:W05 ;
    a ontolex:Word ;
    kno:component kno:KN2018-0228-c2 ;
    kno:instantiates kno:S001513 ;
    kno:activeYears "1"^^xsd:integer ;
    kno:languageType "일+영" ;
    kno:unitType "단어"@ko ;
    skos:definition "정치 스캔들로 인해 일본의 ‘아베’ 총리가 퇴진할 경우 일본 증시에 투자한 외국인 투자자들이 급속도로 투자금을 회수하는 현상을 이르는 말. ‘아베 신조’ 총리의 성(姓)인 ‘아베(安倍)’와 퇴진을 뜻하는 ‘엑시트(exit)’를 결합하여 만든 말이다. ⇒규범 표기는 미확정이다. =아벡시트."@ko ;
    kno:slotFiller "(에)그지트(exit) (1성분)"@ko ;
    kno:component kno:KN2018-0228-c1 ;
    kno:example "¶모처럼의 장기 호황을 맞고 있는 일본 경제의 최대 위협은 ‘{아베그지트’라는} 분석이 나왔다."@ko ;
