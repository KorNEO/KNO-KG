# KN2020-0082 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0082 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "단마토"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8B%A8%EB%A7%88%ED%86%A0> ;
    skos:definition "일반적인 토마토에 비해 당도가 더 높은 토마토. 다량의 감미 성분을 포함하고 있는 스테비아를 이용하여 재배한 것으로 열량이 낮고 당도가 높다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2020-0082-c1 ;
    kno:component kno:KN2020-0082-c2 ;
    kno:componentString "달(다), (토)마토(tomato)"@ko ;
    kno:example "¶OOO 씨는 “요즘 {단마토의} 매력에 푹 빠져 매일 먹고 있다. 설탕을 뿌린 것처럼 달콤하고 맛있다.”라고 말했다."@ko ;
