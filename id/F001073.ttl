# F001073 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001073 a kno:Formative ;
    rdfs:label "공기(空氣)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=551772> ;
    kno:caseCount "2"^^xsd:integer ;
    kno:fullForm "공기"@ko ;
    kno:origin "空氣" ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-O1.3 ;
    kno:surfaceForm "공기"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "지구를 둘러싼 대기의 하층부를 구성하는 무색무취의 투명한 기체. 산소와 질소가 약 1 대 4의 비율로 혼합된 것을 주성분으로 하며, 그 밖에 소량의 아르곤·헬륨 따위의 불활성 가스와 이산화 탄소가 포함되어 있다. 동식물의 호흡, 소리의 전파 따위에 필수적이다. 〔명사〕"@ko ;
    kno:urimalTargetCode "551772" .
