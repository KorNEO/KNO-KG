# KN2021-0207 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0207 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "워크^레저^패션"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9B%8C%ED%81%AC%EB%A0%88%EC%A0%80%ED%8C%A8%EC%85%98> ;
    skos:definition "일할 때와 여가 시간을 보낼 때 두루 입는 옷차림. 일할 때는 적당히 격식을 차린 것처럼 보이지만 몸에 편안한 것이 특징이다. 코로나19로 인해 화상 회의 등의 비대면 환경이 자리 잡으면서 생겨난 말이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2021-0207-c1 ;
    kno:component kno:KN2021-0207-c2 ;
    kno:component kno:KN2021-0207-c3 ;
    kno:componentString "워크(work), 레저(leisure), 패션(fashion)"@ko ;
    kno:example "¶화상 회의가 일상생활이 되면서 하의보다는 상의에 더 신경을 쓰는 것도 {워크 레저 패션의} 중요한 경향이다."@ko ;
    kno:frequency kno:KN2021-0207-freq-NN-2021 ;
