# KN2021-0218 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0218 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "임대료^멈춤법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9E%84%EB%8C%80%EB%A3%8C%EB%A9%88%EC%B6%A4%EB%B2%95> ;
    skos:definition "코로나19의 확산을 방지하기 위해 정부에서 집합을 금지하거나 제한한 업종의 상인들에게 상가의 임대인이 임대료의 전체 또는 일부를 청구할 수 없게 하는 법안. 2020년 12월에 국회에서 발의되었으며 정식 명칭은 ‘상가 건물 임대차 보호법 개정안’이다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2021-0218-c1 ;
    kno:component kno:KN2021-0218-c2 ;
    kno:component kno:KN2021-0218-c3 ;
    kno:componentString "임대료(賃貸料), 멈춤, 법(法)"@ko ;
    kno:example "¶{임대료 멈춤법은} 집합 금지 조치가 내려진 업종에 대해서는 임대인이 임대료 등을 청구할 수 없게 하고, 집합을 제한한 업종의 경우 기존 임대료의 절반 이상을 청구할 수 없도록 하는 내용을 포함하고 있다."@ko ;
