# KN2021-0292 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0292 kno:year "2021"^^xsd:gYear ;
    kno:frequency kno:KN2021-0292-freq-NN-total ;
    rdfs:label "한국 여행 놀이"@ko ;
    skos:definition "외국에서, 자국을 떠나지 않고 한국을 여행하는 흉내를 내는 놀이. 주로 일본에서, 일본 내에 있는 코리아타운을 방문하거나, 집이나 호텔에서 한국 음식을 먹고 한국 콘텐츠를 감상하면서 한국을 여행하는 기분을 내며 즐기는 일을 가리키는 말이다."@ko ;
    kno:frequency kno:KN2021-0292-freq-NN-2024 ;
    kno:frequency kno:KN2021-0292-freq-NN-2023 ;
