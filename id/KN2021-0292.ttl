# KN2021-0292 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0292 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "한국 여행 놀이"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%95%9C%EA%B5%AD%20%EC%97%AC%ED%96%89%20%EB%86%80%EC%9D%B4> ;
    skos:definition "외국에서, 자국을 떠나지 않고 한국을 여행하는 흉내를 내는 놀이. 주로 일본에서, 일본 내에 있는 코리아타운을 방문하거나, 집이나 호텔에서 한국 음식을 먹고 한국 콘텐츠를 감상하면서 한국을 여행하는 기분을 내며 즐기는 일을 가리키는 말이다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2021-0292-c1 ;
    kno:component kno:KN2021-0292-c2 ;
    kno:component kno:KN2021-0292-c3 ;
    kno:componentString "한국(韓國), 여행(旅行), 놀이"@ko ;
    kno:example "¶일본에서 {한국 여행 놀이가} 유행하자 한국 관광 공사는 {한국 여행 놀이에서} 빼놓을 수 없는 음식으로 한국 치킨을 소개했다."@ko ;
