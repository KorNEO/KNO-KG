# F002772 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002772 kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "노마드"@ko ;
    kno:urimalDefinition "<FL>들뢰즈</FL>에 의해 철학적 의미를 부여받은 말로, 특정한 가치와 삶의 방식에 얽매이지 않고 끊임없이 자기 자신을 바꾸어 나가며 창조적으로 사는 인간형. 또는 여러 학문과 지식의 분야를 넘나들며 새로운 앎을 모색하는 인간형을 이르는 말. 〔명사〕"@ko ;
    rdfs:label "노마드(nomade)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:semanticTag kno:usas-M1 ;
    a kno:Formative ;
    kno:urimalTargetCode "1062780" ;
    kno:registration "우리말샘"@ko ;
    kno:origin "nomade" ;
    kno:surfaceForm "노마드"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1062780> .
kno:KN2016-0112-c2 kno:formative kno:F002772 .
