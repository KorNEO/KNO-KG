    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:frequency kno:KN2019-0284-freq-NN-total ;
    a kno:Neologism ;
    skos:definition "트럭으로 옮겨야 할 만큼 많은 자료를 가지고 하는 기소. 검찰이 피의자를 기소할 때 제출하는 수사 기록 따위의 증거 자료가 트럭으로 실어 날라야 할 만큼 많다는 데서 나온 말이다."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8A%B8%EB%9F%AD%20%EA%B8%B0%EC%86%8C> ;
    kno:origin "(<영>truck起訴)" ;
    kno:frequency kno:KN2019-0284-freq-NN-2023 ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2019-0284-c1 ;
    kno:example "¶법조계에선 “굵직한 주요 혐의만 건드리던 검찰이 최근 들어 저인망식 그물망 수사를 벌이는 탓에 {‘트럭 기소’가} 잇따르고 있다.”라고 입을 모은다."@ko ;
    kno:frequency kno:KN2019-0284-freq-NN-2020 ;
