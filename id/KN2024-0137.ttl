# KN2024-0137 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0137 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "순금^챌린지"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%88%9C%EA%B8%88%EC%B1%8C%EB%A6%B0%EC%A7%80> ;
    skos:definition "매일 돈을 조금씩 아껴 일정 금액이 모일 경우 소량의 금으로 전환하는 방식의 재테크 운동. 최근 금 가격이 상승함에 따라 청년층을 중심으로 인기를 끌고 있다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2024-0137-c1 ;
    kno:component kno:KN2024-0137-c2 ;
    kno:componentString "순금(純金), 챌린지(challenge)"@ko ;
    kno:example "¶온라인에선 한 달간 생활비를 아껴 남긴 돈으로 1~3g 내외의 작은 크기의 금으로 바꾸는 {순금 챌린지가} 인기다."@ko ;
