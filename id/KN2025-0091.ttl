# KN2025-0091 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0091 kno:pos "「구」"@ko ;
    kno:year "2025"^^xsd:gYear ;
    kno:componentString "김병기, 방지법(防止法)"@ko ;
