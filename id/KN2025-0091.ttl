    kno:frequency kno:KN2025-0091-freq-NN-total ;
    kno:unitType "구"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    skos:definition "(LLM) 국회의원의 보좌진에 대한 부당한 대우(갑질)나 가족ㆍ친인척 등의 인사 개입, 채용ㆍ인사 청탁 등 이해충돌 소지가 있는 행위를 금지하고, 위반 시 강한 제재를 부과하자는 취지로 거론되는 법안(또는 법) 명칭."@ko ;
    kno:component kno:KN2025-0091-c2 ;
