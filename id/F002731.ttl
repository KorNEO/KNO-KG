# F002731 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002731 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=490627> ;
    kno:semanticTag kno:usas-G3 ;
    kno:surfaceForm "냉전"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    rdfs:label "냉전(冷戰)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "직접적으로 무력을 사용하지 않고, 경제·외교·정보 따위를 수단으로 하는 국제적 대립. 특히 제이 차 세계 대전 이후 미국과 소련을 중심으로 한 자본주의와 공산주의의 대립을 뜻하며, 1990년 소련의 해체와 사회주의권의 몰락으로 양 진영 사이의 냉전 상태는 사실상 종결되었다. 〔명사〕"@ko ;
    kno:fullForm "냉전"@ko ;
    kno:origin "冷戰" ;
