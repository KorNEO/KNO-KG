    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-Z2 ;
    rdfs:seeAlso <https://ko.wikipedia.org/wiki/%EC%86%A1%ED%8C%8C%EA%B5%AC> ;
