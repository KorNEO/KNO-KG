# KN2024-0346 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0346 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "파틀막"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8C%8C%ED%8B%80%EB%A7%89> ;
    skos:definition "‘파를 가지고 오는 것을 틀어막음’을 줄여 이르는 말. 제22대 국회의원 선거 투표장에 대파를 반입할 수 없게 선관위에서 금지한 일로, 제20대 대통령 윤석열이 대파의 가격을 시장가보다 매우 낮게 발언한 것에 반발한 유권자들이 투표장에 대파를 들고 간 것에서 비롯되었다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2024-0346-c1 ;
    kno:component kno:KN2024-0346-c2 ;
    kno:componentString "파, 틀(어)막(다)"@ko ;
    kno:example "¶이 대변인은 대파 가격으로 국민 눈을 속이려고 해도 좋지만, 선관위까지 {파틀막을} 해서야 되겠냐고 했다."@ko ;
