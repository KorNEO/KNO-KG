# KN2016-0260 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0260 kno:origin "(生計型行政事件)" ;
    kno:component kno:KN2016-0260-c3 ;
    kno:example "¶식당 영업 정지 및 운전면허 취소 등에 불복해 소송을 내는 이른바 ‘{생계형 행정 사건’에} 대해 법원이 다음 달부터 신속하게 처리하겠다는 방침을 정했다."@ko ;
    a ontolex:MultiwordExpression ;
    kno:urimalTargetCode "1372695" ;
    kno:activeYears "1"^^xsd:integer ;
    kno:componentString "생계형(生計型), 행정(行政), 사건(事件)"@ko ;
