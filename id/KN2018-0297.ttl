# KN2018-0297 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0297 kno:indexForm "적녹보패러다임"@ko ;
    kno:component kno:KN2018-0297-c3 ;
    skos:definition "노동 운동, 환경 운동, 여성 운동을 함께 이해하는 이론적인 틀이나 체계. 이때 ‘적녹보’는 적색, 녹색, 보라색을 말하는 것으로, 각각 노동, 생태, 여성을 상징한다."@ko ;
    rdfs:label "적녹보^패러다임"@ko ;
    kno:componentString "적(색)(赤), 녹(색)(綠), 보(라색), 패러다임(paradigm)"@ko ;
    kno:unitType "구"@ko ;
    kno:origin "(赤綠보<영>paradigm)" ;
    kno:registration "신어DB"@ko ;
    kno:frequency kno:KN2018-0297-freq-NN-2018 ;
