# F005257 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005257 rdfs:label "월(wall)"@ko ;
    kno:semanticTag kno:usas-H1 ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "240879" ;
    kno:urimalDefinition "생각이나 감정을 말과 글로 표현할 때 완결된 내용을 나타내는 최소의 단위. 주어와 서술어를 갖추고 있는 것이 원칙이나 때로 이런 것이 생략될 수도 있다. 글의 경우, 문장의 끝에 ‘.’, ‘?’, ‘!’ 따위의 문장 부호를 찍는다. ‘철수는 몇 살이니?’, ‘세 살.’, ‘정말?’ 따위이다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=240879> ;
    a kno:Formative ;
    kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "월"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:origin "wall" ;
    kno:surfaceForm "월"@ko .
kno:KN2017-0296-c3 kno:formative kno:F005257 .
