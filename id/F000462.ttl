# F000462 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000462 kno:urimalTargetCode "94928" ;
    kno:urimalDefinition "국세의 하나. 관세 영역을 통해 수출·수입되거나 통과되는 화물에 대하여 부과되는 세금으로, 수출세, 수입세, 통과세의 세 종류가 있으나 현재 우리나라에는 수입세만 있다. 〔명사〕"@ko ;
    kno:fullForm "관세"@ko ;
    kno:semanticTag kno:usas-I1.3 ;
    kno:surfaceForm "관세"@ko ;
    rdfs:label "관세(關稅)"@ko ;
    kno:origin "關稅" ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=94928> ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:caseCount "4"^^xsd:integer .
