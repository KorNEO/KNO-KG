# KN2021-0195 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0195 kno:year "2021"^^xsd:gYear ;
    a ontolex:Word ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2021-0195-c2 ;
    kno:unitType "단어"@ko ;
    kno:indexForm "엘에이치로남불"@ko ;
    skos:definition "임직원들의 땅 투기를 부동산 투자라고 합리화한 한국 토지 주택 공사 직원의 발언을 ‘내로남불’에 빗대어 이르는 말. ‘내로남불’은 ‘내가 하면 로맨스, 남이 하면 불륜’을 줄여 이르는 말로, 다른 사람이 하면 비난할 행위를 자기가 할 때는 합리화하는 태도를 이르는 말이다. 한국 토지 주택 공사의 영문명 이니셜인 ‘엘에이치(LH)’의 모양이 ‘내로남불’의 ‘내’와 비슷하다는 점을 이용하여 풍자적으로 쓰는 말이다."@ko ;
    kno:registration "신어DB"@ko ;
    kno:origin "(LH<영>←romance남不)" ;
    rdfs:label "엘에이치로남불"@ko ;
    kno:frequency kno:KN2021-0195-freq-NN-total ;
