    a kno:Neologism ;
    kno:componentString "엘에이치(LH), (내)로남불(내←romance남不)"@ko ;
    kno:pos "「명」"@ko ;
    kno:languageType "영+고+한" ;
    kno:example "¶{엘에이치(LH)로남불에서} 비롯된 사태가 향후 지역 사회에 얼마나 큰 파문을 일으킬지 가늠하기조차 어려운 상황이다."@ko ;
    kno:component kno:KN2021-0195-c1 ;
