# KN2016-0082 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0082 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "다차원^빈곤율"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372517> ;
    skos:definition "여러 가지 기준에 따라 살펴본 빈곤율. 소득뿐만 아니라 자산, 주거, 건강, 고용, 사회 참여, 사회 관계망 등의 다양한 요인을 함께 고려하여 파악하는 빈곤율이다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2016-0082-c1 ;
    kno:component kno:KN2016-0082-c2 ;
    kno:componentString "다차원(多次元), 빈곤율(貧困率)"@ko ;
    kno:example "¶7가지 요인 중 2개 이상에서 빈곤 상태인 노인의 비율인 {다차원 빈곤율은} 67.3%였다."@ko ;
