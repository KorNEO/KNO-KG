# KN2012-0354 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0354 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "인증-의"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1277847> ;
    skos:definition "일정한 자격을 갖추어 특정한 전문 의료 행위를 할 수 있도록 인증받은 의사."@ko ;
    kno:activeYears "14"^^xsd:integer ;
    kno:component kno:KN2012-0354-c1 ;
    kno:component kno:KN2012-0354-c2 ;
    kno:componentString "인증(認證), -의(醫)"@ko ;
    kno:example "¶17일 OO에 따르면 대한 심장 학회 심혈관 중재 연구회는 올해 중재 시술 인증제 심사 결과 OO 대학교 병원을 비롯, OO 병원을 포함 전국 80개 병원을 인증 기관으로, 심장 내과의 292명을 {인증의로} 인정했다."@ko ;
    kno:formation kno:W02 ;
