# KN2014-0297 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0297 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "포비-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1358300> ;
    skos:definition "자신의 아이를 위해서 아낌없이 투자하는 사람. 또는 그런 무리."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2014-0297-c1 ;
    kno:component kno:KN2014-0297-c2 ;
    kno:component kno:KN2014-0297-c3 ;
    kno:componentString "포(for), (베이)비(baby), -족(族)"@ko ;
    kno:example "¶{포비족은} 일상적으로 사용하게 되는 가전제품 구매 시에도 아이를 위한 기능이 탑재돼 있는 제품을 구매하는 것은 물론 고가의 아이를 위한 전용 제품을 별도로 구매하기도 한다."@ko ;
    kno:formation kno:W02 ;
    kno:frequency kno:KN2014-0297-freq-NN-2014 ;
