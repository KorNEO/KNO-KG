kno:KN2025-0311 kno:activeYears "1"^^xsd:integer ;
    rdfs:label "사법 세탁소"@ko ;
    a ontolex:MultiwordExpression ;
    skos:definition "(LLM) 사법부가 판결ㆍ수사ㆍ재판 절차의 지연이나 판단을 통해 특정 개인ㆍ집단의 잘못을 덮어 주거나 책임을 가볍게 만들어 주는 곳을 비유적으로 이르는 말."@ko ;
    kno:example "(LLM) 일부에서는 재판이 반복해서 미뤄지는 상황을 두고 법원이 {사법세탁소로} 전락했다는 비판을 제기했다."@ko ;
