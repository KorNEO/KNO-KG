    kno:parallelFullForm kno:LEX-빌보드 ;
    kno:semanticTag kno:usas-Z3 ;
    a kno:Formative ;
    kno:urimalDefinition "1894년 미국 뉴욕에서 창간된 음악 잡지. 주로 대중음악과 음악 산업에 관련된 정보와 뉴스를 전달하며, 다양한 음악 장르의 인기 순위를 집계하여 발표하는 것으로 유명하다. ⇒규범 표기는 미확정이다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://www.wikidata.org/entity/Q485240> ;
    kno:urimalTargetCode "1395089" ;
    kno:truncated "true"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1395089> ;
