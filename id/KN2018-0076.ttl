# KN2018-0076 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0076 kno:pos "「구」"@ko ;
    rdfs:label "단톡 지옥"@ko ;
    a ontolex:MultiwordExpression ;
    skos:definition "시도 때도 없이 상사가 업무를 지시하는 회사의 단체 채팅방이나 참여를 원하지 않으나 어쩔 수 없이 성향이 맞지 않는 사람들과 함께 있는 단체 채팅방을 지옥에 빗대어 이르는 말."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:slotFiller "단(체)(團)+톡(←talk) (2성분)"@ko ;
    kno:instantiates kno:S001226 ;
    kno:origin "(團<영>←talk地獄)" ;
    kno:component kno:KN2018-0076-c3 ;
    kno:frequency kno:KN2018-0076-freq-NN-total ;
    kno:frequency kno:KN2018-0076-freq-NN-2023 ;
    kno:year "2018"^^xsd:gYear ;
    kno:lastAttestationYear "2023"^^xsd:gYear ;
    kno:component kno:KN2018-0076-c1 ;
    kno:component kno:KN2018-0076-c2 ;
    kno:example "¶O 씨는 “할 말 있으면 문자로 하면 되지, 별로 친하지도 않은 사람들끼리 모여 있는 단톡방은 정말 불편하다. 오죽하면 ‘{단톡 지옥’이라는} 말까지 생겼겠나.”라며 “단톡방을 나가면 뭐라고 할 것 같아서 억지로 있는데, 볼 때마다 스트레스라 웬만하면 신경을 쓰지 않으려고 한다.”라고 말했다."@ko ;
    kno:urimalTargetCode "1416092" ;
