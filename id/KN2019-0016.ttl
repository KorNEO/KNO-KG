# KN2019-0016 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0016 rdfs:label "공투"@ko ;
    kno:origin "(公<영>←me-too)" ;
    kno:year "2019"^^xsd:gYear ;
