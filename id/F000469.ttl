# F000469 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000469 kno:fullForm "꽃"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "종자식물의 번식 기관. 모양과 색이 다양하며, 꽃받침과 꽃잎, 암술과 수술로 이루어져 있다. 분류 기준에 따라 갖춘꽃과 안갖춘꽃, 단성화와 양성화, 통꽃과 갈래꽃, 풍매화와 충매화 따위로 나눈다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-L3 ;
    kno:surfaceForm "꽃"@ko ;
    rdfs:label "꽃"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "515401" ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=515401> ;
    kno:caseCount "4"^^xsd:integer .
