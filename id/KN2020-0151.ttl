# KN2020-0151 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0151 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "산린이"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%82%B0%EB%A6%B0%EC%9D%B4> ;
    skos:definition "산에 오르기 시작한 지 얼마 되지 않은 사람. ‘산’과 ‘어린이’를 결합하여 만든 말로 등산 초보자를 의미한다. 코로나19의 확산을 방지하기 위해 실내에서 하는 활동의 많은 부분에서 제약이 생기자 여가 활동으로 등산에 관심을 가지기 시작한 사람들이 늘어나는 상황에서 나온 말이다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2020-0151-c1 ;
    kno:component kno:KN2020-0151-c2 ;
    kno:componentString "산(山), (어)린이"@ko ;
    kno:example "¶최근 오랜 집콕 생활에서 벗어나 산을 오르려는 {산린이들이} 늘어나면서 덩달아 아웃도어 브랜드의 매출이 증가하고 있다."@ko ;
    kno:formation kno:W05 ;
