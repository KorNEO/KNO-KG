# KN2017-0272 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0272 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "치중 진담"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380258> ;
    skos:definition "치킨을 먹는 동안 털어놓는, 진심에서 우러나온 말. 술에 취하게 되면 자기의 속마음을 털어놓게 된다는 ‘취중 진담’에서 유래한 말이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2017-0272-c1 ;
    kno:component kno:KN2017-0272-c2 ;
    kno:component kno:KN2017-0272-c3 ;
    kno:componentString "치(킨)(chicken), (취)중(中), 진담(眞談)"@ko ;
    kno:example "¶치맥지교, {치중 진담을} 나누는 대상은 친구인 경우가 많다. 2011년부터 지난 1월까지 치킨과 관련해 가장 언급이 많이 된 인물 1위가 친구인 점은 이를 보여 준다."@ko ;
    kno:frequency kno:KN2017-0272-freq-NN-2017 ;
    kno:frequency kno:KN2017-0272-freq-NN-2018 ;
    kno:frequency kno:KN2017-0272-freq-NN-total ;
    kno:indexForm "치중진담"@ko ;
    kno:instantiates kno:S001598 ;
    kno:languageType "(영+한)_한" ;
    kno:lastAttestationYear "2018"^^xsd:gYear ;
    kno:origin "(<영>←chicken中眞談)" ;
    kno:pos "「구」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:slotFiller "(취)중(中)+진담(眞談) (2성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:urimalTargetCode "1380258" ;
    kno:year "2017"^^xsd:gYear .
