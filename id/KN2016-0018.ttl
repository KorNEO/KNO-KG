    rdfs:label "고용^디딤돌^프로젝트"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:example "¶OO 그룹은 청년 창업과 취업 경쟁력 확보를 위한 ‘청년 비상 프로그램’과 ‘{고용 디딤돌 프로젝트’를} 기획해 2년간 2만 4,000명에 이르는 취업ㆍ창업 인재를 양성하기로 했다."@ko ;
    kno:pos "「구」"@ko ;
    kno:indexForm "고용디딤돌프로젝트"@ko ;
    kno:component kno:KN2016-0018-c1 ;
