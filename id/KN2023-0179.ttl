# KN2023-0179 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0179 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "앱만추"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%95%B1%EB%A7%8C%EC%B6%94> ;
    skos:definition "‘앱으로 만남 추구’를 줄여 이르는 말. 교제를 목적으로 이성끼리 만나기 위한 데이팅 앱이 인기를 얻으며 사용되기 시작하였다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2023-0179-c1 ;
    kno:component kno:KN2023-0179-c2 ;
    kno:component kno:KN2023-0179-c3 ;
    kno:componentString "앱(app), 만(나다), 추(구)(追求)"@ko ;
    kno:example "¶{앱만추는} 요즘 시대의 여러 연애를 나타내는 말 중 하나이며, 특히 데이팅 앱의 사용이 늘어나면서 그 비중이 더 증가하였다."@ko ;
    kno:formation kno:W06 ;
