# KN2020-0169 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0169 kno:pos "「구」"@ko ;
    kno:frequency kno:KN2020-0169-freq-NN-total ;
    kno:instantiates kno:S000532 ;
    kno:slotFiller "감소(減少)+진술서(陳述書) (2성분)"@ko ;
    a ontolex:MultiwordExpression ;
    rdfs:label "소득 감소 진술서"@ko ;
    kno:lastAttestationYear "2022"^^xsd:gYear ;
    kno:languageType "한_한_한" ;
    kno:registration "신어DB"@ko ;
    kno:example "¶금융사에 본인이 서명한 {소득 감소 진술서를} 내면 대출 원금의 상환 유예를 신청할 수 있다."@ko ;
    kno:year "2020"^^xsd:gYear ;
    skos:definition "객관적으로 소득 감소를 증명할 자료가 없을 시, 소득 감소에 관한 내용을 본인이 스스로 작성한 문서. 정부가 코로나19로 소득이 감소하여 기존 대출의 원금을 상환하기 어려운 가계의 대출 원금 상환을 유예해 주었는데, 소득 감소를 증명할 수 없는 경우 소득 감소 진술서를 제출할 수 있도록 하였다."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%86%8C%EB%93%9D%20%EA%B0%90%EC%86%8C%20%EC%A7%84%EC%88%A0%EC%84%9C> ;
