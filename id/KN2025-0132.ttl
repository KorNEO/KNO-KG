    kno:activeYears "1"^^xsd:integer ;
    kno:year "2025"^^xsd:gYear ;
    a ontolex:MultiwordExpression ;
    kno:slotFiller "휴먼(human) (1성분)"@ko ;
    kno:example "(LLM) 회의록을 다들 AI로 요약해 공유하는데, 나는 끝까지 직접 정리해서 올리니 {노멀휴먼으로} 남은 기분이 들었다."@ko ;
    kno:component kno:KN2025-0132-c2 .
