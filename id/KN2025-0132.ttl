# KN2025-0132 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0132 skos:definition "(LLM) 인공 지능(AI) 같은 자동화 도구의 도움을 거의 받지 않고, 사람의 판단과 노동으로만 과업을 수행하는 사람을 자조적ㆍ대조적으로 이르는 말."@ko ;
    kno:unitType "구"@ko ;
    a kno:Neologism ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%85%B8%EB%A9%80%20%ED%9C%B4%EB%A8%BC> ;
    rdfs:label "노멀 휴먼"@ko ;
