# KN2024-0013 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0013 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "교권^보험"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B5%90%EA%B6%8C%EB%B3%B4%ED%97%98> ;
    skos:definition "교사가 교권 침해로부터 발생할 수 있는 법적ㆍ재정적 손실을 대비하기 위해 가입하는 보험. 교육 활동 침해가 공식적으로 인정될 경우 보험금을 지급하며, 법률 비용, 벌금, 휴직 수당 등이 보장된다. 최근 교권 침해 사례 증가와 공적 보호 체계의 부족으로 인해 가입이 급증하고 있다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2024-0013-c1 ;
    kno:component kno:KN2024-0013-c2 ;
    kno:componentString "교권(敎權), 보험(保險)"@ko ;
    kno:example "¶이런 현실 속에서 교사들은 스스로를 지키기 위해 {교권 보험과} 같은 개인 보험에 가입하며 각자도생의 길을 택하고 있다."@ko ;
    kno:frequency kno:KN2024-0013-freq-NN-2023 ;
    kno:frequency kno:KN2024-0013-freq-NN-total ;
    kno:indexForm "교권보험"@ko ;
    kno:instantiates kno:S000355 ;
    kno:instantiates kno:S001145 ;
    kno:languageType "한^한" ;
    kno:lastAttestationYear "2023"^^xsd:gYear ;
    kno:origin "(敎權保險)" ;
    kno:pos "「구」"@ko ;
    kno:predicate "가입하다"@ko ;
    kno:registration "신어DB"@ko ;
    kno:slotFiller "교권(敎權) (1성분)"@ko ;
    kno:slotFiller "보험(保險) (1성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:year "2024"^^xsd:gYear .
