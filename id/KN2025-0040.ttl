# KN2025-0040 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0040 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "계단형 양극화"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B3%84%EB%8B%A8%ED%98%95%20%EC%96%91%EA%B7%B9%ED%99%94> ;
    skos:definition "(LLM) 주택 가격이 가격대별로 여러 단계로 갈라져 움직이면서, 고가 주택은 오르고 중저가 주택은 정체ㆍ하락하는 등 구간별 격차가 누적ㆍ확대되는 현상."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2025-0040-c1 ;
    kno:component kno:KN2025-0040-c2 ;
    kno:componentString "계단형(階段形), 양극화(兩極化)"@ko ;
    kno:example "(LLM) 서울에서도 핵심지 초고가 아파트는 신고가가 이어지는 반면 외곽 중저가 단지는 거래 부진과 가격 조정이 겹치며 {계단형양극화가} 뚜렷해졌다는 분석이 나온다."@ko ;
