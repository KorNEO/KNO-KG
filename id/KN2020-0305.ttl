    kno:pos "「구」"@ko ;
    kno:component kno:KN2020-0305-c2 ;
    kno:indexForm "정보감염증"@ko ;
    kno:component kno:KN2020-0305-c1 ;
    kno:frequency kno:KN2020-0305-freq-NN-total ;
    kno:frequency kno:KN2020-0305-freq-NN-2021 ;
    kno:languageType "한_한" ;
    kno:example "¶언론 관계자들은 최근 코로나19와 관련된 일부 국민들의 {정보 감염증}을 우려하며, 해당 정보를 수용하기에 앞서 정보의 출처와 사실 관계를 먼저 확인해야 한다고 말했다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:urimalTargetCode "1485728" ;
