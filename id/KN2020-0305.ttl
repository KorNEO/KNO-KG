# KN2020-0305 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0305 kno:frequency kno:KN2020-0305-freq-NN-2020 ;
    kno:origin "(情報感染症)" ;
    kno:frequency kno:KN2020-0305-freq-NN-2022 ;
    a ontolex:MultiwordExpression ;
    kno:lastAttestationYear "2022"^^xsd:gYear ;
    kno:year "2020"^^xsd:gYear ;
    skos:definition "사실 확인 없이 과도하게 생산되어 유통되는 정보에 과민하게 반응하는 현상을 일컫는 말. 코로나19와 관련하여 확인되지 않은 정보가 급속히 퍼지면서 혼란을 가져오는 데서 생겨난 말이다."@ko ;
    kno:instantiates kno:S000648 ;
    kno:registration "우리말샘"@ko ;
    rdfs:label "정보 감염증"@ko ;
    kno:unitType "구"@ko ;
