# KN2019-0218 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0218 kno:indexForm "유관순서훈승격특별법"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:example "¶이와 함께 O 의원은 충남도, 천안시와 함께 ‘{유관순 서훈 승격 특별법}’ 통과를 위한 100만 국민 청원 운동을 전개할 계획이다."@ko ;
    kno:origin "(柳寬順敍勳昇格特別法)" ;
    kno:languageType "한^한^한^한" ;
    rdfs:label "유관순^서훈^승격^특별법"@ko ;
