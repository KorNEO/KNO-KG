kno:F001523 kno:surfaceForm "스키"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:label "스키(ski)"@ko ;
    kno:urimalDefinition "눈 위를 지치는 데 쓰는 좁고 긴 판상(板狀)의 기구. 나무나 금속, 플라스틱으로 만들어 신발이 부착되어 있으며 2개의 지팡이를 짚고 달린다. 〔명사〕"@ko ;
    kno:origin "ski" ;
    kno:semanticTag kno:usas-K5.1 ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=15288> ;
    kno:caseCount "2"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "스키"@ko ;
