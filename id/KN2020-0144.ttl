kno:KN2020-0144 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "비화이트^리스트"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B9%84%ED%99%94%EC%9D%B4%ED%8A%B8%EB%A6%AC%EC%8A%A4%ED%8A%B8> ;
    skos:definition "일본 정부가 외국과 교역 시 전략 물자 수출 절차를 간소화할 수 있도록 지정한 우대국 리스트에 포함되지 않는 국가들의 목록."@ko ;
