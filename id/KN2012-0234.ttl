# KN2012-0234 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0234 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "스펙^푸어"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1357066> ;
    skos:definition "직장을 구하기 위해 필요한 학력, 학점, 토익 점수 따위를 올리기 위한 비용의 지출로 가난해져 살기 어려운 사람."@ko ;
