# KN2024-0126 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0126 a kno:Neologism ;
    kno:formation kno:W01 ;
    kno:indexForm "선납후검"@ko ;
    kno:component kno:KN2024-0126-c1 ;
    skos:definition "‘선 납품 후 검사’를 줄여 이르는 말. 긴급 소요나 국가 재난이 발생했을 경우 군수품을 먼저 납품받고 이후에 품질 검사를 받게 하는 제도를 말한다."@ko ;
    kno:lastAttestationYear "2023"^^xsd:gYear ;
    kno:year "2024"^^xsd:gYear ;
    kno:frequency kno:KN2024-0126-freq-NN-total ;
    kno:activeYears "1"^^xsd:integer ;
    kno:languageType "한+한" ;
    kno:registration "신어DB"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%84%A0%EB%82%A9%ED%9B%84%EA%B2%80> ;
    kno:origin "(先納後檢)" ;
    kno:example "¶감사원은 방탄 헬멧의 구매 과정에서 군이 {선납후검의} 요건에 해당되지 않음에도 불구하고 이를 승인하고 품질 검사의 결과까지 허위로 기록한 사실을 적발했다."@ko ;
    kno:componentString "선납(先納), 후검(後檢)"@ko ;
    a ontolex:Word ;
    kno:component kno:KN2024-0126-c2 ;
    kno:pos "「명」"@ko ;
    kno:frequency kno:KN2024-0126-freq-NN-2023 ;
    kno:unitType "단어"@ko ;
    rdfs:label "선납-후검"@ko .
