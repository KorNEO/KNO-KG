@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0532 a ontolex:Word ;
    frac:attestation kno:KN2025-0532-att-nn ;
    ontolex:canonicalForm kno:KN2025-0532-form ;
    ontolex:sense kno:KN2025-0532-sense .

kno:KN2025-0532-att-nn a frac:Attestation ;
    dcterms:date "2025-10-16"^^xsd:date ;
    frac:locus <https://m.sports.naver.com/article/421/0008543517> .

kno:KN2025-0532-form a ontolex:Form ;
    frac:frequency kno:KN2025-0532-freq-nn,
        kno:KN2025-0532-freq-yt ;
    ontolex:writtenRep "중꺾도마"@ko .

kno:KN2025-0532-freq-nn a frac:CorpusFrequency ;
    rdf:value 5 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0532-freq-yt a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0532-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

