@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0705 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2025-0705-att-nn ;
    ontolex:canonicalForm kno:KN2025-0705-form ;
    ontolex:sense kno:KN2025-0705-sense .

kno:KN2025-0705-att-nn a frac:Attestation ;
    dcterms:date "2025-04-17"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/117/0003933829> .

kno:KN2025-0705-form a ontolex:Form ;
    frac:frequency kno:KN2025-0705-freq-nn,
        kno:KN2025-0705-freq-yt ;
    ontolex:writtenRep "힙레 안무"@ko .

kno:KN2025-0705-freq-nn a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0705-freq-yt a frac:CorpusFrequency ;
    rdf:value 48 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0705-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

