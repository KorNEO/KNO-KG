# KN2020-0044 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0044 rdfs:label "기본^재난^지원금"@ko ;
    kno:component kno:KN2020-0044-c2 ;
    kno:example "¶O 의원은 “코로나19가 진정될 기미가 없는 상태에서 민간 소비가 활성화될 수 있도록 {기본 재난 지원금의} 편성에 하루빨리 착수해야 한다.”라고 강조했다."@ko ;
    kno:frequency kno:KN2020-0044-freq-NN-2021 ;
    kno:instantiates kno:S001250 ;
    kno:origin "(基本災難支援金)" ;
    kno:frequency kno:KN2020-0044-freq-NN-2020 ;
    kno:predicate "지급하다"@ko ;
    kno:instantiates kno:S001018 ;
    kno:component kno:KN2020-0044-c1 ;
    kno:registration "신어DB"@ko ;
    kno:lastAttestationYear "2021"^^xsd:gYear ;
    kno:year "2020"^^xsd:gYear ;
    kno:frequency kno:KN2020-0044-freq-NN-total ;
    kno:slotFiller "기본(基本) (1성분)"@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2020-0044-c3 ;
    kno:componentString "기본(基本), 재난(災難), 지원금(支援金)"@ko ;
    a ontolex:MultiwordExpression ;
    kno:pos "「구」"@ko ;
    kno:slotFiller "지원금(支援金) (1성분)"@ko ;
    skos:definition "전국적인 재난 사태로 인해 국민들에게 정부가 지급하는 지원금. 코로나19의 확산으로 인한 경제 위축이 장기화되자 국민들의 생계를 지원하고 위축된 소비 심리를 진작하기 위해 마련된 제도로, 지급 주체가 지방 자치 단체일 경우 각 지방 자치 단체에 따라 지급 내용과 용어가 조금씩 다르다."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%B0%EB%B3%B8%EC%9E%AC%EB%82%9C%EC%A7%80%EC%9B%90%EA%B8%88> ;
    a kno:Neologism ;
    kno:languageType "한^한^한" ;
    kno:indexForm "기본재난지원금"@ko ;
    kno:unitType "구"@ko .
