# KN2023-0046 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0046 kno:instantiates kno:S000801 ;
    kno:unitType "구"@ko ;
    kno:slotFiller "기절(氣絕) (1성분)"@ko ;
    kno:component kno:KN2023-0046-c1 ;
    kno:example "¶OOO은 주 69시간 제도는 실제 노동 현실을 모르는 {기절 근무표이자} 과로사를 조장하는 정책이라고 날을 세웠다."@ko ;
    kno:year "2023"^^xsd:gYear ;
    kno:componentString "기절(氣絕), 근무표(勤務表)"@ko ;
