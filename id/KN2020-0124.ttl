# KN2020-0124 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0124 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "부머 리무버"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B6%80%EB%A8%B8%20%EB%A6%AC%EB%AC%B4%EB%B2%84> ;
    skos:definition "베이비 부머 세대에게 치명적으로 작용할 수 있는 코로나19를 이르는 말. ‘베이비 부머’ 세대를 뜻하는 ‘부머(boomer)’와 없앤다는 의미의 ‘리무버(remover)’를 결합하여 만든 말로, 코로나19가 현재 노인 세대인 베이비 부머 세대에게 치명적으로 작용하여 사망으로 이르게 하는 경우가 많다는 데에서 유래하였다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2020-0124-c1 ;
    kno:component kno:KN2020-0124-c2 ;
    kno:componentString "부머(boomer), 리무버(remover)"@ko ;
    kno:example "¶{부머 리무버는} 코로나19가 노년층을 주로 없애는 질병이라는 일종의 젊은 세대들의 비아냥거림이다."@ko ;
    kno:frequency kno:KN2020-0124-freq-NN-2020 ;
    kno:frequency kno:KN2020-0124-freq-NN-2021 ;
    kno:frequency kno:KN2020-0124-freq-NN-2022 ;
    kno:frequency kno:KN2020-0124-freq-NN-total ;
    kno:indexForm "부머리무버"@ko ;
    kno:instantiates kno:S001321 ;
    kno:languageType "영_영" ;
    kno:lastAttestationYear "2022"^^xsd:gYear ;
    kno:origin "(<영>boomer remover)" ;
    kno:pos "「구」"@ko ;
