# KN2018-0144 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0144 skos:definition "이탈리아 베네치아에서, 주민들이 너무 많은 관광객들로 인해 도시를 떠나 다른 곳으로 이주하는 현상을 이르는 말. ‘베네치아(Venezia)’와 ‘대탈출’을 뜻하는 ‘엑소더스(exodus)’를 결합하여 만든 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:pos "「명」"@ko ;
    kno:origin "(<영>Venexodus)" ;
    rdfs:label "베넥소더스"@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:year "2018"^^xsd:gYear ;
    kno:component kno:KN2018-0144-c1 ;
    kno:registration "우리말샘"@ko ;
    kno:languageType "영" ;
    a kno:Neologism ;
    kno:example "¶도시 곳곳엔 베네치아와 대탈출의 합성어인 ‘{베넥소더스’라고} 적힌 현수막도 걸렸다."@ko ;
