# KN2019-0147 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0147 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "설참"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%84%A4%EC%B0%B8> ;
    skos:definition "‘설명 참고’ 또는 ‘설명 참조’를 줄여 이르는 말. 주로 영상이나 제목 등에 긴 내용을 다 담기 어려울 때, 뒤에 설명을 덧붙이며 이를 참고하라는 뜻으로 쓰는 말이다."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2019-0147-c1 ;
    kno:component kno:KN2019-0147-c2 ;
    kno:componentString "설(명)(說), 참(조)(參)"@ko ;
    kno:example "¶구구절절한 텍스트보다 간명한 비주얼의 영상을 선호하는 젊은 세대를 중심으로 영상 제작 트렌드가 바뀜에 따라 {‘설참’은} 미처 영상에 내용을 담지 못한 이의 친절 어린 호소로도 읽힌다."@ko ;
    kno:formation kno:W06 ;
    kno:indexForm "설참"@ko ;
    kno:languageType "한+한" ;
    kno:origin "(說參)" ;
    kno:pos "「명」"@ko ;
