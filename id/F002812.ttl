# F002812 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002812 kno:semanticTag kno:usas-B1 ;
    a kno:Formative ;
    kno:urimalDefinition "눈알 바깥면의 위에 있는 눈물샘에서 나오는 분비물. 늘 조금씩 나와서 눈을 축이거나 이물질을 씻어 내는데, 자극이나 감동을 받으면 더 많이 나온다. 〔명사〕"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:label "눈(물)"@ko ;
    kno:urimalTargetCode "380239" ;
    kno:fullFormLexeme kno:LEX-눈물 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%88%88> ;
    kno:surfaceForm "눈"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    kno:fullForm "눈물"@ko ;
    kno:parallelFullForm kno:LEX-눈물 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=380239> ;
    kno:semanticTag kno:usas-E4.1m ;
    kno:registration "우리말샘"@ko .
kno:KN2015-0264-c2 kno:formative kno:F002812 .
