# KN2022-0300 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0300 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "플랫폼^분쟁^조정위"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%94%8C%EB%9E%AB%ED%8F%BC%EB%B6%84%EC%9F%81%EC%A1%B0%EC%A0%95%EC%9C%84> ;
    skos:definition "플랫폼 사업자, 이용 사업자, 최종 이용자 간 분쟁을 신속하고 효율적으로 해결하기 위해 조직된 위원회. 코로나19의 확산으로 인해 증가한 비대면 온라인 서비스의 분쟁을 해결하고자 조직되었다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2022-0300-c1 ;
