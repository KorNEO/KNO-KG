    a kno:Neologism ;
    rdfs:label "비상경 서류 분쇄"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B9%84%EC%83%81%EA%B2%BD%20%EC%84%9C%EB%A5%98%20%EB%B6%84%EC%87%84> ;
    skos:definition "상경 계열을 전공하지 않은 사람의 입사 지원서는 서류 전형에서부터 배제된다는 것을 비유적으로 이르는 말."@ko ;
