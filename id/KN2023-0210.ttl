    kno:unitType "구"@ko ;
    rdfs:label "월급 채굴"@ko ;
    a ontolex:MultiwordExpression ;
    kno:languageType "한_한" ;
    kno:example "¶주식 투자 실패로 마이너스가 된 계좌를 회복시키려면 월급을 받아 메우는 수밖에 없다는 자조적 의미에서 ‘{월급 채굴’이라는} 말도 등장했다."@ko ;
