# KN2020-0090 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0090 kno:origin "(東學개미)" ;
    skos:definition "동학 개미 운동에 참여한 국내 개인 투자자들을 이르는 말. 코로나19의 확산과 그에 따른 경제 위기로 인해, 우리나라 주식 시장에서 외국인 투자자들의 대규모 매도세와 국내 개인 투자자들의 대규모 매수세가 맞물린 상황에서, 코스피 지수 및 코스닥 지수의 폭락을 막기 위해 매도된 매물을 조금이라도 매수한 사람을 말한다."@ko ;
    a ontolex:MultiwordExpression ;
    kno:year "2020"^^xsd:gYear ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1494619> ;
