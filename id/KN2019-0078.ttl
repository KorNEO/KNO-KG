# KN2019-0078 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0078 kno:instantiates kno:S000251 ;
    kno:component kno:KN2019-0078-c1 ;
    kno:registration "신어DB"@ko ;
    skos:definition "‘마라 덕후’를 줄여 이르는 말. 얼얼하면서 매운 맛을 내는 ‘마라’라는 향신료를 넣은 음식 따위를 열성적으로 좋아하는 사람을 뜻하는 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:indexForm "마덕"@ko ;
    kno:pos "「명」"@ko ;
    kno:formation kno:W06 ;
    kno:component kno:KN2019-0078-c2 ;
