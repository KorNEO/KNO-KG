    a ontolex:Word ;
    kno:origin "(<중>←mala[麻辣]덕)" ;
    a kno:Neologism ;
    kno:languageType "중+고" ;
    kno:year "2019"^^xsd:gYear ;
    kno:unitType "단어"@ko ;
    kno:example "¶마늘과 고춧가루로 매운맛을 내는 한국 음식과 달리 마라는 독특한 매운맛으로 마라에 중독되어 헤어 나오지 못하는 수많은 {‘마덕’들을} 양산했다."@ko ;
