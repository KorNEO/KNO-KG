# F001925 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001925 kno:urimalDefinition "검찰 수사의 공정성을 기대할 수 없거나 수사가 공정하게 이루어졌다고 볼 수 없는 사건에 대하여 특별 검사에게 수사권을 맡기는 제도. 검찰 수사에 영향을 줄 수 있는 고위 공직자나 검찰의 고위 간부가 수사의 대상이 되었을 때 실시한다. 검찰의 수사가 어렵다고 여겨지는 사건에 한하여 특별 검사에게 수사권을 주어 맡기도록 한 법이다. 〔명사〕"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=811821> ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "811821" ;
    kno:fullForm "특검법"@ko ;
    rdfs:label "특검법(特檢法)"@ko ;
    kno:surfaceForm "특검법"@ko ;
    kno:semanticTag kno:usas-G2.1 ;
    kno:caseCount "2"^^xsd:integer ;
    kno:origin "特檢法" .
