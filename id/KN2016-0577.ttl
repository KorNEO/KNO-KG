kno:KN2016-0577 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "해상 올레길"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%95%B4%EC%83%81%20%EC%98%AC%EB%A0%88%EA%B8%B8> ;
    skos:definition "제주 해군 기지의 외곽 방파제에 위치한, 도보로 여행할 수 있도록 개발된 길. 걷기 좋도록 정비하여 만든 길로 걸으면서 경관을 감상할 수 있다. ⇒규범 표기는 ‘해상 올렛길’이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2016-0577-c1 ;
