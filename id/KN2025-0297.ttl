# KN2025-0297 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0297 kno:component kno:KN2025-0297-c4 ;
    rdfs:label "불법 파업 면허법"@ko ;
    kno:instantiates kno:S000484 ;
    kno:example "(LLM) 일부에서는 노조법 개정안을 두고 {불법파업면허법이라} 부르며 불법 파업에 대한 책임이 느슨해질 수 있다고 반발했다."@ko ;
    kno:origin "(不法罷業免許法)" ;
    kno:component kno:KN2025-0297-c3 ;
    kno:componentString "불법(不法), 파업(罷業), 면허(免許), 법(法)"@ko ;
    kno:unitType "구"@ko ;
    kno:frequency kno:KN2025-0297-freq-NN-2025 ;
    kno:slotFiller "면허(免許) (1성분)"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:year "2025"^^xsd:gYear ;
    kno:frequency kno:KN2025-0297-freq-NN-total ;
    skos:definition "(LLM) ‘노동조합 및 노동 관계 조정법 2ㆍ3조 개정에 관한 법률안’(일명 노란봉투법)을 비난조로 이르는 말. 개정안이 노동조합에 대한 손해 배상 청구를 제한하고 사용자 범위를 확대하는 내용 등을 담아 불법 파업에 대한 책임을 약화시켜 사실상 불법 파업을 용인할 수 있다는 우려에서 나온 표현이다."@ko ;
