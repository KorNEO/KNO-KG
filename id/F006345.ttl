# F006345 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006345 kno:caseCount "1"^^xsd:integer ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=302180> ;
    kno:semanticTag kno:usas-E6p ;
    kno:urimalDefinition "샤크 아우구스트 스텐베르 크로그, 덴마크의 생리학자(1874~1949). 분압차설(分壓差說)을 제창하였고, 원형질막의 투과성에 관하여서도 연구하였다. 모세 혈관의 운동 기능 조절에 관한 연구로 1920년 노벨 생리·의학상을 받았다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "크로그"@ko ;
    kno:origin "krogh" ;
    kno:surfaceForm "크로그"@ko ;
    rdfs:label "크로그(krogh)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:semanticTag kno:usas-H2 ;
    kno:urimalTargetCode "302180" .
kno:KN2017-0370-c2 kno:formative kno:F006345 .
