# KN2025-0229 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0229 a kno:Neologism ;
    kno:origin "(<영>multi tab症候群)" ;
    kno:unitType "구"@ko ;
    kno:indexForm "멀티탭증후군"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    skos:definition "(LLM) 컴퓨터나 스마트폰에서 여러 탭ㆍ창ㆍ앱을 동시에 띄워 놓고 일을 처리하느라 주의가 분산되고, 피로ㆍ불안ㆍ스트레스가 누적되는 상태를 이르는 말."@ko ;
    kno:year "2025"^^xsd:gYear ;
    kno:pos "「구」"@ko ;
    kno:componentString "멀티(multi), 탭(tab), 증후군(症候群)"@ko ;
    a ontolex:MultiwordExpression ;
    kno:instantiates kno:S000031 ;
    kno:languageType "영_영_한" ;
    kno:example "(LLM) 회의 자료 찾느라 브라우저 탭이랑 메신저 창을 잔뜩 켜 두고 일했더니 {멀티탭증후군이} 온 것처럼 집중이 안 되고 머리가 멍했다."@ko ;
    kno:component kno:KN2025-0229-c2 ;
