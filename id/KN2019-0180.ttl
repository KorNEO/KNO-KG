# KN2019-0180 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0180 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "실감^세대"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1423791> ;
    skos:definition "현실에서 직접 경험하는 것을 즐기는 세대. 브이아르(VR) 게임과 같은 체험형 게임을 즐기거나, 실제로 상품을 보고 체험할 수 있는 매장을 찾아가는 등 실제적인 경험을 중요시한다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2019-0180-c1 ;
    kno:component kno:KN2019-0180-c2 ;
    kno:componentString "실감(實感), 세대(世代)"@ko ;
    kno:example "¶이외에도 브이아르(VR), 방 탈출 등으로 대표되는 체험형 카페나 이미지 사진을 직접 찍을 수 있는 셀프 스튜디오 등이 {실감 세대의} 취향을 조준하는 새로운 형태의 사업 아이템이다."@ko ;
    kno:frequency kno:KN2019-0180-freq-NN-2018 ;
