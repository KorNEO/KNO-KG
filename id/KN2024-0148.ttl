@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0148 a ontolex:Word ;
    frac:attestation kno:KN2024-0148-att-nn ;
    ontolex:canonicalForm kno:KN2024-0148-form ;
    ontolex:sense kno:KN2024-0148-sense .

kno:KN2024-0148-att-nn a frac:Attestation ;
    dcterms:date "2023-08-16"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/277/0005300378> .

kno:KN2024-0148-form a ontolex:Form ;
    frac:frequency kno:KN2024-0148-freq-nn,
        kno:KN2024-0148-freq-yt ;
    ontolex:writtenRep "스트림플레이션"@ko .

kno:KN2024-0148-freq-nn a frac:CorpusFrequency ;
    rdf:value 616 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0148-freq-yt a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0148-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%94%94%EC%A7%80%ED%84%B8%20%EC%9D%B4%EB%AF%BC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

