# KN2016-0433 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0433 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "자유^대의원"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372868> ;
    skos:definition "미국의 대통령 선출을 위한 전당 대회에서, 특정 후보의 지지를 표명할 의무 없이 어느 후보에게나 자유로이 투표할 수 있는 대의원을 이르는 말. ‘비구속 대의원’ 또는 ‘비선언 대의원’이라고도 한다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2016-0433-c1 ;
    kno:component kno:KN2016-0433-c2 ;
    kno:componentString "자유(自由), 대의원(代議員)"@ko ;
    kno:example "¶{자유 대의원은} 7월 OO에 열릴 전당 대회에서 누구에게나 표를 던질 수 있다."@ko ;
    kno:frequency kno:KN2016-0433-freq-NN-2016 ;
    kno:frequency kno:KN2016-0433-freq-NN-total ;
    kno:indexForm "자유대의원"@ko ;
    kno:instantiates kno:S001538 ;
    kno:languageType "한^한" ;
    kno:lastAttestationYear "2016"^^xsd:gYear ;
    kno:origin "(自由代議員)" ;
    kno:pos "「구」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:slotFiller "대의원(代議員) (1성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:urimalTargetCode "1372868" ;
    kno:year "2016"^^xsd:gYear .
kno:KN2016-0433-c1 a kno:Component ;
