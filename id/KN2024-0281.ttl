    kno:component kno:KN2024-0281-c2 ;
    rdfs:label "지국비국"@ko ;
    a kno:Neologism ;
    skos:definition "‘지역구 의원은 국민의 힘 후보에, 비례 대표 의원은 국민의 미래 후보에 투표’를 줄여 이르는 말. 2024년 4월 10일에 실시된 대한민국 제22대 국회 의원 선거에서 나온 표현이다."@ko ;
