@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0550 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2025-0550-att-nn ;
    ontolex:canonicalForm kno:KN2025-0550-form ;
    ontolex:sense kno:KN2025-0550-sense .

kno:KN2025-0550-att-nn a frac:Attestation ;
    dcterms:date "2025-05-11"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/648/0000036040> .

kno:KN2025-0550-form a ontolex:Form ;
    frac:frequency kno:KN2025-0550-freq-nn,
        kno:KN2025-0550-freq-yt ;
    ontolex:writtenRep "차원 달라 병"@ko .

kno:KN2025-0550-freq-nn a frac:CorpusFrequency ;
    rdf:value 6 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0550-freq-yt a frac:CorpusFrequency ;
    rdf:value 163 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0550-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%B0%A8%EC%9B%90%EB%8B%AC%EB%9D%BC%EB%B3%91> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

