kno:KN2025-0565 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "치매 생활권"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B9%98%EB%A7%A4%20%EC%83%9D%ED%99%9C%EA%B6%8C> ;
    skos:definition "(LLM) 치매 환자와 가족이 일상생활 속에서 돌봄 부담과 배회ㆍ실종 같은 안전 문제에 지속적으로 노출되는 생활 반경 또는 지역 환경."@ko ;
