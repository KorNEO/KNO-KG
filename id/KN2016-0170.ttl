# KN2016-0170 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0170 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "몰카^드론"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372605> ;
    skos:definition "촬영 사실을 알리지 않고 다른 사람이나 상황을 몰래 촬영하기 위한 무인 항공기. 자동 조종이나 원격 조종이 가능하여 고층 아파트 일대를 날아다니며 실내를 촬영하여 사생활 침해의 원인이 되기도 한다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2016-0170-c1 ;
    kno:component kno:KN2016-0170-c2 ;
    kno:component kno:KN2016-0170-c3 ;
    kno:componentString "몰(래), 카(메라)(camera), 드론(drone)"@ko ;
    kno:example "¶원격 조종과 고해상도 촬영 기능을 탑재한 취미용 드론이 인기를 끌면서 이른바 ‘{몰카 드론’으로} 인한 사생활 침해 문제가 법적 소송으로 번지는 사례가 늘고 있다."@ko ;
    kno:frequency kno:KN2016-0170-freq-NN-2016 ;
    kno:frequency kno:KN2016-0170-freq-NN-2017 ;
    kno:frequency kno:KN2016-0170-freq-NN-2018 ;
    kno:frequency kno:KN2016-0170-freq-NN-total ;
    kno:indexForm "몰카드론"@ko ;
    kno:languageType "(고+영)^영" ;
    kno:lastAttestationYear "2018"^^xsd:gYear ;
    kno:origin "(몰<영>←camera drone)" ;
    kno:pos "「구」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:unitType "구"@ko ;
    kno:urimalTargetCode "1372605" ;
    kno:year "2016"^^xsd:gYear .
