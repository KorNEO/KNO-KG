kno:KN2018-0174 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "생리대 포비아"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416240> ;
    skos:definition "일회용 생리대를 사용하는 것에 대해 두려움이나 거부감을 느끼는 증세. 일회용 생리대에서 인체에 해로운 성분이 검출된 데에서 비롯되었다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
