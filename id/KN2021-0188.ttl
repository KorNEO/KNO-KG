# KN2021-0188 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0188 kno:registration "신어DB"@ko ;
    kno:unitType "구"@ko ;
    a ontolex:MultiwordExpression ;
    kno:instantiates kno:S000806 ;
    skos:definition "위생 장비를 쓰지 않고 절인 배추로 만든 김치. 김치 제조업체의 직원으로 보이는 사람이 알몸으로 배추를 절이는 통 속에 들어가 배추를 옮기는 영상이 온라인에 퍼지면서 수입 김치의 위생이 논란되었다."@ko ;
    kno:frequency kno:KN2021-0188-freq-NN-total ;
    kno:indexForm "알몸김치"@ko ;
    kno:example "¶최악의 위생 환경에서 김치를 담그는 {알몸 김치의} 충격이 가시기도 전에 염색한 과일과 야채가 판매되어 논란이 일고 있다."@ko ;
