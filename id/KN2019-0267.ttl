# KN2019-0267 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0267 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "컴포터-리안"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1436736> ;
    skos:definition "다른 사람의 시선을 신경 쓰지 않고 자신의 편안함만을 추구하는 사람을 이르는 말. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2019-0267-c1 ;
    kno:component kno:KN2019-0267-c2 ;
    kno:componentString "컴포터(블)(comfortable), -리안(-ian)"@ko ;
    kno:example "¶{컴포터리안의} 소비에선 일관된 경향이 발견된다. 남의 시선에 신경 쓰지 않고 ‘내가 편한 것’을 추구한다는 점이 특히 그렇다."@ko ;
