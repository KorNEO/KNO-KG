# KN2017-0033 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0033 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "궁셔리"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380343> ;
    skos:definition "궁상맞으면서도 보기에 고급스러운 데가 있음. ‘궁상’과 고급스러움을 의미하는 ‘럭셔리(luxury)’를 결합하여 만든 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "8"^^xsd:integer ;
    kno:component kno:KN2017-0033-c1 ;
    kno:component kno:KN2017-0033-c2 ;
    kno:componentString "궁(상)(窮), (럭)셔리(luxury)"@ko ;
    kno:example "¶시작부터 OOO은 자신만이 할 수 있는 ‘{궁셔리’를} 선보였다. 남산이 잘 보이는 옥상을 인터뷰 장소로 잡은 OOO은…아보카도를 간장에 찍어 참치 뱃살 맛을 냈다."@ko ;
    kno:formation kno:W05 ;
