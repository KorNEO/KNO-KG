# KN2017-0337 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0337 kno:year "2017"^^xsd:gYear ;
    kno:frequency kno:KN2017-0337-freq-NN-2018 ;
    a kno:Neologism ;
    skos:definition "노년과 중년 사이의 남성을 친근하게 이르는 말. 보통 60대 중후반의 남성들을 말한다. ‘할아버지’와 ‘아재’를 결합하여 만든 말이다."@ko ;
    kno:indexForm "할아재"@ko ;
    kno:unitType "단어"@ko ;
    kno:lastAttestationYear "2018"^^xsd:gYear ;
    kno:example "¶이들은 ‘아재’라는 단어로는 설명이 부족한 ‘{할아재’급의} 드립력과 몸짓으로 또 한번 웃음 폭탄을 투척할 예정인 가운데, 저녁 식사를 걸고 한판 승부를 펼친다."@ko ;
    kno:slotFiller "아재 (1성분)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380627> ;
    kno:activeYears "2"^^xsd:integer ;
