@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0694 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2025-0694-att-nn ;
    ontolex:canonicalForm kno:KN2025-0694-form ;
    ontolex:sense kno:KN2025-0694-sense .

kno:KN2025-0694-att-nn a frac:Attestation ;
    dcterms:date "2025-06-10"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/366/0001084172> .

kno:KN2025-0694-form a ontolex:Form ;
    frac:frequency kno:KN2025-0694-freq-nn,
        kno:KN2025-0694-freq-yt ;
    ontolex:writtenRep "확통 런"@ko .

kno:KN2025-0694-freq-nn a frac:CorpusFrequency ;
    rdf:value 38 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0694-freq-yt a frac:CorpusFrequency ;
    rdf:value 146 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0694-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%82%AC%ED%83%90%EB%9F%B0> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

