# KN2015-0014 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0014 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "구타-흔"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1359885> ;
    skos:definition "사람이나 짐승을 함부로 치고 때린 흔적."@ko ;
    kno:activeYears "2"^^xsd:integer ;
