# KN2025-0487 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0487 skos:definition "(LLM) 전력 수요가 높아질 때 건물ㆍ시설의 부하를 스스로 감지ㆍ분석하여 냉난방ㆍ조명ㆍ설비 등의 운전을 자동으로 조절함으로써 전력 사용량을 줄이거나 분산하는 에너지 관리 방식."@ko ;
    rdfs:label "자가 수요 반응"@ko ;
    kno:registration "신어DB"@ko ;
    kno:instantiates kno:S000689 ;
