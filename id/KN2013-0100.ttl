# KN2013-0100 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0100 kno:component kno:KN2013-0100-c1 ;
    kno:formation kno:W07 ;
    kno:lastAttestationYear "2013"^^xsd:gYear ;
    a kno:Neologism ;
    kno:registration "신어DB"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8B%A4%EC%9D%B4%ED%83%80%EC%98%A4%EC%99%84> ;
    kno:unitType "단어"@ko ;
    rdfs:label "다이타오완"@ko ;
    kno:example "¶중국 최대의 명절 춘절 연휴 기간 중국 전역에서 설맞이 전통 장터 격인 OO가 열리는 가운데 중국 소비자 단체인 OO 협회는 {다이타오완에} 음식을 담아 주는 상관행의 위험성을 지적하며 국민들에게 비닐봉지를 씌운 그릇에 담긴 음식을 먹지 말 것을 권고했다."@ko ;
    kno:year "2013"^^xsd:gYear ;
    kno:frequency kno:KN2013-0100-freq-NN-total ;
    a ontolex:Word ;
    skos:definition "그릇 세척 시설이 갖추어져 있지 않은 중국의 소규모 음식점에서 위생을 위하여 비닐봉지를 씌운 그릇. 비닐에 뜨거운 음식이 닿을 경우 해로운 물질이 나올 수 있어 중국 소비자 단체에서는 비닐을 씌운 그릇에 담긴 음식을 먹지 말 것을 권고하고 있다."@ko ;
    kno:frequency kno:KN2013-0100-freq-NN-2013 ;
    kno:indexForm "다이타오완"@ko ;
    kno:pos "「명」"@ko ;
    kno:origin "(<중>dàitàowǎn[袋套碗])" ;
    kno:componentString "다이타오완(dàitàowǎn)"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:languageType "중" .
