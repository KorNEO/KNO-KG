# KN2023-0049 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0049 kno:instantiates kno:S001095 ;
    kno:component kno:KN2023-0049-c1 ;
    kno:componentString "기회(機會), 발전(發展), 특구(特區), 법(法)"@ko ;
    kno:pos "「구」"@ko ;
    kno:instantiates kno:S001254 ;
    kno:languageType "한^한^한" ;
    kno:unitType "구"@ko ;
    kno:slotFiller "법(法) (1성분)"@ko ;
    skos:definition "비수도권 지역이나 수도권 중 일부 접경 지역 및 인구 감소 지역의 투자 촉진을 목적으로 제정한 법률. 해당 지역으로 이전하는 기업에게 감세 등의 혜택이 지원된다. 정식 명칭은 ‘지방 자치 분권 및 지역 균형 발전에 관한 특별법’이다."@ko ;
    kno:component kno:KN2023-0049-c3 ;
    kno:slotFiller "기회(機會)+발전(發展) (2성분)"@ko ;
    a kno:Neologism ;
    kno:frequency kno:KN2023-0049-freq-NN-2023 ;
    kno:frequency kno:KN2023-0049-freq-NN-2024 ;
    kno:example "¶{기회 발전 특구법은} 국민 모두가 사는 지역에 관계없이 균등한 기회를 누릴 수 있는 지방 시대를 구현하는 것을 목적으로 제정되었다."@ko ;
