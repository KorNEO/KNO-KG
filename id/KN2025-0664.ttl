# KN2025-0664 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0664 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "한남-산성"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%95%9C%EB%82%A8%EC%82%B0%EC%84%B1> ;
    skos:definition "(LLM) 서울 한남동 대통령 관저 일대에서 수사기관 등의 진입이나 영장 집행을 막기 위해 차량 차벽과 인력 배치로 여러 겹의 저지선을 구축한 방어 태세를 비유적으로 이르는 말."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2025-0664-c1 ;
    kno:component kno:KN2025-0664-c2 ;
    kno:componentString "한남(漢南), 산성(山城)"@ko ;
    kno:example "(LLM) 현장에 도착한 수사팀은 버스와 승용차로 길을 막고 인력이 인간띠를 만든 {한남산성에} 가로막혀 더 이상 진입하지 못했다."@ko ;
