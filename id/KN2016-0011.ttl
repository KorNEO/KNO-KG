    kno:frequency kno:KN2016-0011-freq-NN-total ;
    kno:activeYears "7"^^xsd:integer ;
    kno:indexForm "게임마피아"@ko ;
    skos:definition "짧은 시간에 빠른 속도로 성장한 게임업체를 마피아에 빗대어 이르는 말. 주로 갑작스럽게 거대한 규모로 성장한 중국 게임업체를 가리키는 뜻으로 사용한다."@ko ;
