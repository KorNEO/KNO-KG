# KN2016-0011 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0011 kno:component kno:KN2016-0011-c2 ;
    kno:languageType "영^이" ;
    kno:registration "신어DB"@ko ;
    kno:example "¶그럼에도 불구하고 중국 게임업체를 짧은 기간에 성장시키고 기업 공개까지 이끌어 낸 이른바 ‘{게임 마피아’의} 입성에 또 다른 기대를 하는 투자자들이 많은 것도 사실이다."@ko ;
    kno:componentString "게임(game), 마피아(Mafia)"@ko ;
