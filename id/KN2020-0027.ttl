# KN2020-0027 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0027 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "국가^연구^개발^혁신법"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1523496> ;
    skos:definition "중앙 행정 기관이 연구 개발을 위해 지원하는 사업에 대한 관리 규정을 체계적으로 바꾼 법. 기존의 복잡한 관리 규정을 간소화ㆍ체계화하는 것을 주요 골자로 하여 연구자가 행정 업무에 대한 부담 없이 연구에 전념할 수 있도록 하는 것이 목적이다. 2020년 6월 9일 제정되었고 2021년 1월 1일부터 시행되었다."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2020-0027-c1 ;
    kno:component kno:KN2020-0027-c2 ;
    kno:component kno:KN2020-0027-c3 ;
    kno:component kno:KN2020-0027-c4 ;
    kno:component kno:KN2020-0027-c5 ;
    kno:componentString "국가(國家), 연구(硏究), 개발(開發), 혁신(革新), 법(法)"@ko ;
    kno:example "¶{국가 연구 개발 혁신법이} 시행되면서 연구자의 행정적 부담은 줄고 연구에 대한 책임과 자율이 강화되었다. 그만큼 혁신적인 성과를 도출해 내야 하는 연구자의 의무도 커졌다."@ko ;
