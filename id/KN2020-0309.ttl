kno:KN2020-0309 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "종합^지급^결제업자"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A2%85%ED%95%A9%EC%A7%80%EA%B8%89%EA%B2%B0%EC%A0%9C%EC%97%85%EC%9E%90> ;
    skos:definition "은행의 예금이나 여신 업무를 제외한, 계좌 이체, 각종 대금이나 공과금 납부 따위의 계좌를 기반으로 한 서비스를 단일한 온라인 플랫폼을 통해 제공하는 사업자. =종합 지급 결제 사업자."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2020-0309-c1 ;
