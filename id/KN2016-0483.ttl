    a kno:Neologism ;
    kno:example "¶‘{청년 희망 임대 주택’의} 입주 자격은 만 35세 이하의 청년과 신혼부부에 한하고 임대 조건은 정부 정책 금리를 초과할 수 없도록 했다."@ko ;
    kno:urimalTargetCode "1372918" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372918> ;
