# F003634 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003634 kno:surfaceForm "바"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=9459> ;
    kno:semanticTag kno:usas-K5.2 ;
    kno:urimalDefinition "두 사람이 검은 돌과 흰 돌을 나누어 가지고 바둑판 위에 번갈아 하나씩 두어 가며 승부를 겨루는 스포츠. 두 집 이상이 있어야 살며, 서로 에워싼 집을 많이 차지하면 이긴다. 〔명사〕"@ko ;
    a kno:Formative ;
    kno:parallelFullForm kno:LEX-바둑 ;
    kno:fullFormLexeme kno:LEX-바둑 ;
    kno:urimalTargetCode "9459" ;
