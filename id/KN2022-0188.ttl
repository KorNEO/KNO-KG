# KN2022-0188 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0188 kno:unitType "단어"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:example "¶인터넷 커뮤니티에는 부산을 ‘{스까국’이라고} 이르며, 음식을 섞어 먹기를 좋아하는 부산 사람들을 조롱하는 글이 올라오곤 한다."@ko ;
    kno:languageType "고+한" ;
    kno:frequency kno:KN2022-0188-freq-NN-total ;
    kno:componentString "스까, -국(國)"@ko ;
    skos:definition "‘부산’을 ‘무엇이든지 섞어 먹는 나라’에 빗대어 이르는 말. 음식을 섞어 먹는 부산 지역의 식문화를 표현한 말로, 주로 인터넷상에서 부산 지역을 우스꽝스럽게 표현하기 위하여 사용한다. 차별 및 비하하는 의미가 포함되어 있으므로 사용에 주의가 필요하다."@ko ;
    kno:registration "신어DB"@ko ;
