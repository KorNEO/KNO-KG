    a kno:Neologism ;
    kno:year "2017"^^xsd:gYear ;
    kno:slotFiller "인턴(intern) (1성분)"@ko ;
    kno:instantiates kno:S000054 ;
    kno:origin "(<라>▼homo<영>intern)" ;
    kno:componentString "호모(homo), 인턴(intern)"@ko ;
    skos:definition "정규직으로 채용되지 못하고 인턴 생활만 반복하는 취업 준비생을 비유적으로 이르는 말."@ko ;
