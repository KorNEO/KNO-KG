# KN2021-0052 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0052 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "깃깔따구-속"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B9%83%EA%B9%94%EB%94%B0%EA%B5%AC%EC%86%8D> ;
    skos:definition "일반적으로 흐르는 물에서 서식하는 파리목 깔따굿과에 속하는 속류. 국내 미기록 종이었지만 2020년 제주 서귀포시 수돗물에서 깃깔따구속 유충이 발견되었으며, 사람을 물지는 않는다고 알려져 있다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2021-0052-c1 ;
    kno:component kno:KN2021-0052-c2 ;
    kno:componentString "깃깔따구, 속(屬)"@ko ;
    kno:example "¶OO 지역 수돗물에서 {깃깔따구속의} 유충이 발견되어 수돗물 품질 관리에 대한 문제가 제기되고 있다."@ko ;
