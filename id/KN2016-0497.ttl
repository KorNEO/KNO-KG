# KN2016-0497 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0497 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "캠러리"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%BA%A0%EB%9F%AC%EB%A6%AC> ;
    skos:definition "캠핑을 하면서, 요리사들이 바비큐 요리를 하는 것을 구경하는 사람을 이르는 말. ‘캠핑(camping)’과 골프 경기를 구경하는 사람을 뜻하는 ‘갤러리(gallery)’를 결합하여 만든 말이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2016-0497-c1 ;
    kno:component kno:KN2016-0497-c2 ;
    kno:componentString "캠(핑)(camping), (갤)러리(gallery)"@ko ;
    kno:example "¶일반 시민들은 {캠러리라는} 자격으로 참가, 캠핑 활동을 통해 포천 지역의 자연을 느끼면서 바비큐 선수들의 경기를 참관하고,…평가할 수 있는 기회를 가질 수 있다."@ko ;
    kno:formation kno:W05 ;
