@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0380 a ontolex:Word ;
    frac:attestation kno:KN2020-0380-att-nn ;
    ontolex:canonicalForm kno:KN2020-0380-form ;
    ontolex:sense kno:KN2020-0380-sense .

kno:KN2020-0380-att-nn a frac:Attestation ;
    dcterms:date "2020-05-12"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/056/0010834019> .

kno:KN2020-0380-form a ontolex:Form ;
    frac:frequency kno:KN2020-0380-freq-nn,
        kno:KN2020-0380-freq-yt ;
    ontolex:writtenRep "턱스크"@ko .

kno:KN2020-0380-freq-nn a frac:CorpusFrequency ;
    rdf:value 3348 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0380-freq-yt a frac:CorpusFrequency ;
    rdf:value 5346 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0380-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%A7%88%EC%8A%A4%ED%81%AC%20%EB%B6%88%EB%9F%89%20%EC%B0%A9%EC%9A%A9> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

