# F002670 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002670 kno:urimalDefinition "나비목 나방아목의 곤충을 통틀어 이르는 말. 나비와 비슷하나 몸이 더 통통하고 몸에 인분이 덮여 있다. 더듬이는 채찍, 깃, 빗살 모양이며 주로 밤에 활동한다. 전 세계에 약 20만 종, 우리나라에는 1,500여 종이 있다. 〔명사〕"@ko ;
    kno:fullForm "나방"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:semanticTag kno:usas-L2 ;
    kno:urimalTargetCode "8520" ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=8520> ;
    kno:registration "우리말샘"@ko ;
    rdfs:label "나방"@ko ;
    a kno:Formative ;
    kno:surfaceForm "나방"@ko .
kno:KN2024-0338-c3 kno:formative kno:F002670 .
