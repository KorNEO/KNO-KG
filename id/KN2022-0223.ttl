@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0223 a ontolex:Word ;
    frac:attestation kno:KN2022-0223-att-nn ;
    ontolex:canonicalForm kno:KN2022-0223-form ;
    ontolex:sense kno:KN2022-0223-sense .

kno:KN2022-0223-att-nn a frac:Attestation ;
    dcterms:date "2022-02-11"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/311/0001408969> .

kno:KN2022-0223-form a ontolex:Form ;
    frac:frequency kno:KN2022-0223-freq-nn,
        kno:KN2022-0223-freq-yt ;
    ontolex:writtenRep "오운완"@ko .

kno:KN2022-0223-freq-nn a frac:CorpusFrequency ;
    rdf:value 2521 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0223-freq-yt a frac:CorpusFrequency ;
    rdf:value 29718 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0223-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%98%A4%EC%9A%B4%EC%99%84> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

