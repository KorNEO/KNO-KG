# F003594 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003594 kno:fullFormLexeme kno:LEX-세미나 ;
    kno:surfaceForm "미나"@ko ;
    rdfs:label "(세)미나(seminar)"@ko ;
