# KN2019-0247 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0247 kno:frequency kno:KN2019-0247-freq-NN-2019 ;
    kno:registration "신어DB"@ko ;
    kno:component kno:KN2019-0247-c3 ;
    kno:slotFiller "주휴(週休)+수당(手當) (2성분)"@ko ;
    kno:unitType "구"@ko ;
    a ontolex:MultiwordExpression ;
    kno:component kno:KN2019-0247-c1 ;
    kno:instantiates kno:S000097 ;
    skos:definition "최저 임금을 지급할 때 주휴 수당을 포함해야 한다는 법을 제정함에 따라 나타난 경제적 충격을 이르는 말. 2019년 1월 1일부터 시행된 최저 임금법 시행령에 따라 최저 임금 지급 시에도 주휴 수당을 의무적으로 지급하게 되면서 임금을 지급하는 고용주들과 임금을 받는 근로자들이 받은 경제적 영향을 말한다."@ko ;
    kno:frequency kno:KN2019-0247-freq-NN-total ;
    a kno:Neologism ;
    kno:example "¶최저 임금의 2년 연속 두 자릿수 인상에 {주휴 수당 쇼크까지} 겹치면서 그나마 괜찮은 알바 자리는 거의 하늘의 별 따기가 됐을 정도다."@ko ;
    kno:indexForm "주휴수당쇼크"@ko ;
