kno:KN2012-0469 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "하메-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1371033> ;
    skos:definition "거주 비용을 아끼기 위해 가족이 아닌 사람과 집을 같이 사용하는 사람. 또는 그런 무리."@ko ;
