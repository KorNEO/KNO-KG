# KN2016-0377 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0377 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "연극적^개념^소비"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372812> ;
    skos:definition "연극에서 연기를 하는 것처럼 자신이 합리적인 경제관념을 가지고 있는 사람임을 과시하기 위해 하는 소비. 실제로는 합리적인 소비가 아님에도 불구하고 환경 친화적이거나 수익금의 일부를 기부하는 등 공익과 관련된다는 이유로 해당 상품을 구매하는 행위이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2016-0377-c1 ;
    kno:component kno:KN2016-0377-c2 ;
    kno:component kno:KN2016-0377-c3 ;
    kno:componentString "연극적(演劇的), 개념(槪念), 소비(消費)"@ko ;
    kno:example "¶마지막으로 ‘{연극적 개념 소비’는} 착한 소비라는 가면을 쓴 소비자들의 내면 심리를 파헤친다."@ko ;
    kno:frequency kno:KN2016-0377-freq-NN-2015 ;
