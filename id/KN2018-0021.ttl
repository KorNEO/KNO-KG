# KN2018-0021 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0021 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "게하 포비아"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415768> ;
    skos:definition "게스트 하우스에서 일어난 범죄 사건으로 인하여 게스트 하우스에 묵는 것에 대해 두려움이나 거부감을 느끼는 증세. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2018-0021-c1 ;
    kno:component kno:KN2018-0021-c2 ;
    kno:component kno:KN2018-0021-c3 ;
    kno:componentString "게(스트)(guest), 하(우스)(house), 포비아(phobia)"@ko ;
    kno:example "¶OO 관광객 20대 여성이 게스트 하우스에 묵다 관리인에 의해 살해된 것으로 추정되는 사건이 발생한 가운데, 온라인을 중심으로 ‘{게하 포비아’가} 빠르게 확산하고 있다."@ko ;
    kno:frequency kno:KN2018-0021-freq-NN-2018 ;
    kno:frequency kno:KN2018-0021-freq-NN-total ;
    kno:indexForm "게하포비아"@ko ;
    kno:instantiates kno:S000013 ;
    kno:languageType "영_영" ;
    kno:lastAttestationYear "2018"^^xsd:gYear ;
    kno:origin "(<영>▼←guest house phobia)" ;
