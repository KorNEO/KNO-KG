# F005624 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005624 kno:registration "우리말샘"@ko ;
    kno:origin "電氣" ;
    kno:urimalDefinition "물질 안에 있는 전자 또는 공간에 있는 자유 전자나 이온들의 움직임 때문에 생기는 에너지의 한 형태. 음전기와 양전기 두 가지가 있는데, 같은 종류의 전기는 밀어 내고 다른 종류의 전기는 끌어당기는 힘이 있다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-O3 ;
    kno:urimalTargetCode "21762" ;
    kno:caseCount "1"^^xsd:integer ;
    a kno:Formative ;
    kno:fullForm "전기"@ko ;
    kno:surfaceForm "전기"@ko ;
    rdfs:label "전기(電氣)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=21762> .
kno:KN2013-0357-c1 kno:formative kno:F005624 .
