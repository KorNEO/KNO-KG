# KN2016-0567 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0567 kno:indexForm "학대전담경찰관제도"@ko ;
    kno:origin "(虐待專擔警察官制度)" ;
    kno:frequency kno:KN2016-0567-freq-NN-2019 ;
    kno:frequency kno:KN2016-0567-freq-NN-total ;
    kno:componentString "학대(虐待), 전담(專擔), 경찰관(警察官), 제도(制度)"@ko ;
    kno:activeYears "3"^^xsd:integer ;
    skos:definition "학대와 관련된 문제를 전문적으로 도맡아 처리하는 경찰관을 두는 제도. 주로 아동과 같은 사회적 약자를 대상으로 한 학대 사건의 예방과 근절을 목적으로 하며, 학대 위험 대상자 관리와 유관 기관 협조 등의 업무를 수행한다."@ko ;
    kno:registration "우리말샘"@ko ;
    a kno:Neologism ;
    rdfs:label "학대^전담^경찰관^제도"@ko ;
    kno:slotFiller "학대(虐待)+전담(專擔)+경찰관(警察官) (3성분)"@ko ;
    kno:urimalTargetCode "1373002" ;
    kno:predicate "두다"@ko ;
    kno:frequency kno:KN2016-0567-freq-NN-2021 ;
    kno:pos "「구」"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1373002> ;
    kno:instantiates kno:S001760 ;
    kno:component kno:KN2016-0567-c4 ;
    a ontolex:MultiwordExpression ;
    kno:example "¶경찰 관계자는 “학생 간 서열이 형성되는 학기초를 맞아 학교 폭력을 예방하고 지난해 도입된 {학대 전담 경찰관 제도를} 알리기 위해 OO를 홍보 대사로 임명했다.”라고 설명했다."@ko ;
    kno:lastAttestationYear "2021"^^xsd:gYear ;
