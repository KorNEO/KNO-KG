# KN2024-0231 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0231 kno:unitType "구"@ko ;
    rdfs:label "의전 노동"@ko ;
    kno:component kno:KN2024-0231-c1 ;
    kno:instantiates kno:S000247 ;
    kno:frequency kno:KN2024-0231-freq-NN-total ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9D%98%EC%A0%84%20%EB%85%B8%EB%8F%99> ;
    a kno:Neologism ;
    skos:definition "명사(名士)나 귀빈, 조직 내 상급자 등을 예우하거나 대외적 격식을 갖추는 과정에서 생기는 노동. 주 업무와 직접적인 관련이 없음에도 불구하고 관행이나 체면을 중시하는 조직 문화 속에서 요구되는 부가적 노동을 비판적으로 이르는 말이다."@ko ;
    kno:slotFiller "의전(儀典) (1성분)"@ko ;
    kno:predicate "생기다"@ko ;
    kno:component kno:KN2024-0231-c2 ;
    a ontolex:MultiwordExpression ;
    kno:frequency kno:KN2024-0231-freq-NN-2024 ;
    kno:componentString "의전(儀典), 노동(勞動)"@ko ;
    kno:languageType "한_한" ;
    kno:example "¶공직 사회나 민간 기업 모두 불필요한 허례허식을 줄여야 한다고 하면서도, 직장인들은 여전히 업무와 무관한 {의전 노동에} 시달리고 있다."@ko ;
    kno:pos "「구」"@ko ;
