@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0350 a ontolex:Word ;
    frac:attestation kno:KN2024-0350-att-nn ;
    ontolex:canonicalForm kno:KN2024-0350-form ;
    ontolex:sense kno:KN2024-0350-sense .

kno:KN2024-0350-att-nn a frac:Attestation ;
    dcterms:date "2024-03-21"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/016/0002283468> .

kno:KN2024-0350-form a ontolex:Form ;
    frac:frequency kno:KN2024-0350-freq-nn,
        kno:KN2024-0350-freq-yt ;
    ontolex:writtenRep "평화누리-특별자치도"@ko .

kno:KN2024-0350-freq-nn a frac:CorpusFrequency ;
    rdf:value 693 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0350-freq-yt a frac:CorpusFrequency ;
    rdf:value 325 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0350-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EA%B2%BD%EA%B8%B0%EB%B6%81%EB%8F%84/%EB%AA%85%EC%B9%AD%20%EC%84%A0%EC%A0%95%20%EB%B0%8F%20%EB%85%BC%EB%9E%80> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

