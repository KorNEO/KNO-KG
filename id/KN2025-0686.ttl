kno:KN2025-0686 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "호텔 정치학"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%98%B8%ED%85%94%20%EC%A0%95%EC%B9%98%ED%95%99> ;
    skos:definition "(LLM) 정치적 사안이나 정책을 설명ㆍ비판하면서, 호텔 예약금ㆍ취소 수수료 등 ‘호텔’의 소비ㆍ환불 구조를 비유로 끌어와 논리를 전개하는 정치적 수사 또는 담론을 낮잡아 이르는 말."@ko ;
    kno:activeYears "1"^^xsd:integer ;
