# KN2012-0493 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0493 rdfs:label "후첨 수프"@ko ;
    kno:componentString "후첨(後添), 수프(soup)"@ko ;
    skos:definition "라면을 다 끓이고 난 뒤에 넣는 수프. 라면의 맛을 더욱 맛나게 하기 위해 넣는다."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%9B%84%EC%B2%A8%20%EC%88%98%ED%94%84> ;
    kno:registration "신어DB"@ko ;
    kno:frequency kno:KN2012-0493-freq-NN-2018 ;
    kno:activeYears "4"^^xsd:integer ;
    kno:example "¶OO의 인기 비결은 청량고추보다 2~3배 더 맵지만 고소함이 가미된 맛 때문이라는 분석이다. 국물맛을 내는 수프 외에 {후첨수프를} 추가해 매운 맛을 적절히 잡아줬다는 것이다."@ko ;
