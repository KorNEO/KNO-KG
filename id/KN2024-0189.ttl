# KN2024-0189 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0189 kno:languageType "한+한+한" ;
    rdfs:label "영탐탐"@ko ;
    a kno:Neologism ;
    kno:example "¶전반적인 수능 최저 학력 기준도 완화되어 인문 계열은 상대적으로 등급의 확보가 쉬운 {영탐탐의} 조합으로도 최저 기준의 충족이 가능해졌다."@ko ;
    kno:componentString "영(어)(英語), 탐(구)(探究), 탐(구)(探究)"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%98%81%ED%83%90%ED%83%90> ;
