@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0377 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2020-0377-att-nn ;
    ontolex:canonicalForm kno:KN2020-0377-form ;
    ontolex:sense kno:KN2020-0377-sense .

kno:KN2020-0377-att-nn a frac:Attestation ;
    dcterms:date "2020-01-01"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/609/0000226907> .

kno:KN2020-0377-form a ontolex:Form ;
    frac:frequency kno:KN2020-0377-freq-nn,
        kno:KN2020-0377-freq-yt ;
    ontolex:writtenRep "탑골 가요"@ko .

kno:KN2020-0377-freq-nn a frac:CorpusFrequency ;
    rdf:value 832 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0377-freq-yt a frac:CorpusFrequency ;
    rdf:value 55 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0377-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%8A%A4%EB%B8%8C%EC%8A%A4%EB%89%B4%ED%8A%B8%EB%A1%9C> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

