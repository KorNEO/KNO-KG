# KN2012-0421 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0421 kno:year "2012"^^xsd:gYear ;
    kno:formation kno:W08 ;
    a ontolex:Word ;
    skos:definition "서로 상대가 되는 남자 배우와 여자 배우 사이의 어울림을 화학 반응에 빗대어 이르는 말."@ko ;
    kno:example "¶또한…OOO은 OOO보다 무려 9살 연상이었지만 완벽한 {케미로} 상대 배우와 환상적인 그림을 연출해 내며 시청자의 연하남에 대한 판타지를 더욱 크게 만들었다."@ko ;
    kno:activeYears "0"^^xsd:integer ;
