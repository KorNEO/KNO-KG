# KN2018-0122 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0122 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "면제로이드"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1389920> ;
    skos:definition "국제 스포츠 경기에서 병역 혜택에 따른 동기 부여로 경기력이 향상되는 현상."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2018-0122-c1 ;
    kno:component kno:KN2018-0122-c2 ;
    kno:componentString "면제(免除), (스테)로이드(steroid)"@ko ;
    kno:example "¶그리고 네티즌들은 아시안 게임 금메달 획득 시 주어지는 병역 혜택 때문에 일명 ‘{면제로이드’가} 예선전부터 발동했다고 우스갯소리 겸 분석을 내놓고 있다."@ko ;
