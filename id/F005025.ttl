# F005025 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005025 kno:truncated "false"^^xsd:boolean ;
    rdfs:label "여미(yummy)"@ko ;
    kno:urimalDefinition "미국의 사회 계급으로 부상하고 있는, 상향적이고 활동적인 젊은 어머니를 이르는 말. 이들은 가사 노동에만 전념하지 않고 자기 개발이 가능한 직장 생활을 하거나, 여가 시간에 몸매를 가꾸는 운동 등을 하면서 자녀 출산과 육아, 교육에도 많은 노력을 기울인다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "여미"@ko ;
    kno:origin "yummy" ;
    kno:surfaceForm "여미"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=785661> ;
    kno:semanticTag kno:usas-X3.1 ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalTargetCode "785661" ;
    a kno:Formative .
kno:KN2014-0183-c1 kno:formative kno:F005025 .
