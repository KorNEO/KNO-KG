# F002842 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002842 kno:truncated "false"^^xsd:boolean ;
    kno:fullForm "닉슨"@ko ;
    kno:semanticTag kno:usas-Z1 ;
    a kno:Formative ;
    kno:urimalDefinition "미국의 제37대 대통령(1913~1994). ‘닉슨 독트린’을 제창하였고, 21년 동안이나 소원하였던 중국과 대화를 재개하고 소련과 무역 협정을 체결하는 등 외교 분야에서 많은 업적을 남겼으나, 1974년에 워터게이트 사건으로 대통령직을 사임하였다. 재임 기간은 1969~1974년이다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=121837> ;
    rdfs:label "닉슨(Nixon)"@ko ;
    kno:origin "nixon" ;
    rdfs:seeAlso <https://ko.wikipedia.org/wiki/%EB%A6%AC%EC%B2%98%EB%93%9C_%EB%8B%89%EC%8A%A8> ;
    kno:surfaceForm "닉슨"@ko ;
    kno:urimalTargetCode "121837" ;
    kno:caseCount "1"^^xsd:integer ;
