# KN2018-0405 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0405 kno:instantiates kno:S000608 ;
    kno:predicate "올리다"@ko ;
    kno:activeYears "7"^^xsd:integer ;
    rdfs:label "핀셋^인상"@ko ;
    skos:definition "핀셋을 이용해 물건을 집어 올리는 것처럼, 전체가 아닌 특정 부분에 대하여 가격이나 금리 따위를 올리는 일. 예를 들어 특정 계층이나 특정 지역에 국한하여 대출 금리를 인상하는 경우가 이에 해당한다."@ko ;
