# KN2017-0212 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0212 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "온라인 리플리"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380776> ;
    skos:definition "온라인상에서 타인에게 거짓말을 일삼다 결국은 자신마저 속이고 환상 속에서 사는 사람. 과도한 신분 상승 욕구 때문에 타인에게 거짓말을 일삼다 결국은 자신마저 속이고 환상 속에서 살게 되는 유형의 인격 장애를 뜻하는 ‘리플리 증후군’이 현실에서뿐만 아니라 온라인상에서도 발현되는 것을 가리키는 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2017-0212-c1 ;
    kno:component kno:KN2017-0212-c2 ;
    kno:componentString "온라인(online), 리플리(Ripley)"@ko ;
    kno:example "¶온라인에서 가짜 인생을 사는 사람, ‘{온라인 리플리’가} 늘고 있다고 합니다."@ko ;
