# F001545 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001545 a kno:Formative ;
    kno:fullForm "시프트"@ko ;
    kno:urimalDefinition "미식축구에서, 스크럼의 플레이 개시 준비 완료 뒤에 공격 측(攻擊側)의 두 명 이상의 선수가 동시에 행동을 일으키는 일. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=15671> ;
    rdfs:label "시프트(shift)"@ko ;
    kno:semanticTag kno:usas-A2.1 ;
    kno:surfaceForm "시프트"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "15671" ;
    kno:origin "shift" ;
    kno:caseCount "2"^^xsd:integer ;
    kno:registration "우리말샘"@ko .
