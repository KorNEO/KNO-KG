# F006581 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006581 kno:surfaceForm "특별시"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=305871> ;
    kno:fullForm "특별시"@ko ;
    kno:urimalDefinition "지방 자치 단체의 하나. 도(道), 광역시와 같은 상급 지방 자치 단체로, 하급 지방 자치 단체인 보통의 시가 도의 감독을 받는 데 비하여 국무총리의 지휘와 감독 밑에 있다. 관련 사무는 각 중앙 행정 기관장이 지시·감독한다. 현재의 서울이 이에 해당한다. 〔명사〕"@ko ;
    kno:origin "特別市" ;
    kno:urimalTargetCode "305871" ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:label "특별시(特別市)"@ko ;
    kno:semanticTag kno:usas-M7 ;
    a kno:Formative .
kno:KN2024-0309-c2 kno:formative kno:F006581 .
