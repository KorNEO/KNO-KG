    kno:year "2017"^^xsd:gYear ;
    kno:example "¶{쌀설탕은} 기존 설탕보다 덜 달고, 쌀이 함유한 영양소는 고스란히 담겨 있습니다."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380737> ;
