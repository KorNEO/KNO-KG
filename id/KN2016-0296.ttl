# KN2016-0296 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0296 kno:lastAttestationYear "2016"^^xsd:gYear ;
    kno:origin "(<영>smart安全<영>block)" ;
    skos:definition "보행자가 통행하는 도로에 깔도록 만들어진 블록 형태의 바닥 신호등. 신호등과 연계된 발광 다이오드를 이용하여 신호가 바뀔 때마다 블록의 색깔이 바뀌며, 밝기는 일반 신호등의 10배 이상이다."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372731> ;
    kno:component kno:KN2016-0296-c1 ;
