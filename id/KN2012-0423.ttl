# KN2012-0423 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0423 kno:origin "(Kopimism敎)" ;
    kno:lastAttestationYear "2012"^^xsd:gYear ;
    kno:componentString "코피미즘(Kopimism), -교(敎)"@ko ;
    kno:frequency kno:KN2012-0423-freq-NN-2012 ;
    kno:component kno:KN2012-0423-c1 ;
    kno:example "¶{코피미즘교} 측은 “정부로부터 종교로 인정받은 것은 우리 교단의 큰 발전.”이라며 “언젠가는 처벌에 대한 두려움 없이 우리의 신념을 지키며 살 수 있는 날이 오길 바란다.”라고 말했다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:languageType "영+한" ;
    skos:definition "스웨덴에서 만들어진 신흥 종교. 영어 ‘카피(copy)’에서 이름을 따왔으며, 영화나 음악, 사진 등 온라인 콘텐츠를 성스럽게 여기며 복제와 공유를 통해 신성함을 극대화시키는 것을 교리로 삼는다."@ko ;
