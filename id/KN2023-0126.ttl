# KN2023-0126 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0126 a ontolex:MultiwordExpression ;
    kno:origin "(相對的不平等指數)" ;
    skos:definition "수입, 재산, 생활 양식 등에 따른 사회 경제적 불평등을 상대적으로 비교하고 평가하기 위한 지수."@ko ;
    kno:component kno:KN2023-0126-c3 ;
    kno:frequency kno:KN2023-0126-freq-NN-total ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%83%81%EB%8C%80%EC%A0%81%EB%B6%88%ED%8F%89%EB%93%B1%EC%A7%80%EC%88%98> ;
    kno:component kno:KN2023-0126-c1 ;
