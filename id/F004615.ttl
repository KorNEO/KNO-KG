# F004615 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004615 kno:urimalTargetCode "302728" ;
    kno:semanticTag kno:usas-Z3 ;
    kno:fullFormLexeme kno:LEX-테슬라 ;
    kno:surfaceForm "슬라"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "자기력선속의 밀도를 나타내는 국제단위. 1테슬라는 1㎡당 1웨버(weber)의 자기력선속이 통과할 때의 밀도이다. 미국의 전기 공학자 테슬라의 이름에서 유래하였다. 기호는 T. 〔의존 명사〕"@ko ;
    a kno:Formative ;
    kno:semanticTag kno:usas-M3 ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:label "(테)슬라(Tesla)"@ko ;
    kno:parallelFullForm kno:LEX-테슬라 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%8A%AC%EB%9D%BC> ;
