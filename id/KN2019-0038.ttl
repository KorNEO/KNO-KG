kno:KN2019-0038 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "내시피-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1447147> ;
    skos:definition "자신만의 조리법으로 만든 음식을 즐기는 사람. 또는 그런 무리. ⇒규범 표기는 미확정이다."@ko ;
