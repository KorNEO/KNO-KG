@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0547 a ontolex:Word ;
    frac:attestation kno:KN2025-0547-att-nn ;
    ontolex:canonicalForm kno:KN2025-0547-form ;
    ontolex:sense kno:KN2025-0547-sense .

kno:KN2025-0547-att-nn a frac:Attestation ;
    dcterms:date "2025-10-01"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/057/0001911540> .

kno:KN2025-0547-form a ontolex:Form ;
    frac:frequency kno:KN2025-0547-freq-nn,
        kno:KN2025-0547-freq-yt ;
    ontolex:writtenRep "짱북송"@ko .

kno:KN2025-0547-freq-nn a frac:CorpusFrequency ;
    rdf:value 3 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0547-freq-yt a frac:CorpusFrequency ;
    rdf:value 75 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0547-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%8C%A8%EB%A5%9C%EC%86%A1> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

