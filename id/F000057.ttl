# F000057 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000057 a kno:Formative ;
    rdfs:label "뇌(腦)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=490948> ;
    kno:caseCount "15"^^xsd:integer ;
    kno:fullForm "뇌"@ko ;
