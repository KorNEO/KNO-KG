@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0280 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2024-0280-att-nn ;
    ontolex:canonicalForm kno:KN2024-0280-form ;
    ontolex:sense kno:KN2024-0280-sense .

kno:KN2024-0280-att-nn a frac:Attestation ;
    dcterms:date "2023-07-27"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/055/0001076931> .

kno:KN2024-0280-form a ontolex:Form ;
    frac:frequency kno:KN2024-0280-freq-nn,
        kno:KN2024-0280-freq-yt ;
    ontolex:writtenRep "지구^열대화"@ko .

kno:KN2024-0280-freq-nn a frac:CorpusFrequency ;
    rdf:value 271 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0280-freq-yt a frac:CorpusFrequency ;
    rdf:value 252 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0280-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

