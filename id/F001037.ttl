# F001037 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001037 kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "인간 및 동물의 신체에 감염 물질이 유입되거나 발육·증식하여, 공중 보건에 위험이 될 수 있는 병. 제일 급에서 제사 급까지의 감염병 및 기생충 감염병, 세계 보건 기구 감시 대상 감염병, 생물 테러 감염병 따위가 있다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-B2m ;
    kno:caseCount "2"^^xsd:integer ;
    rdfs:label "감염병(感染病)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    kno:urimalTargetCode "810902" ;
    kno:surfaceForm "감염병"@ko ;
    kno:origin "感染病" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=810902> ;
    kno:fullForm "감염병"@ko .
