kno:KN2018-0393 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "프로 엔잡러"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415995> ;
    skos:definition "경제적인 목적에서 또는 자아실현을 위하여 동시에 두 가지 이상의 직업을 갖고 전문적으로 일하는 사람."@ko ;
