# KN2016-0002 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0002 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "가방-순이"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1368773> ;
    skos:definition "결혼식에서, 신부 곁에서 축의금을 받고 식권을 나누어 주거나 신부의 짐을 들어주는 등의 역할을 하며 신부를 돕는 사람."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2016-0002-c1 ;
    kno:component kno:KN2016-0002-c2 ;
    kno:componentString "가방, 순이"@ko ;
    kno:example "¶축의금은 부모에게 고스란히 전달되기 때문에 친구들이나 직장 동료들은 신랑, 신부에게 직접 축의금을 전달해 주기도 하는데, 이때 {가방순이가} 받고 나서 식권을 챙겨주기도 한다."@ko ;
    kno:formation kno:W01 ;
    kno:frequency kno:KN2016-0002-freq-NN-2016 ;
    kno:frequency kno:KN2016-0002-freq-NN-2022 ;
    kno:frequency kno:KN2016-0002-freq-NN-2023 ;
