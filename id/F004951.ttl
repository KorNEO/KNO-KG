# F004951 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004951 a kno:Formative ;
    rdfs:label "어모털리티(amortality)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:semanticTag kno:usas-T3m ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1281707> ;
    kno:urimalDefinition "실제 나이를 잊고 평생을 젊게 사는 것을 이르는 말. <FL>메이어</FL>(Mayer, C.)의 책 ≪어모털리티≫에서 나온 말로, 영원히 늙지 않는다는 뜻이다. 평균 수명이 늘어남에 따라 나이에 대한 생각이 변하여 고령에도 젊은 사람들 못지않게 왕성한 활동을 하는 사람들의 속성을 가리킨다. 〔명사〕"@ko ;
    kno:urimalTargetCode "1281707" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "어모털리티"@ko ;
    kno:origin "amortality" ;
    kno:surfaceForm "어모털리티"@ko .
kno:KN2013-0296-c1 kno:formative kno:F004951 .
