# KN2020-0142 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0142 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "비말^차단용^마스크"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1507075> ;
    skos:definition "병원체의 감염을 매개할 수 있는 침방울의 유입을 차단하기 위해 쓰는 마스크. 주로 비말을 매개로 전파되는 코로나19를 예방하기 위해 쓰는 마스크의 한 종류이다. 보건 마스크에 비해 두께가 얇아 숨쉬기 편하면서도 덴탈 마스크와 비슷한 수준의 침방울 차단 효과가 있다. =비말 마스크, 비말 차단 마스크."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2020-0142-c1 ;
    kno:component kno:KN2020-0142-c2 ;
    kno:component kno:KN2020-0142-c3 ;
    kno:componentString "비말(飛沫), 차단용(遮斷用), 마스크(mask)"@ko ;
    kno:example "¶더운 날씨에 연일 온라인에서 품절되고 있는 {비말 차단용 마스크를} 곧 대형 마트에서도 살 수 있게 된다."@ko ;
