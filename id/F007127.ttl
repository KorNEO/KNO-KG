# F007127 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F007127 kno:fullForm "홀로그램"@ko ;
    a kno:Formative ;
    kno:caseCount "1"^^xsd:integer ;
    kno:truncated "false"^^xsd:boolean ;
    kno:semanticTag kno:usas-Y1 ;
    kno:surfaceForm "홀로그램"@ko ;
    kno:urimalTargetCode "324158" ;
    kno:registration "우리말샘"@ko ;
    rdfs:label "홀로그램(hologram)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=324158> ;
    kno:urimalDefinition "홀로그래피에서, 입체상을 재현하는 간섭 줄무늬를 기록한 매체. 기준이 되는 레이저광과 물체로부터의 반사 레이저광으로 이루어지는 간섭 줄무늬를 필름에 농담(濃淡)으로 기록한 것으로, 간섭 줄무늬는 사진화되는 물체의 광학적인 모든 정보를 지닌다. 〔명사〕"@ko ;
    kno:origin "hologram" .
kno:KN2016-0605-c1 kno:formative kno:F007127 .
