    kno:unitType "구"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:instantiates kno:S000010 ;
    kno:example "(LLM) 여당은 야당이 추진하는 {내란정당해산법이} 특정 정당을 겨냥한 정치 공세라며 강하게 반발했다."@ko ;
