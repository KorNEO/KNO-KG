# KN2013-0220 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0220 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "빨대-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1368501> ;
    skos:definition "30대 이후에도 부모로부터 독립하지 못하고 경제적으로 도움을 받는 사람. 또는 그런 무리."@ko ;
    kno:activeYears "14"^^xsd:integer ;
    kno:component kno:KN2013-0220-c1 ;
    kno:component kno:KN2013-0220-c2 ;
    kno:componentString "빨대, -족(族)"@ko ;
    kno:example "¶안 그래도 요즘 ‘연어족’이라는 둥, ‘{빨대족’이라는} 둥 해서 세대 간 관계를 더욱 힘들게 하는 말들이 판치고 있다."@ko ;
