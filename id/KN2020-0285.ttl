# KN2020-0285 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0285 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "재난^기본^소득"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1485755> ;
    skos:definition "전국적인 재난 사태로 인해 경제적으로 어려운 상황에 처한 사람이 기본 생활을 유지할 수 있도록 정부에서 지급하는 소득. 코로나19의 대유행으로 인한 경제적 위기 상황을 극복하기 위해 정부에서 국민들에게 지원금을 지급하는 방안을 논의하는 과정에서 나온 말이다. =기본 재난 소득, 재난 생계 소득."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2020-0285-c1 ;
    kno:component kno:KN2020-0285-c2 ;
    kno:component kno:KN2020-0285-c3 ;
    kno:componentString "재난(災難), 기본(基本), 소득(所得)"@ko ;
    kno:example "¶{재난 기본 소득을} 신청하기 위한 온라인 페이지를 개시한 직후 접속자가 한꺼번에 몰리면서 서버 장애가 발생하여 많은 시민들이 불편을 겪었습니다."@ko ;
