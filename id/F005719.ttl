# F005719 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005719 kno:surfaceForm "젤"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:semanticTag kno:usas-B4 ;
    kno:origin "gel" ;
    kno:semanticTag kno:usas-O1.2 ;
