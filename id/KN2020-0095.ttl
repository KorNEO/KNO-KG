    kno:frequency kno:KN2020-0095-freq-NN-2020 ;
    skos:definition "어린이집, 유치원, 입시 학원 따위의 현실 공간에 마련된 교육 장소에 학생들이 직접 가서 듣는 수업. 온라인으로 행해지는 가상 수업에 반대되는 말이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:indexForm "등원수업"@ko ;
