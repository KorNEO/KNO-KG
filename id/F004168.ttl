# F004168 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004168 kno:urimalTargetCode "1385201" ;
    kno:caseCount "1"^^xsd:integer ;
    a kno:Formative ;
    kno:fullForm "사스"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:registration "우리말샘"@ko ;
    kno:surfaceForm "사스"@ko ;
    kno:semanticTag kno:usas-B2m ;
    rdfs:label "사스(SARS)"@ko ;
    kno:urimalDefinition "코로나바이러스 감염의 일종으로 급성 폐렴을 일으키는 질환. 동물에게서 사람으로 옮겨진다고 알려져 있으며 고열을 동반하고 감기와 비슷한 증상을 보이다가 심한 폐렴으로 인하여 호흡 곤란이 일어난다. 감염력이 심해 2002~2003년 사이에 전 세계적으로 전염이 확산된 적이 있었다. 〔명사〕"@ko ;
    kno:origin "sars" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1385201> .
kno:KN2020-0147-c1 kno:formative kno:F004168 .
