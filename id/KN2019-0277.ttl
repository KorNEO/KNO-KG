# KN2019-0277 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0277 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "토착 왜구"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1424999> ;
    skos:definition "대대로 우리나라에서 살고 있는 친일파를 낮잡아 이르는 말."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2019-0277-c1 ;
    kno:component kno:KN2019-0277-c2 ;
    kno:componentString "토착(土着), 왜구(倭寇)"@ko ;
    kno:example "¶무엇보다 이날 ‘OO’는 웃음 속에 현실을 담은 사이다 풍자로 안방극장을 사로잡았다.…대대로 친일파 집안인 경찰서장을 {‘토착 왜구’로} 풍자하는 등 권력층의 온상을 거침없이 비꼬는 OOO의 사이다 대사가 통쾌함을 안겼다."@ko ;
