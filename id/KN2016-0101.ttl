# KN2016-0101 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0101 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "데모크래틱^디자인"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372536> ;
    skos:definition "모양이나 품질, 실용성과 기능, 가격 등의 모든 요소를 고려하여 설계하는 디자인. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "10"^^xsd:integer ;
    kno:component kno:KN2016-0101-c1 ;
    kno:component kno:KN2016-0101-c2 ;
    kno:componentString "데모크래틱(democratic), 디자인(design)"@ko ;
    kno:example "¶OO의 디자인 수장인 OOO은…“OO의 모든 제품은 {데모크래틱 디자인} 철학에 기반을 두고 있으며, OO는 이를 통해 실용성과 멋진 디자인, 우수한 품질을 갖춘 지속 가능한 제품을 합리적인 가격에 제공하고자 한다.”라고 전했다."@ko ;
    kno:frequency kno:KN2016-0101-freq-NN-2015 ;
    kno:frequency kno:KN2016-0101-freq-NN-2016 ;
    kno:frequency kno:KN2016-0101-freq-NN-2017 ;
