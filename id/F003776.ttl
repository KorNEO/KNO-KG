# F003776 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003776 kno:urimalTargetCode "10792" ;
    kno:urimalDefinition "많은 사람이 함께 타는 대형 자동차. 보통은 운임을 받고 정해진 길을 따라 운행하며, 시내버스, 시외버스, 관광버스, 고속버스 따위가 있다. 〔명사〕"@ko ;
    kno:fullForm "버스"@ko ;
    kno:surfaceForm "버스"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=10792> ;
    kno:caseCount "1"^^xsd:integer ;
    kno:origin "bus" ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-M3 ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    rdfs:label "버스(bus)"@ko .
