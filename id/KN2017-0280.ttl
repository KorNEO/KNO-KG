kno:KN2017-0280 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "컨슈머토피아"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380266> ;
    skos:definition "소비자의 요구가 시장의 모든 요건을 결정하는 경제 체계. 소비자를 뜻하는 ‘컨슈머(consumer)’와 이상 세계를 뜻하는 ‘유토피아(Utopia)’를 결합하여 만든 말이다."@ko ;
