    a kno:Neologism ;
    rdfs:label "간호^인력^인권법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B0%84%ED%98%B8%EC%9D%B8%EB%A0%A5%EC%9D%B8%EA%B6%8C%EB%B2%95> ;
    skos:definition "간호사 한 명당 환자 수를 규정하는 법률. 코로나19가 오랜 기간 이어져 오고 있는 상황에서 간호사의 업무 가중 해소와 인력 부족 문제를 해결하기 위한 방안을 의미한다."@ko ;
