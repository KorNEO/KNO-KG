# KN2023-0152 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0152 kno:component kno:KN2023-0152-c2 ;
    kno:frequency kno:KN2023-0152-freq-NN-2022 ;
    skos:definition "‘채무자 회생 및 파산에 관한 법률 개정안’을 달리 이르는 말. 개인 회생 절차를 간소화하기 위해, 채무자가 개인 회생 채권자 목록에서 누락된 경우 변제 계획 인가 후에도 이를 수정할 수 있도록 하는 것을 주요 내용으로 한다."@ko ;
    kno:componentString "신속(迅速), 회생(回生), 추진(推進), 법(法)"@ko ;
    kno:registration "신어DB"@ko ;
    kno:example "¶{신속 회생 추진법은} 코로나19의 확산으로 인해 늘어난 가계 부채를 해결하기 위한 대책 중 하나로 발의되었다."@ko ;
    kno:unitType "구"@ko ;
