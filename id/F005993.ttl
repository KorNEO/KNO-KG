# F005993 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005993 kno:fullForm "차일드"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:label "차일드(child)"@ko ;
    kno:urimalDefinition "비어 고든 차일드, 오스트레일리아 태생의 영국 고고학자(1892~1957). 생산 기술의 변천을 중심으로 선사 문화 및 고대 문명을 재구성하였다. 저서에 ≪유럽 문명의 여명≫, ≪문명의 기원≫ 따위가 있다. 〔명사〕"@ko ;
    kno:surfaceForm "차일드"@ko ;
    kno:origin "child" ;
    a kno:Formative ;
    kno:truncated "false"^^xsd:boolean ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-T3m ;
