# F005538 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005538 kno:truncated "false"^^xsd:boolean ;
    rdfs:label "작은"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1476724> ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "작은"@ko ;
    kno:surfaceForm "작은"@ko ;
    kno:urimalTargetCode "1476724" ;
    kno:urimalDefinition "경상북도 성주군 수륜면에 있는 이. 수륜면의 동부에 위치해 있으며, 대부분 산지와 골짜기이다. 동쪽에 추산이 솟아 있고, 서쪽에 까치산이 걸쳐 있다. 중북부에 작은지 저수지가 자리하고, 북쪽에서 작은 하천이 발원하여 남쪽으로 흘러 나간다. 하천과 골짜기 주변에 소규모 농경지가 형성되어 있다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-N3.2m ;
    kno:caseCount "1"^^xsd:integer .
kno:KN2016-0436-c1 kno:formative kno:F005538 .
