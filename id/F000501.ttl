    kno:origin "multi" ;
    kno:fullForm "멀티"@ko ;
    kno:surfaceForm "멀티"@ko ;
    kno:urimalDefinition "케이블을 앞의 맨 위 또는 맨 아래에 있는 잭에 ‘Y’ 자 모양으로 연결시키거나 신호를 분할시키는 방법. 신호는 맨 위 뒷부분에서 맨 아래 뒷부분에 있는 패치 베이 잭으로 계속 이동한다. 〔명사〕"@ko ;
    kno:urimalTargetCode "1242196" ;
    kno:semanticTag kno:usas-N5p ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1242196> ;
    kno:truncated "false"^^xsd:boolean ;
    kno:registration "우리말샘"@ko .
