@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0466 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2025-0466-att-nn ;
    ontolex:canonicalForm kno:KN2025-0466-form ;
    ontolex:sense kno:KN2025-0466-sense .

kno:KN2025-0466-att-nn a frac:Attestation ;
    dcterms:date "2025-07-23"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/052/0002223270> .

kno:KN2025-0466-form a ontolex:Form ;
    frac:frequency kno:KN2025-0466-freq-nn,
        kno:KN2025-0466-freq-yt ;
    ontolex:writtenRep "윤 네버"@ko .

kno:KN2025-0466-freq-nn a frac:CorpusFrequency ;
    rdf:value 57 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0466-freq-yt a frac:CorpusFrequency ;
    rdf:value 7 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0466-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

