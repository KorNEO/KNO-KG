# KN2018-0166 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0166 kno:languageType "한_한" ;
    kno:pos "「구」"@ko ;
    rdfs:label "사무실 지박령"@ko ;
    kno:urimalTargetCode "1380847" ;
    skos:definition "야근 등으로 퇴근하지 못하고 오랜 시간 사무실에 머무는 직장인을, 자신이 죽은 곳을 떠나지 못하고 맴도는 영혼을 뜻하는 ‘지박령’에 비유하여 이르는 말."@ko ;
    kno:component kno:KN2018-0166-c2 ;
    kno:year "2018"^^xsd:gYear ;
    a kno:Neologism ;
    kno:example "¶퇴근을 못 해 사무실을 떠나지 못하는 직장인의 상황을 지박령으로 표현한 ‘{사무실 지박령’이란} 신조어에 공감하는 직장인도 많았다."@ko ;
    kno:component kno:KN2018-0166-c1 ;
