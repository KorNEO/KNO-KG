# F000058 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000058 kno:truncated "false"^^xsd:boolean ;
    kno:fullForm "산업"@ko ;
    kno:surfaceForm "산업"@ko ;
    kno:urimalDefinition "인간의 생활을 경제적으로 풍요롭게 하기 위하여 재화나 서비스를 생산하는 사업. 농업·목축업·임업·광업·공업을 비롯한 유형물(有形物)의 생산 이외에 상업·금융업·운수업·서비스업 따위와 같이 생산에 직접 결부되지 않으나 국민 경제에 불가결한 사업도 포함하며, 좁은 뜻으로는 공업만을 가리키기도 한다. 〔명사〕"@ko ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=535088> ;
    kno:origin "産業" ;
    kno:urimalTargetCode "535088" ;
    kno:caseCount "15"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-I4 ;
    rdfs:label "산업(産業)"@ko .
