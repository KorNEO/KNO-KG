# KN2019-0159 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0159 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "소확횡"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1439150> ;
    skos:definition "‘소소하지만 확실한 횡령’을 줄여 이르는 말. 회사나 사무실 등에서 구비된 간식 따위를 밖으로 가지고 나오거나 회사 설비를 개인적인 용도로 이용하는 일 등이 이에 해당한다."@ko ;
    kno:activeYears "8"^^xsd:integer ;
    kno:component kno:KN2019-0159-c1 ;
    kno:component kno:KN2019-0159-c2 ;
    kno:component kno:KN2019-0159-c3 ;
    kno:componentString "소(소하다)(小), 확(실하다)(確), 횡(령)(橫)"@ko ;
    kno:example "¶심지어는 출근한 후에 화장실을 들르는 것이 자신의 {소확횡이라는} 직장인도 있다."@ko ;
