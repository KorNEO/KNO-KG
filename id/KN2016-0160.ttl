# KN2016-0160 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0160 kno:frequency kno:KN2016-0160-freq-NN-2016 ;
    kno:year "2016"^^xsd:gYear ;
    rdfs:label "메모리의 벽"@ko ;
    kno:example "¶OO, OO, OO 등도 시피유와 메모리, 스토리지 간 성능 격차가 전체적인 시스템 속도 향상에 병목 현상을 일으키는 ‘{메모리의 벽’을} 대외적으로 인정한 바 있다."@ko ;
    kno:frequency kno:KN2016-0160-freq-NN-total ;
