# KN2020-0002 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0002 kno:languageType "한^한^한^한" ;
    kno:pos "「구」"@ko ;
    kno:instantiates kno:S001112 ;
    kno:slotFiller "특별(特別)+관리(管理)+지역(地域) (3성분)"@ko ;
    kno:activeYears "4"^^xsd:integer ;
    skos:definition "감염병의 확산을 막기 위해 통상적인 수준보다 더 강한 방역 조치와 관리가 이루어지는 지역. 특정 지역을 중심으로 코로나19가 확산되기 시작하던 단계에서 효율적으로 방역 활동을 하기 위해 적용되었다."@ko ;
    kno:frequency kno:KN2020-0002-freq-NN-total ;
    kno:unitType "구"@ko ;
    kno:predicate "이루어지다"@ko ;
    kno:instantiates kno:S000168 ;
    rdfs:label "감염병^특별^관리^지역"@ko ;
    kno:frequency kno:KN2020-0002-freq-NN-2020 ;
    kno:component kno:KN2020-0002-c1 ;
    a kno:Neologism ;
    kno:component kno:KN2020-0002-c4 ;
    kno:slotFiller "감염병(感染病)+특별(特別)+관리(管理) (3성분)"@ko ;
    kno:example "¶O 국무총리는 신종 감염병의 방역과 관련하여 “OO 지역을 {감염병 특별 관리 지역으로} 지정해 더 높은 단계의 방역 조치를 취하겠다.”라고 발표했다."@ko ;
    kno:lastAttestationYear "2023"^^xsd:gYear ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1479326> ;
