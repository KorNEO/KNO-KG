# KN2014-0172 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0172 kno:formation kno:W02 ;
    kno:slotFiller "봉(封)+-족(族) (2성분)"@ko ;
    kno:languageType "(고+한)+한" ;
    kno:component kno:KN2014-0172-c3 ;
    kno:frequency kno:KN2014-0172-freq-NN-2015 ;
    skos:definition "낱개 포장된 물건을 필요한 양만 소량으로 구매하는 사람. 또는 그런 무리. 열매나 곡식의 낱개를 세는 단위 ‘알’과 봉지 따위에 담긴 물건을 세는 단위인 ‘봉’이 결합한 말이다."@ko ;
    kno:instantiates kno:S000001 ;
    kno:slotFiller "알+봉(封) (2성분)"@ko ;
