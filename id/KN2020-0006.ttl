    kno:pos "「구」"@ko ;
    kno:registration "신어DB"@ko ;
    a kno:Neologism ;
    skos:definition "감염병 환자 혹은 감염병 검사 결과를 기다리는 사람이 사회와 분리된 채 일상적인 생활을 할 수 있도록 마련한 시설. 코로나19의 확산을 막기 위해 증상이 나타나거나 의심되는 사람들을 사회로부터 떼어 놓고 생활하도록 만들어 놓은 시설이다."@ko ;
    kno:lastAttestationYear "2022"^^xsd:gYear ;
