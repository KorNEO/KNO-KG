# KN2020-0006 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0006 kno:indexForm "격리생활시설"@ko ;
    kno:example "¶정부는 감염병 확산을 차단하기 위해 해외 입국자들이 증상이 없더라도 감염병 검사 결과를 통보 받을 때까지 우선 {격리 생활 시설에} 거주해야 한다는 방침을 세웠다."@ko ;
    rdfs:label "격리^생활^시설"@ko ;
    kno:languageType "한^한^한" ;
    kno:unitType "구"@ko ;
