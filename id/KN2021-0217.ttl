@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0217 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2021-0217-att-nn ;
    ontolex:canonicalForm kno:KN2021-0217-form ;
    ontolex:sense kno:KN2021-0217-sense .

kno:KN2021-0217-att-nn a frac:Attestation ;
    dcterms:date "2020-08-03"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/079/0003390825> .

kno:KN2021-0217-form a ontolex:Form ;
    frac:frequency kno:KN2021-0217-freq-nn,
        kno:KN2021-0217-freq-yt ;
    ontolex:writtenRep "일^가구^일^주택법"@ko .

kno:KN2021-0217-freq-nn a frac:CorpusFrequency ;
    rdf:value 203 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0217-freq-yt a frac:CorpusFrequency ;
    rdf:value 180 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0217-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

