# KN2016-0584 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0584 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "호모^인턴스"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1368871> ;
    skos:definition "정규직으로 채용되지 못하고 인턴 생활만 반복하는 취업 준비생을 비유적으로 이르는 말."@ko ;
