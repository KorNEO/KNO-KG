# KN2012-0129 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0129 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "목각인형^춤극"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%AA%A9%EA%B0%81%EC%9D%B8%ED%98%95%EC%B6%A4%EA%B7%B9> ;
    skos:definition "배우 대신에 나무를 깎아 만든 인형을 등장시켜 춤을 추도록 조종하면서 하는 연극."@ko ;
