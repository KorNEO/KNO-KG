# F001852 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001852 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=370183> ;
    kno:urimalTargetCode "370183" ;
    kno:caseCount "2"^^xsd:integer ;
    kno:origin "capsule" ;
    kno:urimalDefinition "아교풀로 얇게 만든 작은 갑. 맛이나 냄새, 색상 따위가 좋지 않은 가루약이나 기름 따위를 넣어서 먹는 데 쓴다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-O2 ;
    kno:truncated "false"^^xsd:boolean ;
    kno:surfaceForm "캡슐"@ko ;
    rdfs:label "캡슐(capsule)"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-B3 ;
    kno:fullForm "캡슐"@ko ;
    a kno:Formative .
