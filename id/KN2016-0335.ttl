kno:KN2016-0335 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "아재 댄스"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372770> ;
    skos:definition "이전에 유행하였던 춤, 일정한 형식을 벗어나 제멋대로 추는 춤 또는 우스꽝스러운 몸짓으로 추는 춤 따위를 비유적으로 이르는 말. 아저씨들이 추는 춤이나 아저씨들이 좋아하는 춤을 의미한다."@ko ;
    kno:activeYears "10"^^xsd:integer ;
