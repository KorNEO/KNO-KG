    a kno:Neologism ;
    rdfs:label "내란무새"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%82%B4%EB%9E%80%EB%AC%B4%EC%83%88> ;
    skos:definition "(LLM) 정치적 논쟁 등에서 상대의 주장이나 맥락은 외면한 채 어떤 사안이든 ‘내란’으로만 규정하며 같은 말을 되풀이하는 사람을 비꼬아 이르는 말."@ko ;
