# F002107 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002107 a kno:Formative ;
    rdfs:label "갈대"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=559784> ;
