# KN2015-0034 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0034 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "놀-족"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%86%80%EC%A1%B1> ;
    skos:definition "일이나 업무 따위를 놀이처럼 하는 사람. 또는 그런 무리. 일과 놀이의 경계를 분명하게 나누지 않고 일을 재미있게 하고자 노력하는 사람이나 무리를 이르는 말이다."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2015-0034-c1 ;
    kno:component kno:KN2015-0034-c2 ;
    kno:componentString "놀, -족(族)"@ko ;
    kno:example "¶20대는 {놀족이다}. 일상을 놀이처럼, 놀이를 일상처럼 즐긴다."@ko ;
