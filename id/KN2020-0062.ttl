# KN2020-0062 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0062 kno:component kno:KN2020-0062-c5 ;
    kno:instantiates kno:S000485 ;
    kno:instantiates kno:S001261 ;
    kno:pos "「구」"@ko ;
    rdfs:label "긴급^재난^생계^지원^자금"@ko ;
    kno:year "2020"^^xsd:gYear ;
    kno:activeYears "1"^^xsd:integer ;
    kno:predicate "지급하다"@ko ;
    kno:origin "(緊急災難生計支援資金)" ;
    kno:component kno:KN2020-0062-c3 ;
    a kno:Neologism ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%B4%EA%B8%89%EC%9E%AC%EB%82%9C%EC%83%9D%EA%B3%84%EC%A7%80%EC%9B%90%EC%9E%90%EA%B8%88> ;
    skos:definition "전국적인 재난 사태로 인해 생계에 어려움을 겪는 국민들에게 정부가 긴급하게 지급하는 자금. 코로나19의 확산으로 인한 경제 위축이 장기화되자 국민들의 생계를 지원하고 위축된 소비 심리를 진작하기 위해 마련된 제도로, 지급 주체가 지방 자치 단체일 경우 각 지방 자치 단체에 따라 지급 내용과 용어가 조금씩 다르다."@ko ;
    kno:frequency kno:KN2020-0062-freq-NN-total ;
    kno:component kno:KN2020-0062-c1 ;
    kno:componentString "긴급(緊急), 재난(災難), 생계(生計), 지원(支援), 자금(資金)"@ko ;
    kno:slotFiller "재난(災難)+생계(生計)+지원(支援) (3성분)"@ko ;
    kno:lastAttestationYear "2020"^^xsd:gYear ;
    kno:slotFiller "지원(支援)+자금(資金) (2성분)"@ko ;
    kno:component kno:KN2020-0062-c4 ;
    kno:registration "신어DB"@ko ;
    kno:example "¶한 콜센터에서 코로나19 집단 확진이 발생하자 OO 콜센터 노조는 “정부는 지원 사각지대에 놓여 있는 취약 노동자 보호를 위해 {긴급 재난 생계 지원 자금} 등 대책을 수립하여 생계를 위한 돈을 지급해야 한다.”라고 주장했다."@ko ;
    kno:unitType "구"@ko ;
    a ontolex:MultiwordExpression ;
