# KN2016-0394 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0394 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "우선^선택^지명^원칙"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372829> ;
    skos:definition "지명을 결정할 때에 공적으로 인정되어 널리 불리는 지명, 역사성과 상징성을 가진 지명, 지역 실정에 맞는 지명을 우선하여 선택해야 한다는 원칙. 2012년, 국토 교통부가 발간한 ‘지명 표준화 편람(제2판)’에 명시되어 있다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2016-0394-c1 ;
    kno:component kno:KN2016-0394-c2 ;
    kno:component kno:KN2016-0394-c3 ;
    kno:component kno:KN2016-0394-c4 ;
    kno:componentString "우선(優先), 선택(選擇), 지명(地名), 원칙(原則)"@ko ;
    kno:example "¶위원회의 결정에 대해 OO시는 반발했다. 국토 교통부가 지난 2012년 발간한 ‘지명 표준화 편람’의 지명 표준화 기본 원칙 가운데 현재 불리고 있는 지명을 우선 채택한다는 현칭주의 원칙과 {우선 선택 지명 원칙에} 위배된다는 이유다."@ko ;
    kno:frequency kno:KN2016-0394-freq-NN-2016 ;
    kno:frequency kno:KN2016-0394-freq-NN-total ;
    kno:indexForm "우선선택지명원칙"@ko ;
    kno:languageType "한^한^한^한" ;
