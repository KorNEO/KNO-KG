# KN2019-0334 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0334 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "혼족-템"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%98%BC%EC%A1%B1%ED%85%9C> ;
    skos:definition "혼자 사는 사람을 위한 물건. 주로 수량이 적은 물건을 말한다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2019-0334-c1 ;
