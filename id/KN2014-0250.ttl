# KN2014-0250 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0250 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "첫사랑 브레이커"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1373506> ;
    skos:definition "다른 사람의 첫사랑을 방해하거나 첫사랑을 하고 있는 두 사람 사이에 끼어들어 이들의 관계를 갈라놓는 사람."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2014-0250-c1 ;
    kno:component kno:KN2014-0250-c2 ;
    kno:componentString "첫사랑, 브레이커(braker)"@ko ;
    kno:example "¶결국 그는 영화 ‘OO’에서 OOO-OOO 커플, 영화 ‘OO’ OO-OOO 커플을 방해한 데에 이어 또 남의 연애사를 끼어든 모양새가 된다. ‘{첫사랑 브레이커’의} 오명을 뒤집어쓰게 되는 셈이다."@ko ;
    kno:frequency kno:KN2014-0250-freq-NN-2013 ;
