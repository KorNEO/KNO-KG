# F002256 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002256 kno:urimalDefinition "규칙적으로 되풀이되는 자연 현상에 따라서 일 년을 구분한 것. 일반적으로 온대 지방은 기온의 차이를 기준으로 하여 봄, 여름, 가을, 겨울의 네 계절로 나누고, 열대 지방에서는 강우량을 기준으로 하여 건기와 우기로 나눈다. 천문학적으로는 춘분, 하지, 추분, 동지로 나눈다. 〔명사〕"@ko ;
    rdfs:label "계절(季節)"@ko ;
    kno:fullForm "계절"@ko ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=377013> ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "계절"@ko ;
    kno:semanticTag kno:usas-T1.3 ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "377013" ;
    kno:truncated "false"^^xsd:boolean ;
    kno:origin "季節" .
kno:KN2020-0121-c3 kno:formative kno:F002256 .
