# F001173 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001173 a kno:Formative ;
    rdfs:label "대장동(大庄洞)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1409096> ;
    kno:caseCount "2"^^xsd:integer ;
    kno:fullForm "대장동"@ko ;
    kno:origin "大庄洞" ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-Z2 ;
    kno:surfaceForm "대장동"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "경기도 고양시 덕양구에 있는 동. 덕양구의 남서부에 위치해 있다. 서북쪽에 묘하나골산이 솟아 있으며, 동쪽과 남쪽에 대장천이 경계를 따라 흐른다. 하천 주변으로 농경지가 형성되어 있다. 동쪽에 교외선이 지나며, 대정역이 자리하고 있다. 서울 지하철 3호선, 경의중앙선, 수도권 제1 순환 고속 도로, 39번 국도가 지난다. 〔명사〕"@ko ;
    kno:urimalTargetCode "1409096" .
kno:KN2022-0113-c1 kno:formative kno:F001173 .
