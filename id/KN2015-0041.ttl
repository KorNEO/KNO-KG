# KN2015-0041 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0041 kno:predicate "형성하다"@ko ;
    kno:lastAttestationYear "2015"^^xsd:gYear ;
    a ontolex:MultiwordExpression ;
    kno:instantiates kno:S000901 ;
    skos:definition "초저금리로 인해 유동 자금이 고수익을 창출하는 주식과 부동산 시장으로 흘러 들어가 자산 거품을 형성하는 현상. 시대 변화에 따라 새롭게 부상하는 표준인 ‘뉴 노멀(new normal)’에 거품 형성을 뜻하는 ‘붐(boom)’이 결합된 말이다."@ko ;
    kno:component kno:KN2015-0041-c3 ;
    kno:slotFiller "붐(boom) (1성분)"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1359957> ;
    kno:frequency kno:KN2015-0041-freq-NN-2015 ;
    kno:componentString "뉴(new), 노멀(normal), 붐(boom)"@ko ;
    kno:languageType "영^영^영" ;
    kno:instantiates kno:S001302 ;
    kno:year "2015"^^xsd:gYear ;
    kno:unitType "구"@ko ;
    kno:indexForm "뉴노멀붐"@ko ;
    kno:pos "「구」"@ko ;
    kno:component kno:KN2015-0041-c1 ;
    kno:component kno:KN2015-0041-c2 ;
    kno:frequency kno:KN2015-0041-freq-NN-total ;
    a kno:Neologism ;
    kno:example "¶{뉴 노멀 붐은} 뉴 노멀 시대를 맞아 역사상 최저치로 떨어진 저금리ㆍ저성장 흐름이 오랫동안 지속될 것이라는 분위기에서 만들어진 것이다."@ko ;
    kno:urimalTargetCode "1359957" ;
    rdfs:label "뉴^노멀^붐"@ko ;
    kno:origin "(<영>new normal boom)" ;
    kno:slotFiller "뉴(new)+노멀(normal) (2성분)"@ko .
