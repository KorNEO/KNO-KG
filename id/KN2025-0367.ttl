# KN2025-0367 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0367 kno:year "2025"^^xsd:gYear ;
    a kno:Neologism ;
    kno:pos "「명」"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:example "(LLM) 온라인을 중심으로 캄보디아에서 사기 조직이 활동한다는 이야기가 퍼지면서, 누리 소통망 서비스(SNS)에서는 {스캠보디아라는} 말까지 등장했다."@ko ;
    kno:indexForm "스캠보디아"@ko ;
    kno:languageType "영+영" ;
    kno:component kno:KN2025-0367-c2 ;
    kno:frequency kno:KN2025-0367-freq-NN-total ;
    kno:registration "신어DB"@ko ;
    a ontolex:Word ;
    skos:definition "(LLM) ‘스캠(scam, 사기)’과 ‘캄보디아’를 결합한 말로, 온라인 사기ㆍ납치ㆍ감금 등 범죄의 거점이라는 인식을 바탕으로 캄보디아를 비하하여 이르는 표현. ⇒규범 표기는 미확정이다."@ko ;
    kno:unitType "단어"@ko ;
