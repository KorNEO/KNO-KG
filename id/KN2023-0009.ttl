# KN2023-0009 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0009 kno:unitType "구"@ko ;
    kno:pos "「구」"@ko ;
    skos:definition "개인 채무자들의 빚 부담을 경감하기 위하여 필요한 사항을 정한 법. 정식 명칭은 ‘개인 금융 채권의 관리 및 개인 채무자 보호에 관한 법률’이다."@ko ;
    kno:origin "(個人債務者保護法)" ;
    kno:instantiates kno:S000469 ;
    kno:frequency kno:KN2023-0009-freq-NN-2025 ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:activeYears "4"^^xsd:integer ;
    kno:slotFiller "채무자(債務者)+보호법(保護法) (2성분)"@ko ;
    kno:component kno:KN2023-0009-c3 ;
    kno:slotFiller "개인(個人)+채무자(債務者) (2성분)"@ko ;
    kno:example "¶OO에서도 취약 계층과 관련하여 향후 채무자와 금융 회사 간의 자율적인 채무 조정을 제도적으로 뒷받침하기 위하여 {개인 채무자 보호법을} 제정하기로 결정했다."@ko ;
    kno:languageType "한^한^한" ;
