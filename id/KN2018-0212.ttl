# KN2018-0212 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0212 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "슬로컬리제이션"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415676> ;
    skos:definition "도시에서 느리게 사는 삶을 이르는 말. 바쁜 도시 생활 속에서 여유를 가지고 느리게 사는 경험을 하자는 뜻으로, ‘느린’을 뜻하는 ‘슬로(slow)’와 ‘지역화’를 뜻하는 ‘로컬리제이션(localization)’을 결합하여 만든 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2018-0212-c1 ;
    kno:component kno:KN2018-0212-c2 ;
    kno:componentString "슬로(slow), (로)컬리제이션(localization)"@ko ;
    kno:example "¶일례로 도시에서 느린 삶을 경험한다는 의미의 ‘{슬로컬리제이션’을} 실천하는 경향이 두드러지고 있다. 들로, 산으로, 경치 좋은 곳으로 떠나 그곳에서 캠핑을 하는 캠핑족들이 늘고 있다."@ko ;
    kno:formation kno:W05 ;
    kno:frequency kno:KN2018-0212-freq-NN-2018 ;
    kno:frequency kno:KN2018-0212-freq-NN-total ;
    kno:indexForm "슬로컬리제이션"@ko ;
