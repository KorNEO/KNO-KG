@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0091 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2020-0091-att-nn ;
    ontolex:canonicalForm kno:KN2020-0091-form ;
    ontolex:sense kno:KN2020-0091-sense .

kno:KN2020-0091-att-nn a frac:Attestation ;
    dcterms:date "2020-03-13"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/016/0001648124> .

kno:KN2020-0091-form a ontolex:Form ;
    frac:frequency kno:KN2020-0091-freq-nn,
        kno:KN2020-0091-freq-yt ;
    ontolex:writtenRep "동학 개미 운동"@ko .

kno:KN2020-0091-freq-nn a frac:CorpusFrequency ;
    rdf:value 5833 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0091-freq-yt a frac:CorpusFrequency ;
    rdf:value 754 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0091-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/2020%EB%85%84%20%EC%A3%BC%EA%B0%80%20%EB%8C%80%ED%8F%AD%EB%9D%BD> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

