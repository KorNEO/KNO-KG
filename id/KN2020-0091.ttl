# KN2020-0091 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0091 kno:frequency kno:KN2020-0091-freq-NN-2021 ;
    kno:component kno:KN2020-0091-c3 ;
    a kno:Neologism ;
    kno:unitType "구"@ko ;
    kno:slotFiller "동학(東學) (1성분)"@ko ;
    kno:instantiates kno:S001255 ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    skos:definition "코스피 지수 및 코스닥 지수의 폭락을 막기 위한 국내 개인 투자자들의 대규모 매수세를 동학 농민 운동에 빗대어 이르는 말. 코로나19의 확산과 그에 따른 경제 위기로 인해, 우리나라 주식 시장에 대해 불안감을 느끼기 시작한 외국인 투자자들이 대규모 매도세를 이어 갔고, 이에 맞서 매도된 매물을 힘겹게 매수하여 우리나라 주식 시장을 지켜낸 국내 개인 투자자들의 모습과 그 상황이 1894년에 일어난 반외세 운동인 동학 농민 운동과 유사하여 붙여진 이름이다."@ko ;
    kno:frequency kno:KN2020-0091-freq-NN-2022 ;
    kno:slotFiller "개미+운동(運動) (2성분)"@ko ;
    kno:instantiates kno:S000719 ;
    kno:componentString "동학(東學), 개미, 운동(運動)"@ko ;
    kno:example "¶한국 증시는 코로나19에도 불구하고 일명 ‘{동학 개미 운동’이라} 불리는 개인 투자자들의 적극적인 시장 참여로 인해 전례 없는 상승세가 이어졌다."@ko ;
    kno:pos "「구」"@ko ;
