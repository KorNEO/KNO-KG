@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0026 a ontolex:Word ;
    frac:attestation kno:KN2023-0026-att-nn ;
    ontolex:canonicalForm kno:KN2023-0026-form ;
    ontolex:sense kno:KN2023-0026-sense .

kno:KN2023-0026-att-nn a frac:Attestation ;
    dcterms:date "2022-10-20"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/025/0003232056> .

kno:KN2023-0026-form a ontolex:Form ;
    frac:frequency kno:KN2023-0026-freq-nn,
        kno:KN2023-0026-freq-yt ;
    ontolex:writtenRep "곱게팅"@ko .

kno:KN2023-0026-freq-nn a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0026-freq-yt a frac:CorpusFrequency ;
    rdf:value 13 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0026-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

