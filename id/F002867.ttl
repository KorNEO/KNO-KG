# F002867 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002867 kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=564866> ;
    a kno:Formative ;
    kno:fullForm "단백질"@ko ;
    kno:semanticTag kno:usas-F1 ;
    kno:origin "蛋白質" ;
    kno:urimalTargetCode "564866" ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:label "단백질(蛋白質)"@ko ;
    kno:urimalDefinition "아미노산이 펩타이드 결합을 하여 생긴 여러 개의 아미노산으로 이루어진 고분자 화합물. 세포를 구성하고 생체 내 물질대사의 촉매 작용을 하여 생명 현상을 유지하는 물질로서, 사람의 3대 영양소 가운데 하나이다. 〔명사〕"@ko ;
    kno:surfaceForm "단백질"@ko ;
    kno:registration "우리말샘"@ko .
kno:KN2020-0011-c2 kno:formative kno:F002867 .
