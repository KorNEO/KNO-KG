    a kno:Neologism ;
    rdfs:label "국가^지도^통신^차량"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B5%AD%EA%B0%80%EC%A7%80%EB%8F%84%ED%86%B5%EC%8B%A0%EC%B0%A8%EB%9F%89> ;
    skos:definition "국가가 위기 상황에 처할 경우 국가 위기 관리 센터를 대신하여 그 역할을 수행하는 차량. =국가 지도 차량."@ko ;
