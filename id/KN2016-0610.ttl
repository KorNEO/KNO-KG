# KN2016-0610 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0610 rdfs:label "회계^올림픽"@ko ;
    kno:urimalTargetCode "1373045" ;
    kno:component kno:KN2016-0610-c2 ;
    kno:unitType "구"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:frequency kno:KN2016-0610-freq-NN-total ;
