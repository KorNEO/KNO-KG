@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0273 a ontolex:Word ;
    frac:attestation kno:KN2022-0273-att-nn ;
    ontolex:canonicalForm kno:KN2022-0273-form ;
    ontolex:sense kno:KN2022-0273-sense .

kno:KN2022-0273-att-nn a frac:Attestation ;
    dcterms:date "2021-06-26"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/003/0010573077> .

kno:KN2022-0273-form a ontolex:Form ;
    frac:frequency kno:KN2022-0273-freq-nn,
        kno:KN2022-0273-freq-yt ;
    ontolex:writtenRep "커팅-족"@ko .

kno:KN2022-0273-freq-nn a frac:CorpusFrequency ;
    rdf:value 7 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0273-freq-yt a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0273-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

