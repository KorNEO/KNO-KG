    a kno:Neologism ;
    rdfs:label "요가 링"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9A%94%EA%B0%80%20%EB%A7%81> ;
    skos:definition "요가를 할 때 발을 올리거나 종아리에 끼우는 동작 따위에 쓰는 고리."@ko ;
