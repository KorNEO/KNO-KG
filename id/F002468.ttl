# F002468 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002468 rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B5%AD> ;
    kno:registration "우리말샘"@ko ;
    kno:origin "國會議員" ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:label "국(회의원)(國會議員)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=488855> ;
    kno:urimalDefinition "국민의 대표로서 국회를 이루는 구성원. 국민의 선거에 의하여 선출된다. 우리나라의 경우, 임기는 4년이며, 지역구 253인과 비례 대표 47인으로 구성되어 있다. 현행범인 경우를 제외하고는 회기 중 국회의 동의 없이 체포 또는 구금할 수 없으며, 회기 전에 체포 또는 구금한 때는 현행범이 아닌 한 국회의 요구가 있으면 회기 중 석방하며, 국회에서 직무상 행한 발언과 표결에 대하여 국회 밖에서 책임을 지지 않는 면책 특권이 있다."@ko ;
    kno:surfaceForm "국"@ko ;
    kno:parallelFullForm kno:LEX-국회의원 ;
    a kno:Formative ;
    kno:fullFormLexeme kno:LEX-국회의원 ;
    kno:semanticTag kno:usas-G1.1 ;
    kno:urimalTargetCode "488855" ;
    kno:fullForm "국회의원"@ko ;
    kno:truncated "true"^^xsd:boolean .
