# KN2017-0195 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0195 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "얼리힐링족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380759> ;
    skos:definition "자신이 행복하게 사는 것을 최우선으로 생각하는 30대의 사람. 또는 그런 무리. 주로 자기 계발이나 건강 관리 등에 시간과 돈을 투자하여 지치고 상처 입은 몸과 마음을 치유하고자 하는 30대를 이르는 말이다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2017-0195-c1 ;
    kno:component kno:KN2017-0195-c2 ;
    kno:component kno:KN2017-0195-c3 ;
    kno:componentString "얼리(early), 힐링(healing), -족(族)"@ko ;
    kno:example "¶또한 행복한 삶의 가치를 추구하는 30대인 ‘{얼리 힐링족’은} 일 외에 본인의 삶과 생활을 중시하는 소비자들로 자기 계발과 여행, 자동차 등에 관심이 많다."@ko ;
    kno:frequency kno:KN2017-0195-freq-NN-2016 ;
