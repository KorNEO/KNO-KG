# KN2022-0077 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0077 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "글로벌^메탄^서약"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%80%EB%A1%9C%EB%B2%8C%EB%A9%94%ED%83%84%EC%84%9C%EC%95%BD> ;
    skos:definition "2020년과 비교하여 2030년까지 메탄의 배출을 최소 30% 이상 줄인다는 내용의 서약. 메탄이 기후 변화에 영향을 미치는 온실가스이므로 이와 관련하여 국제적 메탄 감축 협력에 대한 논의가 반영된 것이다. =국제 메탄 서약."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2022-0077-c1 ;
