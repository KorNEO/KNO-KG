@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0253 a ontolex:Word ;
    frac:attestation kno:KN2024-0253-att-nn ;
    ontolex:canonicalForm kno:KN2024-0253-form ;
    ontolex:sense kno:KN2024-0253-sense .

kno:KN2024-0253-att-nn a frac:Attestation ;
    dcterms:date "2024-03-25"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/023/0003824328> .

kno:KN2024-0253-form a ontolex:Form ;
    frac:frequency kno:KN2024-0253-freq-nn,
        kno:KN2024-0253-freq-yt ;
    ontolex:writtenRep "재렉스"@ko .

kno:KN2024-0253-freq-nn a frac:CorpusFrequency ;
    rdf:value 5 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0253-freq-yt a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0253-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%95%8C%EB%A0%89%EC%8A%A4(%EC%B9%B4%EC%9A%B4%ED%84%B0%EC%82%AC%EC%9D%B4%EB%93%9C)/%EB%B8%8C%EB%A0%88%EC%9D%B4%ED%81%AC%EB%B9%84%ED%8A%B8> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

