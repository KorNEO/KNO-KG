# KN2024-0253 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0253 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "재렉스"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9E%AC%EB%A0%89%EC%8A%A4> ;
    skos:definition "주식, 펀드, 암호 화폐 투자 등을 통해 미래를 위한 자산 관리를 하면서 명품 의류 구입이나 해외여행 등 현재의 가치와 만족 또한 중시하는 생활 방식. 투자 활동을 의미하는 ‘재테크(財tech)’와 과시적 소비를 뜻하는 ‘플렉스(flex)’를 결합하여 만든 말이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2024-0253-c1 ;
    kno:component kno:KN2024-0253-c2 ;
    kno:componentString "재(財), (플)렉스(flex)"@ko ;
    kno:example "¶그녀는 주식으로 번 돈을 재투자하면서도 자신을 위한 새 명품 가방을 구매하는 {재렉스를} 실천하고 있다."@ko ;
    kno:formation kno:W05 ;
    kno:frequency kno:KN2024-0253-freq-NN-2024 ;
