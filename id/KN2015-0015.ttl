# KN2015-0015 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0015 kno:slotFiller "굿즈(goods) (1성분)"@ko ;
    kno:pos "「명」"@ko ;
    kno:predicate "집착하다"@ko ;
    rdfs:label "굿즈덕"@ko ;
    kno:formation kno:W05 ;
    kno:component kno:KN2015-0015-c1 ;
    kno:instantiates kno:S000060 ;
    kno:component kno:KN2015-0015-c2 ;
    kno:componentString "굿즈(goods), 덕(후)(otaku)"@ko ;
    kno:languageType "영+일" ;
    kno:indexForm "굿즈덕"@ko ;
    a ontolex:Word ;
    skos:definition "그림이나, 만화, 영화, 연예인 등의 문화 콘텐츠와 관련된 상품을 지나치게 좋아하거나 집착하는 사람. 또는 그에 전문적인 지식을 지닌 사람. 주로 자기가 좋아하는 아이돌을 응원하기 위하여 그와 관련된 모든 상품을 사서 모으려고 하는 사람을 가리킨다."@ko ;
    kno:registration "신어DB"@ko ;
    kno:unitType "단어"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B5%BF%EC%A6%88%EB%8D%95> ;
    kno:activeYears "0"^^xsd:integer ;
    kno:year "2015"^^xsd:gYear ;
    a kno:Neologism ;
    kno:origin "(<영>goods<일>←otaku[御宅])" ;
    kno:example "¶{굿즈덕은} 아이돌과 같은 스타의 얼굴이 그려진 상품을 모으는 덕후이고, 문구덕은 펜, 연필, 노트 등을 모으기 좋아하는 덕후, 그리고 소품덕은 인테리어용 작은 물건들을 모으는 마니아입니다."@ko .
