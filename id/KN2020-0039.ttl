# KN2020-0039 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0039 kno:instantiates kno:S000634 ;
    kno:activeYears "2"^^xsd:integer ;
    kno:componentString "기간산업(基幹産業), 기금(基金)"@ko ;
    kno:predicate "지급하다"@ko ;
    kno:languageType "한^한" ;
    skos:definition "기간산업의 경영난 및 그에 따른 근로자의 고용 불안을 해소하기 위해 정부가 지급하는 기금. 코로나19의 확산으로 인해 기간산업계가 어려움을 겪자 정부가 지원하는 돈으로, 한국 산업 은행이 기업에 자금을 빌려주고 정부에서 지급 보증을 해 주는 형식으로 운영된다. 기간산업을 영위하는 기업이나 기간산업 기업을 지원하기 위해 설립된 회사 및 기구를 지원 대상으로 한다. =기간산업 안정 기금, 기간 안정 산업 기금."@ko ;
    kno:frequency kno:KN2020-0039-freq-NN-2020 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%B0%EA%B0%84%EC%82%B0%EC%97%85%EA%B8%B0%EA%B8%88> ;
