# KN2023-0058 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0058 kno:slotFiller "깡통+전세(傳貰)+공공(公共)+매입(買入) (4성분)"@ko ;
    kno:registration "신어DB"@ko ;
    kno:activeYears "1"^^xsd:integer ;
