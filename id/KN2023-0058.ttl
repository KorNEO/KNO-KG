    kno:frequency kno:KN2023-0058-freq-NN-2023 ;
    kno:languageType "(고+한)^한^한^한^한" ;
    a ontolex:MultiwordExpression ;
    kno:example "¶전세 사기에 대한 대책으로 제시된 {깡통 전세 공공 매입 특별법은} 공공 기관이 보증금 채권을 매입하여 공공 임대 주택으로 활용하고, 피해 임차인들에게 우선적으로 지원하는 것을 주요 내용으로 한다."@ko ;
    kno:frequency kno:KN2023-0058-freq-NN-total ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B9%A1%ED%86%B5%EC%A0%84%EC%84%B8%EA%B3%B5%EA%B3%B5%EB%A7%A4%EC%9E%85%ED%8A%B9%EB%B3%84%EB%B2%95> ;
