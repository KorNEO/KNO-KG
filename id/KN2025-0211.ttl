    kno:activeYears "1"^^xsd:integer ;
    kno:example "(LLM) 검진 결과를 바탕으로 식단과 운동, 수면을 다시 설계하고 피부 관리까지 병행하는 {리뉴에이징}을 시작했다."@ko ;
