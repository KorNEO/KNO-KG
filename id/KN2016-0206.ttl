# KN2016-0206 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0206 a kno:Neologism ;
    kno:example "¶OOO 의원은 11일 의원 총회에서 ‘{병립형 석패율제’를} 당론으로 채택해 줄 것을 공식 제안했다."@ko ;
    kno:origin "(竝立形惜敗率制)" ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B3%91%EB%A6%BD%ED%98%95%EC%84%9D%ED%8C%A8%EC%9C%A8%EC%A0%9C> ;
    kno:indexForm "병립형석패율제"@ko ;
    kno:year "2016"^^xsd:gYear ;
    kno:activeYears "1"^^xsd:integer ;
    kno:frequency kno:KN2016-0206-freq-NN-2015 ;
    skos:definition "권역별 비례 대표제와 석패율제를 결합하여 의원을 선출하는 선거 제도. 전국을 권역에 따라 구별하고 정당 득표율에 따라 권역별 비례 대표 당선자를 결정하는 방식으로, 의원의 정수를 늘리지 않으면서 취약 지역구 후보를 비례 대표로 선출할 수 있도록 하여 지역주의를 완화하는 효과를 거둘 수 있다."@ko ;
    kno:component kno:KN2016-0206-c1 ;
