# KN2019-0070 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0070 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "또티지"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%98%90%ED%8B%B0%EC%A7%80> ;
    skos:definition "액세서리 따위에서 낡고 오래된 느낌을 중요하게 생각하는 경향. 빈티지를 선호하는 경향성이 다시 돌아왔다는 의미에서 ‘또’를 ‘빈티지’에 붙여서 만든 말이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2019-0070-c1 ;
    kno:component kno:KN2019-0070-c2 ;
    kno:componentString "또, (빈)티지(vintage)"@ko ;
    kno:example "¶{‘또티지’는} ‘또? 빈티지’를 뜻하며, 새로울 것 같지 않은 예스러움이 현시대에 맞게 재해석되는 흐름을 담았다."@ko ;
    kno:formation kno:W05 ;
    kno:frequency kno:KN2019-0070-freq-NN-2019 ;
    kno:frequency kno:KN2019-0070-freq-NN-total ;
