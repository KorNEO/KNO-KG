kno:KN2025-0140 kno:componentString "누(noûs), 세미아(sêmeîon)"@ko ;
    rdfs:label "누세미아"@ko ;
    skos:definition "(LLM) 생성형 인공지능과 대화하는 과정에서 그 대상에게 의도ㆍ감정ㆍ내면 등 인간과 같은 정신적 상태가 있다고 느끼거나, 실제 인격체와 소통하는 듯한 감각을 경험하는 인지적 현상."@ko ;
