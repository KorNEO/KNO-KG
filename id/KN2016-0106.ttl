# KN2016-0106 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0106 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "도^의원^내각제"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8F%84%EC%9D%98%EC%9B%90%EB%82%B4%EA%B0%81%EC%A0%9C> ;
    skos:definition "도 의원이 지방 장관을 겸직할 수 있도록 하는 의원 내각제. 현행 지방 자치법에서는 지방 의원이 지방 공무원을 겸직할 수 없으나, ‘지방 장관’이라는 명예직을 두어 도 의원이 둘 이상의 직위를 겸할 수 있도록 한다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
