# KN2018-0026 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0026 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415806> ;
    kno:component kno:KN2018-0026-c2 ;
    kno:componentString "경찰(警察), 로또(lotto)"@ko ;
    skos:definition "경찰을 대상으로 고소를 하거나 민원을 제기하여 받은 거액의 합의금을 ‘로토’의 비규범 표기형인 ‘로또’에 비유하여 이르는 말. 자신의 잘못을 떠나 경찰관에게 물리적인 행사를 당했다는 이유로 소송을 걸어 거액을 취하는 것을 말한다. ⇒규범 표기는 ‘경찰 로토’이다."@ko ;
    kno:urimalTargetCode "1415806" ;
    kno:frequency kno:KN2018-0026-freq-NN-2017 ;
    kno:languageType "한_영" ;
    rdfs:label "경찰 로또"@ko ;
    kno:lastAttestationYear "2018"^^xsd:gYear ;
    kno:example "¶O 경사는 얼마 전 유흥업소 밀집 지역을 순찰하던 중 한 상인으로부터 “유흥업소 호객꾼 사이에서 ‘{경찰 로또’란} 말이 돈다.”라는 얘기를 들었다."@ko ;
    kno:registration "우리말샘"@ko ;
