# F006444 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006444 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1330144> ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "택견에서, 양팔을 높이 들었다가 힘을 빼고 내리면서 몸을 터는 동작. 긴장을 완화하고 팔 근육을 풀어 준다. 전체적으로 힘을 뺀 상태에서 실행한다. 〔명사〕"@ko ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "털기"@ko ;
    kno:surfaceForm "털기"@ko ;
    kno:urimalTargetCode "1330144" ;
    kno:semanticTag kno:usas-A1.1.1 ;
    rdfs:label "털기"@ko ;
