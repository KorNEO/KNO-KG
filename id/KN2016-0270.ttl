# KN2016-0270 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0270 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "세대^분리^현상"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372705> ;
    skos:definition "서로 다른 세대가 가치관이나 행동 따위의 차이로 인해 분리되는 현상."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2016-0270-c1 ;
    kno:component kno:KN2016-0270-c2 ;
    kno:component kno:KN2016-0270-c3 ;
    kno:componentString "세대(世代), 분리(分離), 현상(現象)"@ko ;
    kno:example "¶OOO은 “광주를 중심으로 젊은 층은 OO당, 고령층은 OO당 등 지지 정당에 대한 {세대 분리 현상이} 나타나고 있다.”라면서 “현재까지는 어느 한쪽으로 기울지 않고 있다.”라고 말했다."@ko ;
    kno:frequency kno:KN2016-0270-freq-NN-2016 ;
    kno:frequency kno:KN2016-0270-freq-NN-2017 ;
