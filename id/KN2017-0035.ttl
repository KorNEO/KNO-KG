    kno:slotFiller "(얼리 어)답터(early adopter)+-족(族) (2성분)"@ko ;
    rdfs:label "그루답터-족"@ko ;
    kno:languageType "영+한" ;
    kno:example "¶패션과 미용에 아낌없이 투자하는 ‘그루밍족’을 넘어 피부 타입에 맞는 제품을 비교하거나 메이크업 제품을 사용하는 ‘{그루답터족’까지} 생겼다."@ko ;
    kno:instantiates kno:S001163 ;
    kno:component kno:KN2017-0035-c1 ;
    kno:componentString "그루(밍)(grooming), (얼리 어)답터(early adopter), -족(族)"@ko ;
