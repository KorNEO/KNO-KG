# KN2017-0035 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0035 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "그루답터-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380345> ;
    skos:definition "다른 사람보다 먼저 패션이나 미용과 관련된 신제품을 구매하여 외모를 가꾸는 남자. 또는 그런 무리. 자신의 패션이나 미용에 아낌없이 투자하는 남자들을 일컫는 ‘그루밍족(gloomming族)’과, 새로운 제품에 대한 정보를 다른 사람보다 먼저 알고 신제품을 구매하여 사용하는 사람을 의미하는 ‘얼리 어답터(early adopter)’를 결합하여 만든 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2017-0035-c1 ;
    kno:component kno:KN2017-0035-c2 ;
    kno:component kno:KN2017-0035-c3 ;
    kno:componentString "그루(밍)(grooming), (얼리 어)답터(early adopter), -족(族)"@ko ;
    kno:example "¶패션과 미용에 아낌없이 투자하는 ‘그루밍족’을 넘어 피부 타입에 맞는 제품을 비교하거나 메이크업 제품을 사용하는 ‘{그루답터족’까지} 생겼다."@ko ;
    kno:formation kno:W02 ;
    kno:frequency kno:KN2017-0035-freq-NN-2016 ;
