# KN2017-0254 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0254 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "지휘 근무병"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380240> ;
    skos:definition "지휘관의 공적 직무 수행을 돕고 비서 역할을 하는 병사. 주로 지휘관실의 시설을 관리하고, 상황실과의 연락을 담당하며, 기타 공적 업무를 수행한다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2017-0254-c1 ;
    kno:component kno:KN2017-0254-c2 ;
    kno:componentString "지휘(指揮), 근무병(勤務兵)"@ko ;
    kno:example "¶이처럼 {지휘 근무병은} 지휘관이 자신의 역할에 좀 더 충실할 수 있도록 돕지만, 부대에 따라 업무 강도가 천차만별인 탓에 일각에서는 지나친 사역(使役)이 아니냐는 지적도 있다."@ko ;
    kno:frequency kno:KN2017-0254-freq-NN-2016 ;
    kno:frequency kno:KN2017-0254-freq-NN-total ;
    kno:indexForm "지휘근무병"@ko ;
    kno:languageType "한_한" ;
    kno:lastAttestationYear "2016"^^xsd:gYear ;
    kno:origin "(指揮勤務兵)" ;
    kno:pos "「구」"@ko ;
    kno:predicate "하다"@ko ;
