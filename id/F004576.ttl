# F004576 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004576 kno:urimalDefinition "인터넷 웹 페이지에 나타나는 데이터 중에서 필요한 데이터만을 추출하도록 만들어진 프로그램. 각 사이트로부터 데이터를 수집해 오는 기술, 일정 포맷으로 변환하는 기술 따위가 핵심이다. ⇒규범 표기는 ‘스크레이핑’이다. 〔명사〕"@ko ;
    kno:surfaceForm "스크래핑"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    rdfs:label "스크래핑(scraping)"@ko ;
    kno:origin "scraping" ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "1392134" ;
    a kno:Formative ;
