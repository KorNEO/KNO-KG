@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0085 a ontolex:Word ;
    frac:attestation kno:KN2022-0085-att-nn ;
    ontolex:canonicalForm kno:KN2022-0085-form ;
    ontolex:sense kno:KN2022-0085-sense .

kno:KN2022-0085-att-nn a frac:Attestation ;
    dcterms:date "2022-02-09"^^xsd:date ;
    frac:locus <https://m.entertain.naver.com/article/421/0005894633> .

kno:KN2022-0085-form a ontolex:Form ;
    frac:frequency kno:KN2022-0085-freq-nn,
        kno:KN2022-0085-freq-yt ;
    ontolex:writtenRep "나이토그래피"@ko .

kno:KN2022-0085-freq-nn a frac:CorpusFrequency ;
    rdf:value 1569 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0085-freq-yt a frac:CorpusFrequency ;
    rdf:value 43 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0085-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%82%98%EC%9D%B4%ED%86%A0%EA%B7%B8%EB%9E%98%ED%94%BC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

