# KN2022-0190 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0190 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "스프링깅"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%8A%A4%ED%94%84%EB%A7%81%EA%B9%85> ;
    skos:definition "봄에 산책 또는 조깅을 하면서 쓰레기 따위를 줍는 행위를 이르는 말. 봄을 뜻하는 ‘스프링(spring)’과 조깅을 하면서 쓰레기 따위를 줍는 행위를 뜻하는 ‘플로깅(plogging)’을 결합하여 만든 말이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2022-0190-c1 ;
    kno:component kno:KN2022-0190-c2 ;
    kno:componentString "스프링(spring), (플로)깅(plogging)"@ko ;
    kno:example "¶우리 집 봄 나들이는 개나리가 핀 강가를 걸으며 쓰레기를 줍는 ‘{스프링깅’으로} 시작된다."@ko ;
    kno:formation kno:W05 ;
    kno:frequency kno:KN2022-0190-freq-NN-2022 ;
