@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0254 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2020-0254-att-nn ;
    ontolex:canonicalForm kno:KN2020-0254-form ;
    ontolex:sense kno:KN2020-0254-sense .

kno:KN2020-0254-att-nn a frac:Attestation ;
    dcterms:date "2020-05-15"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/437/0000238173> .

kno:KN2020-0254-form a ontolex:Form ;
    frac:frequency kno:KN2020-0254-freq-nn,
        kno:KN2020-0254-freq-yt ;
    ontolex:writtenRep "위드 코로나"@ko .

kno:KN2020-0254-freq-nn a frac:CorpusFrequency ;
    rdf:value 101173 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0254-freq-yt a frac:CorpusFrequency ;
    rdf:value 9322 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0254-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%8B%A8%EA%B3%84%EC%A0%81%20%EC%9D%BC%EC%83%81%ED%9A%8C%EB%B3%B5> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

