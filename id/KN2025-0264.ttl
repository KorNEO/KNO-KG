    kno:activeYears "1"^^xsd:integer ;
    kno:registration "신어DB"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B0%98%EC%A4%91%20%EC%8B%9C%EC%9C%84%20%EA%B8%88%EC%A7%80%EB%B2%95> ;
    kno:component kno:KN2025-0264-c2 ;
    skos:definition "(LLM) 특정 집단(예: 중국인ㆍ중국)을 겨냥한 혐오ㆍ차별을 선동할 우려가 있는 반중 집회ㆍ시위를 제한하거나 금지하는 취지의 법안(또는 그에 대한 비판적 명칭)."@ko ;
    kno:unitType "구"@ko ;
    kno:origin "(反中示威禁止法)" ;
    kno:component kno:KN2025-0264-c1 ;
    kno:example "(LLM) 일각에서는 {반중시위금지법이} 혐오 표현을 막기 위한 장치라고 주장했지만, 다른 쪽에서는 집회ㆍ표현의 자유를 과도하게 제한할 수 있다며 반발했다."@ko ;
    kno:slotFiller "반중(反中)+시위(示威) (2성분)"@ko ;
