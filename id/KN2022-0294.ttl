@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0294 a ontolex:Word ;
    frac:attestation kno:KN2022-0294-att-nn ;
    ontolex:canonicalForm kno:KN2022-0294-form ;
    ontolex:sense kno:KN2022-0294-sense .

kno:KN2022-0294-att-nn a frac:Attestation ;
    dcterms:date "2021-05-17"^^xsd:date ;
    frac:locus <https://m.sports.naver.com/article/356/0000047007> .

kno:KN2022-0294-form a ontolex:Form ;
    frac:frequency kno:KN2022-0294-freq-nn,
        kno:KN2022-0294-freq-yt ;
    ontolex:writtenRep "퐁퐁-단"@ko .

kno:KN2022-0294-freq-nn a frac:CorpusFrequency ;
    rdf:value 42 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0294-freq-yt a frac:CorpusFrequency ;
    rdf:value 901 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0294-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%90%81%ED%90%81%EB%8B%A8> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

