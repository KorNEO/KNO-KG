# KN2020-0184 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0184 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "스테이 앳 홈 챌린지"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%8A%A4%ED%85%8C%EC%9D%B4%20%EC%95%B3%20%ED%99%88%20%EC%B1%8C%EB%A6%B0%EC%A7%80> ;
    skos:definition "코로나19 감염을 예방하기 위해 생활 예방 수칙을 잘 지키면서 집에 머무르자는 메시지를 전달하는 챌린지. 집에서 재미있게 노는 모습을 촬영해서 자신의 누리 소통망 서비스(SNS) 계정에 올리는 방식으로 진행된다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2020-0184-c1 ;
    kno:component kno:KN2020-0184-c2 ;
