# KN2021-0041 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0041 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "금융 치료02"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%88%EC%9C%B5%20%EC%B9%98%EB%A3%8C02> ;
    skos:definition "월급이나 상여금, 복지 포인트 등의 금전적인 보상을 통해 일하면서 겪는 정신적인 고통을 치유하고 행복감을 느끼게 하는 것을 비유적으로 이르는 말."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2021-0041-c1 ;
    kno:component kno:KN2021-0041-c2 ;
    kno:componentString "금융(金融), 치료02"@ko ;
    kno:example "¶지난달 초과 근무로 너무 힘들었지만, 월급 통장을 보니 {금융 치료가} 되는 느낌이다. 급식^개미(給食개미) 한^고 『경제』 〔경제생활〕 주식 시장에서 개인적으로 주식 투자를 하는 중ㆍ고등학생을 이르는 말. ¶최근 청소년들 사이 주식 열풍이 불면서 급 식 개미들의 투자 열기가 높아지고 있다."@ko ;
    kno:indexForm "금융치료"@ko ;
    kno:languageType "한_한" ;
    kno:origin "(金融治療)" ;
    kno:pos "「구」"@ko ;
    kno:registration "신어DB"@ko ;
    kno:unitType "구"@ko ;
    kno:year "2021"^^xsd:gYear .
