    kno:component kno:KN2015-0091-c2 ;
    skos:definition "1박 이상의 야영 생활에 필요한 장비를 넣은 배낭을 짊어지고 산과 들을 자유롭게 걸어 다니는 여행. =등짐 들살이."@ko ;
    a kno:Neologism ;
