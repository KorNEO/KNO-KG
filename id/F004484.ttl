kno:F004484 rdfs:label "수질(水質)"@ko ;
    kno:urimalDefinition "물의 성질. 물의 온도, 맑고 흐림, 빛깔, 비중, 방사능 및 유기질과 무기질, 혹은 세균의 함유량 따위에 따라 결정된다. 〔명사〕"@ko ;
    kno:fullForm "수질"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "수질"@ko ;
    kno:origin "水質" ;
    kno:registration "우리말샘"@ko ;
