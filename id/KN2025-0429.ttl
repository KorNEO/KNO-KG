    kno:frequency kno:KN2025-0429-freq-NN-2025 ;
    a ontolex:Word ;
    skos:definition "(LLM) 상품이나 서비스의 이용자이면서 동시에 해당 플랫폼ㆍ브랜드의 지분, 토큰, 멤버십 지분형 권리 등을 보유해 성장에 참여하고 그에 따른 이익을 함께 나누는 소비자."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%98%A4%EB%84%88%EC%8A%88%EB%A8%B8> ;
