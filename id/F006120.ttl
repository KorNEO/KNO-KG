kno:F006120 kno:caseCount "1"^^xsd:integer ;
    kno:origin "natural" ;
    kno:urimalDefinition "오선보에서, 임시표로 높이거나 낮춘 음을 본래의 음으로 돌아가게 하는 기호. ‘<span class=\"korean-webfont\">&#x266E;</span>’로 표시한다. 〔명사〕"@ko ;
    kno:surfaceForm "추럴"@ko ;
    kno:semanticTag kno:usas-A5.4p ;
    kno:fullFormLexeme kno:LEX-내추럴 ;
    kno:parallelFullForm kno:LEX-내추럴 ;
    a kno:Formative ;
    kno:truncated "true"^^xsd:boolean ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "내추럴"@ko ;
