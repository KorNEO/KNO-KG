# KN2021-0006 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0006 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "가상 출국 여행"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1523591> ;
    skos:definition "실제 해외여행처럼 비행기를 타고 출국하지만 목적지에 착륙하지 않고, 낮은 고도로 목적지 상공을 비행하며 돌아본 후 출발지로 돌아오는 여행. 코로나19의 확산으로 해외여행이 제한되며 생겨난 여행 상품이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2021-0006-c1 ;
    kno:component kno:KN2021-0006-c2 ;
    kno:component kno:KN2021-0006-c3 ;
    kno:componentString "가상(假想), 출국(出國), 여행(旅行)"@ko ;
    kno:example "¶감염병의 확산으로 국가 간의 이동이 어려운 상황에서 {가상 출국 여행을} 즐기려는 수요가 늘고 있다."@ko ;
