# KN2017-0096 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0096 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "만뚫남"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A7%8C%EB%9A%AB%EB%82%A8> ;
    skos:definition "‘만화를 뚫고 나온 듯한 남자’라는 뜻으로, 만화에 등장하는 인물 못지않게 외모가 뛰어난 남자를 이르는 말."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2017-0096-c1 ;
    kno:component kno:KN2017-0096-c2 ;
    kno:component kno:KN2017-0096-c3 ;
    kno:componentString "만(화)(漫), 뚫(다), 남(자)(男)"@ko ;
    kno:example "¶OOO는 3일 자신의 OO에 “…OOO와 함께 지난 화 진정한 {만뚫남이} 된 우리 OOO을 지켜봐 주세요. 오늘 밤 10시 ‘OO’ 5화 본방 사수!”라는 글과 함께 사진 한 장을 게재했다."@ko ;
    kno:formation kno:W06 ;
