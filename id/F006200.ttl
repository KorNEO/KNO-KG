# F006200 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006200 kno:caseCount "1"^^xsd:integer ;
    rdfs:label "카페인(←Kakao story Facebook Instagram)"@ko ;
    kno:urimalDefinition "알칼로이드의 하나. 쓴맛이 있는 무색의 고체로, 커피의 열매나 잎, 카카오와 차 따위의 잎에 들어 있다. 흥분제·이뇨제·강심제 따위에 쓰나 많이 사용하면 중독 증세를 일으킨다. 화학식은 C<sub>8</sub>H<sub>10</sub>N<sub>4</sub>O<sub>2</sub>. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-Y2 ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-Q1.3 ;
    kno:fullForm "카페인"@ko ;
    kno:surfaceForm "카페인"@ko ;
    kno:urimalTargetCode "584170" ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=584170> ;
    kno:origin "kakao" .
