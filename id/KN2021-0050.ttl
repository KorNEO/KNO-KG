# KN2021-0050 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0050 kno:instantiates kno:S001255 ;
    kno:componentString "기후(氣候), 테크(놀로지)(technology)"@ko ;
    kno:origin "(氣候<영>tech)" ;
    kno:slotFiller "테크(놀로지)(technology) (1성분)"@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:pos "「명」"@ko ;
    skos:definition "첨단 정보 기술을 기후 분야에 적용하여 온실가스의 배출량을 줄이거나 지구 온난화 등의 기후 문제를 해결하도록 돕는 기술."@ko ;
    kno:frequency kno:KN2021-0050-freq-NN-2022 ;
