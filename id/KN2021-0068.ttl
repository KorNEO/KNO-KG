# KN2021-0068 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0068 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "대네수엘라"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8C%80%EB%84%A4%EC%88%98%EC%97%98%EB%9D%BC> ;
    skos:definition "‘대한민국’과 ‘베네수엘라’를 결합하여 만든 말로, 우리나라 정부의 정책이 베네수엘라의 실패한 정책을 닮아 간다는 말."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2021-0068-c1 ;
    kno:component kno:KN2021-0068-c2 ;
    kno:componentString "대(한민국)(大韓民國), (베)네수엘라(Venezuela)"@ko ;
    kno:example "¶한 전문가는 최근 국민들이 우리나라를 {대네수엘라라고} 칭하는 것을 단순한 조롱이 아니라 정책에 대한 우려를 뜻하는 것으로 해석해야 한다고 말했다."@ko ;
