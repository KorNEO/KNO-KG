kno:KN2020-0250 kno:year "2020"^^xsd:gYear ;
    kno:componentString "원격(遠隔), 수업(授業), 시대(時代)"@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:example "¶{원격 수업 시대를} 맞아 학부모를 대상으로 한 연수가 개최돼 학부모들로부터 관심을 얻고 있다."@ko ;
