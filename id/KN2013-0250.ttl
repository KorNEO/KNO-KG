# KN2013-0250 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0250 a kno:Neologism ;
    kno:example "¶신조어는 직장인 사회와 관련한 것이 가장 많아 100여 개가 넘는다. 물에 술 탄 듯 술에 물 탄 듯한 처세를 하는 사람을 빗댄 ‘{소주타’를} 비롯해…직장에서 동료를 따돌리는 ‘직따’ 등 무수하다."@ko ;
    rdfs:label "소주-타"@ko ;
    kno:languageType "한+고" ;
    kno:origin "(燒酒타)" ;
    kno:componentString "소주(燒酒), 타"@ko ;
    kno:pos "「명」"@ko ;
    a ontolex:Word ;
    kno:activeYears "0"^^xsd:integer ;
    kno:indexForm "소주타"@ko ;
    kno:unitType "단어"@ko ;
    kno:registration "신어DB"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%86%8C%EC%A3%BC%ED%83%80> ;
    kno:formation kno:W01 ;
    skos:definition "우유부단하고 태도가 분명하지 않은 사람을 비유적으로 이르는 말."@ko ;
