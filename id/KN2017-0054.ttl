# KN2017-0054 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0054 skos:definition "북해 유전을 통해 얻은 석유와 가스를 수출하면서도 환경 오염을 막기 위해 석유와 가스 산업을 약화하려는 노르웨이 정부의 모순을 이르는 말."@ko ;
    a kno:Neologism ;
    kno:languageType "영^영" ;
    kno:origin "(Norway<영>paradox)" ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "1380364" ;
    kno:component kno:KN2017-0054-c2 ;
