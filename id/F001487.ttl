# F001487 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001487 kno:caseCount "2"^^xsd:integer ;
    kno:semanticTag kno:usas-G2.1 ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    kno:urimalDefinition "재판에 의하여 원고와 피고 사이의 권리나 의무 따위의 법률관계를 확정하여 줄 것을 법원에 요구함. 또는 그런 절차. 민사 소송, 형사 소송, 행정 소송, 선거 소송 따위가 있다. 〔명사〕"@ko ;
    kno:surfaceForm "소송"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "소송"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=500161> ;
    kno:origin "訴訟" ;
    kno:urimalTargetCode "500161" ;
    rdfs:label "소송(訴訟)"@ko .
