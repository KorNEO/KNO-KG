# KN2012-0020 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0020 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "공공^원룸텔"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1356946> ;
    skos:definition "국가나 민간 업체 등에서 1~2인 가구가 거주할 수 있도록 저렴한 임대료로 공급하는 호텔식 원룸."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2012-0020-c1 ;
    kno:component kno:KN2012-0020-c2 ;
    kno:component kno:KN2012-0020-c3 ;
    kno:componentString "공공(公共), 원룸(one-room), (호)텔(hotel)"@ko ;
    kno:example "¶아울러 대학 부지 내 기숙사 건립을 장려하고 매 년 5000호의 {공공 원룸텔을} 공급할 예정이다."@ko ;
