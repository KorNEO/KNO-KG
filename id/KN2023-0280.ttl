# KN2023-0280 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0280 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "최소^주거^보장법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B5%9C%EC%86%8C%EC%A3%BC%EA%B1%B0%EB%B3%B4%EC%9E%A5%EB%B2%95> ;
    skos:definition "열악한 주거 시설 거주자들의 최소 주거 환경을 보장하기 위한 법안. 야당이 주요 입법 과제로 발표한 법안 중 하나이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2023-0280-c1 ;
    kno:component kno:KN2023-0280-c2 ;
    kno:component kno:KN2023-0280-c3 ;
    kno:component kno:KN2023-0280-c4 ;
    kno:componentString "최소(最小), 주거(住居), 보장(保障), 법(法)"@ko ;
    kno:example "¶최근 수도권 집중 호우로 거주 환경이 좋지 않은 계층의 인명 및 재산 피해가 발생한 현실을 반영하여, 취약 계층을 국가가 지원하도록 하는 ‘{최소 주거 보장법’과} 장애인에 대한 국가의 책임을 강화하는 ‘장애인 국가 책임제법’ 등이 주요 안건으로 선정되었다."@ko ;
    kno:frequency kno:KN2023-0280-freq-NN-2022 ;
