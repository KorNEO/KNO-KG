# KN2019-0149 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0149 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "성장^우위국"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%84%B1%EC%9E%A5%EC%9A%B0%EC%9C%84%EA%B5%AD> ;
    skos:definition "신흥 경제국 중 지난 수십 년간 급속한 성장을 이룬 나라. 지난 50년간 연평균 1인 국내 총생산 성장률이 3.5% 이상이면 장기 성장 우위국, 최근 20년간 성장률이 5% 이상이면 신흥 성장 우위국으로 분류된다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2019-0149-c1 ;
    kno:component kno:KN2019-0149-c2 ;
    kno:component kno:KN2019-0149-c3 ;
    kno:componentString "성장(成長), 우위(優位), -국(國)"@ko ;
    kno:example "¶{성장 우위국은} 국내 총생산 1조 달러당 대기업 수가 선진국이나 다른 신흥국 대비 두 배 이상 많은 것으로 나타났다."@ko ;
    kno:frequency kno:KN2019-0149-freq-NN-2018 ;
    kno:frequency kno:KN2019-0149-freq-NN-2019 ;
    kno:frequency kno:KN2019-0149-freq-NN-2020 ;
    kno:frequency kno:KN2019-0149-freq-NN-total ;
    kno:indexForm "성장우위국"@ko ;
    kno:instantiates kno:S000423 ;
    kno:languageType "한^한" ;
    kno:lastAttestationYear "2020"^^xsd:gYear ;
    kno:origin "(成長優位國)" ;
    kno:pos "「구」"@ko ;
    kno:registration "신어DB"@ko ;
    kno:slotFiller "성장(成長)+우위(優位) (2성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:year "2019"^^xsd:gYear .
