# F005151 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005151 kno:semanticTag kno:usas-L2 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=18412> ;
    kno:surfaceForm "올빼미"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "올빼미"@ko ;
    rdfs:label "올빼미"@ko ;
    kno:urimalTargetCode "18412" ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    kno:urimalDefinition "올빼밋과의 새. 등과 배는 누런빛을 띤 갈색이고 세로무늬가 있다. 눈가의 털은 방사상으로 나고 얼굴은 둥근데 귀깃이 없다. 야행성으로 한국, 일본, 아시아 동북부, 유럽 등지에 분포한다. 우리나라 천연기념물이다. 〔명사〕"@ko .
kno:KN2014-0194-c1 kno:formative kno:F005151 .
