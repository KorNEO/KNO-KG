kno:KN2024-0065 rdfs:label "말따행따"@ko ;
    kno:example "¶정부는 지역시민과 한 약속을 어기고 {말따행따를 하며} 그들을 기만했다."@ko ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:component kno:KN2024-0065-c2 ;
    a kno:Neologism ;
