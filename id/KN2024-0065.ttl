    kno:component kno:KN2024-0065-c3 ;
    skos:definition "‘말 따로 행동 따로’를 줄여 이르는 말. 말과 행동이 서로 들어맞지 않는 태도를 비난할 때 쓰는 표현이다."@ko ;
