# F006459 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006459 kno:urimalTargetCode "302728" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:semanticTag kno:usas-Z3 ;
    rdfs:label "테슬라(Tesla)"@ko ;
    kno:fullForm "테슬라"@ko ;
    kno:urimalDefinition "자기력선속의 밀도를 나타내는 국제단위. 1테슬라는 1㎡당 1웨버(weber)의 자기력선속이 통과할 때의 밀도이다. 미국의 전기 공학자 테슬라의 이름에서 유래하였다. 기호는 T. 〔의존 명사〕"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:surfaceForm "테슬라"@ko ;
    kno:origin "tesla" ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-M3 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=302728> ;
    a kno:Formative .
