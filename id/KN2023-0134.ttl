# KN2023-0134 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0134 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "센타고"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%84%BC%ED%83%80%EA%B3%A0> ;
    skos:definition "본사의 할인 행사와는 별도로, 와인이나 위스키 등의 고급 주류를 자체적으로 할인하여 판매하는 편의점. 또는 이러한 할인 정보를 공유하는 온라인 커뮤니티. ⇒규범 표기는 ‘센터고’이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2023-0134-c1 ;
    kno:component kno:KN2023-0134-c2 ;
    kno:componentString "센타(center), 고(高)"@ko ;
    kno:example "¶일부 {센타고} 매장은 점포 간 재고 이동을 통해 인기 있는 와인이나 위스키를 확보한 후, 본사의 할인 행사와 더불어 추가적인 혜택을 제공한다."@ko ;
