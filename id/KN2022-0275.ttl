    a kno:Neologism ;
    rdfs:label "코내기"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1630534> ;
    skos:definition "코로나 팬데믹 시기에 입학한 새내기. ‘코로나’와 ‘새내기’를 결합한 말로, 코로나19 시기에 입학한 20~22학번 대학 새내기를 이르는 말이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
