kno:KN2022-0118 kno:indexForm "도그폰"@ko ;
    kno:languageType "영_영" ;
    kno:unitType "구"@ko ;
    kno:year "2022"^^xsd:gYear ;
    kno:origin "(<영>dog phone)" ;
    rdfs:label "도그 폰"@ko ;
