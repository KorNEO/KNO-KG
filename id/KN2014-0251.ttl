# KN2014-0251 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0251 kno:frequency kno:KN2014-0251-freq-NN-total ;
    kno:languageType "한+한" ;
    kno:origin "(廳舍病)" ;
    skos:definition "여름철 공공기관의 실내 온도 제한으로 인해 청사 안이 매우 더움을 비유적으로 이르는 말."@ko ;
    kno:pos "「명」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:instantiates kno:S000021 ;
    kno:indexForm "청사병"@ko ;
    kno:example "¶급기야 ‘{청사병’이란} 신조어까지 만들어졌다. OO청사에 근무하는 40대 공직자는 유달리 더위를 타는 탓에 지난해 여름을 떠올리면 울렁증이 와 닿는다고 했다."@ko ;
    a ontolex:Word ;
