# KN2013-0142 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0142 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "로린이"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A1%9C%EB%A6%B0%EC%9D%B4> ;
    skos:definition "어린 여자아이를 성적 대상으로 이르는 말. 어린 여자아이를 나보코프의 동명(同名) 소설에 등장하는 성적(性的)으로 조숙한 ‘롤리타’에 비유한 말이다."@ko ;
    kno:activeYears "14"^^xsd:integer ;
    kno:component kno:KN2013-0142-c1 ;
    kno:component kno:KN2013-0142-c2 ;
    kno:componentString "로(리타)(Lolita), (어)린이"@ko ;
    kno:example "¶임용 대기자 O 씨는 작년 10월 보수 성향 인터넷 사이트인 ‘OO’ 게시판에 ‘초등 교사’라는 닉네임으로 초등학생을 ‘{로린이’로} 지칭하는 글과 사진을 올려 물의를 빚었다."@ko ;
