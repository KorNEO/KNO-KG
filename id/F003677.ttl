# F003677 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003677 kno:surfaceForm "반"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=9436> ;
    kno:urimalDefinition "대화하는 사람의 관계가 분명치 아니하거나 매우 친밀할 때 쓰는, 높이지도 낮추지도 아니하는 말. ‘이 책 재미있어?’, ‘아주 재미있는걸’에서와 같이 종결 어미 ‘-아’, ‘-지’, ‘-군’, ‘-ㄴ걸’ 따위가 쓰인다. 〔명사〕"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B0%98> ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "9436" ;
    kno:fullFormLexeme kno:LEX-반말 ;
    kno:parallelFullForm kno:LEX-반말 ;
    kno:semanticTag kno:usas-Q3 ;
    kno:origin "半" ;
    a kno:Formative ;
    kno:truncated "true"^^xsd:boolean ;
    kno:fullForm "반말"@ko ;
    rdfs:label "반(말)(半)"@ko ;
    kno:caseCount "1"^^xsd:integer .
kno:KN2012-0141-c1 kno:formative kno:F003677 .
