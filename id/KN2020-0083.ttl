# KN2020-0083 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0083 kno:component kno:KN2020-0083-c1 ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:frequency kno:KN2020-0083-freq-NN-total ;
    skos:definition "인스턴트 커피 가루, 뜨거운 물, 설탕 등의 재료를 한데 넣어 크림처럼 될 때까지 휘저은 후, 이를 우유 위에 올려 만든 커피. 베이킹 소다와 설탕으로 만든 과자인 달고나와 그 맛이 비슷하여 붙여진 이름이다. 코로나19의 확산과 그에 따른 사회적 거리 두기의 시행으로 인해 집에 머무르는 시간이 늘면서, 그 시간을 보낼 소일거리를 찾는 이들로부터 시작되었다."@ko ;
    a ontolex:Word ;
    kno:year "2020"^^xsd:gYear ;
    kno:frequency kno:KN2020-0083-freq-NN-2021 ;
    kno:frequency kno:KN2020-0083-freq-NN-2020 ;
    kno:frequency kno:KN2020-0083-freq-NN-2022 ;
    kno:unitType "단어"@ko ;
    kno:languageType "고+영" ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8B%AC%EA%B3%A0%EB%82%98%EC%BB%A4%ED%94%BC> ;
    kno:indexForm "달고나커피"@ko ;
    kno:example "¶코로나19로 집에 있는 시간이 많아진 요즘, 400번 이상 저어야 만들 수 있다는 {달고나커피가} 유행처럼 번지고 있다."@ko ;
    kno:componentString "달고나, 커피(coffee)"@ko ;
