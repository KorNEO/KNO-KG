# F006400 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006400 kno:urimalDefinition "물체에 외부에서 힘을 가하면 부피와 모양이 바뀌었다가, 그 힘을 제거하면 본디의 모양으로 되돌아가려고 하는 성질. 변형의 종류에 따라 체적 탄성과 형상 탄성으로 나눈다. 〔명사〕"@ko ;
    rdfs:label "탄성(彈性)"@ko ;
    kno:origin "彈性" ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "301037" ;
    a kno:Formative ;
    kno:fullForm "탄성"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "탄성"@ko ;
    kno:semanticTag kno:usas-O4.5 ;
