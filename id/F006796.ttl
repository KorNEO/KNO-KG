    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "311300" ;
    kno:urimalDefinition "영국의 여성 작가 셸리가 지은 괴기(怪奇) 소설. 의학도인 프랑켄슈타인이 시체를 이용하여 만든 초인적 힘을 가진 괴물이 광폭하여 나쁜 짓을 자행하다가 프랑켄슈타인마저 살해하고는 북극해로 모습을 감춘다는 내용이다. 1818년에 발표하였다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:caseCount "1"^^xsd:integer ;
