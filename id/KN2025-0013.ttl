    kno:component kno:KN2025-0013-c2 ;
    a kno:Neologism ;
    kno:example "(LLM) 기념일인데도 선물은커녕 영화표도 할인되는 시간만 고집해서 {가성비남친이} 아니냐는 말이 나왔다."@ko ;
    kno:instantiates kno:S000812 ;
    skos:definition "(LLM) 연애 관계에서 데이트 비용이나 선물 등 상대를 위해 쓰는 지출을 지나치게 아끼며 최소화하려는 태도를 보이는 남자친구."@ko ;
