# KN2020-0092 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0092 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "뒷-계정"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%92%B7%EA%B3%84%EC%A0%95> ;
    skos:definition "자신의 신원을 직접적으로 드러내지 않은 채로 별도의 목적을 위해 만들어진 비공개 계정을 이르는 말."@ko ;
