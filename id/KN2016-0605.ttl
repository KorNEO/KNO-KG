# KN2016-0605 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0605 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "홀로그램 집회"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1373040> ;
    skos:definition "홀로그램을 사용하여 진행하는 집회. 집회 참가자가 집회 장소에 직접 가지 않고 집회 장소에 설치된 홀로그램 장치를 이용해 진행한다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2016-0605-c1 ;
    kno:component kno:KN2016-0605-c2 ;
    kno:componentString "홀로그램(hologram), 집회(集會)"@ko ;
    kno:example "¶경찰은 이번 {홀로그램 집회에} 대해 스크린 속 참가자가 구호를 제창하고 집단 의사를 표시하는 등 집회ㆍ시위 형식을 보이면 이를 규제하겠다는 입장을 밝혔다."@ko ;
    kno:frequency kno:KN2016-0605-freq-NN-2016 ;
    kno:frequency kno:KN2016-0605-freq-NN-2017 ;
    kno:frequency kno:KN2016-0605-freq-NN-total ;
    kno:indexForm "홀로그램집회"@ko ;
    kno:instantiates kno:S000397 ;
