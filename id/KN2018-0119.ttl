# KN2018-0119 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0119 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "메기^기업"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416185> ;
    skos:definition "기존 동종 기업의 경영을 활발하게 하는 신생 기업을 이르는 말. 미꾸라지가 메기를 피하려고 빨리 움직이는 것을 기업 경영에 비유한 ‘메기 효과’에서 파생되었다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2018-0119-c1 ;
    kno:component kno:KN2018-0119-c2 ;
    kno:componentString "메기, 기업(企業)"@ko ;
    kno:example "¶그는 과감한 혁신을 가속화하기 위해 ‘{메기 기업’이} 필요하다고 제안했다."@ko ;
