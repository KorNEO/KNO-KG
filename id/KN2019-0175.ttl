kno:KN2019-0175 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "스텔스 차선"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%8A%A4%ED%85%94%EC%8A%A4%20%EC%B0%A8%EC%84%A0> ;
    skos:definition "야간이나 날이 어두울 때 잘 보이지 않는 도로 위 차선. 특히 비 오는 날 선명하게 보이지 않아 운전하기 어렵다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
