# KN2017-0100 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0100 kno:origin "(<영>magic toolbar)" ;
    kno:indexForm "매직툴바"@ko ;
    skos:definition "키보드의 펑션 키를 대신해 컴퓨터 운영 체제나 웹 브라우저 따위의 응용 프로그램 가운데 사용자가 자주 사용하는 명령어들을 따로 모아 아이콘 모양으로 만들어 놓은 것."@ko ;
    kno:predicate "놓은"@ko ;
    rdfs:label "매직 툴바"@ko ;
    kno:component kno:KN2017-0100-c1 ;
    kno:component kno:KN2017-0100-c2 ;
