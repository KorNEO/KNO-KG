    kno:lastAttestationYear "2016"^^xsd:gYear ;
    kno:year "2017"^^xsd:gYear ;
    kno:frequency kno:KN2017-0100-freq-NN-2016 ;
    kno:activeYears "1"^^xsd:integer ;
    kno:example "¶신형 OO는 디스플레이 자동 변환 기술인 {매직 툴바를} 탑재하고 있어 키보드 윗줄의 펑션 키는 사라지게 됐다."@ko ;
    kno:frequency kno:KN2017-0100-freq-NN-total ;
    a ontolex:MultiwordExpression .
