# KN2018-0058 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0058 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "나심비"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1382414> ;
    skos:definition "‘내가 심리적으로 만족하는 비율’을 줄여 이르는 말. 어떤 품목이나 상품에 대하여 가격과 상관없이 본인 스스로가 만족하는 정도를 말한다."@ko ;
    kno:activeYears "8"^^xsd:integer ;
    kno:component kno:KN2018-0058-c1 ;
    kno:component kno:KN2018-0058-c2 ;
    kno:component kno:KN2018-0058-c3 ;
    kno:componentString "나, 심(리)(心), 비(율)(比)"@ko ;
    kno:example "¶가성비, 가심비에 이어 ‘{나심비’가} 새로운 쇼핑 트렌드로 떠오르고 있다. ‘나’의 심적 만족을 위해 가격에 상관없이 과감히 지갑을 열겠다는 소비 심리다."@ko ;
    kno:formation kno:W06 ;
