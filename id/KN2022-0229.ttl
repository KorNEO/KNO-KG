    dcterms:isReferencedBy <https://namu.wiki/w/%EC%9C%A4%EC%84%9D%EC%97%B4%20%EC%A0%95%EB%B6%80%20%EB%8C%80%ED%86%B5%EB%A0%B9%20%EC%A7%91%EB%AC%B4%EC%8B%A4%20%EC%9A%A9%EC%82%B0%20%EC%9D%B4%EC%A0%84> .

