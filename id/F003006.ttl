kno:F003006 kno:registration "우리말샘"@ko ;
    kno:surfaceForm "돈세탁"@ko ;
    a kno:Formative ;
    kno:urimalDefinition "기업의 비자금이나 범죄, 탈세, 뇌물 따위와 관련된 정당하지 못한 돈을 여러 가지 방법으로 정당한 돈처럼 탈바꿈하여 자금 출처의 추적을 어렵게 하는 일. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-G2.1m ;
    kno:urimalTargetCode "345608" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=345608> ;
