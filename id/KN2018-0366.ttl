# KN2018-0366 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0366 kno:frequency kno:KN2018-0366-freq-NN-2017 ;
    kno:componentString "틸러슨(Tillerson), 플랜(plan)"@ko ;
    kno:example "¶한편 OOO 장관은 이날 북한이 일정 기간 도발을 중단하고, 대화 의지를 밝히면 대화의 문은 열려 있을 것이라며 이른바 ‘{틸러슨 플랜’을} 재확인했다."@ko ;
    a ontolex:MultiwordExpression ;
    kno:registration "신어DB"@ko ;
    kno:frequency kno:KN2018-0366-freq-NN-total ;
    kno:activeYears "2"^^xsd:integer ;
    rdfs:label "틸러슨 플랜"@ko ;
    kno:lastAttestationYear "2018"^^xsd:gYear ;
    kno:languageType "영_영" ;
    skos:definition "북한이 일정 기간 이상 도발하지 않고 대화할 의지를 보이면 대화를 통해 평화적으로 협상을 진행한다는 계획. 2017년 9월 미국의 국무 장관인 틸러슨이 북한에 제안한 것으로, 북한이 60일 이상 군사적 도발을 하지 않을 경우 아무런 전제 조건 없이 대화를 통해 핵무기와 관련된 협상을 진행할 수 있다고 한 것에 이름 붙여진 것이다."@ko ;
