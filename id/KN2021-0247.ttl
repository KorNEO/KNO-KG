@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0247 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2021-0247-att-nn ;
    ontolex:canonicalForm kno:KN2021-0247-form ;
    ontolex:sense kno:KN2021-0247-sense .

kno:KN2021-0247-att-nn a frac:Attestation ;
    dcterms:date "2020-12-24"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/020/0003328211> .

kno:KN2021-0247-form a ontolex:Form ;
    frac:frequency kno:KN2021-0247-freq-nn,
        kno:KN2021-0247-freq-yt ;
    ontolex:writtenRep "지역^재생^잠재력^지수"@ko .

kno:KN2021-0247-freq-nn a frac:CorpusFrequency ;
    rdf:value 101 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0247-freq-yt a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0247-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

