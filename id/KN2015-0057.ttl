# KN2015-0057 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0057 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "래시^팬츠"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1359961> ;
    skos:definition "래시 가드로 만든 바지. 주로 서핑이나 수영 따위와 같은 물놀이를 할 때 입는 바지로 자외선 차단율이 높고 탄성이 뛰어난 소재를 사용해 활동하기 편하면서 다리 전체를 가리는 용도로 사용한다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2015-0057-c1 ;
    kno:component kno:KN2015-0057-c2 ;
    kno:componentString "래시(←rash guard), 팬츠(pants)"@ko ;
    kno:example "¶레깅스처럼 발목까지 딱 붙는 바지는 {래시 팬츠라고} 부른다."@ko ;
