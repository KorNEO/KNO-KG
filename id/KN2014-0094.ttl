# KN2014-0094 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0094 rdfs:label "맥덕"@ko ;
    kno:component kno:KN2014-0094-c2 ;
    kno:year "2014"^^xsd:gYear ;
    kno:component kno:KN2014-0094-c1 ;
    kno:urimalTargetCode "1374923" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1374923> ;
    kno:origin "(麥<일>←otaku[御宅])" ;
    kno:componentString "맥(주)(麥), 덕(후)(otaku)"@ko ;
    skos:definition "맥주를 지나치게 좋아하거나 집착하는 사람. 또는 맥주에 전문적인 지식을 지닌 사람."@ko ;
    kno:example "¶하지만 지난해부터 20~30대 ‘{맥덕’만} 알고 있던 수제 맥주가 요즘에는 세대의 벽을 허물고 한국의 새로운 술 문화 트렌드로 자리 잡아 가고 있다."@ko ;
    kno:formation kno:W05 ;
    kno:predicate "집착하다"@ko ;
    kno:languageType "한+일" ;
