# KN2018-0110 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0110 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "리플레이^어택"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416177> ;
    skos:definition "이용자의 전자 지갑에 저장된 가상 화폐가 해킹으로 인해 기존의 전자 지갑과 유사한 다른 전자 지갑으로 중복되어 출금되는 현상."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2018-0110-c1 ;
    kno:component kno:KN2018-0110-c2 ;
    kno:componentString "리플레이(replay), 어택(attack)"@ko ;
    kno:example "¶에스디케이(SDK) 스푸핑 또는 {리플레이 어택으로} 불리는 이 광고 사기는 사용자 정보 없이도 개인 디바이스를 해킹하고, 이 과정에서 얻은 정보를 가짜 앱 설치에 활용한다."@ko ;
    kno:frequency kno:KN2018-0110-freq-NN-2017 ;
    kno:frequency kno:KN2018-0110-freq-NN-2018 ;
    kno:frequency kno:KN2018-0110-freq-NN-total ;
    kno:indexForm "리플레이어택"@ko ;
    kno:languageType "영^영" ;
