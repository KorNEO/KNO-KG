# F006195 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006195 a kno:Formative ;
    rdfs:label "카스트(caste)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=547489> ;
    kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "카스트"@ko ;
    kno:origin "caste" ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-S5 ;
    kno:surfaceForm "카스트"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "인도의 세습적 계급 제도. 승려 계급인 브라만, 귀족과 무사 계급인 크샤트리아, 평민인 바이샤, 노예인 수드라의 네 계급을 기원으로 현재는 2,500종 이상의 카스트와 부카스트로 나뉜다. 계급에 따라 결혼, 직업, 식사 따위의 일상생활에 엄중한 규제가 있다. 〔명사〕"@ko ;
    kno:urimalTargetCode "547489" .
