# KN2020-0061 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0061 rdfs:label "긴급^재난^기부금"@ko ;
    kno:pos "「구」"@ko ;
    kno:languageType "한^한^한" ;
    kno:unitType "구"@ko ;
    kno:year "2020"^^xsd:gYear ;
    kno:component kno:KN2020-0061-c1 ;
