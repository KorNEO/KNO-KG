# F006771 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006771 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=315059> ;
    kno:fullForm "핑퐁"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalDefinition "나무로 만든 대(臺)의 가운데에 네트를 치고 라켓으로 공을 쳐 넘겨 승부를 겨루는 구기 경기. 한 경기는 5게임 또는 7게임으로 이루어지며 매 게임에서 11점을 먼저 득점하면 이긴다. 남녀 단식과 복식, 혼합 복식, 단체전이 있다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-K5.1 ;
    kno:fullFormLexeme kno:LEX-핑퐁 ;
    kno:origin "ping-pong" ;
    rdfs:label "(핑)퐁(ping-pong)"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%90%81> ;
    kno:surfaceForm "퐁"@ko ;
    kno:urimalTargetCode "315059" ;
    kno:registration "우리말샘"@ko ;
    kno:parallelFullForm kno:LEX-핑퐁 ;
    a kno:Formative .
