# KN2021-0137 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0137 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "백신^휴가^제도"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B0%B1%EC%8B%A0%ED%9C%B4%EA%B0%80%EC%A0%9C%EB%8F%84> ;
    skos:definition "백신 접종을 위해 휴가를 주는 제도. 코로나19 백신이 보급됨에 따라 백신 접종률을 높이기 위해 시행되었다. 백신을 접종한 다음 날 하루를 부여하고, 이상 반응이 있는 경우 추가로 하루를 더 사용할 수 있다. 코로나19가 전 세계적으로 유행한 상황에서 나온 말이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2021-0137-c1 ;
    kno:component kno:KN2021-0137-c2 ;
    kno:component kno:KN2021-0137-c3 ;
    kno:componentString "백신(vaccine), 휴가(休暇), 제도(制度)"@ko ;
    kno:example "¶이달부터는 {백신 휴가 제도가} 시행되어 백신 접종 후 이상 징후가 있다면 의사의 소견서 없이도 최대 이틀 동안은 휴가를 쓸 수 있다."@ko ;
    kno:frequency kno:KN2021-0137-freq-NN-2021 ;
    kno:frequency kno:KN2021-0137-freq-NN-2022 ;
    kno:frequency kno:KN2021-0137-freq-NN-total ;
    kno:indexForm "백신휴가제도"@ko ;
