# KN2017-0217 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0217 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "욜로-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1374702> ;
    skos:definition "지금 살아 있는 이 시점의 삶에 충실하며 자신의 즐거움과 행복을 추구하는 사람. 또는 그런 무리."@ko ;
