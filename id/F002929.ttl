    kno:caseCount "1"^^xsd:integer ;
    a kno:Formative ;
    kno:urimalDefinition "서울특별시 강남구에 있는 동. 동쪽으로 탄천과 양재천이 흐르며 송파구와 인접해 있다. 인근에 명문 고등학교들이 있어 학원가가 발달하였다. 〔명사〕"@ko ;
    rdfs:label "대치(大峙)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1430608> ;
    kno:urimalTargetCode "1430608" ;
    kno:truncated "false"^^xsd:boolean ;
