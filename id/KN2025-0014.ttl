@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0014 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2025-0014-att-nn ;
    ontolex:canonicalForm kno:KN2025-0014-form ;
    ontolex:sense kno:KN2025-0014-sense .

kno:KN2025-0014-att-nn a frac:Attestation ;
    dcterms:date "2025-05-27"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/008/0005199522> .

kno:KN2025-0014-form a ontolex:Form ;
    frac:frequency kno:KN2025-0014-freq-nn,
        kno:KN2025-0014-freq-yt ;
    ontolex:writtenRep "가세연 방지법"@ko .

kno:KN2025-0014-freq-nn a frac:CorpusFrequency ;
    rdf:value 20 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0014-freq-yt a frac:CorpusFrequency ;
    rdf:value 57 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0014-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

