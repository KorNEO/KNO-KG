# KN2013-0146 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0146 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "롬부즈만"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A1%AC%EB%B6%80%EC%A6%88%EB%A7%8C> ;
    skos:definition "일선 경찰서에 변호사를 계약직 등으로 채용해 수사 과정에서 피의자 인권 보호 활동을 담당하게 하는 제도."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2013-0146-c1 ;
    kno:component kno:KN2013-0146-c2 ;
    kno:componentString "로(law), (옴)부즈만(ombudsman)"@ko ;
    kno:example "¶OOO 경찰청장은 21일 기자 간담회에서 “법적인 지식을 갖춘 변호사들이 경찰 수사 과정에서 인권이 제대로 존중되고 있는지 감시할 수 있도록 이르면 올해 안에 일명 ‘{롬부즈만’} 제도를 운영하는 방안을 검토 중.”이라고 밝혔다."@ko ;
    kno:formation kno:W05 ;
