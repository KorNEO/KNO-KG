# KN2016-0487 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0487 kno:languageType "한+한" ;
    kno:component kno:KN2016-0487-c1 ;
    kno:formation kno:W01 ;
    rdfs:label "촉감-시계"@ko ;
    kno:year "2016"^^xsd:gYear ;
    skos:definition "시각 장애인을 위해 손끝으로 시간을 읽을 수 있게 만든 점자 손목시계. 분침과 시침을 대신해 시계 안에서 움직이는 쇠구슬을 통해 시간과 분을 읽을 수 있다."@ko ;
    a ontolex:Word ;
    kno:urimalTargetCode "1372922" ;
    kno:origin "(觸感時計)" ;
    kno:indexForm "촉감시계"@ko ;
    kno:componentString "촉감(觸感), 시계(時計)"@ko ;
    kno:lastAttestationYear "2015"^^xsd:gYear ;
    a kno:Neologism ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2016-0487-c2 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372922> ;
    kno:unitType "단어"@ko ;
    kno:frequency kno:KN2016-0487-freq-NN-2015 ;
    kno:frequency kno:KN2016-0487-freq-NN-total ;
    kno:example "¶하지만 학원 뺑뺑이와 과외, 무한 경쟁의 쳇바퀴에 찌들지 않은 덕분에 청년 OOO는…대학원 시절 옆자리에 앉아 자꾸만 시간을 물어보던 시각 장애인 친구를 보며 {촉감시계를} 구상했고 이후 점자 시계, 말하는 시계 등 수많은 시행착오를 거쳐 일반인들도 동경하는 명품을 만들어 냈다."@ko ;
    kno:pos "「명」"@ko ;
    kno:registration "우리말샘"@ko .
