# KN2015-0055 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0055 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "떳-덕후"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%96%B3%EB%8D%95%ED%9B%84> ;
    skos:definition "자신이 한 분야에 지나치게 집중하거나 집착하는 사람임을 숨기지 않고 떳떳하게 밝히는 사람. ‘떳떳하다’의 ‘떳’과 ‘오덕후’의 ‘덕후’를 결합하여 만든 말이다."@ko ;
