    kno:lastAttestationYear "2025"^^xsd:gYear ;
    kno:frequency kno:KN2025-0274-freq-NN-total ;
    kno:component kno:KN2025-0274-c2 ;
    kno:example "(LLM) 야당은 청문회 내내 해명이 석연치 않다며 김 후보자를 {배추총리}라고 부르며 지명 철회를 요구했다."@ko ;
