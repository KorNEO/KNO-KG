# KN2023-0032 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0032 kno:instantiates kno:S001226 ;
    kno:component kno:KN2023-0032-c2 ;
    kno:component kno:KN2023-0032-c4 ;
    a kno:Neologism ;
    kno:pos "「구」"@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:languageType "한^한^한^한" ;
    kno:frequency kno:KN2023-0032-freq-NN-2023 ;
    rdfs:label "국가^인재^양성^기본법"@ko ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:registration "신어DB"@ko ;
    kno:example "¶첨단 핵심 분야의 인재를 양성하기 위한 법적 근거를 마련하기 위하여 {국가 인재 양성 기본법을} 마련하여, 정부 및 지자체가 인재 양성 정책을 수립하거나 성과 점검의 책임을 지게 할 것이다."@ko ;
    kno:frequency kno:KN2023-0032-freq-NN-total ;
    kno:slotFiller "인재(人材)+양성(養成) (2성분)"@ko ;
    kno:componentString "국가(國家), 인재(人材), 양성(養成), 기본법(基本法)"@ko ;
    kno:origin "(國家人材養成基本法)" ;
    kno:year "2023"^^xsd:gYear ;
    kno:unitType "구"@ko ;
    a ontolex:MultiwordExpression ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B5%AD%EA%B0%80%EC%9D%B8%EC%9E%AC%EC%96%91%EC%84%B1%EA%B8%B0%EB%B3%B8%EB%B2%95> ;
    kno:component kno:KN2023-0032-c3 ;
    skos:definition "항공ㆍ우주 미래 모빌리티와 바이오헬스, 첨단 부품ㆍ소재, 디지털 그리고 환경 및 에너지 분야를 포함하는 5대 핵심 첨단 분야의 인재 육성을 목적으로 제정한 법률. 국가의 체계적인 인재 양성을 위하여 직업 교육법, 인재 데이터 관리법과 함께 인재 양성 3법에 포함된다."@ko ;
    kno:frequency kno:KN2023-0032-freq-NN-2024 ;
