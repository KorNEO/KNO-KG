kno:KN2013-0286 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "아나리오"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%95%84%EB%82%98%EB%A6%AC%EC%98%A4> ;
    skos:definition "방송에서, 혼자서 아나운서와 리포터 그리고 오디오 관리자 등의 여러 가지 역할을 동시에 하는 사람."@ko ;
