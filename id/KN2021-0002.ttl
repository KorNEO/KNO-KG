@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0002 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2021-0002-att-nn ;
    ontolex:canonicalForm kno:KN2021-0002-form ;
    ontolex:sense kno:KN2021-0002-sense .

kno:KN2021-0002-att-nn a frac:Attestation ;
    dcterms:date "2020-11-17"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/081/0003140531> .

kno:KN2021-0002-form a ontolex:Form ;
    frac:frequency kno:KN2021-0002-freq-nn,
        kno:KN2021-0002-freq-yt ;
    ontolex:writtenRep "가덕도^특별법"@ko .

kno:KN2021-0002-freq-nn a frac:CorpusFrequency ;
    rdf:value 1756 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0002-freq-yt a frac:CorpusFrequency ;
    rdf:value 83 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0002-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EA%B0%80%EB%8D%95%EB%8F%84%EC%8B%A0%EA%B3%B5%ED%95%AD%20%EA%B1%B4%EC%84%A4%EC%9D%84%20%EC%9C%84%ED%95%9C%20%ED%8A%B9%EB%B3%84%EB%B2%95> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

