# F001999 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001999 a kno:Formative ;
    kno:urimalTargetCode "313448" ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:origin "韓牛" ;
