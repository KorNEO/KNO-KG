# F004749 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004749 kno:urimalTargetCode "215736" ;
    kno:semanticTag kno:usas-O2 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=215736> ;
    kno:urimalDefinition "존 밀링턴 싱, 아일랜드의 극작가(1871~1909). 아일랜드 토착민의 일상어와 생활을 사실적 수법으로 그렸다. 작품에 &lt;골짜기의 그늘&gt;, &lt;서방의 플레이보이&gt; 따위가 있다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    kno:surfaceForm "싱"@ko ;
    kno:fullForm "싱"@ko ;
    kno:origin "thing" ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:label "싱(thing)"@ko .
