# KN2025-0644 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0644 kno:frequency kno:KN2025-0644-freq-NN-total ;
    skos:definition "(LLM) 나중에 살 가능성에 대비해 상품ㆍ서비스의 링크나 정보를 폴더 등에 먼저 저장ㆍ분류해 두었다가, 필요할 때 비교ㆍ구매에 활용하는 소비 행태."@ko ;
    kno:componentString "폴더(folder), 소비(消費)"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8F%B4%EB%8D%94%20%EC%86%8C%EB%B9%84> ;
