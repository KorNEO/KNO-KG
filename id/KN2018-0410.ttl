kno:KN2018-0410 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "한반도^운전석론"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416014> ;
    skos:definition "우리나라가 한반도의 문제를 주체적으로 해결할 수 있는 위치에 있다는 이론."@ko ;
