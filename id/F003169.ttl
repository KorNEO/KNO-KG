# F003169 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003169 kno:origin "backlash" ;
    kno:urimalDefinition "서로 물리는 기계 부분 사이의 상대적인 움직임으로 양자 사이의 결합이 단단하지 않을 때 생기는 현상. 백래시가 있는 동력 전달 장치의 응답에서는 히스테리시스 현상이 나타난다. 〔명사〕"@ko ;
    kno:surfaceForm "래시"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    a kno:Formative ;
    kno:parallelFullForm kno:LEX-백래시 ;
    kno:fullFormLexeme kno:LEX-백래시 ;
    kno:truncated "true"^^xsd:boolean ;
    kno:urimalTargetCode "695303" ;
    kno:semanticTag kno:usas-S8m ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=695303> ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%9E%98%EC%8B%9C> ;
    rdfs:label "(백)래시(backlash)"@ko ;
    kno:fullForm "백래시"@ko .
kno:KN2024-0027-c2 kno:formative kno:F003169 .
