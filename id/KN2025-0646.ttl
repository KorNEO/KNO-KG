    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2025-0646-c3 ;
    kno:example "(LLM) 상대 후보는 ‘세금 안 내도 된다’는 구호를 앞세운 {표팔이마케팅이} 정책 토론을 흐린다고 비판했다."@ko ;
