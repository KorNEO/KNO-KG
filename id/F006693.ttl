    kno:semanticTag kno:usas-S4 ;
    kno:urimalDefinition "레즈비언 커플 가운데 전통적 이성애 관계에서 여성적 행동을 취하는 대상을 이르는 말. 여성적 복장을 하거나 대상과의 관계에서 열등한 위치를 점하는 특징을 보인다. 〔명사〕"@ko ;
    kno:fullForm "펨"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "펨"@ko ;
    kno:origin "feminine" ;
    rdfs:label "펨(←feminine)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
