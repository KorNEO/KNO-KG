kno:KN2014-0103 kno:componentString "문(門), 막(다), 튀(다)"@ko ;
    a kno:Neologism ;
    kno:example "¶욕하고 도망치는 ‘욕튀’, 남의 집 문 열지 못하게 하고 도망가는 ‘{문막튀}’ 등 각종 ‘튀’ 카페가 기승입니다."@ko ;
    kno:predicate "도망치다"@ko ;
