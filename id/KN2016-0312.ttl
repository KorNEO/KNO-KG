# KN2016-0312 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0312 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "슬랩^소송"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372747> ;
    skos:definition "주로 정부나 기업 등 우월한 지위를 가진 쪽이 약자를 상대로 제기하는 전략적 소송. 주로 승소할 가능성이 매우 낮더라도 대중의 공공 영역에 대한 비판적 참여를 봉쇄하려는 의도로 제기된다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2016-0312-c1 ;
    kno:component kno:KN2016-0312-c2 ;
    kno:componentString "슬랩(SLAPP), 소송(訴訟)"@ko ;
    kno:example "¶OOO 씨는 “그동안 겪은 정신적, 육체적 부담은 말로 표현할 수 없다.”라면서 “이런 {슬랩 소송을} 제기하지 못하도록 해야 한다.”라고 강조했습니다."@ko ;
    kno:frequency kno:KN2016-0312-freq-NN-2016 ;
    kno:frequency kno:KN2016-0312-freq-NN-2024 ;
    kno:frequency kno:KN2016-0312-freq-NN-2025 ;
    kno:frequency kno:KN2016-0312-freq-NN-total ;
    kno:indexForm "슬랩소송"@ko ;
    kno:instantiates kno:S000879 ;
