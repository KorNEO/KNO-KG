kno:KN2022-0003 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "가스플레이션"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1670808> ;
    skos:definition "가스 가격의 상승으로 인해 발생하는 인플레이션. 에너지 공급의 부족과 친환경 정책 등 복합적인 원인으로 인해 발생한 물가 상승 현상이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
