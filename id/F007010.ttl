# F007010 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F007010 kno:fullForm "해커"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalTargetCode "28860" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=28860> ;
    kno:urimalDefinition "컴퓨터 시스템의 내부 구조와 동작 따위에 심취하여 이를 알고자 노력하는 사람. 다른 사람의 컴퓨터 시스템에 침입하여 사용자 행위 및 데이터를 불법으로 열람·변조·파괴하는 ‘블랙 해커’와, 이러한 블랙 해커의 공격에 대응하는 ‘화이트 해커’ 따위가 있다. 〔명사〕"@ko ;
    kno:origin "hacker" ;
    kno:registration "우리말샘"@ko ;
    a kno:Formative ;
    rdfs:label "해커(hacker)"@ko ;
    kno:semanticTag kno:usas-Y2 ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "해커"@ko .
