# KN2018-0090 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0090 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "뒷모습 증후군"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416128> ;
    skos:definition "과도한 교육열로 인해 아이들이 집 밖에서 보내는 시간이 많아져 얼굴보다 뒷모습을 보는 것이 더 익숙해진 사회 현상을 이르는 말."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2018-0090-c1 ;
    kno:component kno:KN2018-0090-c2 ;
    kno:componentString "뒷모습, 증후군(症候群)"@ko ;
    kno:example "¶아이의 얼굴보다 뒷모습이 더 익숙해져 이름 붙여진 ‘{뒷모습 증후군’으로} 마음 고생하는 학부모들이 늘고 있다."@ko ;
