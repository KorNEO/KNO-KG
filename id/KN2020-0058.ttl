# KN2020-0058 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0058 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "긴급^생계^수당"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%B4%EA%B8%89%EC%83%9D%EA%B3%84%EC%88%98%EB%8B%B9> ;
    skos:definition "전국적인 재난 사태로 인해 경제적으로 어려운 상황에 처한 사람을 돕기 위해 정부에서 긴급하게 지급하는 수당. 코로나19의 대유행으로 인한 경제적 위기 상황을 극복하기 위해 정부에서 국민들에게 지원금을 지급하는 방안을 논의하는 과정에서 나온 말이다. =긴급 재난 수당."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2020-0058-c1 ;
    kno:component kno:KN2020-0058-c2 ;
    kno:component kno:KN2020-0058-c3 ;
    kno:componentString "긴급(緊急), 생계(生計), 수당(手當)"@ko ;
    kno:example "¶O 지사는 “코로나19로 고통 받고 있는 국민들에게 {긴급 생계 수당을} 신속하게 지급하여 지역 경제를 활성화하는 것이 급선무이다.”라며 정부의 지급 결정을 촉구했다."@ko ;
    kno:frequency kno:KN2020-0058-freq-NN-2020 ;
    kno:frequency kno:KN2020-0058-freq-NN-2021 ;
    kno:frequency kno:KN2020-0058-freq-NN-total ;
    kno:indexForm "긴급생계수당"@ko ;
