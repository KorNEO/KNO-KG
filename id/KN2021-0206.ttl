# KN2021-0206 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0206 kno:unitType "구"@ko ;
    kno:componentString "우먼(woman), 버핏(Buffett)"@ko ;
    skos:definition "주식 투자 수익률이 높은 여성을 미국의 유명한 투자가이자 자산가인 워런 버핏(Warren Buffett)에 빗대어 이르는 말. 주식 시장의 단기적인 주가 등락에 반응하기보다는 워런 버핏처럼 우량주에 주목하여 장기적으로 투자하는 경향이 있다."@ko ;
    kno:frequency kno:KN2021-0206-freq-NN-2020 ;
    kno:component kno:KN2021-0206-c2 ;
    kno:indexForm "우먼버핏"@ko ;
    kno:frequency kno:KN2021-0206-freq-NN-total ;
    a kno:Neologism ;
    kno:origin "(<영>woman Buffett)" ;
    kno:registration "신어DB"@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:frequency kno:KN2021-0206-freq-NN-2021 ;
    a ontolex:MultiwordExpression ;
    kno:example "¶최근 주식 투자를 하는 여성들이 장기 투자를 선호하고, 수익률도 양호한 것으로 나타나 증권가에서 {우먼 버핏으로} 불리고 있다."@ko ;
    kno:lastAttestationYear "2021"^^xsd:gYear ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9A%B0%EB%A8%BC%EB%B2%84%ED%95%8F> ;
