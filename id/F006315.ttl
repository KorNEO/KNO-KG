# F006315 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006315 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=300140> ;
    a kno:Formative ;
    kno:caseCount "1"^^xsd:integer ;
    kno:origin "cougar" ;
    rdfs:label "쿠거(cougar)"@ko ;
    kno:fullForm "쿠거"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:surfaceForm "쿠거"@ko ;
    kno:semanticTag kno:usas-T3p ;
    kno:semanticTag kno:usas-S2.1 ;
    kno:urimalTargetCode "300140" ;
    kno:urimalDefinition "고양잇과의 하나. 몸의 길이는 1.2~1.8미터이며, 등은 붉은 갈색 또는 잿빛을 띤 갈색이고 배는 누런색이다. 귀가 둥글고 크며 볼에 검은 반문이 있다. 나무에 잘 오르며, 사슴·토끼 따위를 잡아먹는데 남북아메리카에 분포한다. 〔명사〕"@ko ;
    kno:truncated "false"^^xsd:boolean .
kno:KN2012-0302-c2 kno:formative kno:F006315 .
