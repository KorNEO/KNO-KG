    kno:componentString "온, 학교(學校), 교육(敎育), 회복(回復), 학습(學習), 지원(支援)"@ko ;
    kno:example "¶{온 학교 교육 회복 학습 지원은} 코로나19로 지치고 힘든 학생들의 교육 결손과 학부모들의 교육 피해의 회복에 도움을 주고자 마련되었다."@ko ;
    kno:slotFiller "온+학교(學校)+교육(敎育)+회복(回復)+학습(學習) (5성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:component kno:KN2022-0225-c5 ;
    kno:year "2022"^^xsd:gYear ;
    skos:definition "코로나19로 인하여 학습이 어려운 학생들을 돕기 위하여 교육비를 지원하는 일. 경상북도 교육청이 2021년 9월에 도내 모든 유치원부터 고등학교까지의 학생들과 특수 학교 및 방송 통신 학교 등의 학생들을 대상으로 일인당 삼십만 원의 지원금을 지급 했다."@ko ;
    kno:languageType "고^한^한^한^한^한" ;
    kno:instantiates kno:S000628 ;
    kno:pos "「구」"@ko ;
    a kno:Neologism ;
