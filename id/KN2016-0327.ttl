# KN2016-0327 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0327 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "싱글 웨딩"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372762> ;
    skos:definition "배우자 없이 혼자 하는 결혼식. 배우자와 함께 결혼을 하지 않고도 결혼식의 분위기를 느끼거나 결혼 사진을 촬영하기 위해 하는 결혼식이다."@ko ;
    kno:activeYears "9"^^xsd:integer ;
    kno:component kno:KN2016-0327-c1 ;
    kno:component kno:KN2016-0327-c2 ;
    kno:componentString "싱글(single), 웨딩(wedding)"@ko ;
    kno:example "¶{싱글 웨딩은} 결혼은 하지 않지만 드레스를 입어 보고 싶은 사람들 사이에서 번지고 있다."@ko ;
