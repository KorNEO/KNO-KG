# KN2025-0019 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0019 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "갓반중"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B0%93%EB%B0%98%EC%A4%91> ;
    skos:definition "(LLM) 일반 중학교 가운데서도 상위권 학생 비율이 높고 특목고ㆍ자사고 등 상급학교 진학 실적이 뛰어나다고 평가되는 학교를 이르는 말."@ko ;
