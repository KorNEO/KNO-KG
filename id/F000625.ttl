# F000625 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000625 a kno:Formative ;
    rdfs:label "(파)파라치(paparazzi)"@ko ;
    kno:fullForm "파파라치"@ko ;
    kno:origin "paparazzi" ;
    kno:semanticTag kno:usas-Q4.2 ;
    kno:urimalTargetCode "621219" ;
    kno:caseCount "4"^^xsd:integer ;
    kno:urimalDefinition "유명 인사나 연예인의 사생활을 카메라로 몰래 찍은 뒤 이를 신문이나 잡지사에 고액으로 팔아넘기는 직업적 사진사. 이탈리아의 영화감독 페데리코 펠리니가 만든 <달콤한 생활>에 등장한 신문사의 사진 기자에서 유래하는데, 이탈리아어로 파리처럼 윙윙거리며 달려드는 벌레를 뜻한다. 〔명사〕"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    kno:parallelFullForm kno:LEX-파파라치 ;
    kno:registration "우리말샘"@ko ;
    kno:fullFormLexeme kno:LEX-파파라치 ;
    kno:surfaceForm "파라치"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=621219> ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8C%8C%EB%9D%BC%EC%B9%98> .
