# KN2023-0342 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0342 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "풍선^갈등"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%92%8D%EC%84%A0%EA%B0%88%EB%93%B1> ;
    skos:definition "중국의 정찰 풍선이 미국의 영공을 침범하면서 중국과 미국 사이에서 발생한 갈등. 정찰 풍선은 7일 동안 미국을 남동 방향으로 횡단하였으며 고도의 통신 장비가 있었지만, 중국은 기상 관측을 위한 비행선이라고 해명하였다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2023-0342-c1 ;
    kno:component kno:KN2023-0342-c2 ;
    kno:componentString "풍선(風船), 갈등(葛藤)"@ko ;
    kno:example "¶미국과 중국의 고위급 인사들이 만남을 추진하면서 양측이 {풍선 갈등을} 진정시키고자 한다는 의견에 힘이 실리고 있다."@ko ;
    kno:frequency kno:KN2023-0342-freq-NN-2023 ;
    kno:frequency kno:KN2023-0342-freq-NN-2024 ;
    kno:frequency kno:KN2023-0342-freq-NN-total ;
    kno:indexForm "풍선갈등"@ko ;
    kno:instantiates kno:S000325 ;
    kno:languageType "한^한" ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:origin "(風船葛藤)" ;
    kno:pos "「구」"@ko ;
    kno:registration "신어DB"@ko ;
    kno:slotFiller "풍선(風船) (1성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:year "2023"^^xsd:gYear .
