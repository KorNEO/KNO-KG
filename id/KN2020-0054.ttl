# KN2020-0054 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0054 a ontolex:MultiwordExpression ;
    kno:languageType "한^고^한" ;
    kno:origin "(緊急돌봄制度)" ;
    kno:component kno:KN2020-0054-c3 ;
    kno:component kno:KN2020-0054-c1 ;
    kno:instantiates kno:S001178 ;
    rdfs:label "긴급^돌봄^제도"@ko ;
    kno:year "2020"^^xsd:gYear ;
    kno:indexForm "긴급돌봄제도"@ko ;
    kno:frequency kno:KN2020-0054-freq-NN-2023 ;
    kno:activeYears "6"^^xsd:integer ;
    skos:definition "전국적인 재난 사태가 발생한 상황에서 정부가 지정한 기관이 노인이나 아동 등을 맡아 돌보아 주는 제도. 코로나19의 확산으로 인해 대부분의 보육 시설 및 학교, 복지관 등이 문을 닫으면서 발생한 돌봄 공백을 없애기 위해서 마련된 제도이다."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%B4%EA%B8%89%EB%8F%8C%EB%B4%84%EC%A0%9C%EB%8F%84> ;
    kno:unitType "구"@ko ;
    kno:example "¶직장인이자 두 아이의 엄마인 OOO 씨는 코로나19 확산으로 전국 어린이집 휴원이 결정되면서 {긴급 돌봄 제도를} 이용하기로 했다."@ko ;
    kno:frequency kno:KN2020-0054-freq-NN-2021 ;
