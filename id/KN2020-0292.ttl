# KN2020-0292 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0292 kno:languageType "한^한^한" ;
    rdfs:label "재난^생계^지원금"@ko ;
    kno:component kno:KN2020-0292-c1 ;
    kno:pos "「구」"@ko ;
    a ontolex:MultiwordExpression ;
    kno:frequency kno:KN2020-0292-freq-NN-2020 ;
    kno:activeYears "3"^^xsd:integer ;
    kno:example "¶정부는 중위 소득 이하에 해당하는 가구에 4인 가구를 기준으로 100만 원의 {재난 생계 지원금을} 지급하는 안을 검토하고 있다."@ko ;
    skos:definition "전국적인 재난 사태로 인해 생계에 어려움을 겪는 국민들에게 정부가 지급하는 지원금. 코로나19의 확산으로 인한 경제 위축이 장기화되자 국민들의 생계를 지원하고 위축된 소비 심리를 진작하기 위해 마련된 제도로, 지급 주체가 지방 자치 단체일 경우 각 지방 자치 단체에 따라 지급 내용과 용어가 조금씩 다르다. =재난 생활 지원금."@ko ;
