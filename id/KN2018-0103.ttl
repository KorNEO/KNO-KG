kno:KN2018-0103 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "레이저^합동^직격탄"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A0%88%EC%9D%B4%EC%A0%80%ED%95%A9%EB%8F%99%EC%A7%81%EA%B2%A9%ED%83%84> ;
    skos:definition "지피에스(GPS)와 관성 항법 장치를 유도 시스템으로 사용하는 전천후 정밀 공격용 탄약인 합동 직격탄에 레이저 유도 방식을 추가한 폭탄. 지피에스 유도 방식과 레이저 유도 방식을 함께 사용한다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
