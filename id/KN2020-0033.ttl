# KN2020-0033 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0033 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "그린 스테이"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1601576> ;
    skos:definition "물, 에너지, 화학 물질 등의 불필요한 사용을 줄이는 친환경적 숙박 문화를 이르는 말."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2020-0033-c1 ;
    kno:component kno:KN2020-0033-c2 ;
    kno:componentString "그린(green), 스테이(stay)"@ko ;
    kno:example "¶OO 호텔은 욕실에서 사용하는 샴푸, 보디 워시 등의 플라스틱 용기를 친환경 대용량 용기로 대체하고 모든 조명을 이산화 탄소 배출이 적은 엘이디 조명으로 교체하는 등 {그린 스테이를} 추구하는 모습을 보인다."@ko ;
