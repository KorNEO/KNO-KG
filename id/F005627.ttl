# F005627 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005627 kno:caseCount "1"^^xsd:integer ;
    kno:urimalTargetCode "267274" ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "대뇌 반구의 앞부분. 운동 중추와 운동 언어 중추가 있고 사고, 판단과 같은 고도의 정신 작용이 이루어지는 곳이다. 포유류 가운데 고등 동물일수록 잘 발달되어 있다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=267274> ;
    kno:registration "우리말샘"@ko ;
    kno:surfaceForm "전두엽"@ko ;
    kno:semanticTag kno:usas-B1 ;
    a kno:Formative ;
    kno:fullForm "전두엽"@ko ;
    rdfs:label "전두엽(前頭葉)"@ko ;
    kno:origin "前頭葉" .
