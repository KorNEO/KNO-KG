# KN2013-0296 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0296 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "어모털리티"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1281707> ;
    skos:definition "영원히 늙지 않음. 평균 수명이 늘어나면서 고령의 나이에도 젊은 사람들 못지 않게 왕성한 활동을 하는 사람들의 속성을 이르는 말이다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2013-0296-c1 ;
    kno:componentString "어모털리티(amortality)"@ko ;
    kno:example "¶장년층과 노년층을 대상으로 한 문화 강좌가 봇물을 이루고, 이들이 공연ㆍ연극 등의 주요 관객층으로 자리 잡은 데 이어 시니어 온라인 커뮤니티까지 활성화되면서 {어모털리티는} 이제 대세가 되고 있다."@ko ;
