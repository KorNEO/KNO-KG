    kno:componentString "취합(聚合), 검사법(檢査法)"@ko ;
    a kno:Neologism ;
    kno:frequency kno:KN2020-0326-freq-NN-2021 ;
    kno:example "¶방역 당국은 코로나19 검사에 최대 10명의 검체를 한 번에 검사하는 {취합 검사법을} 도입하기로 결정했다."@ko ;
    kno:registration "우리말샘"@ko ;
