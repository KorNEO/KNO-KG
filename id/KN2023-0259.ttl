# KN2023-0259 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0259 kno:origin "(重꺾허)" ;
    kno:component kno:KN2023-0259-c3 ;
    kno:component kno:KN2023-0259-c1 ;
    skos:definition "‘중요한 것은 꺾이지 않는 허리’를 줄여 이르는 말. 허리 건강의 중요성을 ‘중요한 것은 꺾이지 않는 마음’을 줄인 말인 ‘중 꺾마’에 빗대어 재미있게 이르는 말이다."@ko ;
    a ontolex:Word ;
    kno:instantiates kno:S000581 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A4%91%EA%BA%BE%ED%97%88> ;
