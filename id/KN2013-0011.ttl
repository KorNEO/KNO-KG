# KN2013-0011 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0011 kno:componentString "개, (오)빠"@ko ;
    a ontolex:Word ;
    kno:instantiates kno:S000083 ;
    rdfs:label "개빠"@ko ;
