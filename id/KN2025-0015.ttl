# KN2025-0015 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0015 kno:indexForm "가짜내성"@ko ;
    kno:slotFiller "내성(耐性) (1성분)"@ko ;
    kno:example "(LLM) 연구진은 항암제 용량을 무작정 늘리기보다 {가짜내성이} 약물 전달 문제에서 비롯된 것은 아닌지 먼저 점검해야 한다고 밝혔다."@ko ;
    kno:predicate "떨어지다"@ko ;
    kno:component kno:KN2025-0015-c1 ;
    kno:unitType "구"@ko ;
    kno:frequency kno:KN2025-0015-freq-NN-total ;
    kno:activeYears "1"^^xsd:integer ;
    kno:registration "신어DB"@ko ;
    kno:year "2025"^^xsd:gYear ;
    a kno:Neologism ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B0%80%EC%A7%9C%20%EB%82%B4%EC%84%B1> ;
    skos:definition "(LLM) 항암제 등을 반복 투여하는 과정에서 암세포의 유전적ㆍ생물학적 내성 변화가 주된 원인이 아님에도, 약물이 종양 조직에 충분히 도달ㆍ침투하지 못해 치료 효과가 떨어지는 현상."@ko ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
