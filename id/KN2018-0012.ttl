kno:KN2018-0012 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "갓튜버"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B0%93%ED%8A%9C%EB%B2%84> ;
    skos:definition "특정 동영상 공유 사이트에서, 인기가 많고 영향력이 높은 콘텐츠 제작자를 이르는 말."@ko ;
