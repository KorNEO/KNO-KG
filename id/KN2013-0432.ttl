# KN2013-0432 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0432 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "퍼펫-극"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1357460> ;
    skos:definition "사람을 대신해 인형을 등장시켜 전개하는 연극. 손과 같은 신체 일부분을 사용하여 인형을 조종하거나, 줄 또는 막대에 인형 을 매달아 조종하며 대사를 한다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2013-0432-c1 ;
    kno:component kno:KN2013-0432-c2 ;
    kno:componentString "퍼펫(puppet), 극(劇)"@ko ;
    kno:example "¶첫 등장 시 미국에서도 파격적이었던 {퍼펫극} 형태의 뮤지컬은 국내에 들어오기까지 오랜 시간이 걸렸다."@ko ;
    kno:formation kno:W01 ;
