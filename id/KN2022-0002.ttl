# KN2022-0002 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0002 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "가스테란투스^익스팅크투스"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B0%80%EC%8A%A4%ED%85%8C%EB%9E%80%ED%88%AC%EC%8A%A4%EC%9D%B5%EC%8A%A4%ED%8C%85%ED%81%AC%ED%88%AC%EC%8A%A4> ;
    skos:definition "게스네리아과의 한 종류. 짙은 홍색의 꽃이 피며 열대, 아열대에서 자란다. 1981년에 처음으로 발견되었을 당시에 이미 멸종된 것으로 알려졌으나 2021년 11월 에콰도르 서부의 센티넬라 산에서 다시 발견되었다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2022-0002-c1 ;
    kno:component kno:KN2022-0002-c2 ;
    kno:componentString "가스테란투스(Gasteranthus), 익스팅크투스(extinctus)"@ko ;
    kno:example "¶남미 에콰도르에 서식하는 ‘{가스테란투스 익스팅크투스’는} ‘멸종’이라는 단어에서 유래한 이름의 의미 그대로 40년 전에 이미 멸종했다고 여겨졌지만, 최근에 다시 발견되었다."@ko ;
    kno:frequency kno:KN2022-0002-freq-NN-2022 ;
    kno:frequency kno:KN2022-0002-freq-NN-2023 ;
    kno:frequency kno:KN2022-0002-freq-NN-total ;
    kno:indexForm "가스테란투스익스팅크투스"@ko ;
    kno:languageType "라^라" ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:origin "(<라>Gasteranthus extinctus)" ;
