# KN2014-0152 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0152 a kno:Neologism ;
    kno:frequency kno:KN2014-0152-freq-NN-total ;
    skos:definition "누리 소통망 서비스(SNS)에 올라온 각종 정보를 통해 미래를 예측하고 이에 대응하는 능력."@ko ;
    kno:registration "신어DB"@ko ;
    kno:instantiates kno:S001385 ;
    kno:example "¶소셜 미디어는 기업들의 좋은 비즈니스 기회이기도 하지만 리스크이기도 하다. 따라서 기업 측면에서 리스크를 사전에 예측하고 미연에 방지할 수 있는 체계적인 관리가 필요하며 이를 수행할 수 있는 ‘{소셜력’을} 직원들의 업무 능력으로 요구하고 있다."@ko ;
    kno:unitType "단어"@ko ;
    kno:instantiates kno:S000006 ;
    kno:slotFiller "소셜(social) (1성분)"@ko ;
    kno:pos "「명」"@ko ;
    kno:componentString "소셜(social), -력(力)"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%86%8C%EC%85%9C%EB%A0%A5> ;
