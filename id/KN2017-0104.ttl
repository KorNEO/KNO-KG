# KN2017-0104 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0104 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "먹튀 출산"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380448> ;
    skos:definition "특정 지자체에서 출산 장려를 위해 아이를 낳은 가정에 지급하는 돈만 받은 후 다른 지역으로 이사 가는 현상. 출산 장려금을 많이 주는 지자체로 주소지를 임시로 옮긴 뒤, 출산 장려금만 받고 다시 돌아가는 일을 이른다."@ko ;
    kno:activeYears "8"^^xsd:integer ;
    kno:component kno:KN2017-0104-c1 ;
    kno:component kno:KN2017-0104-c2 ;
    kno:componentString "먹튀, 출산(出産)"@ko ;
    kno:example "¶4년째 출산율 1위인 전남 OO군이 {먹튀 출산과} 재정 악화 문제로 골머리를 앓고 있다."@ko ;
    kno:frequency kno:KN2017-0104-freq-NN-2016 ;
