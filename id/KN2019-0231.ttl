# KN2019-0231 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0231 kno:languageType "한_한" ;
    kno:componentString "임신(妊娠), 하청(下請)"@ko ;
    kno:origin "(妊娠下請)" ;
    kno:example "¶한국에서는 불임 부부가 제3의 여성에게 임신과 출산을 하게 하는 대리모 자체가 불법이다.…하지만 음지에선 여전히 {‘임신 하청’이라고} 불리는 위험한 불법 대리모 계약이 빈번하다고 한다."@ko ;
    kno:registration "신어DB"@ko ;
    kno:lastAttestationYear "2019"^^xsd:gYear ;
    kno:year "2019"^^xsd:gYear ;
    rdfs:label "임신 하청"@ko ;
    kno:indexForm "임신하청"@ko ;
    kno:pos "「구」"@ko ;
    a kno:Neologism ;
    kno:frequency kno:KN2019-0231-freq-NN-2019 ;
    kno:unitType "구"@ko ;
    skos:definition "정상적인 방법으로는 아이를 가질 수 없는 부부의 의뢰를 받아 일정한 돈을 받고 아기를 대신 낳아 주는 일을, 기업들 사이에서 이루어지는 하청에 빗대어 이르는 말. 주로 개발 도상국의 여성이 선진국의 불임 부부에게 의뢰를 받아 대신 임신과 출산을 하는 일을 이르는 말이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2019-0231-c1 ;
    kno:frequency kno:KN2019-0231-freq-NN-total ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9E%84%EC%8B%A0%20%ED%95%98%EC%B2%AD> ;
