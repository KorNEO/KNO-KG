# KN2024-0237 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0237 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "이음^연령"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9D%B4%EC%9D%8C%EC%97%B0%EB%A0%B9> ;
    skos:definition "영아 교육과 유아 교육 또는 유아 교육과 초등 교육 간의 연계 강화를 위해 정책적으로 지정한 연령. 주로 만 2세 영아들은 놀이 중심 교육 확대를 통해 누리 과정과의 연계성을 강화하고, 만 5세 유아들은 초기 문해력과 기초 학습 역량을 집중적으로 지원하기 위해 설정되었다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2024-0237-c1 ;
    kno:component kno:KN2024-0237-c2 ;
    kno:componentString "이음, 연령(年齡)"@ko ;
    kno:example "¶교육청 관계자는 “이번 사업을 통해 {이음 연령인} 만 5세 유아들이 책과 친해지고, 문해력과 기초 학습 역량을 기를 수 있을 것으로 기대한다.”라고 밝혔다."@ko ;
    kno:frequency kno:KN2024-0237-freq-NN-2024 ;
    kno:frequency kno:KN2024-0237-freq-NN-total ;
    kno:indexForm "이음연령"@ko ;
    kno:languageType "고^한" ;
    kno:lastAttestationYear "2024"^^xsd:gYear ;
    kno:origin "(이음年齡)" ;
    kno:pos "「구」"@ko ;
    kno:registration "신어DB"@ko ;
    kno:unitType "구"@ko ;
    kno:year "2024"^^xsd:gYear .
