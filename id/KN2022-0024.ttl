    kno:slotFiller "면담제(面談制) (1성분)"@ko ;
    kno:component kno:KN2022-0024-c2 ;
    kno:languageType "한^한" ;
    skos:definition "사전 구속 영장이 신청된 피의자를 검찰이 직접 면담하여 변론의 기회를 주는 제도. 영장의 심사를 강화하고, 피의자의 변론권을 보장하여 부당한 구속을 방지하기 위한 제도를 말한다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    a kno:Neologism ;
    kno:unitType "구"@ko ;
    kno:frequency kno:KN2022-0024-freq-NN-2022 ;
    kno:example "¶{검찰 면담제에} 따르면, 검사는 특별한 이유가 없는 한 피의자를 조사하거나 면담한 당일에 구속 영장의 청구 여부를 결정해야 한다."@ko ;
    kno:pos "「구」"@ko ;
    a ontolex:MultiwordExpression ;
