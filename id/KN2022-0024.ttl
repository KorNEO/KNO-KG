# KN2022-0024 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0024 kno:year "2022"^^xsd:gYear ;
    kno:frequency kno:KN2022-0024-freq-NN-2025 ;
