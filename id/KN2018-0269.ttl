# KN2018-0269 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0269 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "우먼스플레인"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9A%B0%EB%A8%BC%EC%8A%A4%ED%94%8C%EB%A0%88%EC%9D%B8> ;
    skos:definition "어떤 사건이나 사물 따위에 대해 설명하는 여자. 주로 어떤 상황에 대한 남성의 편협한 시각을 여성의 관점에서 다시 설명하는 여자를 의미한다. 어떤 사건이나 사물 따위에 대해 설명하는 남자를 가리키는 ‘맨스플레인’에 상대하여 이르는 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2018-0269-c1 ;
    kno:componentString "우먼스플레인(womansplain)"@ko ;
    kno:example "¶어떤 남자들은 맨스플레인이라는 개념이 한국에 전래된 후, ‘{우먼스플레인’도} 있다는 둥, 이런 식으로 나오니까 남성과 여성 사이에 대화가 통하지 않는다는 둥, 온갖 볼멘소리를 늘어놓기 시작했던 것이다."@ko ;
    kno:formation kno:W07 ;
