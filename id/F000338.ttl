# F000338 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000338 kno:caseCount "5"^^xsd:integer ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "영리(營利)를 얻기 위하여 재화나 용역을 생산하고 판매하는 조직체. 출자(出資) 형태에 따라 사기업(私企業), 공기업(公企業), 공사 합동 기업(公私合同企業)으로 나눈다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=378946> ;
    kno:surfaceForm "기업"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:semanticTag kno:usas-I2.1 ;
    kno:origin "企業" ;
    rdfs:label "기업(企業)"@ko ;
    kno:urimalTargetCode "378946" ;
    kno:fullForm "기업"@ko .
