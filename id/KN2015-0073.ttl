kno:KN2015-0073 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "메르스^피난민"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1359965> ;
    skos:definition "메르스를 피하여 가는 사람. 전염성이 강한 메르스가 유행하여 메르스가 발병하지 않은 지역으로 옮겨 가는 사람을 이른다."@ko ;
