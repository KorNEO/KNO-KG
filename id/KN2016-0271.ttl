# KN2016-0271 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0271 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "세실 효과"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%84%B8%EC%8B%A4%20%ED%9A%A8%EA%B3%BC> ;
    skos:definition "짐바브웨의 국립 공원에 서식하는 사자 개체 수를 현저하게 증가시킨 효과. 황게 국립 공원의 숫사자 ‘세실’이 사살된 것에 대한 짐바브웨 국민들의 분노로 인하여 사자 사냥꾼의 수가 줄어들어 사자의 수가 증가하였다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2016-0271-c1 ;
    kno:component kno:KN2016-0271-c2 ;
    kno:componentString "세실(Cecil), 효과(效果)"@ko ;
    kno:example "¶이처럼 사자 수가 늘어난 가장 큰 원인은 이른바 ‘{세실 효과}’ 때문이다."@ko ;
