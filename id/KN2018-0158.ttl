kno:KN2018-0158 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "비트폐인"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B9%84%ED%8A%B8%ED%8F%90%EC%9D%B8> ;
    skos:definition "온종일 가상 화폐의 시세 확인과 투자에 몰두하느라 정상적인 일상 생활이 어려운 사람을 이르는 말. 가상 화폐의 일종인 ‘비트코인(Bitcoin)’과 ‘폐인(廢人)’을 결합하여 만든 말이다."@ko ;
