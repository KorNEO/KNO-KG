# KN2020-0088 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0088 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "돌밥돌밥"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8F%8C%EB%B0%A5%EB%8F%8C%EB%B0%A5> ;
    skos:definition "‘돌아서면 밥 차리고 또 돌아서면 밥을 차림’을 줄여 이르는 말. 코로나19의 확산과 그에 따른 사회적 거리 두기의 시행으로 인해 가족 구성원들이 집에서 아침밥, 점심밥, 저녁밥을 모두 먹는 일이 많아지자 매끼 식사를 직접 준비하는 가정주부의 고됨을 표현한 말이다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2020-0088-c1 ;
