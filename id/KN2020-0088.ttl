    kno:component kno:KN2020-0088-c3 ;
    kno:component kno:KN2020-0088-c4 ;
    kno:componentString "돌(아서다), 밥, 돌(아서다), 밥"@ko ;
    kno:example "¶코로나19로 인한 계속된 {돌밥돌밥에} 지친 가정주부들을 위해 유통업계에서 다양한 반찬 상품들을 내놓았다."@ko ;
    kno:formation kno:W06 ;
