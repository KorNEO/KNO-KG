# KN2015-0275 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0275 kno:instantiates kno:S000616 ;
    rdfs:label "히든 시티 티케팅"@ko ;
    kno:urimalTargetCode "1359822" ;
    skos:definition "비행기의 최종 목적지에 하차하지 않고 경유지에 하차함으로써 더 싼 값에 항공권을 구매하는 방법. 실제 목적지로 바로 가는 항공권보다 실제 목적지를 경유하여 다른 곳으로 가는 항공권이 더 쌀 때 후자를 선택하여 비용을 아끼는 방법이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:frequency kno:KN2015-0275-freq-NN-2016 ;
    kno:slotFiller "시티(city)+티케팅(ticketing) (2성분)"@ko ;
    kno:component kno:KN2015-0275-c2 ;
    kno:languageType "영_영_영" ;
    a kno:Neologism ;
    kno:componentString "히든(hidden), 시티(city), 티케팅(ticketing)"@ko ;
    kno:component kno:KN2015-0275-c3 ;
    kno:frequency kno:KN2015-0275-freq-NN-total ;
    kno:pos "「구」"@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:lastAttestationYear "2016"^^xsd:gYear ;
    kno:component kno:KN2015-0275-c1 ;
    kno:predicate "구매하다"@ko ;
    kno:frequency kno:KN2015-0275-freq-NN-2015 ;
    kno:indexForm "히든시티티케팅"@ko ;
    kno:origin "(<영>hidden city ticketing)" ;
    kno:example "¶OO은 편도 티켓에 한해서 실제 목적지로 가는 티켓을 구입하는 대신 실제 목적지를 경유지로 하는 좀 더 싼 티켓을 구입한 후 경유지에서 다음 비행기에 탑승하지 않는 ‘{히든 시티 티케팅}’ 전략으로 인터넷 항공 티켓 중개를 맡아 왔다."@ko ;
