# KN2013-0424 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2013-0424 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "티텐더"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8B%B0%ED%85%90%EB%8D%94> ;
    skos:definition "카페에서 주문을 받아 차를 만들어 파는 사람."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2013-0424-c1 ;
    kno:component kno:KN2013-0424-c2 ;
    kno:componentString "티(tea), (바)텐더(bartender)"@ko ;
    kno:example "¶유통업체들이 적극적인 체험 마케팅을 진행하는 것은 고객들의 쇼핑에 대한 가치관이 ‘제품을 구매하는 행위’에서 ‘놀이와 문화를 즐기는 행위’로 변하고 있기 때문이다. OO 관계자는 “단순히 화장품을 판매하는 곳이 아닌 휴식과 문화를 체험하는 공간으로 꾸몄다. 영국식 인테리어 뿐 아니라 {티텐더가} 있어 다양한 티 문화를 즐길 수 있다.”라고 말했다."@ko ;
