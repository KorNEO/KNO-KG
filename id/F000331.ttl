# F000331 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000331 kno:urimalTargetCode "340331" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=340331> ;
    rdfs:label "경제학(經濟學)"@ko ;
    kno:caseCount "5"^^xsd:integer ;
    kno:urimalDefinition "경제 현상을 분석하고 연구하는 학문. 사회 과학의 한 분야로 국민 경제학, 경영학, 재정학, 가정학을 통틀어 이르는 말인데 일반적으로는 국민 경제학을 이른다. 〔명사〕"@ko ;
    a kno:Formative ;
    kno:fullForm "경제학"@ko ;
    kno:surfaceForm "경제학"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-I1 ;
    kno:origin "經濟學" .
