kno:KN2019-0193 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "어버이-주의"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%96%B4%EB%B2%84%EC%9D%B4%EC%A3%BC%EC%9D%98> ;
    skos:definition "부모와 자식의 관계처럼 국가가 국민을 보살펴야 한다고 생각하는 태도."@ko ;
