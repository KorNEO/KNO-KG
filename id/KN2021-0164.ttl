kno:KN2021-0164 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "숏케팅"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1558471> ;
    skos:definition "유행에 민감한 소비자를 사로잡기 위해 단기간 내에 치고 빠지는 방식으로 이루어지는 마케팅."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2021-0164-c1 ;
    kno:component kno:KN2021-0164-c2 ;
    kno:componentString "숏(short), (마)케팅(marketing)"@ko ;
    kno:example "¶{숏케팅은} 넘쳐 나는 콘텐츠들 속에서 짧고 강렬한 자극을 원하는 소비자를 공략하는 효과적인 마케팅 방법으로 주목받고 있다."@ko ;
