    rdfs:label "블랙아웃 화요일"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B8%94%EB%9E%99%EC%95%84%EC%9B%83%20%ED%99%94%EC%9A%94%EC%9D%BC> ;
    kno:unitType "구"@ko ;
    kno:predicate "표명하다"@ko ;
    kno:frequency kno:KN2020-0127-freq-NN-2020 ;
    kno:pos "「구」"@ko ;
    a kno:Neologism ;
    kno:year "2020"^^xsd:gYear ;
    kno:origin "(<영>blackout火曜日)" ;
    kno:component kno:KN2020-0127-c1 ;
    kno:frequency kno:KN2020-0127-freq-NN-total ;
    kno:example "¶한 음반사는 인종 차별을 위해 음악 산업이 할 수 있는 일을 생각해 보고자 {블랙아웃 화요일에} 동참하게 되었다고 한다."@ko .
