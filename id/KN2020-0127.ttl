# KN2020-0127 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0127 a ontolex:MultiwordExpression ;
    kno:registration "신어DB"@ko ;
    kno:componentString "블랙아웃(blackout), 화요일(火曜日)"@ko ;
    skos:definition "인종 차별을 규탄하는 시위에 연대와 지지를 표명하는 캠페인. 미국 음반사에서 시작된 이 캠페인은 2020년 6월 2일 화요일 업무를 중단하고 인종 차별에 항의한 것으로, 전 세계 대중 음악계와 방송계 등으로 확산되었다."@ko ;
    kno:indexForm "블랙아웃화요일"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:languageType "영_한" ;
    kno:lastAttestationYear "2020"^^xsd:gYear ;
