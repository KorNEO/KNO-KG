# KN2018-0072 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0072 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "니트^비용"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416080> ;
    skos:definition "나라에서 정한 의무 교육을 마친 뒤에, 진학이나 취직을 하지 않고 직업 교육을 받지 않으며 지내는 젊은이들로 인한 사회ㆍ경제적 비용. 젊은이들이 노동을 통해 소득을 얻지 못하는 데 따르는 비용을 뜻하는 말로, 가계 차원에서는 일을 하지 않는 가족 구성원 때문에 줄어드는 소득을 의미하고, 국가 차원에서는 이들이 일을 했다면 발생했을 총소득 및 청년의 노동력이 사장됨에 따라 발생하는 기회비용을 의미한다. 이 비용은 이들이 취업할 경우에 받게 될 임금과 기업의 사회 보장 분담금 등을 더하는 방식으로 측정된다. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2018-0072-c1 ;
    kno:component kno:KN2018-0072-c2 ;
    kno:componentString "니트(NEET), 비용(費用)"@ko ;
    kno:example "¶한국의 청년 {니트 비용은} 경제 협력 개발 기구 회원국 중 세 번째로 많다."@ko ;
