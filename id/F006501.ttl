# F006501 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006501 kno:urimalTargetCode "302610" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:registration "우리말샘"@ko ;
    kno:fullFormLexeme kno:LEX-통풍 ;
    a kno:Formative ;
    kno:parallelFullForm kno:LEX-통풍 ;
    kno:origin "痛風" ;
    kno:fullForm "통풍"@ko ;
    kno:surfaceForm "통"@ko ;
    rdfs:label "통(풍)(痛風)"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=302610> ;
    kno:urimalDefinition "팔다리 관절에 심한 염증이 되풀이되어 생기는 유전성 대사 이상 질환. 관절 속이나 주위에 요산염이 쌓여서 일어나며, 열이 나고 피부가 붉어지며 염증이 생긴 관절에 통증이 있다. 〔명사〕"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%86%B5> .
kno:KN2025-0053-c4 kno:formative kno:F006501 .
