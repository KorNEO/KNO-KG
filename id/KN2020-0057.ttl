# KN2020-0057 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0057 rdfs:label "긴급^민생^지원금"@ko ;
    kno:frequency kno:KN2020-0057-freq-NN-2024 ;
    kno:slotFiller "민생(民生) (1성분)"@ko ;
    kno:unitType "구"@ko ;
