# F000541 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000541 kno:semanticTag kno:usas-O1.3 ;
    kno:urimalDefinition "모든 물질 가운데 가장 가벼운 기체 원소. 빛깔과 냄새와 맛이 없고 불에 타기 쉽다. 환원 작용을 일으키며 금속에 대하여 친화력이 적다. 원자 기호는 H, 원자 번호는 1, 원자량은 1.0079. 〔명사〕"@ko ;
    kno:surfaceForm "수소"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "수소"@ko ;
    kno:caseCount "4"^^xsd:integer ;
    kno:origin "水素" ;
    rdfs:label "수소(水素)"@ko ;
    kno:urimalTargetCode "389868" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=389868> ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative .
