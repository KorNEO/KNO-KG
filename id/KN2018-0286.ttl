# KN2018-0286 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0286 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "자구벽^기반^자기^메모리"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416338> ;
    skos:definition "자기장을 이용해 자구벽을 이동시켜 정보를 저장하는 장치. 기존 하드 디스크는 원판의 회전으로 정보를 저장해 속도가 느리고 에너지 소모가 컸지만, 이 장치는 하드 디스크에 비해 이동 속도가 약 세 배가량 높고 전력 소모량도 낮아 실용성이 크다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2018-0286-c1 ;
    kno:component kno:KN2018-0286-c2 ;
    kno:component kno:KN2018-0286-c3 ;
    kno:component kno:KN2018-0286-c4 ;
    kno:componentString "자구벽(磁區壁), 기반(基盤), 자기(磁氣), 메모리(memory)"@ko ;
    kno:example "¶국내 연구진이 차세대 메모리 소자로 꼽히는 ‘{자구벽 기반 자기 메모리’의} 속도를 높이는 핵심 기술을 개발했다."@ko ;
