# KN2020-0297 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0297 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "재난^소득^기금"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9E%AC%EB%82%9C%EC%86%8C%EB%93%9D%EA%B8%B0%EA%B8%88> ;
    skos:definition "전국적인 재난 사태로 인해 소득이 줄어든 국민들을 지원하기 위해 정부에서 마련한 기금. 코로나19로 인한 재난 상황에서 기금을 마련하기 시작했다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
