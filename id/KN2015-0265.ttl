# KN2015-0265 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0265 a kno:Neologism ;
    kno:instantiates kno:S000611 ;
    kno:slotFiller "미(모)(美) (1성분)"@ko ;
    skos:definition "‘현실 미모’를 줄여 이르는 말. 방송이나 사진으로 보는 모습이 아니라 직접 눈으로 본 모습이 매우 아름다울 때 쓰는 말이다."@ko ;
    kno:indexForm "현미"@ko ;
    kno:registration "신어DB"@ko ;
    kno:year "2015"^^xsd:gYear ;
    kno:activeYears "0"^^xsd:integer ;
    rdfs:label "현미"@ko ;
    kno:componentString "현(실)(現), 미(모)(美)"@ko ;
    kno:component kno:KN2015-0265-c2 ;
    kno:example "¶스튜디오에 등장한 줄임말을 쓰는 친구들은…“OOO 언니는 가까이서 보니 {현미} 돋는다.”라며 “말을 줄여서 쓰는 게 정말 편하다. 할 말이 많으니 말을 줄이는 거다.”라고 밝혔다."@ko ;
    kno:component kno:KN2015-0265-c1 ;
    kno:languageType "한+한" ;
    kno:formation kno:W06 ;
    kno:unitType "단어"@ko ;
    kno:origin "(現美)" ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%98%84%EB%AF%B8> ;
    a ontolex:Word ;
    kno:pos "「명」"@ko .
kno:KN2015-0265-c2 kno:role "슬롯 채움"@ko ;
    rdfs:label "미(모)(美)"@ko ;
    kno:fullForm "미모"@ko ;
    kno:surfaceForm "미"@ko ;
