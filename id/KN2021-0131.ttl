# KN2021-0131 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0131 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "백신 장벽"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B0%B1%EC%8B%A0%20%EC%9E%A5%EB%B2%BD> ;
    skos:definition "백신 확보가 어려워 국가 간 백신 수출입이 금지된 상황을 장벽에 빗대어 이르는 말. 코로나19가 전 세계적으로 유행한 상황에서 나온 말이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
