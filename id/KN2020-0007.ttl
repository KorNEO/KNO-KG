kno:KN2020-0007 kno:frequency kno:KN2020-0007-freq-NN-2025 ;
    kno:unitType "구"@ko ;
    rdfs:label "공감 소비 운동"@ko ;
    kno:year "2020"^^xsd:gYear ;
    kno:frequency kno:KN2020-0007-freq-NN-2020 ;
