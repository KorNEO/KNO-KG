# F006658 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006658 kno:fullForm "팩"@ko ;
    kno:origin "pack" ;
    a kno:Formative ;
    rdfs:label "팩(pack)"@ko ;
    kno:urimalDefinition "밀가루, 달걀, 황토(黃土) 따위에 각종 약제나 영양제, 과일 따위를 반죽하여서 얼굴 따위에 바르거나 붙이는 미용법. 또는 그런 화장품. 혈액 순환을 좋게 하고 털구멍의 더러움을 제거하여, 피부의 노화를 방지하고, 표백·청정 따위의 효과를 낸다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=333700> ;
    kno:urimalTargetCode "333700" ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:semanticTag kno:usas-B1 ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "팩"@ko .
kno:KN2012-0053-c2 kno:formative kno:F006658 .
