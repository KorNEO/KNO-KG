# KN2018-0424 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0424 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "홈 루덴스족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1383463> ;
    skos:definition "집에서 하는 놀이를 즐기면서 편안하게 휴식을 취하는 사람. 또는 그런 무리. 유희하는 인간이라는 뜻의 ‘호모 루덴스’에서 유래한 말이다."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2018-0424-c1 ;
    kno:component kno:KN2018-0424-c2 ;
    kno:component kno:KN2018-0424-c3 ;
    kno:componentString "홈(home), 루덴스(ludens), -족(族)"@ko ;
    kno:example "¶OO 관계자는 “{홈 루덴스족과} 더불어 모든 소비자에게 마음의 평안을 가져다주는 쉼터 같은 공간을 제공하고자 하는 마음으로 신규 디자인을 선보이게 됐다.”라고 전했다."@ko ;
    kno:frequency kno:KN2018-0424-freq-NN-2017 ;
