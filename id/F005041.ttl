    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=429399> ;
    kno:urimalTargetCode "429399" ;
    kno:urimalDefinition "국가나 사회에 특별한 공로가 있거나 일정 기간 동안 국가 기관에 복무한 사람에게 해마다 주는 돈. 무상 연금, 유상 연금, 종신 연금, 유기 연금 따위로 나뉜다. 〔명사〕"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%97%B0> ;
    kno:surfaceForm "연"@ko ;
    kno:parallelFullForm kno:LEX-연금 ;
    kno:semanticTag kno:usas-I1.1 ;
    kno:fullFormLexeme kno:LEX-연금 ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:label "연(금)(年金)"@ko .
