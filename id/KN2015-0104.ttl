kno:KN2015-0104 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "사이다-남"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1359939> ;
    skos:definition "청량음료의 하나인 사이다를 마신 것처럼, 복잡하고 해결하기 어려운 상황을 시원하게 해결해 주는 남자."@ko ;
