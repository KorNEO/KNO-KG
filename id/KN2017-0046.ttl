# KN2017-0046 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0046 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "내비게이션 소비"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380356> ;
    skos:definition "인공 지능, 사물 인터넷 등 무선 통신 기술을 기반으로 소비자의 쇼핑 동선을 파악하여, 소비자에게 관련된 정보를 제공하는 방식으로 이루어지는 소비 형태."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2017-0046-c1 ;
    kno:component kno:KN2017-0046-c2 ;
    kno:componentString "내비게이션(navigation), 소비(消費)"@ko ;
    kno:example "¶{내비게이션 소비는} 이용자의 모바일 쇼핑 동선을 파악해 수요에 맞는 정보를 제공하는 소비를 말한다. 인공 지능을 이용한 ‘OO 서비스’가 대표적이다."@ko ;
    kno:frequency kno:KN2017-0046-freq-NN-2016 ;
