# KN2020-0034 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0034 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "그린^스완"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B7%B8%EB%A6%B0%EC%8A%A4%EC%99%84> ;
    skos:definition "기후 변화가 초래한 경제적 위기를 이르는 말. 전혀 예상하지 못했던 일로 인한 경제적 위기를 뜻하는 ‘블랙 스완’에서 나온 말로, 환경 오염으로 인한 이상 기후 현상이 막대한 경제적 비용을 발생시키며 엄청난 경제 위기를 맞을 수 있다는 의미로 사용된다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2020-0034-c1 ;
    kno:component kno:KN2020-0034-c2 ;
    kno:componentString "그린(green), 스완(swan)"@ko ;
    kno:example "¶최근 전 세계적으로 나타나는 이상 기후 현상으로 인해 금융 당국도 {그린 스완을} 우려하고 나섰다."@ko ;
