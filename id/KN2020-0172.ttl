# KN2020-0172 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0172 kno:component kno:KN2020-0172-c2 ;
    kno:instantiates kno:S000027 ;
    kno:slotFiller "소부장(素部裝) (1성분)"@ko ;
    kno:frequency kno:KN2020-0172-freq-NN-2025 ;
    kno:pos "「구」"@ko ;
    kno:example "¶{소부장 특별법이} 시행되면서 정책 범위가 소재 및 부품에서 소재ㆍ부품ㆍ장비까지 확장되었다."@ko ;
    a kno:Neologism ;
    kno:unitType "구"@ko ;
    kno:year "2020"^^xsd:gYear ;
    kno:urimalTargetCode "1456042" ;
    kno:componentString "소부장(素部裝), 특별법(特別法)"@ko ;
    kno:component kno:KN2020-0172-c1 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1456042> ;
    skos:definition "소재ㆍ부품ㆍ장비와 관련한 산업의 대외 의존도를 낮추고 경쟁력을 강화하기 위해 제정한 법률. 2019년 7월부터 일본 정부가 반도체 생산에 필수적인 품목들을 한국으로 수출하는 데에 규제를 강화하였고, 이에 대응하기 위해 한국 정부에서 시행하였다. 2001년 제정된 ‘소재ㆍ부품 특별법’을 전면 개편하여 2019년 9월 국회에 발의되고 2020년 4월에 시행되었다. 정식 명칭은 ‘소재ㆍ부품ㆍ장비 산업 경쟁력 강화를 위한 특별 조치법’이다. =소재ㆍ부품ㆍ장비 산업 특별법."@ko ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
