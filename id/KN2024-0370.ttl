# KN2024-0370 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0370 kno:instantiates kno:S000015 ;
    kno:indexForm "한우법"@ko ;
    kno:frequency kno:KN2024-0370-freq-NN-2025 ;
    kno:activeYears "3"^^xsd:integer ;
    skos:definition "탄소 중립 실현과 기후 변화 대응을 위한 축산 환경의 전환, 한우 산업의 경쟁력 강화를 위해 제정한 법률. 정식 명칭은 ‘탄소 중립에 따른 한우 산업 전환 및 지원에 관한 법률’이다. =한우 사업법."@ko ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    a kno:Neologism ;
