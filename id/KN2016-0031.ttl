# KN2016-0031 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0031 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "관상^죽상^경화"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B4%80%EC%83%81%EC%A3%BD%EC%83%81%EA%B2%BD%ED%99%94> ;
    skos:definition "관상 동맥에 지방 침착물 따위가 쌓여서 죽종이 생기고, 이로 인하여 동맥이 좁아지고 딱딱해지는 증상. 혈액 공급이 제대로 되지 않으며 심장이 제 기능을 발휘하지 못하는 질환으로 가슴 통증을 유발할 수 있다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2016-0031-c1 ;
    kno:component kno:KN2016-0031-c2 ;
    kno:component kno:KN2016-0031-c3 ;
    kno:componentString "관상(冠狀), 죽상(粥狀), 경화(硬化)"@ko ;
    kno:example "¶실제로는 허혈성 심장병은 {관상 죽상 경화에} 의해 생기는 경우가 대부분이므로 관상 동맥 질환으로 불리는 경우도 있다."@ko ;
    kno:frequency kno:KN2016-0031-freq-NN-2015 ;
    kno:frequency kno:KN2016-0031-freq-NN-total ;
    kno:indexForm "관상죽상경화"@ko ;
    kno:instantiates kno:S000727 ;
    kno:languageType "한^한^한" ;
    kno:lastAttestationYear "2015"^^xsd:gYear ;
    kno:origin "(冠狀粥狀硬化)" ;
    kno:pos "「구」"@ko ;
    kno:predicate "딱딱해지다"@ko ;
    kno:registration "신어DB"@ko ;
    kno:slotFiller "관상(冠狀)+죽상(粥狀) (2성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:year "2016"^^xsd:gYear .
