# KN2018-0140 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0140 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "벌집^계좌"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1383154> ;
    skos:definition "법인 계좌 아래에 여러 개의 개인 계좌를 개설하는 일. 또는 그런 형태의 계좌. 은행이 가상 화폐 거래를 목적으로 하는 가상 계좌 발급을 중단하자 일부 가상 화폐 거래소가 편법으로 운영한 계좌의 형태를 말한다."@ko ;
    kno:activeYears "8"^^xsd:integer ;
    kno:component kno:KN2018-0140-c1 ;
    kno:component kno:KN2018-0140-c2 ;
    kno:componentString "벌집, 계좌(計座)"@ko ;
    kno:example "¶{벌집 계좌는} 자금 세탁 소지가 크고, 해킹과 같은 사고가 생겼을 때 거래 자금이 뒤엉킬 수 있다."@ko ;
