# KN2018-0344 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0344 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "클램포러리"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415948> ;
    skos:definition "고전적이면서 세련된 이미지에 현대적이며 활동이 자유로운 느낌을 더한 옷맵시. ‘고전’을 뜻하는 ‘클래식(classic)’과 ‘현대’를 뜻하는 ‘컨템포러리(contemporary)’를 결합하여 만든 말이다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2018-0344-c1 ;
    kno:component kno:KN2018-0344-c2 ;
    kno:componentString "클래(식)(classic), (컨템)포러리(contemporary)"@ko ;
    kno:example "¶{클램포러리의} 유행으로 OO는 수년간 이어지는 경기 침체에도 불구하고 올해 최고의 실적을 올릴 것으로 기대를 모은다. 모던하고 클래식한 브랜드 이미지를 강화하겠단 각오다."@ko ;
    kno:formation kno:W05 ;
