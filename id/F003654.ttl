# F003654 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003654 kno:semanticTag kno:usas-C1 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1043803> ;
    kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "물질 대신에 생명체를 다루는 생물학과 예술을 융합한 예술 장르. 생물학적 기술이 다양하게 쓰이기도 하고, 박테리아, 세포, 분자, 식물체, 디엔에이(DNA) 또는 유전자 따위의 생물체를 대상으로 하기도 한다. 이와 같은 것을 컴퓨터나 전자 미디어를 사용하여 예술 작품으로 표현한다. 〔명사〕"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:label "바이오아트(bio art)"@ko ;
    kno:fullForm "바이오아트"@ko ;
    a kno:Formative ;
    kno:origin "bio" ;
    kno:semanticTag kno:usas-Y1 ;
    kno:urimalTargetCode "1043803" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "바이오아트"@ko .
