# F000163 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000163 kno:caseCount "8"^^xsd:integer ;
    kno:fullForm "근육"@ko ;
    kno:urimalDefinition "힘줄과 살을 통틀어 이르는 말. 동물의 운동을 맡은 기관으로, 단백질·지방·탄수화물·무기 염류를 포함하고 있는데, 수분이 70%를 차지한다. 기능적으로 보아 수의근인 골격근과 불수의근인 내장근이 있으며, 구조적으로 보아 가로무늬근과 민무늬근이 있다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-B1 ;
    kno:urimalTargetCode "103150" ;
    kno:surfaceForm "근육"@ko ;
    rdfs:label "근육(筋肉)"@ko ;
    kno:origin "筋肉" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=103150> ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative .
