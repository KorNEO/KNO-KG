# KN2021-0174 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0174 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "식집사"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1604547> ;
    skos:definition "식물을 시중들듯이 정성스럽게 돌보고 기르는 사람을 비유적으로 이르는 말. 코로나19의 확산으로 인해 외부 활동을 하기보다는 집에 머무르며 식물을 기르는 사람들이 많아지는 상황에서 나온 말이다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2021-0174-c1 ;
    kno:component kno:KN2021-0174-c2 ;
    kno:componentString "식(물)(植物), 집사(執事)"@ko ;
    kno:example "¶코로나19의 확산과 사회적 거리 두기의 시행 이후, 기성세대만의 취미 활동으로 여겨졌던 원예가 ‘{식집사’라는} 이름으로 젊은 세대에게도 인기를 끌고 있다."@ko ;
