# KN2017-0073 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0073 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "독서실 원시인"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380402> ;
    skos:definition "취업을 위하여 독서실에서 공부하는 사람을 ‘원시인’에 비유하여 이르는 말. 일정한 직업을 잡아 직장을 구한 사람들을 가리키는 ‘취업 인류’에 상대하여 이르는 말이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2017-0073-c1 ;
    kno:component kno:KN2017-0073-c2 ;
    kno:componentString "독서실(讀書室), 원시인(原始人)"@ko ;
    kno:example "¶2011년 공기업 몇 군데에 지원했지만 모두 떨어졌다.…O 씨는 그렇게 ‘{독서실 원시인’으로} 돌아왔다."@ko ;
    kno:frequency kno:KN2017-0073-freq-NN-2017 ;
    kno:frequency kno:KN2017-0073-freq-NN-total ;
