# KN2017-0078 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0078 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "디지털 성범죄"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1389932> ;
    skos:definition "카메라나 인터넷 같은 디지털 매체를 이용한 성범죄. 예를 들어 몰래 카메라로 타인의 모습을 찍어 인터넷에 유포하는 행위 따위가 있다."@ko ;
    kno:activeYears "10"^^xsd:integer ;
    kno:component kno:KN2017-0078-c1 ;
    kno:component kno:KN2017-0078-c2 ;
    kno:componentString "디지털(digital), 성범죄(性犯罪)"@ko ;
    kno:example "¶O 의원은…“{디지털 성범죄는} 기록이 남는다는 점에서 피해자의 고통이 매우 크기 때문에 엄정한 처벌이 필요하다.”라며 입법 취지를 강조했다."@ko ;
