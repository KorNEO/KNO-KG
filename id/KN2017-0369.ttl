# KN2017-0369 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0369 kno:languageType "덴+고" ;
    kno:origin "(<덴>hygge스럽다)" ;
    kno:slotFiller "휘게(hygge) (1성분)"@ko ;
    kno:formation kno:W02 ;
    kno:instantiates kno:S001167 ;
    kno:example "¶달달한 케이크와 차만 있으면 그곳이 어디든 {휘게스러운} 공간이 된다."@ko ;
