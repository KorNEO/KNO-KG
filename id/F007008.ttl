# F007008 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F007008 kno:semanticTag kno:usas-A1.1.2 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1272671> ;
    kno:urimalDefinition "단순한 부정이나 파괴가 아니라 토대를 흔들어 새로운 가능성을 탐색하고 숨겨져 있는 의미와 성질을 발견함. 서양 형이상학의 종말을 지향하려는 후기 구조주의의 목적을 위하여 제창된 것으로, 데리다의 용어이다. 〔명사〕"@ko ;
    kno:urimalTargetCode "1272671" ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:label "해체론(解體論)"@ko ;
    kno:origin "解體論" ;
    kno:truncated "false"^^xsd:boolean ;
    kno:surfaceForm "해체론"@ko ;
    a kno:Formative ;
    kno:fullForm "해체론"@ko ;
    kno:registration "우리말샘"@ko .
