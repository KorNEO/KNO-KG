# KN2023-0071 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0071 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "누칼협"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%88%84%EC%B9%BC%ED%98%91> ;
    skos:definition "‘누가 칼로 협박했느냐’를 줄여 이르는 말. 누군가가 고충을 토로할 때 그에 대한 책임이 그 일을 선택한 개인에게 있다고 주장할 때 사용한다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2023-0071-c1 ;
