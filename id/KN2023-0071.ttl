@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2023-0071 a ontolex:Word ;
    frac:attestation kno:KN2023-0071-att-nn ;
    ontolex:canonicalForm kno:KN2023-0071-form ;
    ontolex:sense kno:KN2023-0071-sense .

kno:KN2023-0071-att-nn a frac:Attestation ;
    dcterms:date "2022-09-04"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/047/0002365059> .

kno:KN2023-0071-form a ontolex:Form ;
    frac:frequency kno:KN2023-0071-freq-nn,
        kno:KN2023-0071-freq-yt ;
    ontolex:writtenRep "누칼협"@ko .

kno:KN2023-0071-freq-nn a frac:CorpusFrequency ;
    rdf:value 477 ;
    frac:corpus kno:corpus-NN .

kno:KN2023-0071-freq-yt a frac:CorpusFrequency ;
    rdf:value 14025 ;
    frac:corpus kno:corpus-YT .

kno:KN2023-0071-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%88%84%EA%B0%80%20%EC%B9%BC%EB%93%A4%EA%B3%A0%20%ED%98%91%EB%B0%95%ED%95%A8%3F> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

