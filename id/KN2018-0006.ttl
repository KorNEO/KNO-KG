    kno:lastAttestationYear "2018"^^xsd:gYear ;
    kno:year "2018"^^xsd:gYear ;
    rdfs:label "각시탈리즘"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B0%81%EC%8B%9C%ED%83%88%EB%A6%AC%EC%A6%98> ;
