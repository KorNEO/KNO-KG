# KN2018-0047 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0047 kno:pos "「명」"@ko ;
    skos:definition "사람들에게 좋은 평가를 받는 양조원에서 양질의 포도로 잘 만든 고급 포도주. ‘좋은’을 뜻하는 ‘굿(good)’과 ‘포도가 풍작인 해에 정평 있는 양조원에서 양질의 포도로 만든 고급 포도주’를 뜻하는 ‘빈티지(vintage)’를 결합하여 만든 말이다."@ko ;
    kno:origin "(<영>▼good←vintage)" ;
    kno:formation kno:W05 ;
    a kno:Neologism ;
    kno:indexForm "굿빈"@ko ;
    kno:example "¶{굿빈은} ‘굿 빈티지’, 망빈은 안 좋았던 해를 빗댄 표현인 ‘망한 빈티지’란 뜻이다."@ko ;
    kno:instantiates kno:S001238 ;
    kno:component kno:KN2018-0047-c1 ;
    kno:componentString "굿(good), 빈(티지)(vintage)"@ko ;
    kno:component kno:KN2018-0047-c2 ;
    kno:activeYears "0"^^xsd:integer ;
    rdfs:label "굿빈"@ko ;
    a ontolex:Word ;
    kno:year "2018"^^xsd:gYear ;
    kno:instantiates kno:S000907 ;
    kno:languageType "영+영" ;
    kno:slotFiller "빈(티지)(vintage) (1성분)"@ko ;
    kno:unitType "단어"@ko ;
    kno:slotFiller "굿(good) (1성분)"@ko ;
