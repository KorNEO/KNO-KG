# KN2024-0328 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0328 kno:activeYears "2"^^xsd:integer ;
    skos:definition "직업 안정성이 높고 급여나 복지 등의 처우가 좋은 공무직 또는 대기업 사무직을 비유적으로 이르는 말. 왕을 의미하는 ‘킹(king)’과 ‘사무직(事務職)’을 결합하여 만든 말이다."@ko ;
    kno:formation kno:W05 ;
    kno:component kno:KN2024-0328-c2 ;
