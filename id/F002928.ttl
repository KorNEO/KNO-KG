# F002928 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002928 a kno:Formative ;
    kno:fullForm "대주"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:surfaceForm "대주"@ko ;
    kno:urimalDefinition "증권 회사가 신용 거래를 통해 고객에게 주식을 대여하는 일. 또는 그 주식. 고객은 높은 가격에서 주식을 빌려 매각한 뒤, 가격이 내렸을 때 그 수량만큼의 주식을 사서 갚음으로써 시세 차익을 얻으려는 것이다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalTargetCode "528442" ;
    rdfs:label "대주(貸株)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=528442> ;
    kno:origin "貸株" ;
    kno:semanticTag kno:usas-I1.2 .
kno:KN2021-0013-c2 kno:formative kno:F002928 .
