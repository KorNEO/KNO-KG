# KN2015-0260 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0260 a kno:Neologism ;
    kno:frequency kno:KN2015-0260-freq-NN-2015 ;
    kno:example "¶특허권자인 다국적 제약 회사는 {허특법을} 통해 높은 약값을 유지하며 제네릭약을 견제할 수 있다."@ko ;
    kno:unitType "단어"@ko ;
    kno:componentString "허(가)(許), 특(허)(特), 법(法)"@ko ;
    kno:instantiates kno:S000015 ;
