@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2025-0380 a ontolex:Word ;
    frac:attestation kno:KN2025-0380-att-nn ;
    ontolex:canonicalForm kno:KN2025-0380-form ;
    ontolex:sense kno:KN2025-0380-sense .

kno:KN2025-0380-att-nn a frac:Attestation ;
    dcterms:date "2025-08-28"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/023/0003925922> .

kno:KN2025-0380-form a ontolex:Form ;
    frac:frequency kno:KN2025-0380-freq-nn,
        kno:KN2025-0380-freq-yt ;
    ontolex:writtenRep "실압근"@ko .

kno:KN2025-0380-freq-nn a frac:CorpusFrequency ;
    rdf:value 25 ;
    frac:corpus kno:corpus-NN .

kno:KN2025-0380-freq-yt a frac:CorpusFrequency ;
    rdf:value 2078 ;
    frac:corpus kno:corpus-YT .

kno:KN2025-0380-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EB%82%B4%EC%9E%A5%ED%98%95%20%EA%B7%BC%EC%9C%A1> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

