# F007085 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F007085 kno:urimalTargetCode "1386326" ;
    kno:truncated "true"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1386326> ;
