# F003115 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003115 a kno:Formative ;
    rdfs:label "땀"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "사람의 피부나 동물의 살가죽에서 나오는 찝찔한 액체. 염분·지방산·요소 따위가 있어 특유한 냄새가 나는데, 주로 날씨가 덥거나 운동을 하거나 긴장을 하거나 병으로 몸에서 열이 날 때 분비된다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-B1 ;
    kno:fullForm "땀"@ko ;
    kno:urimalTargetCode "514672" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=514672> ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "땀"@ko .
kno:KN2013-0302-c2 kno:formative kno:F003115 .
