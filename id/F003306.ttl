# F003306 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003306 kno:truncated "true"^^xsd:boolean ;
    a kno:Formative ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A6%AC%EC%96%B4%ED%8A%B8> ;
    kno:parallelFullForm kno:LEX-패트리어트 ;
    kno:fullFormLexeme kno:LEX-패트리어트 ;
    kno:surfaceForm "리어트"@ko ;
    kno:semanticTag kno:usas-Z3 ;
    kno:fullForm "패트리어트"@ko ;
    kno:urimalDefinition "북부 하이부시 블루베리 품종의 하나. 수세가 강하고 개장성이며 다소 직립성을 가진다. 다산성으로 내한성이 매우 강하고, 과습에도 상대적으로 저항성을 가진다. 중간 정도의 청색 과실이 조밀한 과방 형태로 달리는데 과병흔이 적고 향이 우수하다. 봄에는 다량의 하얀 꽃이 피고 여름에는 짙은 녹색의 잎이 달린다. 오렌지와 적색의 가을 단풍색이 아름다워 과실뿐만 아니라 화훼용으로도 적합하다. ⇒규범 표기는 ‘패트리엇’이다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-G3 ;
    kno:urimalTargetCode "1180213" ;
    rdfs:label "(패트)리어트(patriot)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1180213> ;
    kno:registration "우리말샘"@ko ;
    kno:origin "patriot" .
