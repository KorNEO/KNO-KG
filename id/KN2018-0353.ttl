# KN2018-0353 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0353 kno:instantiates kno:S000097 ;
    kno:lastAttestationYear "2018"^^xsd:gYear ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%85%8C%EB%8D%94%EC%87%BC%ED%81%AC> ;
    kno:pos "「구」"@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:indexForm "테더쇼크"@ko ;
    a ontolex:MultiwordExpression ;
    kno:component kno:KN2018-0353-c1 ;
    skos:definition "달러와 연동된 가상 화폐를 거래하는 한 업체가 가상 화폐의 시세를 조작했다는 의혹으로 사람들이 받은 충격을 이르는 말. 해당 업체들은 투자자들에게 가치가 없는 가상 화폐를 소개하고 거래 업체의 가상 화폐로 교환하여 투자하도록 유도하는 방식을 통해 시세를 조작했다는 혐의를 받았으며, 이로 인해 국내외의 가상 화폐의 가치가 급격히 떨어졌다. ⇒규범 표기는 미확정이다."@ko ;
    kno:registration "신어DB"@ko ;
    kno:componentString "테더(tether), 쇼크(shock)"@ko ;
    kno:example "¶이처럼 가상 화폐 시세가 폭락한 것은 국내를 비롯한 세계 곳곳에서 강경한 규제책들이 나오고 있는 데다 ‘{테더 쇼크’가} 겹쳤기 때문인 것으로 풀이된다."@ko ;
    kno:unitType "구"@ko ;
