    kno:registration "신어DB"@ko ;
    kno:formation kno:W07 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A7%88%EA%B0%80%EB%85%B8%EB%AF%B9%EC%8A%A4> ;
