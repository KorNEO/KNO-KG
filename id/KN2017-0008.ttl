# KN2017-0008 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0008 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "개-사이다"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B0%9C%EC%82%AC%EC%9D%B4%EB%8B%A4> ;
    skos:definition "답답한 상황을 매우 속 시원하게 해결해 주는 사람이나 상황을 속되게 이르는 말."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2017-0008-c1 ;
    kno:component kno:KN2017-0008-c2 ;
    kno:componentString "개, 사이다(cider)"@ko ;
    kno:example "¶OOO은 “‘{개사이다’는} 시적이고 아름다운 단어다. 직접적으로 개랑도 관련 없고, 직접적으로 청량음료랑도 관련 없다. 그런데 내 머릿속에 두 가지를 옆에 놓는 순간 모든 대한민국 사람들이 알아듣는 아주 시원한 기분이 생긴다.”라고 말했다."@ko ;
    kno:formation kno:W01 ;
