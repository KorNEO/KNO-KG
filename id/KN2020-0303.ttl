kno:KN2020-0303 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "전자^수행^추적^시스템"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A0%84%EC%9E%90%EC%88%98%ED%96%89%EC%B6%94%EC%A0%81%EC%8B%9C%EC%8A%A4%ED%85%9C> ;
    skos:definition "지피에스와 영상분석 기법을 이용해 운동선수들의 이동 경로 및 이동량 따위의 정보를 파악함으로써 선수 관리에 대한 데이터를 생성하는 시스템."@ko ;
    kno:activeYears "2"^^xsd:integer ;
