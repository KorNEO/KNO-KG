# KN2014-0151 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0151 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "소금-남"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1383568> ;
    skos:definition "피부가 희고 쌍꺼풀이 없으며 큰 키에 마른 몸매를 지녀 여린 소년의 느낌을 주는 남자. 소금처럼 하얗고 담백한 느낌을 주는 남자를 이른다."@ko ;
    kno:activeYears "8"^^xsd:integer ;
    kno:component kno:KN2014-0151-c1 ;
    kno:component kno:KN2014-0151-c2 ;
    kno:componentString "소금, -남(男)"@ko ;
    kno:example "¶OOO은 ‘{소금남’에} 완벽 부합하는 비주얼을 자랑하며 극 중 OOO과 OOO의 각 선 대립 속에 유들유들한 캐릭터로 OO에 생기를 불어 넣고 있다."@ko ;
