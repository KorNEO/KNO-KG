# KN2016-0188 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0188 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "바람웃도"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B0%94%EB%9E%8C%EC%9B%83%EB%8F%84> ;
    skos:definition "‘바람이 불어오는 쪽에 앉은 신’이라는 뜻으로, 제주도 신화에서 바람과 비를 관장하는 신을 이르는 말."@ko ;
