# KN2018-0167 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0167 a ontolex:MultiwordExpression ;
    kno:registration "신어DB"@ko ;
    kno:frequency kno:KN2018-0167-freq-NN-2018 ;
    kno:activeYears "2"^^xsd:integer ;
    kno:indexForm "사무직공장"@ko ;
    kno:pos "「구」"@ko ;
    kno:year "2018"^^xsd:gYear ;
    kno:componentString "사무직(事務職), 공장(工場)"@ko ;
    kno:frequency kno:KN2018-0167-freq-NN-total ;
    kno:unitType "구"@ko ;
    kno:example "¶이번엔 ‘{사무직 공장’이라} 불리는 노동 현장, 콜센터입니다. 70~80㎝ 간격의 좁은 칸막이 사이에 앉아 종일 전화를 받는 상담원들의 삶이, 밀려드는 부품을 꾸역꾸역 조립하는 공장 노동자와 다를 바 없습니다."@ko ;
    a kno:Neologism ;
    kno:component kno:KN2018-0167-c1 ;
    rdfs:label "사무직 공장"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%82%AC%EB%AC%B4%EC%A7%81%20%EA%B3%B5%EC%9E%A5> ;
    kno:frequency kno:KN2018-0167-freq-NN-2023 ;
    kno:component kno:KN2018-0167-c2 ;
    kno:languageType "한_한" ;
    kno:origin "(事務職工場)" ;
    kno:lastAttestationYear "2023"^^xsd:gYear ;
    skos:definition "사무직 직원인 콜센터 근로자들의 일하는 모습이 공장에서 일하는 노동자의 모습과 비슷하고, 좁은 칸막이로 되어 있는 콜센터 사무실의 구조와 근로 환경이 공장과 유사한 것을 두고, 콜센터 사무실을 공장에 빗대어 이르는 말."@ko .
