# KN2022-0090 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0090 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "내손내산"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%82%B4%EC%86%90%EB%82%B4%EC%82%B0> ;
    skos:definition "‘내 손으로 내가 삼’을 줄여 이르는 말. 주로 물건을 소개하는 상황에서, 광고가 아니라 내 손으로 내가 직접 산 물건임을 나타내기 위해 사용하는 말이다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2022-0090-c1 ;
