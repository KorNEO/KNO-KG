# KN2019-0235 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0235 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "자해계"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9E%90%ED%95%B4%EA%B3%84> ;
    skos:definition "자해한 상처를 찍은 사진이나 자해할 정도로 우울한 감정을 표현한 글 따위를 게시하기 위해 만든 계정. 주로 누리 소통망 서비스(SNS)에서, 일상적으로 이용하는 계정은 따로 두고 자해와 관련된 내용만을 게시하기 위해 비밀스럽게 운영하는 계정이다."@ko ;
    kno:activeYears "8"^^xsd:integer ;
    kno:component kno:KN2019-0235-c1 ;
    kno:component kno:KN2019-0235-c2 ;
    kno:componentString "자해(自害), 계(정)(計)"@ko ;
    kno:example "¶OOO 씨는 입원 치료를 받으면서 그린 그림과 자해 사진을 OO에 올렸다.…{자해계를} 만든 지 4개월 만에 팔로워가 2천 명이 훌쩍 넘었다."@ko ;
