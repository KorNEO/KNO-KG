# KN2019-0295 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0295 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "편디-족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1438001> ;
    skos:definition "편의점에서 판매하는 디저트를 즐겨 먹는 사람. 또는 그런 무리."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:component kno:KN2019-0295-c1 ;
