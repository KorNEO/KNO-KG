    kno:languageType "한_한" ;
    kno:activeYears "1"^^xsd:integer ;
    skos:definition "(LLM) 친근하고 살갑게 챙기면서도 말투나 행동이 다소 직설적이고 주도적인, 중년 여성 친척(고모) 같은 분위기나 성향."@ko ;
