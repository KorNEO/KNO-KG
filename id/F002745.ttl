# F002745 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002745 kno:surfaceForm "네수엘라"@ko ;
    kno:semanticTag kno:usas-Z2 ;
    kno:fullFormLexeme kno:LEX-베네수엘라 ;
    kno:urimalTargetCode "349819" ;
    kno:origin "venezuela" ;
    kno:urimalDefinition "남아메리카 대륙 북부에 있는 공화국. 에스파냐의 식민지였으나 독립 전쟁을 일으켜 1819년에 대콜롬비아 연방을 수립하고 1830년에 독립 공화국이 되었다. 세계적인 산유국이고 금·커피·코코아·목화·사탕수수 따위가 많이 나며, 주민은 메스티소로 대부분 가톨릭교도이고 주요 언어는 에스파냐어이다. 수도는 카라카스, 면적은 91만 2050㎢. 〔명사〕"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%84%A4%EC%88%98%EC%97%98%EB%9D%BC> ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=349819> ;
    rdfs:label "(베)네수엘라(Venezuela)"@ko ;
    a kno:Formative ;
