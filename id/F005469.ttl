# F005469 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F005469 kno:fullFormLexeme kno:LEX-마일리지 ;
    kno:surfaceForm "일리지"@ko ;
    kno:parallelFullForm kno:LEX-마일리지 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9D%BC%EB%A6%AC%EC%A7%80> ;
