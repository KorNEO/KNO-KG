    kno:urimalTargetCode "597407" ;
    kno:caseCount "1"^^xsd:integer ;
    a kno:Formative ;
    kno:urimalDefinition "고정 고객 확보를 위한 기업의 판매 촉진 프로그램. 고객은 이용 실적에 따라 점수를 획득하는데 누적된 점수는 화폐의 기능을 한다. 항공사에서 시작되어 근래에는 신용 카드사, 통신 회사 따위에서도 고객을 데려올 목적으로 이용하고 있다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "마일리지"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    rdfs:label "(마)일리지(mileage)"@ko ;
    kno:semanticTag kno:usas-I1 .
