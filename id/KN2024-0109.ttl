# KN2024-0109 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0109 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "빵^서기관"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B9%B5%EC%84%9C%EA%B8%B0%EA%B4%80> ;
    skos:definition "빵의 가격을 관리하는 담당자. 물가 체감도가 높은 빵, 우유, 과자, 커피, 라면, 아이스크림, 설탕, 식용유, 밀가루 등 9개 품목을 집중 관리 대상으로 선정하고, 서기관이나 사무관급 담당자를 지정한데서 온 말이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2024-0109-c1 ;
    kno:component kno:KN2024-0109-c2 ;
    kno:componentString "빵, 서기관(書記官)"@ko ;
    kno:example "¶정부가 {빵 서기관을} 지정하여 빵 가격을 잡겠다고 하였으나 널뛰는 물가를 잡기에는 역부족이라는 지적이 나오고 있다."@ko ;
    kno:frequency kno:KN2024-0109-freq-NN-2023 ;
