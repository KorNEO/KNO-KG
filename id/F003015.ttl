# F003015 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003015 kno:semanticTag kno:usas-Z2 ;
    kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "강원특별자치도 속초시 동쪽에 있는 동. 국제 여객선 터미널, 시외버스 터미널이 있어 교통이 편리하다. 춘천 지방 법원 속초 지원 등의 관공서가 들어서 있으며, 관광 명소로 영금정, 동명항 등이 있다. 면적은 0.79㎢. 〔명사〕"@ko ;
    kno:fullFormLexeme kno:LEX-동명동 ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8F%99> ;
    kno:origin "東" ;
    kno:caseCount "1"^^xsd:integer ;
