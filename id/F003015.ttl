    kno:fullForm "동명동"@ko ;
    kno:urimalTargetCode "1388989" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1388989> ;
    kno:truncated "true"^^xsd:boolean ;
    kno:surfaceForm "동"@ko ;
    a kno:Formative ;
