# KN2018-0010 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0010 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "갑질 출장"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B0%91%EC%A7%88%20%EC%B6%9C%EC%9E%A5> ;
    skos:definition "출장 시 지나친 의전을 요구하거나, 출장비 명목의 지원금을 용무 외의 용도로 사용하는 것을 이르는 말."@ko ;
