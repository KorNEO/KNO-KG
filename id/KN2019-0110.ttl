# KN2019-0110 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0110 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "믿거"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1425221> ;
    skos:definition "‘믿고 거르다’를 줄여 이르는 말. 어떤 것을 선택할 때 기본적인 조건에 맞지 않아 가장 먼저 제외하는 것을 이른다."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2019-0110-c1 ;
    kno:component kno:KN2019-0110-c2 ;
    kno:componentString "믿(다), 거(르다)"@ko ;
    kno:example "¶게임을 ‘누가 만들었느냐’는 게임을 선택할 때 큰 영향을 주는 요소입니다. 개발자가 누구냐에 따라 기대작이 되기도 하고, ‘{믿거}’ 게임이 되기도 하거든요."@ko ;
    kno:formation kno:W06 ;
    kno:indexForm "믿거"@ko ;
    kno:languageType "고+고" ;
    kno:pos "「명」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:unitType "단어"@ko ;
    kno:urimalTargetCode "1425221" ;
    kno:year "2019"^^xsd:gYear .
