# KN2021-0262 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0262 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "캐해"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1666902> ;
    skos:definition "‘캐릭터 해석’을 줄여 이르는 말. 특정 인물의 성격이나 표정, 말투, 행동 특성 따위를 자세하게 파악하여 앞으로 어떻게 행동할지 예측하는 것을 이르는 말이다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2021-0262-c1 ;
    kno:component kno:KN2021-0262-c2 ;
    kno:componentString "캐(릭터)(character), 해(석)(解釋)"@ko ;
    kno:example "¶‘{캐해’는} 영화나 드라마 속 등장인물뿐만이 아니라, 자신이 좋아하는 연예인 등을 대상으로도 활발하게 이뤄진다."@ko ;
    kno:formation kno:W06 ;
