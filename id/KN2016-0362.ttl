# KN2016-0362 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0362 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "양맺기^문화"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%96%91%EB%A7%BA%EA%B8%B0%EB%AC%B8%ED%99%94> ;
    skos:definition "학교 선후배 사이에서 양언니나 양오빠 관계를 맺는 문화. 선배와 후배가 서로 짝을 맺고, 선배가 후배를 돌보아 주고자 하는 취지로 시작되었으나 학교 폭력으로 변질되고 있다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2016-0362-c1 ;
    kno:component kno:KN2016-0362-c2 ;
    kno:component kno:KN2016-0362-c3 ;
    kno:component kno:KN2016-0362-c4 ;
    kno:componentString "양(養), 맺(다), -기, 문화(文化)"@ko ;
    kno:example "¶{양맺기 문화는} 선ㆍ후배 사이에서 양언니, 양오빠 관계를 맺고 선배가 후배 뒤를 봐주고, 후배는 선물로 보답하는 취지로 시작됐다."@ko ;
    kno:frequency kno:KN2016-0362-freq-NN-2016 ;
