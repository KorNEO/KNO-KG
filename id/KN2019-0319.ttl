# KN2019-0319 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0319 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "학폭투"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%95%99%ED%8F%AD%ED%88%AC> ;
    skos:definition "학교 폭력 피해 경험을 밝혀, 학교 폭력 문제의 심각성을 알림. 또는 그런 활동을 하는 운동. ‘학교 폭력’과 ‘나도 당했음’을 뜻하는 ‘미 투(me too)’를 결합하여 만든 말이다. ⇒규범 표기는 미확정이다. =학투."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2019-0319-c1 ;
    kno:component kno:KN2019-0319-c2 ;
    kno:componentString "학폭(學暴), (미)투(me-too)"@ko ;
    kno:example "¶{‘학폭투’라는} 현상의 이면에는 이러한 학교 폭력의 보편성과 잔인성의 심각함이 자리해 있다."@ko ;
