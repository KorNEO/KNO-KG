# F006838 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006838 kno:caseCount "1"^^xsd:integer ;
    kno:semanticTag kno:usas-W5p ;
    kno:truncated "false"^^xsd:boolean ;
    kno:origin "plugging" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=683894> ;
    kno:urimalDefinition "직류 전동기에 가해지는 직류 전압의 극성을 바꾸거나 교류 전동기에 가해지는 교류 전압의 상(相) 순서를 바꾸어 제동 토크를 발생시켜서 전동기의 속도를 줄이는 제동 방식. 이때 발생하는 제동 토크는 역방향 토크이므로, 속도가 영(0)이 되었을 때 전원을 차단하지 않으면 전동기가 반대 방향으로 회전한다. ⇒규범 표기는 미확정이다. 〔명사〕"@ko ;
    kno:fullForm "플러깅"@ko ;
    kno:surfaceForm "플러깅"@ko ;
    rdfs:label "플러깅(plugging)"@ko ;
    kno:registration "우리말샘"@ko ;
    a kno:Formative ;
    kno:urimalTargetCode "683894" .
kno:KN2025-0651-c1 kno:formative kno:F006838 .
