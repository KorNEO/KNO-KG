# KN2021-0285 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0285 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "폰꾸"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1516691> ;
    skos:definition "‘폰 꾸미기’를 줄여 이르는 말. 휴대 전화에 스티커를 붙이거나 전용 액세서리를 부착하는 등으로 휴대 전화를 장식하는 행위를 이르는 말이다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2021-0285-c1 ;
    kno:component kno:KN2021-0285-c2 ;
    kno:componentString "폰(phone), 꾸(미다)"@ko ;
    kno:example "¶OO은 새로운 스마트폰 출시를 맞아 다양한 액세서리도 함께 선보이며 {폰꾸에} 적극적인 젊은 층을 공략하고 있다."@ko ;
