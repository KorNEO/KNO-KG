# KN2023-0105 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2023-0105 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "반도체^산업^강화법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B0%98%EB%8F%84%EC%B2%B4%EC%82%B0%EC%97%85%EA%B0%95%ED%99%94%EB%B2%95> ;
    skos:definition "반도체 투자 활성화를 위하여 반도체 투자에 대한 세제 혜택을 주고자 제정한 법률. 대기업의 반도체 설비 투자 세액 공제율을 기존의 8%에서 15%로, 중소기업은 16%에서 25%까지 상향하는 것을 내용으로 한다."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2023-0105-c1 ;
    kno:component kno:KN2023-0105-c2 ;
    kno:component kno:KN2023-0105-c3 ;
    kno:componentString "반도체(半導體), 산업(産業), 강화법(強化法)"@ko ;
    kno:example "¶{반도체 산업 강화법에} 대하여 법안 취지에 대해서는 일부 공감하면서도 대기업을 위한 특혜 법안이 될 수 있다는 이유로 반대하고 있다."@ko ;
