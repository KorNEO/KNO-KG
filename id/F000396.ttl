# F000396 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000396 kno:urimalTargetCode "19699" ;
    kno:registration "우리말샘"@ko ;
    kno:caseCount "5"^^xsd:integer ;
    kno:urimalDefinition "행성의 인력에 의하여 그 둘레를 도는 천체. 지구, 화성, 목성, 토성, 천왕성, 해왕성에 있으며 태양계에는 160개가 넘는 위성이 알려져 있다. 대표적으로 지구에는 달이 있다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-W1 ;
    kno:surfaceForm "위성"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=19699> ;
    kno:truncated "false"^^xsd:boolean ;
    kno:origin "衛星" ;
    kno:fullForm "위성"@ko ;
    rdfs:label "위성(衛星)"@ko ;
    a kno:Formative .
