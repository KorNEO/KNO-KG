@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0353 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2020-0353-att-nn ;
    ontolex:canonicalForm kno:KN2020-0353-form ;
    ontolex:sense kno:KN2020-0353-sense .

kno:KN2020-0353-att-nn a frac:Attestation ;
    dcterms:date "2020-03-13"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/009/0004535905> .

kno:KN2020-0353-form a ontolex:Form ;
    frac:frequency kno:KN2020-0353-freq-nn,
        kno:KN2020-0353-freq-yt ;
    ontolex:writtenRep "코로나 이혼"@ko .

kno:KN2020-0353-freq-nn a frac:CorpusFrequency ;
    rdf:value 154 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0353-freq-yt a frac:CorpusFrequency ;
    rdf:value 12 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0353-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%BD%94%EB%A1%9C%EB%82%98%20%EC%9D%B4%ED%98%BC> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

