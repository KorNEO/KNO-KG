# KN2017-0084 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0084 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "랜선 집사"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1382495> ;
    skos:definition "고양이를 직접 키우지는 않지만 온라인상에서 고양이의 사진이나 동영상을 보고 귀엽게 여기는 사람을 비유적으로 이르는 말."@ko ;
    kno:activeYears "9"^^xsd:integer ;
    kno:component kno:KN2017-0084-c1 ;
    kno:component kno:KN2017-0084-c2 ;
    kno:component kno:KN2017-0084-c3 ;
    kno:componentString "랜(LAN), 선(線), 집사(執事)"@ko ;
    kno:example "¶{랜선 집사임을} 자부하는 구독자들은 “우리 OO이 살이 너무 빠진 것 아닌가?” 등으로 마치 자기 고양이인 양 관심을 표현하고 “광고를 중간에 넘기지 않고 끝까지 다 볼 테니 광고 수익이 나면 애들 간식을 사 먹여 달라.” 등의 요청을 댓글로 남긴다."@ko ;
    kno:frequency kno:KN2017-0084-freq-NN-2017 ;
    kno:frequency kno:KN2017-0084-freq-NN-2018 ;
    kno:frequency kno:KN2017-0084-freq-NN-2019 ;
