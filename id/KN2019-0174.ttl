kno:KN2019-0174 rdfs:label "스텔스자라니족"@ko ;
    kno:componentString "스텔스(stealth), 자(전거)(自), (고)라니, -족(族)"@ko ;
    kno:unitType "구"@ko ;
    kno:frequency kno:KN2019-0174-freq-NN-total ;
