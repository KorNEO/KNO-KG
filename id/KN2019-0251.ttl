# KN2019-0251 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0251 kno:component kno:KN2019-0251-c1 ;
    kno:languageType "(고+한)^한" ;
    kno:instantiates kno:S000002 ;
    kno:example "¶반면 신세대는 가맹점 큐아르(QR) 코드를 스마트폰으로 찍거나 본인의 스마트폰에 내장된 큐아르(QR) 코드를 가맹점 단말기로 찍게 한다. 중국을 휩쓰는 이른바 {‘찍결 세대’의} 등장이다."@ko ;
    kno:pos "「구」"@ko ;
    skos:definition "스마트폰을 이용해 정보 무늬(QR code) 따위를 찍어 상품의 값을 치르는 세대. ‘찍결’은 ‘찍어서 결제’를 줄여 이르는 말이다."@ko ;
    a ontolex:MultiwordExpression ;
    kno:year "2019"^^xsd:gYear ;
    kno:slotFiller "찍(다)+결(제)(決) (2성분)"@ko ;
