# KN2022-0304 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0304 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "해치 펫트롤"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%95%B4%EC%B9%98%20%ED%8E%AB%ED%8A%B8%EB%A1%A4> ;
    skos:definition "사고가 나지 않도록 반려견과 함께 여러 곳 을 돌아다니며 동네를 살피는 목적으로 조직된 순찰대. 주민이 반려견의 산책과 더불어 거주지 근처의 위험 요소를 파악하는 정책으로 서울시 자치 경찰 위원회가 2022년 5월부터 6월까지 시범 운영하였다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2022-0304-c1 ;
    kno:component kno:KN2022-0304-c2 ;
    kno:component kno:KN2022-0304-c3 ;
    kno:componentString "해치(獬豸), 펫(pet), (파)트롤(patrol)"@ko ;
    kno:example "¶서울시 자치 경찰 위원회는 지역 방법 순찰대인 ‘{해치 펫트롤’을} 모집 중이다."@ko ;
    kno:frequency kno:KN2022-0304-freq-NN-2022 ;
