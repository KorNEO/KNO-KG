# KN2016-0292 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0292 a ontolex:MultiwordExpression ;
    kno:example "¶최근 온라인 커뮤니티를 중심으로 이른바 ‘{수저 인증’을} 즐기는 이들이 확산되고 있다."@ko ;
    kno:frequency kno:KN2016-0292-freq-NN-2022 ;
    kno:frequency kno:KN2016-0292-freq-NN-total ;
    kno:origin "(수저認證)" ;
    kno:registration "우리말샘"@ko ;
    kno:component kno:KN2016-0292-c2 ;
    kno:unitType "구"@ko ;
    kno:indexForm "수저인증"@ko ;
    a kno:Neologism ;
    skos:definition "부모의 지위, 재산, 직업 따위에 따라서 금수저, 은수저, 흙수저 등으로 사회 계급을 나누었을 때, 자신이 어떤 계급에 속하는지를 증명함. 또는 그런 일. 온라인 커뮤니티나 누리 소통망 서비스(SNS) 따위에 좋은 환경과 조건을 가진 ‘금수저’임을 과시하거나, 부모로부터 경제적 도움을 받지 못하는 ‘흙수저’임을 인증하는 자조적인 글을 게시한다."@ko ;
    rdfs:label "수저 인증"@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:frequency kno:KN2016-0292-freq-NN-2023 ;
