# F006582 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006582 kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    kno:urimalDefinition "지방 자치 단체의 하나. 광역 자치 단체로 정부가 직접 관할하며 법률에 의거하여 자치권이 보장된 도(道) 단위의 행정 구역이다. 현재의 강원도, 전라북도, 제주도가 이에 해당한다. 〔명사〕"@ko ;
    kno:origin "特別自治道" ;
    kno:fullForm "특별자치도"@ko ;
    rdfs:label "특별자치도(特別自治道)"@ko ;
    kno:surfaceForm "특별자치도"@ko ;
    kno:semanticTag kno:usas-M7 ;
    kno:urimalTargetCode "925882" ;
    kno:caseCount "1"^^xsd:integer ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=925882> ;
    kno:registration "우리말샘"@ko .
kno:KN2024-0350-c2 kno:formative kno:F006582 .
