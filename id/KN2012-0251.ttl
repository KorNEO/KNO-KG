kno:KN2012-0251 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "썸녀"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1357089> ;
    skos:definition "실제로 사귀는 관계는 아니지만 서로 호감을 느끼는 관계의 여성."@ko ;
