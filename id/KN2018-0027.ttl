# KN2018-0027 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2018-0027 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "고도 가공식품"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1415807> ;
    skos:definition "농산물, 축산물, 수산물 따위의 원식자재를 공장에서 인공적으로 처리하여 만든 식품으로, 당분이나 염도가 높고 각종 첨가제가 많이 들어 있는 가공식품. 당분이나 소금의 함량이 높은 각종 과자류, 햄과 같은 가공육, 유통 기한이 긴 즉석식품 등이 이에 해당한다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2018-0027-c1 ;
    kno:component kno:KN2018-0027-c2 ;
    kno:componentString "고도(高度), 가공식품(加工食品)"@ko ;
    kno:example "¶각종 첨가물을 넣어 만든 ‘{고도 가공식품’을} 많이 먹을수록 암에 걸릴 위험이 커진다는 연구 결과가 나왔습니다."@ko ;
    kno:frequency kno:KN2018-0027-freq-NN-2018 ;
