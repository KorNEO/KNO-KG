@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2024-0177 a ontolex:Word ;
    frac:attestation kno:KN2024-0177-att-nn ;
    ontolex:canonicalForm kno:KN2024-0177-form ;
    ontolex:sense kno:KN2024-0177-sense .

kno:KN2024-0177-att-nn a frac:Attestation ;
    dcterms:date "2023-08-24"^^xsd:date ;
    frac:locus <https://m.entertain.naver.com/article/006/0000119487> .

kno:KN2024-0177-form a ontolex:Form ;
    frac:frequency kno:KN2024-0177-freq-nn,
        kno:KN2024-0177-freq-yt ;
    ontolex:writtenRep "엔시티피케이션"@ko .

kno:KN2024-0177-freq-nn a frac:CorpusFrequency ;
    rdf:value 31 ;
    frac:corpus kno:corpus-NN .

kno:KN2024-0177-freq-yt a frac:CorpusFrequency ;
    rdf:value 1 ;
    frac:corpus kno:corpus-YT .

kno:KN2024-0177-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%97%94%EC%8B%9C%ED%8B%B0%ED%94%BC%EC%BC%80%EC%9D%B4%EC%85%98> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

