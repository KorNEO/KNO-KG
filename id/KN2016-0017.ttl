# KN2016-0017 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0017 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "고용^디딤돌^제도"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372452> ;
    skos:definition "주로 청년들의 일자리 창출을 위해서 교육과 채용을 함께 진행하는 제도. 교육 과정과 인턴 과정을 단계적으로 진행해 취업을 알선하는 제도이다. 2015년에 고용노동부에서 추진한 제도이다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2016-0017-c1 ;
    kno:component kno:KN2016-0017-c2 ;
    kno:component kno:KN2016-0017-c3 ;
    kno:componentString "고용(雇用), 디딤돌, 제도(制度)"@ko ;
    kno:example "¶OO 그룹 관계자는 “이번 {고용 디딤돌 제도는} 별도로 설립된 공익 법인을 통해 사회적 책임을 이행하는 형태이기 때문에, 단발에 그치지 않고 지속성을 갖는 것이 특징.”이라고 설명했다."@ko ;
    kno:frequency kno:KN2016-0017-freq-NN-2015 ;
    kno:frequency kno:KN2016-0017-freq-NN-2016 ;
    kno:frequency kno:KN2016-0017-freq-NN-2017 ;
    kno:frequency kno:KN2016-0017-freq-NN-total ;
