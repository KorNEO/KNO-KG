# KN2021-0243 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0243 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "중수-청"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%A4%91%EC%88%98%EC%B2%AD> ;
    skos:definition "‘중대 범죄 수사청’을 줄여 이르는 말. 2021년 2월에 국회에서 ‘중대 범죄 수사청 설치 및 운영에 관한 법률안’이 발의되면서 ‘중대 범죄 수사청’을 새로 설치하는 방안이 제안되었다. 법안에 따르면, 중대 범죄에 대하여 기존 검찰이 가진 수사권을 ‘중대 범죄 수사청’이 이관받게 되고 검찰은 주로 공소의 업무를 맡아보게 된다."@ko ;
    kno:activeYears "6"^^xsd:integer ;
    kno:component kno:KN2021-0243-c1 ;
    kno:component kno:KN2021-0243-c2 ;
    kno:componentString "중수(重搜), -청(廳)"@ko ;
    kno:example "¶법안은 경제 범죄, 부패 범죄, 공직자 범죄, 선거 범죄, 방위 사업 범죄, 대형 참사 등 검찰 소관인 6대 범죄의 관련 수사권을 {중수청에} 이관하는 내용을 담고 있다."@ko ;
    kno:formation kno:W02 ;
