# KN2017-0244 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0244 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "젊꼰"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380808> ;
    skos:definition "‘젊은 꼰대’를 줄여 이르는 말. 자신의 생각이나 가치관을 타인에게 강요하는 젊은이를 속되게 이르는 말이다."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:component kno:KN2017-0244-c1 ;
    kno:component kno:KN2017-0244-c2 ;
    kno:componentString "젊(다), 꼰(대)"@ko ;
    kno:example "¶회사원 O 씨는 “입사 초반에 나이가 나보다 세 살 어린 선배가 다짜고짜 반말을 했다.”라며 “부당하다고 생각했는데 얼마 전 들어온 막내 직원에게 비슷한 행동을 하는 날 발견한 뒤 ‘나도 무의식중에 {젊꼰이} 될 수 있겠다.’라는 생각이 들었다.”라고 말했다."@ko ;
    kno:formation kno:W06 ;
    kno:indexForm "젊꼰"@ko ;
    kno:languageType "고+고" ;
    kno:pos "「명」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:unitType "단어"@ko ;
    kno:urimalTargetCode "1380808" ;
