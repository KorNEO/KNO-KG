@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2022-0169 a ontolex:Word ;
    frac:attestation kno:KN2022-0169-att-nn ;
    ontolex:canonicalForm kno:KN2022-0169-form ;
    ontolex:sense kno:KN2022-0169-sense .

kno:KN2022-0169-att-nn a frac:Attestation ;
    dcterms:date "2020-01-01"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/055/0000782370> .

kno:KN2022-0169-form a ontolex:Form ;
    frac:frequency kno:KN2022-0169-freq-nn,
        kno:KN2022-0169-freq-yt ;
    ontolex:writtenRep "사불"@ko .

kno:KN2022-0169-freq-nn a frac:CorpusFrequency ;
    rdf:value 27790 ;
    frac:corpus kno:corpus-NN .

kno:KN2022-0169-freq-yt a frac:CorpusFrequency ;
    rdf:value 21493 ;
    frac:corpus kno:corpus-YT .

kno:KN2022-0169-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EC%82%AC%EB%9E%91%EC%9D%98%20%EB%B6%88%EC%8B%9C%EC%B0%A9> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

