# KN2016-0325 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0325 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "실리콘바이유"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%8B%A4%EB%A6%AC%EC%BD%98%EB%B0%94%EC%9D%B4%EC%9C%A0> ;
    skos:definition "벤처를 창업하는 데 좋은 조건을 갖춘 뉴올리언스(New Orleans) 지역. 2005년 허리케인 카트리나에 의해 폐허가 된 곳에 새로운 창업 단지를 조성한 곳이다. 미국에서 실리콘 반도체를 제조하는 업체가 많이 모여 있는 지역을 가리키는 ‘실리콘 밸리’와 늪처럼 된 강의 내포 또는 지류를 의미하는 ‘바이유(bayou)’를 결합하여 만든 말이다. 미시시피 강 하류에 위치한 뉴올리언스에는 ‘바이유’가 많다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2016-0325-c1 ;
    kno:component kno:KN2016-0325-c2 ;
    kno:componentString "실리콘(밸리)(Silicon Valley), 바이유(bayou)"@ko ;
    kno:example "¶미 언론은 샌프란시스코, 뉴욕에 이어 미 스타트 업의 새로운 메카로 각광받는 뉴올리언스를 {실리콘바이유라} 부른다."@ko ;
    kno:formation kno:W05 ;
    kno:frequency kno:KN2016-0325-freq-NN-2015 ;
    kno:frequency kno:KN2016-0325-freq-NN-total ;
    kno:indexForm "실리콘바이유"@ko ;
