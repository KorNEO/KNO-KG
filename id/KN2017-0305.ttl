# KN2017-0305 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0305 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "팩트리어트"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380566> ;
    skos:definition "사실에 입각해 상대방이 감추고 싶어 하는 사실을 직설적으로 지적하는 행위. 또는 그런 사람. 사실을 뜻하는 ‘팩트(fact)’와 미사일의 한 종류인 ‘패트리엇 미사일(patriot missile)’의 비규범 형태인 ‘패트리어트 미사일’을 결합하여 만든 말이다. ⇒규범 표기는 미확정이다."@ko ;
    kno:activeYears "4"^^xsd:integer ;
    kno:component kno:KN2017-0305-c1 ;
