kno:KN2012-0328 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "월급 로그아웃"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1371339> ;
    skos:definition "인터넷 사이트에서 로그아웃을 하는 것처럼 통장에 들어온 월급이 순식간에 빠져나가는 것을 비유적으로 이르는 말."@ko ;
    kno:activeYears "5"^^xsd:integer ;
