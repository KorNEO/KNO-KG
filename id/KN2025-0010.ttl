# KN2025-0010 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2025-0010 kno:pos "「구」"@ko ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
    a kno:Neologism ;
    kno:component kno:KN2025-0010-c1 ;
    kno:componentString "LLM, 그루밍(grooming)"@ko ;
    kno:indexForm "LLM그루밍"@ko ;
    skos:definition "(LLM) 대형 언어 모델이 특정 주장이나 이해관계에 유리한 답을 내놓도록, 허위ㆍ편향 정보를 대량으로 생산ㆍ유포해 학습 데이터나 검색ㆍ요약 등 출력 결과를 왜곡하는 조작 행위."@ko ;
    a ontolex:MultiwordExpression ;
    kno:registration "신어DB"@ko ;
    kno:example "(LLM) 특정 단체가 기사와 게시물을 조직적으로 쏟아내 이런 정보가 학습ㆍ인용되면, 챗봇의 답변이 한쪽 주장으로 기울어지는 {LLM그루밍이} 발생할 수 있다."@ko ;
    kno:unitType "구"@ko ;
    kno:year "2025"^^xsd:gYear ;
    kno:component kno:KN2025-0010-c2 ;
