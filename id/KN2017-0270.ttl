    rdfs:label "치매 푸어"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380256> ;
    skos:definition "치매 환자를 돌보는 데 들어가는 비용으로 인하여 경제적으로 어려움을 겪는 사람. ⇒규범 표기는 미확정이다."@ko ;
