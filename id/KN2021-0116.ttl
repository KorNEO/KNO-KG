# KN2021-0116 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0116 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "뭐하회"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%AD%90%ED%95%98%ED%9A%8C> ;
    skos:definition "‘뭐 하는 회사야?’ 또는 ‘뭐라도 하겠지. 회사인데.’를 줄여 이르는 말. 주로 특정 회사의 주가 관련 정보를 다른 투자자에게 물어보고 답할 때 사용하는 말이다. ‘머하회’로 쓰기도 한다."@ko ;
