# KN2012-0368 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0368 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "장잉-정신"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1375844> ;
    skos:definition "많은 시간을 투자하여 사회적으로 의미 없다고 생각되는 일을 하려는 정신."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2012-0368-c1 ;
