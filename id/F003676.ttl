# F003676 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003676 rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B0%98> ;
    kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "상온에서 전기 전도율이 도체와 절연체의 중간 정도인 물질. 낮은 온도에서는 거의 전기가 통하지 않으나 높은 온도에서는 전기가 잘 통한다. 실리콘, 저마늄, 산화 이구리 따위가 있으며 정류기(整流器), 다이오드, 집적 회로, 트랜지스터 따위의 전자 소자에 널리 쓴다. 〔명사〕"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=532655> ;
    kno:parallelFullForm kno:LEX-반도체 ;
    kno:fullFormLexeme kno:LEX-반도체 ;
    kno:surfaceForm "반"@ko ;
    rdfs:label "반(도체)(半導體)"@ko ;
    a kno:Formative ;
    kno:origin "半導體" ;
    kno:semanticTag kno:usas-Y1 ;
    kno:fullForm "반도체"@ko ;
    kno:urimalTargetCode "532655" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:truncated "true"^^xsd:boolean .
kno:KN2023-0106-c1 kno:formative kno:F003676 .
