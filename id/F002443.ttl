# F002443 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002443 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=97763> ;
    kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "한시(漢詩) 따위에서 두 마디가 한 덩이씩 되게 지은 글. 그 한 덩이를 ‘구(句)’라 하고 각 마디를 ‘짝’이라 하는데, 앞마디를 안짝, 뒷마디를 바깥짝이라고 한다. ⇒규범 표기는 ‘귀글’이다. 〔명사〕"@ko ;
    kno:urimalTargetCode "97763" ;
    kno:semanticTag kno:usas-Z3 ;
    kno:fullForm "구글"@ko ;
    rdfs:label "구글(Google)"@ko ;
    kno:semanticTag kno:usas-Y2 ;
