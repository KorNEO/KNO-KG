# KN2016-0019 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0019 a kno:Neologism ;
    kno:lastAttestationYear "2017"^^xsd:gYear ;
    skos:definition "1인용 소형 자동차인 고카트를 탈 수 있도록 만들어 놓은 경기장. 엔진과 프레임, 1인승 좌석으로 이루어진 스포츠 자동차로 오락용이나 경기용으로 쓰는 고카트를 탈 수 있는 설비를 갖추었다."@ko ;
    kno:origin "(<영>gocart場)" ;
    kno:pos "「명」"@ko ;
    kno:unitType "단어"@ko ;
    kno:example "¶이날 방송에서 친구들은 레이싱계의 살아 있는 전설 OOO의 실외 {고카트장을} 방문했다."@ko ;
    kno:urimalTargetCode "1372454" ;
    kno:slotFiller "고카트(gocart) (1성분)"@ko ;
    kno:languageType "영+한" ;
