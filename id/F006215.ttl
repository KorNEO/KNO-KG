# F006215 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F006215 kno:caseCount "1"^^xsd:integer ;
    kno:urimalDefinition "크리스마스에 부르는 성탄 축하곡. 14세기 영국에서 종교 가곡의 한 형식으로 생겨나 발전하였으며, 나중에는 성탄절을 축하하는 노래만을 이르게 되었다. 〔명사〕"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=584320> ;
    a kno:Formative ;
    kno:urimalTargetCode "584320" ;
    kno:origin "carol" ;
