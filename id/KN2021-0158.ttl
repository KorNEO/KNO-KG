@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2021-0158 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2021-0158-att-nn ;
    ontolex:canonicalForm kno:KN2021-0158-form ;
    ontolex:sense kno:KN2021-0158-sense .

kno:KN2021-0158-att-nn a frac:Attestation ;
    dcterms:date "2020-08-03"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/025/0003022912> .

kno:KN2021-0158-form a ontolex:Form ;
    frac:frequency kno:KN2021-0158-freq-nn,
        kno:KN2021-0158-freq-yt ;
    ontolex:writtenRep "서학^개미"@ko .

kno:KN2021-0158-freq-nn a frac:CorpusFrequency ;
    rdf:value 41086 ;
    frac:corpus kno:corpus-NN .

kno:KN2021-0158-freq-yt a frac:CorpusFrequency ;
    rdf:value 6589 ;
    frac:corpus kno:corpus-YT .

kno:KN2021-0158-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%EA%B0%9C%EB%AF%B8(%EC%A3%BC%EC%8B%9D)> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

