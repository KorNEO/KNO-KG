    kno:parallelFullForm kno:LEX-젠트리피케이션 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1201250> ;
    kno:surfaceForm "트리피케이션"@ko ;
    kno:fullFormLexeme kno:LEX-젠트리피케이션 ;
