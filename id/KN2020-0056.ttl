# KN2020-0056 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0056 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "긴급^돌봄^학교"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B8%B4%EA%B8%89%EB%8F%8C%EB%B4%84%ED%95%99%EA%B5%90> ;
    skos:definition "전국적인 재난 사태가 발생한 상황에서 돌봄 교실을 운영하도록 정부가 지정한 학교. 코로나19의 확산으로 인해 대부분의 학교가 휴교함에 따라 발생한 돌봄 공백을 없애고 맞벌이 부부의 보육 부담을 줄이기 위해서 마련되었다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2020-0056-c1 ;
    kno:component kno:KN2020-0056-c2 ;
    kno:component kno:KN2020-0056-c3 ;
    kno:componentString "긴급(緊急), 돌봄, 학교(學校)"@ko ;
    kno:example "¶코로나19로 인해 전국의 개학이 연기되면서 학생들의 돌봄 문제에도 비상이 걸렸다. 초등학생 아들을 두었다는 한 학부모는 “시어머니가 아들을 밖에 내보내는 것을 반대하여 {긴급 돌봄 학교는} 생각도 못한다.”라고 걱정을 표했다."@ko ;
    kno:frequency kno:KN2020-0056-freq-NN-2020 ;
    kno:frequency kno:KN2020-0056-freq-NN-total ;
    kno:indexForm "긴급돌봄학교"@ko ;
    kno:instantiates kno:S000450 ;
    kno:languageType "한^고^한" ;
    kno:lastAttestationYear "2020"^^xsd:gYear ;
    kno:origin "(緊急돌봄學校)" ;
    kno:pos "「구」"@ko ;
    kno:registration "신어DB"@ko ;
    kno:slotFiller "학교(學校) (1성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:year "2020"^^xsd:gYear .
