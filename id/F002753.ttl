# F002753 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002753 kno:semanticTag kno:usas-S4 ;
    kno:surfaceForm "네포"@ko ;
    kno:urimalDefinition "권력자가 자기의 친족에게 관직, 지위 따위를 주는 일. 10세기에서 14세기 사이에 로마 교황들이 자기의 사생아를 네포스(nepos), 곧 조카라 하여 중용(重用)한 데에서 유래하였다. 〔명사〕"@ko ;
    kno:fullForm "네포티즘"@ko ;
    kno:urimalTargetCode "453678" ;
    kno:origin "nepotism" ;
    rdfs:label "네포(티즘)(nepotism)"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:fullFormLexeme kno:LEX-네포티즘 ;
    kno:parallelFullForm kno:LEX-네포티즘 ;
