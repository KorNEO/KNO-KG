# F004670 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004670 kno:surfaceForm "시지"@ko ;
    a kno:Formative ;
    kno:origin "cg" ;
    kno:fullForm "시지"@ko ;
    kno:urimalDefinition "지식 표현에 대한 형식. <FL>소와</FL>(Sowa, J. F.)가 1976년 처음으로 데이터베이스 시스템에서 개념적 스키마를 표현하는 데 사용하였고, 나중에 인공 지능과 컴퓨터 과학 및 인지 과학에 적용되었다. 논리적으로 정확하고 사람이 읽을 수 있으며 전산 처리가 가능한 형태로 의미를 부여하는 그래프로서, 언어와 직접 연결시켜 컴퓨터 형식과 자연 언어 간 변환을 위한 중간 언어 역할을 한다. 그래프 표현으로 읽을 수도 있지만 정형 설계 및 기술 언어로서의 역할을 하며, 정보 검색, 데이터베이스 설계, 전문가 시스템 따위에 사용된다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-Y2 ;
    rdfs:label "시지(CG)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=828203> ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "828203" ;
    kno:caseCount "1"^^xsd:integer .
kno:KN2013-0274-c1 kno:formative kno:F004670 .
