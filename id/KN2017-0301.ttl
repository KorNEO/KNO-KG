# KN2017-0301 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0301 kno:languageType "영_영" ;
    kno:pos "「구」"@ko ;
    rdfs:label "팔러 캐비닛"@ko ;
    kno:component kno:KN2017-0301-c1 ;
    kno:instantiates kno:S001060 ;
    kno:activeYears "1"^^xsd:integer ;
    kno:year "2017"^^xsd:gYear ;
    a kno:Neologism ;
    kno:slotFiller "팔러(parlor) (1성분)"@ko ;
    kno:lastAttestationYear "2016"^^xsd:gYear ;
    kno:componentString "팔러(parlor), 캐비닛(cabinet)"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%ED%8C%94%EB%9F%AC%20%EC%BA%90%EB%B9%84%EB%8B%9B> ;
    kno:example "¶미국 가정에선 일반 손님은 응접실까지만 들이고, 친한 사이만 주방 출입을 허용한다. 이에 빗대 미국 정가에선 OOO 대통령 재임 이후 공식 내각을 ‘{팔러 캐비닛}’, 비공식 자문 위원을 ‘키친 캐비닛’으로 부른다."@ko ;
    kno:registration "신어DB"@ko ;
    kno:component kno:KN2017-0301-c2 ;
    skos:definition "미국의 공식 내각을 비유적으로 이르는 말. 이들은 공식적으로 대통령의 보좌 및 자문을 담당한다. 미국에서 대통령의 식사에 초청을 받아 담소를 나눌 수 있을 정도로 격의 없는 지인들을 이르는 말인 ‘키친 캐비닛’에 상대하여 이르는 말이다. 손님이 집에 오는 경우 보통 응접실이나 거실에서 손님을 대접하지만, 격의 없는 지인은 부엌까지 드나들 수 있는 미국의 문화에서 유래하였다."@ko ;
    kno:unitType "구"@ko ;
    a ontolex:MultiwordExpression ;
