# KN2016-0217 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0217 rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1368867> ;
    a ontolex:MultiwordExpression ;
    kno:origin "(部長<영>intern)" ;
    skos:definition "정규직으로 채용되지 못한 채 오랜 인턴 생활로 인해 부장급의 능력을 갖춘 취업 준비생."@ko ;
    kno:activeYears "7"^^xsd:integer ;
    kno:indexForm "부장인턴"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:instantiates kno:S000420 ;
    kno:example "¶만년 인턴 생활만 하다 보니 ‘{부장 인턴’이란} 말도 생겨났다. 인턴만 하다 보니 부장급 능력을 갖추게 됐다는 자조 섞인 말이다."@ko ;
