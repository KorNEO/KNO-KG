kno:KN2021-0205 a ontolex:Word ;
    a kno:Neologism ;
    rdfs:label "완내스"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1664463> ;
    skos:definition "‘완전 내 스타일’을 줄여 이르는 말. 어떤 것이 자신의 취향에 딱 맞음을 이르는 말이다."@ko ;
