# KN2016-0232 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0232 kno:unitType "구"@ko ;
    kno:languageType "힌_영" ;
    skos:definition "인도에서 일어난 입시 부정 사건. 인도에서, 대학교를 진학하거나 공무원이 되는 데 기준이 되는 시험을 주관하는 단체인 ‘브야팜(Vyapam)’에서 따온 말이다."@ko ;
    kno:origin "(Vyapam<영>scandal)" ;
    kno:component kno:KN2016-0232-c2 ;
    kno:indexForm "브야팜스캔들"@ko ;
    kno:componentString "브야팜(Vyapam), 스캔들(scandal)"@ko ;
    a kno:Neologism ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B8%8C%EC%95%BC%ED%8C%9C%20%EC%8A%A4%EC%BA%94%EB%93%A4> ;
    kno:example "¶{브야팜 스캔들은} 졸업생은 많은데 일자리와 대학교가 부족한 상황에서 고득점과 학위, 직업을 돈으로 사려고 조직적으로 저지른 범죄다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:pos "「구」"@ko ;
    a ontolex:MultiwordExpression ;
