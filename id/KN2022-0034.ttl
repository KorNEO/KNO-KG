# KN2022-0034 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0034 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "고등^직업^교육^거점^지구^지원^사업"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B3%A0%EB%93%B1%EC%A7%81%EC%97%85%EA%B5%90%EC%9C%A1%EA%B1%B0%EC%A0%90%EC%A7%80%EA%B5%AC%EC%A7%80%EC%9B%90%EC%82%AC%EC%97%85> ;
    skos:definition "지자체와 기업, 전문 대학이 연합체를 조직하여 교육 체계를 개편하고 지역 내의 특화 분야를 선정하는 등의 방법으로 대학이 지역의 거점의 역할을 맡을 수 있도록 지원하는 사업."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2022-0034-c1 ;
    kno:component kno:KN2022-0034-c2 ;
    kno:component kno:KN2022-0034-c3 ;
    kno:component kno:KN2022-0034-c4 ;
    kno:component kno:KN2022-0034-c5 ;
    kno:component kno:KN2022-0034-c6 ;
    kno:component kno:KN2022-0034-c7 ;
    kno:componentString "고등(高等), 직업(職業), 교육(敎育), 거점(據點), 지구(地區), 지원(支援), 사업(事業)"@ko ;
    kno:example "¶전문 대학을 위한 협의회는 기초 지방 자치 단체와 전문대가 연계하여 평생 직업 교육을 강화하고 지역 특화 분야를 중심으로 학과를 개편하는 ‘{고등 직업 교육 거점 지구 지원 사업’의} 추진을 요구하였다."@ko ;
    kno:frequency kno:KN2022-0034-freq-NN-2021 ;
