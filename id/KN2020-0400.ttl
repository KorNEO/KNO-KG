# KN2020-0400 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0400 kno:frequency kno:KN2020-0400-freq-NN-2020 ;
    a kno:Neologism ;
    kno:languageType "한^한" ;
    kno:unitType "구"@ko ;
    kno:component kno:KN2020-0400-c2 ;
