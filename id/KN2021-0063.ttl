# KN2021-0063 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0063 kno:frequency kno:KN2021-0063-freq-NN-2025 ;
    a kno:Neologism ;
    kno:activeYears "3"^^xsd:integer ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%8B%A8%EC%9D%BC%EC%A0%95%EC%95%A1%EC%A0%9C> ;
