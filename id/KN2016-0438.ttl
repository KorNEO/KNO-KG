# KN2016-0438 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0438 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "잔업^난민"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9E%94%EC%97%85%EB%82%9C%EB%AF%BC> ;
    skos:definition "잔업을 하며 귀가를 미루는 직장인. 퇴근 후에도 할 일이 없고 가정에서 편안함을 느끼지 못해 잔업을 선택한다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2016-0438-c1 ;
    kno:component kno:KN2016-0438-c2 ;
    kno:componentString "잔업(殘業), 난민(難民)"@ko ;
    kno:example "¶집에 가서 집안일이 하기 싫어서 일부러 늦게 가는 사람들 많고, 요즘 일본 수도권 근교의 베드타운에서는 ‘노(no) 잔업 데이(day)’에 억지로 퇴근한 사람들, 이른바 ‘{잔업 난민’들이} 집에 들어가기 전에 시간을 보낼 수 있는 술집과 패밀리 레스토랑, 빠찡꼬점, 사우나 등이 특히 수요일에 톡톡히 특수를 본다."@ko ;
    kno:frequency kno:KN2016-0438-freq-NN-2016 ;
    kno:frequency kno:KN2016-0438-freq-NN-total ;
