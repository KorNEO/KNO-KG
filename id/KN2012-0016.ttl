# KN2012-0016 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2012-0016 a ontolex:Word ;
    a kno:Neologism ;
    kno:unitType "단어"@ko ;
    kno:indexForm "계폭"@ko ;
    kno:component kno:KN2012-0016-c2 ;
    kno:componentString "계(정)(計), 폭(파)(爆)"@ko ;
    kno:urimalTargetCode "1373104" ;
    rdfs:label "계폭"@ko ;
    kno:component kno:KN2012-0016-c1 ;
    kno:formation kno:W06 ;
    skos:definition "‘계정 폭파’를 줄여 이르는 말. 에스엔에스 계정이 삭제되는 것이다."@ko ;
    kno:languageType "한+한" ;
    kno:year "2012"^^xsd:gYear ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1373104> ;
    kno:origin "(計爆)" ;
    kno:pos "「명」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:example "¶OO당은 29일 OO당이 OOO 후보 등 자당 후보들이 트위터 계정 폭파를 당했다며 검찰 수사까지 주장했다가 트위터 본사로부터 {계폭은} 불가능하다고 힐난을 당한 것과 관련, “국민은 OO당을 ‘자가당착’이라고 조소하지 않을까 싶다.”라고 비꼬았다."@ko ;
    kno:activeYears "0"^^xsd:integer .
