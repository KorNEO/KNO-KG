# F004025 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004025 a kno:Formative ;
    rdfs:label "브레이커(braker)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1300477> ;
    kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "브레이커"@ko ;
    kno:origin "braker" ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-A1.1.2 ;
    kno:surfaceForm "브레이커"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "봅슬레이에서, 코스 도중에 브레이크와 스피드를 조절하는 선수. 출발할 때 파일럿이 타는 것을 확인한 후 봅슬레이에 맨 마지막으로 올라탄다. 브레이크는 직선과 정지할 때만 가능하고 커브에서는 사용할 수 없다. 〔명사〕"@ko ;
    kno:urimalTargetCode "1300477" .
kno:KN2014-0250-c2 kno:formative kno:F004025 .
