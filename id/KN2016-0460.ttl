    kno:pos "「구」"@ko ;
    kno:origin "(竹筒作業/죽通作業)" ;
    kno:example "¶최근 OO 지검 수사관들은 ‘떴다방’ 수사를 하던 중 ‘{죽통 작업’이라는} 낯선 단어를 접했다."@ko ;
    a ontolex:MultiwordExpression ;
    kno:instantiates kno:S001012 ;
    kno:urimalTargetCode "1372895" ;
    a kno:Neologism ;
    kno:componentString "죽(은)(竹), 통(장)(筒), 작업(作業)"@ko ;
