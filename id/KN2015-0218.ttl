# KN2015-0218 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0218 kno:origin "(<영>←couple퀴)" ;
    kno:unitType "단어"@ko ;
    skos:definition "다른 사람들에게 피해를 주거나 혐오감을 느끼게 만드는 커플을 낮잡아 이르는 말. ‘커플(couple)’의 첫 음절과 ‘바퀴벌레’의 두 번째 음절을 합한 말이다."@ko ;
    kno:languageType "영+고" ;
    kno:instantiates kno:S000592 ;
    kno:registration "신어DB"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%BB%A4%ED%80%B4> ;
    kno:example "¶이번에는 ‘{커퀴’에게} 당했습니다."@ko ;
    rdfs:label "커퀴"@ko ;
    kno:pos "「명」"@ko ;
