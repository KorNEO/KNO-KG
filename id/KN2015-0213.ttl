# KN2015-0213 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0213 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "카페인^우울증"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%B9%B4%ED%8E%98%EC%9D%B8%EC%9A%B0%EC%9A%B8%EC%A6%9D> ;
    skos:definition "누리 소통망 서비스(SNS) 때문에 생기는 우울증. 주로 누리 소통망 서비스에서 드러나는 다른 사람의 긍정적 상황과 자신의 부정적 상황을 비교해서 생기는 우울증이다. ‘카페인’은 대표적인 누리 소통망 서비스인 ‘카카오 서비스(Kakao service), 페이스북(Facebook), 인스타그램(Instagram)’의 첫머리 글자에서 유래한 말이다."@ko ;
    kno:activeYears "10"^^xsd:integer ;
    kno:component kno:KN2015-0213-c1 ;
    kno:component kno:KN2015-0213-c2 ;
    kno:component kno:KN2015-0213-c3 ;
    kno:component kno:KN2015-0213-c4 ;
    kno:componentString "카(카오)(Kakao), 페(이스북)(Facebook), 인(스타그램)(Instagram), 우울증(憂鬱症)"@ko ;
    kno:example "¶카카오 서비스, 페이스북, 인스타그램 등으로 소통하는 사람들은 자기보다 행복해 보이는 사람들 때문에 ‘{카페인 우울증’이} 생기기도 한다."@ko ;
