    a kno:Neologism ;
    rdfs:label "수입차^푸어"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1357286> ;
    skos:definition "할부로 수입차를 구매한 후 할부금을 제때 갚지 못해 빚에 시달리는 사람."@ko ;
