    a kno:Formative ;
    kno:urimalDefinition "긴 손잡이가 있고, 바닥에 2~4개의 작은 바퀴가 달린 탈것. 두 손으로 손잡이를 잡고 한 발로 바닥을 밀면서 탄다. 〔명사〕"@ko ;
    rdfs:label "킥(보드)(kickboard)"@ko ;
    kno:truncated "true"^^xsd:boolean ;
