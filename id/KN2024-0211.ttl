# KN2024-0211 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0211 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "우유^서기관"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9A%B0%EC%9C%A0%EC%84%9C%EA%B8%B0%EA%B4%80> ;
    skos:definition "우유의 가격을 관리하는 담당자. 물가 체감도가 높은 빵, 우유, 과자, 커피, 라면, 아이스크림, 설탕, 식용유, 밀가루 등 9개 품목을 집중 관리 대상으로 선정하고, 서기관이나 사무관급 담당자를 지정한 것에서 나온 말이다. =우유 관리관."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2024-0211-c1 ;
    kno:component kno:KN2024-0211-c2 ;
    kno:componentString "우유(牛乳), 서기관(書記官)"@ko ;
    kno:example "¶최근 정부가 품목별 물가 관리에 나서면서 {우유 서기관이} 부활한 가운데 정부가 가격 형성에 지나치게 개입한다는 지적이 잇따르고 있다."@ko ;
    kno:frequency kno:KN2024-0211-freq-NN-2023 ;
