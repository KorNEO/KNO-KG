# F002587 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002587 kno:surfaceForm "기러기"@ko ;
    kno:urimalDefinition "오릿과에 딸린 철새를 통틀어 이르는 말. 오리와 비슷하나 목이 길고 다리가 짧으며 강, 바다, 늪가에 산다. 가을에 한국에 와서 봄에 시베리아, 사할린, 알래스카 등지로 가는 겨울 철새이다. 쇠기러기, 큰기러기, 회색기러기 따위가 있다. 〔명사〕"@ko ;
    a kno:Formative ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "기러기"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=107045> ;
    kno:semanticTag kno:usas-S4 ;
    kno:semanticTag kno:usas-L2 ;
    kno:urimalTargetCode "107045" ;
    rdfs:label "기러기"@ko ;
    kno:caseCount "1"^^xsd:integer .
kno:KN2015-0263-c2 kno:formative kno:F002587 .
