kno:KN2025-0033 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "게임 물 장사 위원회"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B2%8C%EC%9E%84%20%EB%AC%BC%20%EC%9E%A5%EC%82%AC%20%EC%9C%84%EC%9B%90%ED%9A%8C> ;
    skos:definition "(LLM) 게임의 등급 분류ㆍ심의 과정에서 비용을 과도하게 걷거나 수익 사업처럼 운영한다는 비판을 담아, 특정 기관을 비꼬아 이르는 말."@ko ;
