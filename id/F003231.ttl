# F003231 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F003231 kno:semanticTag kno:usas-N3.7m ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=967755> ;
    kno:origin "raw" ;
    kno:truncated "false"^^xsd:boolean ;
    kno:fullForm "로"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:urimalDefinition "디스크에 특정한 데이터를 써넣은 직후 바로 읽어 내어 메모리에 쓰인 원래의 데이터와 일치하는지를 검토하여 오류를 검출하는 하드웨어 통제 장치. 양자가 일치하지 않는 경우에는 써넣기에 실패했다고 판단하여 써넣기와 비교를 반복하며, 그래도 비교 결과가 일치하지 않으면 미리 확보한 다른 영역에 데이터를 써넣는다. 〔명사〕"@ko ;
    kno:surfaceForm "로"@ko ;
    a kno:Formative ;
    rdfs:label "로(raw)"@ko ;
    kno:urimalTargetCode "967755" ;
    kno:caseCount "1"^^xsd:integer .
kno:KN2012-0104-c1 kno:formative kno:F003231 .
