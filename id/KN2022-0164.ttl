    rdfs:label "블세"@ko ;
    kno:languageType "영+영" ;
    kno:year "2022"^^xsd:gYear ;
    kno:component kno:KN2022-0164-c2 ;
    kno:registration "신어DB"@ko ;
    kno:example "¶OOO은 마무리 투수로 9회 말에 등판하였지만, 상대 팀의 마지막 타자에게 안타를 내어 주며 {블세를} 범하는 실수를 하고 말았다."@ko ;
    kno:pos "「명」"@ko ;
    kno:origin "(<영>←blown save)" ;
