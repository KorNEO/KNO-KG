# KN2022-0164 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0164 skos:definition "‘블론 세이브’를 줄여 이르는 말. 야구에서, 세이브 상황에 등판한 투수가 상대 팀에게 동점 혹은 역전을 허용하는 일을 이르는 말이다."@ko ;
    kno:activeYears "0"^^xsd:integer ;
    kno:indexForm "블세"@ko ;
    a ontolex:Word ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%B8%94%EC%84%B8> ;
    kno:componentString "블(론)(blown), 세(이브)(save)"@ko ;
    a kno:Neologism ;
