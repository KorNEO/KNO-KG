# KN2017-0261 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0261 kno:component kno:KN2017-0261-c1 ;
    kno:slotFiller "책맥(冊麥) (1성분)"@ko ;
    skos:definition "책을 읽으면서 맥주를 마시는 사람. 또는 그런 무리."@ko ;
    a ontolex:Word ;
    kno:unitType "단어"@ko ;
    kno:instantiates kno:S000001 ;
    kno:predicate "마시다"@ko ;
    kno:frequency kno:KN2017-0261-freq-NN-2016 ;
    kno:urimalTargetCode "1380247" ;
    kno:frequency kno:KN2017-0261-freq-NN-total ;
    kno:component kno:KN2017-0261-c2 ;
    kno:example "¶‘{책맥족’은} 특히 여름밤이 ‘책맥’하기 딱 좋다고 입을 모은다. 직장인 OOO 씨는 “요즘처럼 더운 밤은 잠들기 쉽지 않은데 샤워 후에 선풍기를 틀어 놓고 책을 읽으며 맥주 한 잔 마시면 쉽게 잠들 수 있다.”라고 말했다."@ko ;
