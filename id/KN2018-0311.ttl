kno:KN2018-0311 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "차박 캠핑"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1376814> ;
    skos:definition "여행할 때에 자동차에서 음식을 먹거나 잠을 자고 머무르면서 야영함. 또는 그런 생활."@ko ;
