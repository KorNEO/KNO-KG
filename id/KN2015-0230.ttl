# KN2015-0230 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0230 kno:registration "우리말샘"@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:languageType "한^영" ;
    kno:example "¶향후엔 정년 연장에 따른 ‘{퇴직 크레바스’를} 해소하고, 노후 생활을 위하여 국민연금의 수급 개시 연령과 일치시키는 플랜도 구상할 필요가 있다."@ko ;
    kno:lastAttestationYear "2017"^^xsd:gYear ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372278> ;
    kno:component kno:KN2015-0230-c2 ;
    a kno:Neologism ;
    kno:frequency kno:KN2015-0230-freq-NN-2015 ;
    kno:frequency kno:KN2015-0230-freq-NN-2017 ;
    kno:frequency kno:KN2015-0230-freq-NN-total ;
    skos:definition "퇴직 후부터 국민연금을 수령하기 전까지의 기간. 이 기간 동안 수입이 없는 상황을 빙하의 표면에 생긴 깊은 균열인 크레바스에 비유한 말이다."@ko ;
    kno:frequency kno:KN2015-0230-freq-NN-2016 ;
