# KN2014-0105 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2014-0105 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "미세스^주스족"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1373724> ;
    skos:definition "주스를 살 때 물이나 첨가물을 섞지 않고 생즙으로 만든 주스만 고집하는 결혼한 여성. 또는 그런 무리. ⇒규범 표기는 ‘미시즈 주스족’이다."@ko ;
    kno:activeYears "1"^^xsd:integer ;
    kno:component kno:KN2014-0105-c1 ;
    kno:component kno:KN2014-0105-c2 ;
    kno:component kno:KN2014-0105-c3 ;
    kno:componentString "미세스(Mrs), 주스(juice), -족(族)"@ko ;
    kno:example "¶한편 OO 1층에 위치한 OO는…오픈과 동시에 주부들 사이에서 입소문이 나면서 ‘{미세스 주스족’의} 핫플레이스로 떠올랐다."@ko ;
    kno:frequency kno:KN2014-0105-freq-NN-2014 ;
    kno:frequency kno:KN2014-0105-freq-NN-total ;
    kno:indexForm "미세스주스족"@ko ;
    kno:instantiates kno:S001302 ;
    kno:languageType "영^(영+한)" ;
    kno:lastAttestationYear "2014"^^xsd:gYear ;
    kno:origin "(<영>▼Mrs. juice族)" ;
    kno:pos "「구」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:slotFiller "주스(juice) (1성분)"@ko ;
    kno:unitType "구"@ko ;
    kno:urimalTargetCode "1373724" ;
    kno:year "2014"^^xsd:gYear .
