    kno:unitType "구"@ko ;
    a ontolex:MultiwordExpression ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%82%AC%ED%86%A0%EC%8B%9C%EC%82%AC%EC%9D%B4%ED%81%B4> ;
