# F000493 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000493 a kno:Formative ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%9D%BC%EB%8B%88> ;
    kno:caseCount "4"^^xsd:integer ;
    kno:parallelFullForm kno:LEX-고라니 ;
    kno:urimalDefinition "사슴과의 하나. 노루의 일종으로 몸의 길이는 90cm 정도로 작으며, 여름에는 붉은 갈색, 가을에는 잿빛 갈색이다. 암수 모두 뿔이 없으며 송곳니는 밖으로 나와 있고 5월경에 새끼를 낳는다. 관목으로 우거진 숲 따위에서 단독 생활을 하거나 적은 수의 무리를 지어 사는데 한국, 중국의 만주 등지에 분포한다. 〔명사〕"@ko ;
    kno:semanticTag kno:usas-L2 ;
    kno:fullForm "고라니"@ko ;
    rdfs:label "(고)라니"@ko ;
    kno:fullFormLexeme kno:LEX-고라니 ;
    kno:surfaceForm "라니"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=4582> ;
    kno:registration "우리말샘"@ko ;
    kno:urimalTargetCode "4582" ;
    kno:truncated "true"^^xsd:boolean .
