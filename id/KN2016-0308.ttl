# KN2016-0308 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0308 kno:component kno:KN2016-0308-c1 ;
    kno:registration "신어DB"@ko ;
    kno:languageType "영^한" ;
    kno:lastAttestationYear "2015"^^xsd:gYear ;
    kno:year "2016"^^xsd:gYear ;
    skos:definition "병역을 기피하려고 대한민국 국적을 포기하거나 이탈한 사람에게 입국 금지 조치를 할 수 있도록 한 법안. 2015년 6월에 국회에서 발의된 ‘출입국 관리법 일부 개정 법률안’의 내용으로 포함되었다."@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%8A%A4%ED%8B%B0%EB%B8%8C%EC%9C%A0%EB%B2%95> ;
