# KN2017-0289 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0289 skos:definition "자신에게 어울리는 색조. 개인의 피부색, 머리색 등에 따라 다르며 쿨톤, 웜톤 등이 있다. 색조를 뜻하는 영어 ‘톤(tone)’과 ‘정체성’을 결합하여 만든 말이다."@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380664> ;
    kno:unitType "단어"@ko ;
    kno:frequency kno:KN2017-0289-freq-NN-2018 ;
    kno:component kno:KN2017-0289-c1 ;
    kno:year "2017"^^xsd:gYear ;
    kno:activeYears "4"^^xsd:integer ;
    kno:lastAttestationYear "2020"^^xsd:gYear ;
    rdfs:label "톤체성"@ko ;
    kno:predicate "어울리다"@ko ;
    kno:indexForm "톤체성"@ko ;
    kno:formation kno:W05 ;
    kno:slotFiller "(정)체성(體性) (1성분)"@ko ;
    kno:example "¶OO은 최근 ‘{톤체성’이라는} 신조어가 생길 만큼 자신에게 맞는 퍼스널 컬러를 찾으려는 고객이 늘어남에 따라 맞춤형 윤곽 메이크업 제품인 OO을 선보이게 됐다고 설명했다."@ko ;
    a ontolex:Word ;
    kno:componentString "톤(tone), (정)체성(體性)"@ko ;
