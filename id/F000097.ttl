# F000097 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F000097 kno:caseCount "11"^^xsd:integer ;
    kno:urimalTargetCode "112747" ;
    a kno:Formative ;
    kno:urimalDefinition "꿀벌이 꽃에서 빨아들여 벌집 속에 모아 두는, 달콤하고 끈끈한 액체. 그 성분은 대부분 당분(糖分)이며 식용하거나 약으로 쓴다. 〔명사〕"@ko ;
    rdfs:label "꿀"@ko ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=112747> ;
    kno:truncated "false"^^xsd:boolean ;
    kno:fullForm "꿀"@ko ;
    kno:surfaceForm "꿀"@ko ;
    kno:semanticTag kno:usas-A5.1p .
