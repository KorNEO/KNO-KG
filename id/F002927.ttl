# F002927 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F002927 a kno:Formative ;
    rdfs:label "대전동(道傳洞)"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1408440> ;
    kno:caseCount "1"^^xsd:integer ;
    kno:fullForm "대전동"@ko ;
    kno:origin "道傳洞" ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-Z2 ;
    kno:surfaceForm "대전동"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    kno:urimalDefinition "강원특별자치도 강릉시에 있는 동. 강릉시의 중동부에 위치해 있다. 야트막한 구릉의 줄기가 마을을 두르며, 동쪽에 태장봉이 솟아 있다. 경포천이 마을 중남부를 감싸고 흐르며, 하천 주변에 농경지와 주거지가 형성되어 있다. 강릉 일반 산업 단지가 조성되어 산업 연구 시설이 들어서 있으며, 7번 국도가 동쪽을 남북으로 지난다. 〔명사〕"@ko ;
    kno:urimalTargetCode "1408440" .
kno:KN2012-0071-c1 kno:formative kno:F002927 .
