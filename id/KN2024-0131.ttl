    a kno:Neologism ;
    rdfs:label "세종^지법^설치법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%84%B8%EC%A2%85%EC%A7%80%EB%B2%95%EC%84%A4%EC%B9%98%EB%B2%95> ;
    skos:definition "세종시에 지방 법원과 행정 법원을 만드는 데 필요한 내용을 담고 있는 법률. 정식 명칭은 ‘법원 설치법 개정안’이다. =세종 법원법."@ko ;
