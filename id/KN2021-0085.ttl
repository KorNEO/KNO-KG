# KN2021-0085 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2021-0085 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "딴봉띠^집회"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%94%B4%EB%B4%89%EB%9D%A0%EC%A7%91%ED%9A%8C> ;
    skos:definition "2021년 3월부터 12월까지 광주의 미얀마 노동자, 학생, ‘미얀마 군부 쿠데타 반대와 민주화 지지 광주 연대’를 중심으로 미얀마 군부 독재에 저항하고자 열린 집회. ‘딴봉띠’는 큰소리로 악귀를 쫓는 미얀마의 전통 풍습을 뜻한다."@ko ;
    kno:activeYears "3"^^xsd:integer ;
    kno:component kno:KN2021-0085-c1 ;
    kno:component kno:KN2021-0085-c2 ;
    kno:componentString "딴봉띠(ttanpongtti), 집회(集會)"@ko ;
    kno:example "¶오는 18일에는 광주에서 미얀마 민주주의 수호를 위한 마지막 {딴봉띠 집회가} 열린다."@ko ;
