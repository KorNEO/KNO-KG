# F004375 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004375 kno:fullFormLexeme kno:LEX-어셈블리 ;
    kno:semanticTag kno:usas-G1.1 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=681025> ;
    kno:urimalDefinition "사이리스터, 다이오드, 사이리스터 스택, 다이오드 스택과 이에 딸린 모든 결선 및 보조 부품이 자체의 기계적인 구조물 내에 전기적 또는 기계적으로 결합되어 있는 것. 냉각 장치가 있는 경우에는 보통 이 부품들을 포함하지만 변환기용 변압기, 개폐 장치 및 기타 보조 장치는 포함하지 않는다. 〔명사〕"@ko ;
    kno:parallelFullForm kno:LEX-어셈블리 ;
    kno:registration "우리말샘"@ko ;
    kno:fullForm "어셈블리"@ko ;
    rdfs:label "(어)셈블리(assembly)"@ko ;
    kno:truncated "true"^^xsd:boolean ;
    kno:origin "assembly" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "셈블리"@ko ;
