# KN2022-0060 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0060 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "국가^첨단^전략^기술"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B5%AD%EA%B0%80%EC%B2%A8%EB%8B%A8%EC%A0%84%EB%9E%B5%EA%B8%B0%EC%88%A0> ;
    skos:definition "반도체와 이차 전지 등을 포함하는 첨단 기술. 첨단 산업의 경쟁력 강화와 경제 안보 확보를 목적으로 지정하였다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
