@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0368 a ontolex:Word ;
    frac:attestation kno:KN2020-0368-att-nn ;
    ontolex:canonicalForm kno:KN2020-0368-form ;
    ontolex:sense kno:KN2020-0368-sense .

kno:KN2020-0368-att-nn a frac:Attestation ;
    dcterms:date "2020-04-13"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/001/0011543323> .

kno:KN2020-0368-form a ontolex:Form ;
    frac:frequency kno:KN2020-0368-freq-nn,
        kno:KN2020-0368-freq-yt ;
    ontolex:writtenRep "코로나케이션"@ko .

kno:KN2020-0368-freq-nn a frac:CorpusFrequency ;
    rdf:value 19 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0368-freq-yt a frac:CorpusFrequency ;
    rdf:value 0 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0368-sense a ontolex:LexicalSense .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

