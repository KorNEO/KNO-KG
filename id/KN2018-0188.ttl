kno:KN2018-0188 a kno:Neologism ;
    kno:componentString "소매, 넣기"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:predicate "주다"@ko ;
    kno:lastAttestationYear "2025"^^xsd:gYear ;
