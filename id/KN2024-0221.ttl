# KN2024-0221 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2024-0221 kno:registration "신어DB"@ko ;
    kno:unitType "구"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EC%9C%A0%EA%B8%88%EB%AC%B4%EC%A3%84%20%EB%AC%B4%EA%B8%88%EC%9C%A0%EC%A3%84> ;
    kno:frequency kno:KN2024-0221-freq-NN-2024 ;
    kno:componentString "유금무죄(有金無罪), 무금유죄(無金有罪)"@ko ;
    skos:definition "국회 의원은 죄를 지어도 벌을 받지 않고, 국회 의원이 아닌 사람은 벌을 받는다는 뜻으로 법이 모든 사람에게 공평하게 적용되지 않는 상황을 이르는 말. 여기서 ‘금(金)’은 국회 의원임을 표시하는 ‘금배지(金badge)’를 가리킨다."@ko ;
    kno:frequency kno:KN2024-0221-freq-NN-total ;
    rdfs:label "유금무죄 무금유죄"@ko ;
    kno:origin "(有金無罪無金有罪)" ;
