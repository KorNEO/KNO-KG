# F007108 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F007108 kno:surfaceForm "호버"@ko ;
    kno:caseCount "1"^^xsd:integer ;
    kno:urimalDefinition "가축에게 바람이 직접적으로 영향을 미치지 못하게 막아 주는 보온 덮개. 어린 동물을 위한 축사나 우리의 온도 유지 및 기류 방지를 목적으로 한다. 천장에 매달아 사용한다. 〔명사〕"@ko ;
    kno:urimalTargetCode "1041486" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1041486> ;
    kno:registration "우리말샘"@ko ;
    kno:origin "hover" ;
    rdfs:label "호버(hover)"@ko ;
    kno:truncated "false"^^xsd:boolean ;
    a kno:Formative ;
    kno:fullForm "호버"@ko ;
    kno:semanticTag kno:usas-M1 .
