# KN2015-0210 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2015-0210 kno:activeYears "3"^^xsd:integer ;
    a ontolex:Word ;
    kno:pos "「명」"@ko ;
    skos:definition "‘인도’를 비유적으로 이르는 말. 인도의 대표 음식인 ‘카레’에 나라를 의미하는 한자어 ‘국(國)’을 결합하여 만든 말이다."@ko ;
    kno:registration "우리말샘"@ko ;
    kno:frequency kno:KN2015-0210-freq-NN-2019 ;
    kno:example "¶이외에 중국은 대륙, 미국은 천조국, 러시아 불곰국, 캐나다 단풍국, 인도 {카레국}, 네덜란드 풍차국 등 대부분 음식, 건물, 국기 등 일종의 랜드마크라고 할 수 있는 것들로 붙어진 별명이다."@ko ;
    kno:origin "(<영>←curry國)" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1359748> ;
    kno:componentString "카레(←curry), -국(國)"@ko ;
