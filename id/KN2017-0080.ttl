# KN2017-0080 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0080 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "라이스 슈가"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1380424> ;
    skos:definition "쌀을 가공하여 만든 설탕. 기존의 설탕보다 당도가 덜하고, 쌀의 영양소가 함유되어 있는 가공 설탕이다. 엿기름을 이용해 쌀을 액체 상태로 만든 뒤, 다시 고체로 만드는 공정을 거쳐 완성된다. =쌀설탕."@ko ;
    kno:activeYears "2"^^xsd:integer ;
    kno:component kno:KN2017-0080-c1 ;
    kno:component kno:KN2017-0080-c2 ;
    kno:componentString "라이스(rice), 슈가(sugar)"@ko ;
    kno:example "¶국산 쌀을 가공해 설탕으로 만든 쌀설탕, {라이스 슈가가} 국내에서 개발됐다."@ko ;
    kno:frequency kno:KN2017-0080-freq-NN-2016 ;
    kno:frequency kno:KN2017-0080-freq-NN-2017 ;
    kno:frequency kno:KN2017-0080-freq-NN-total ;
    kno:indexForm "라이스슈가"@ko ;
    kno:languageType "영_영" ;
    kno:lastAttestationYear "2017"^^xsd:gYear ;
    kno:origin "(<영>rice sugar)" ;
    kno:pos "「구」"@ko ;
    kno:registration "우리말샘"@ko ;
    kno:unitType "구"@ko ;
    kno:urimalTargetCode "1380424" ;
    kno:year "2017"^^xsd:gYear .
kno:KN2017-0080-c1 a kno:Component ;
