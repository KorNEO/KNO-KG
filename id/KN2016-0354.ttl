kno:KN2016-0354 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "암행 순찰차"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1372789> ;
    skos:definition "범죄나 사고를 방지하기 위하여 정체를 숨기고 여러 곳을 두루 돌아다니는 순찰차."@ko ;
