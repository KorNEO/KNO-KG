    dcterms:isReferencedBy <https://namu.wiki/w/%EC%9C%A4%EC%84%9D%EC%97%B4%20%EB%8C%80%ED%86%B5%EB%A0%B9%20%ED%87%B4%EC%A7%84%EB%A1%A0/12.3%20%EB%82%B4%EB%9E%80%20%EC%9D%B4%EC%A0%84> .

