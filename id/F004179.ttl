# F004179 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F004179 kno:fullForm "사진"@ko ;
    a kno:Formative ;
    kno:origin "寫眞" ;
    kno:registration "우리말샘"@ko ;
    kno:semanticTag kno:usas-Q4.3 ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=13033> ;
    kno:urimalDefinition "물체의 형상을 감광막 위에 나타나도록 찍어 오랫동안 보존할 수 있게 만든 영상. 물체로부터 오는 광선을 사진기 렌즈로 모아 필름, 건판 따위에 결상(結像)을 시킨 뒤에, 이것을 현상액으로 처리하여 음화(陰畫)를 만들고 다시 인화지로 양화(陽畫)를 만든다. 〔명사〕"@ko ;
    rdfs:label "사진(寫眞)"@ko ;
    kno:urimalTargetCode "13033" ;
    kno:caseCount "1"^^xsd:integer ;
    kno:surfaceForm "사진"@ko ;
    kno:truncated "false"^^xsd:boolean .
kno:KN2016-0253-c1 kno:formative kno:F004179 .
