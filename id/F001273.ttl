# F001273 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:F001273 kno:origin "tomato" ;
    kno:caseCount "2"^^xsd:integer ;
    kno:truncated "true"^^xsd:boolean ;
    kno:semanticTag kno:usas-F1 ;
    kno:urimalTargetCode "401100" ;
    kno:registration "우리말샘"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=401100> ;
    kno:fullForm "토마토"@ko ;
    kno:fullFormLexeme kno:LEX-토마토 ;
    rdfs:label "(토)마토(tomato)"@ko ;
    kno:urimalDefinition "가짓과의 한해살이풀. 높이는 1~1.5미터이며, 잎은 어긋나고 우상 복엽이다. 여름에 노란 꽃이 총상(總狀) 화서로 잎겨드랑이에 피고, 열매는 장과(漿果)로 붉게 익으며 식용한다. 남아메리카 열대 지방이 원산지로 밭에서 재배한다. 〔명사〕"@ko ;
    a kno:Formative ;
    kno:surfaceForm "마토"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EB%A7%88%ED%86%A0> ;
    kno:parallelFullForm kno:LEX-토마토 .
