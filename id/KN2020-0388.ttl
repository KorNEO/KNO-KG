@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix frac: <http://www.w3.org/ns/lemon/frac#> .
@prefix kno: <https://w3id.org/kno/id/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kno:KN2020-0388 a ontolex:MultiwordExpression ;
    frac:attestation kno:KN2020-0388-att-nn ;
    ontolex:canonicalForm kno:KN2020-0388-form ;
    ontolex:sense kno:KN2020-0388-sense .

kno:KN2020-0388-att-nn a frac:Attestation ;
    dcterms:date "2020-02-13"^^xsd:date ;
    frac:locus <https://n.news.naver.com/article/018/0004574953> .

kno:KN2020-0388-form a ontolex:Form ;
    frac:frequency kno:KN2020-0388-freq-nn,
        kno:KN2020-0388-freq-yt ;
    ontolex:writtenRep "포스트 코로나"@ko .

kno:KN2020-0388-freq-nn a frac:CorpusFrequency ;
    rdf:value 122880 ;
    frac:corpus kno:corpus-NN .

kno:KN2020-0388-freq-yt a frac:CorpusFrequency ;
    rdf:value 2098 ;
    frac:corpus kno:corpus-YT .

kno:KN2020-0388-sense a ontolex:LexicalSense ;
    dcterms:isReferencedBy <https://namu.wiki/w/%ED%8F%AC%EC%8A%A4%ED%8A%B8%20%EC%BD%94%EB%A1%9C%EB%82%98> .

kno:corpus-NN skos:prefLabel "신문 말뭉치"@ko .

kno:corpus-YT skos:prefLabel "댓글 말뭉치"@ko .

