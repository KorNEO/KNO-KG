    a kno:Formative ;
    kno:origin "stress" ;
    kno:urimalDefinition "적응하기 어려운 환경에 처할 때 느끼는 심리적·신체적 긴장 상태. 장기적으로 지속되면 심장병, 위궤양, 고혈압 따위의 신체적 질환을 일으키기도 하고 불면증, 신경증, 우울증 따위의 심리적 부적응을 나타내기도 한다. 〔명사〕"@ko ;
    kno:surfaceForm "스트레스"@ko ;
    kno:truncated "false"^^xsd:boolean .
