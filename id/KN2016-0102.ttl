# KN2016-0102 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2016-0102 kno:frequency kno:KN2016-0102-freq-NN-total ;
    kno:languageType "한^한" ;
    kno:registration "우리말샘"@ko ;
    skos:definition "한국은행의 돈이 시중으로 흘러가도록 돕는 역할을 하는 은행을 비유적으로 이르는 말. 물이 통하도록 만든 관처럼 돈이 통하도록 하는 은행이라는 뜻이다."@ko ;
    kno:pos "「구」"@ko ;
