kno:KN2025-0451 kno:activeYears "1"^^xsd:integer ;
    skos:definition "(LLM) 전세 제도를 축소하고 월세 중심의 임대차 구조로 전환하는 흐름이나 정책 방향을 지지하는 사람. 또는 그런 성향의 집단."@ko ;
