kno:KN2018-0093 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "딥^테크^기업"@ko ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1416134> ;
    skos:definition "고도의 기술력을 가진 신생 기업. 기술력은 있으나 대부분 투자를 유도하는 능력이 없어 성장에 어려움을 겪기도 한다."@ko ;
