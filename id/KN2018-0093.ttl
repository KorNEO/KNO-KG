    kno:component kno:KN2018-0093-c3 ;
    kno:componentString "딥(deep), 테크(tech), 기업(企業)"@ko ;
    kno:example "¶O 대표는 {딥 테크 기업이} 경영 능력만 갖출 경우 성장 가능성은 더 높다고 주장했다."@ko ;
