# KN2019-0100 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2019-0100 kno:languageType "고+영" ;
    kno:year "2019"^^xsd:gYear ;
    a ontolex:Word ;
    kno:pos "「명」"@ko ;
    skos:definition "알몸이 찍힌 동영상으로 상대방을 협박하여 큰돈을 뜯어내는 범죄를 비유적으로 이르는 말. ⇒규범 표기는 ‘몸토’이다."@ko ;
    kno:registration "신어DB"@ko ;
    a kno:Neologism ;
    kno:origin "(몸<영>←Lotto)" ;
    kno:example "¶몸 캠 피싱은 최근 늘어난 인터넷 사기 범죄로, 이른바 ‘영상 통화 사기’, ‘{몸또}’, ‘화상 통화 사기’, ‘화상 통화 협박’ 등으로도 불리고 있는 신종 수법이다."@ko ;
