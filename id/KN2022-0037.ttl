# KN2022-0037 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2022-0037 a ontolex:MultiwordExpression ;
    a kno:Neologism ;
    rdfs:label "고준위^특별법"@ko ;
    rdfs:seeAlso <https://opendict.korean.go.kr/search/searchResult?focus_name_top=query&query=%EA%B3%A0%EC%A4%80%EC%9C%84%ED%8A%B9%EB%B3%84%EB%B2%95> ;
    skos:definition "고준위 방사성 폐기물을 안전하게 관리하기 위한 절차와 원칙 및 관리 시설의 부지 선정 등에 관한 내용을 담고 있는 법률. 정식 명칭은 ‘고준위 방사성 폐기물 관리에 관한 특별법’이다."@ko ;
    kno:activeYears "5"^^xsd:integer ;
    kno:component kno:KN2022-0037-c1 ;
    kno:component kno:KN2022-0037-c2 ;
    kno:componentString "고준위(高準位), 특별법(特別法)"@ko ;
    kno:example "¶‘{고준위 특별법’의} 발의에 반대하는 단체에서는 이 법안이 고준위 방사성 폐기물의 안전한 처분과 관리를 위한 법안이 아니라고 주장하였다."@ko ;
