# KN2017-0013 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2017-0013 kno:indexForm "겟꿀러"@ko ;
    a kno:Neologism ;
    kno:year "2017"^^xsd:gYear ;
