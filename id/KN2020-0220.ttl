# KN2020-0220 — 한국어 신어 지식 그래프 (kno-components.ttl 발췌)

kno:KN2020-0220 kno:component kno:KN2020-0220-c1 ;
    a kno:Neologism ;
    kno:unitType "단어"@ko ;
    kno:origin "(<영>upperwear)" ;
    rdfs:seeAlso <http://opendict.korean.go.kr/dictionary/view?sense_no=1515781> ;
    kno:urimalTargetCode "1515781" ;
    kno:year "2020"^^xsd:gYear ;
    kno:pos "「명」"@ko ;
    rdfs:label "어퍼웨어"@ko ;
    kno:formation kno:W07 ;
    kno:example "¶온라인 수업 시작 직전까지 침대에서 늦장을 부리던 아이는 윗옷만 갈아입고 잠옷 바지는 그대로인 {어퍼웨어를} 선보이며 컴퓨터 앞에 앉았다."@ko ;
    skos:definition "화상 회의나 영상 통화 따위를 하기 위해 상의만 차려입는 옷차림. 화면을 통해 주로 상체 쪽만 상대방에게 보이기 때문에 상의는 잘 차려입고 화면에 보이지 않는 하의는 편하게 입는다. 코로나19의 확산을 방지하기 위한 사회적 거리 두기의 일환으로 재택근무나 온라인 수업 따위가 일상화되는 상황에서 나온 말이다."@ko ;
    kno:predicate "차려입다"@ko ;
    kno:componentString "어퍼(upper), 웨어(wear)"@ko ;
