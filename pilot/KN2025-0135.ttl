kno:KN2025-0135 a ontolex:MultiwordExpression ;
    ontolex:canonicalForm kno:KN2025-0135-form1 ;
    ontolex:otherForm kno:KN2025-0135-form2.

kno:KN2025-0135-form1 ontolex:writtenRep "노쇼 경제학"@ko ;
    morph:consistsOf kno:component-C-000001, kno:component-C-000004 .

kno:KN2025-0135-form2 ontolex:writtenRep "노쇼경제학"@ko .

kno:KN2025-0135 frac:frequency
    [ a frac:Frequency ; rdf:value 85 ;
      frac:unit "ecel" ; frac:observedIn kno:articleCorpus ] ,
    [ a frac:Frequency ; rdf:value 200 ;
      frac:unit "ecel" ; frac:observedIn kno:commentsCorpus ] .

kno:KN2025-0135 frac:attestation
    [ a frac:Attestation ;
      frac:quotedText "그러면서 \"이재명이 집권한다면 만들어질 세상은 그렇게 무서운 곡학아세의 세상\"이라며 \"호텔에 예약했다가 취소해도 마을에 돈이 돌았으니 잘된 거라는 ‘노쇼 경제학’도 다시 꺼내 들었다”고 강조했다."@ko ;
      frac:observedIn <https://n.news.naver.com/article/082/0001326236> ] .

